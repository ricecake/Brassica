#version 460
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_quad : require

// AMD FidelityFX Single Pass Downsampler (external/ffx-spd) -- builds the terrain min/max mip
// chain from TerrainMinMaxTexture's mip 0 (written per-texel by terrain_gen.comp, min == max ==
// height there) down to mip 10 (1x1, for MapDim = 1024). This is SPD 2.0's "A-prefix" header pair
// (ffx_a.h/ffx_spd.h), not the newer FidelityFX SDK -- A_GPU/A_GLSL, not FFX_GPU/FFX_GLSL.
#define A_GPU 1
#define A_GLSL 1

#include "bindless.glsl"
#include "ffx-spd/ffx_a.h"

shared vec4 spdIntermediate[16][16];
shared uint spdCounter;

// One uint per clipmap slice (layer), zeroed once at creation and reset by SPD itself
// (SpdResetAtomicCounter) after each run -- node-owned, not a graph resource (nothing else ever
// reads it). set = 2: set 0 is the FrameUBO, set 1 is the bindless catalog above: this is the one
// thing in this shader that genuinely needs its own node-local binding.
layout(set = 2, binding = 0, std430) coherent buffer AtomicCounter { uint counter[]; };

layout(push_constant) uniform Constants {
	uint   srcIndex;       // bindless SAMPLED index for TerrainMinMaxTexture's mip 0 (read-only)
	uint   mips;           // total output mips to compute (10 for MapDim = 1024 -- our mip 1..10)
	uint   numWorkGroups;  // workgroups dispatched for this slice (excludes the Z/slice dimension)
	uvec2  workGroupOffset; // tile offset -- (0,0) until incremental dirty-rect dispatch lands
	// Bindless STORAGE indices for SPD's internal output mips 0..9 (== our mip 1..10). Index 5
	// (our mip 6) is SPD's single-workgroup coarse-tail handoff -- SpdStore/SpdLoad route it
	// through uImageArraysRG32FCoherent instead of the plain writeonly alias every other index
	// uses, but it's the same bindless slot either way (AssignAndWriteBindlessIndices doesn't
	// care which GLSL declaration a resource's index gets read through).
	uint   mipIndices[10];
} cb;

// 1. Fetch mip 0 -- already (min, max) per terrain_gen.comp's write, not a raw height, so no
// manual min==max duplication needed here. Sampled read (not storage): formatless storage reads
// aren't legal in this toolchain (bindless.glsl's comment), but a sampled read has no such
// restriction regardless of format.
vec4 SpdLoadSourceImage(ivec2 pix, uint slice) {
	vec2 minMax = texelFetch(
		sampler2DArray(uTextureArrays[nonuniformEXT(cb.srcIndex)], uSamplers[BRASSICA_SAMPLER_NEAREST_CLAMP]),
		ivec3(pix, slice),
		0
	).rg;
	return vec4(minMax, 0.0, 0.0);
}

// 2. Fetch mip 6 -- the coherent handoff: the single surviving workgroup reads back every
// workgroup's mip-6 write (SpdStore below) to seed the coarse tail (mips 7-10).
vec4 SpdLoad(ivec2 pix, uint slice) {
	return imageLoad(uImageArraysRG32FCoherent[nonuniformEXT(cb.mipIndices[5])], ivec3(pix, slice));
}

// 3. Store an output mip. index is SPD's own 0-based numbering (0..9 here == our mip 1..10).
void SpdStore(ivec2 pix, vec4 outValue, uint index, uint slice) {
	if (index == 5) {
		imageStore(uImageArraysRG32FCoherent[nonuniformEXT(cb.mipIndices[5])], ivec3(pix, slice), outValue);
	} else {
		imageStore(uImageArraysGenericWrite[nonuniformEXT(cb.mipIndices[index])], ivec3(pix, slice), outValue);
	}
}

// 4. LDS intermediate storage -- SPD's own scratch space for the second half of its 0-1 mip pass.
vec4 SpdLoadIntermediate(uint x, uint y) {
	return spdIntermediate[x][y];
}

void SpdStoreIntermediate(uint x, uint y, vec4 value) {
	spdIntermediate[x][y] = value;
}

// 5. Atomic counters -- one per slice, used to elect the single workgroup that computes the
// coarse tail. SPD resets its own counter back to 0 after each run (SpdDownsample's body calls
// this right before the coarse tail), so nothing outside this shader has to.
void SpdIncreaseAtomicCounter(uint slice) {
	spdCounter = atomicAdd(counter[slice], 1u);
}

uint SpdGetAtomicCounter() {
	return spdCounter;
}

void SpdResetAtomicCounter(uint slice) {
	counter[slice] = 0u;
}

// 6. Min/max reduction -- x = min, y = max; z/w unused (kept zero, matching SpdLoadSourceImage).
vec4 SpdReduce4(vec4 v0, vec4 v1, vec4 v2, vec4 v3) {
	float minVal = min(min(v0.x, v1.x), min(v2.x, v3.x));
	float maxVal = max(max(v0.y, v1.y), max(v2.y, v3.y));
	return vec4(minVal, maxVal, 0.0, 0.0);
}

#include "ffx-spd/ffx_spd.h"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main() {
	SpdDownsample(
		gl_WorkGroupID.xy,
		gl_LocalInvocationIndex,
		cb.mips,
		cb.numWorkGroups,
		gl_WorkGroupID.z, // one clipmap slice (LOD layer) per Z workgroup index
		cb.workGroupOffset
	);
}
