#version 460
#extension GL_EXT_nonuniform_qualifier : require

#include "bindless.glsl"
#include "common.glsl"
#include "helpers/octahedral.glsl"

layout(set = 1, binding = 3, rgba32f) uniform image2D uImageStorageRGBA32F[];
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform ClimateAdvectPushConstants {
	uint  inStorageIdx;  // Input climate texture index
	uint  outStorageIdx; // Output climate texture index
	uint  textureDim;    // 2048
	float dt;            // Advection step size (default 1.0)
} push;

void main() {
	uvec2 pixel = gl_GlobalInvocationID.xy;
	if (pixel.x >= push.textureDim || pixel.y >= push.textureDim) {
		return;
	}

	vec2 uv = (vec2(pixel) + 0.5) / float(push.textureDim);
	ivec2 coord = ivec2(pixel);

	vec4 currentData = imageLoad(uImageStorageRGBA32F[nonuniformEXT(push.inStorageIdx)], coord);
	vec2 currentWind = currentData.ba;

	// Semi-Lagrangian backtracking along wind field
	vec2 backtrackUV = uv - currentWind * push.dt;

	// Wrap octahedral UV back into valid [0, 1] range
	backtrackUV = clamp(backtrackUV, vec2(0.0), vec2(1.0));
	ivec2 backtrackCoord = ivec2(clamp(backtrackUV * float(push.textureDim), vec2(0.0), vec2(float(push.textureDim - 1))));

	vec4 backData = imageLoad(uImageStorageRGBA32F[nonuniformEXT(push.inStorageIdx)], backtrackCoord);

	// Evaluate terrain land/ocean mask for moisture replenishment & mountain deflection
	vec3 dir = octahedralUVToDirection(uv);
	vec3 p = dir * FAKE_PLANET_RADIUS;
	float landMask = 0.0;
	vec3 gradMask = vec3(0.0);
	evaluate_soft_voronoi_pseudosphere2(p, 32, landMask, gradMask);

	float landVal = clamp(landMask, 0.0, 1.0);

	float advectedTemp = mix(currentData.r, backData.r, 0.7);
	float advectedMoisture = mix(currentData.g, backData.g, 0.7);
	vec2 advectedWind = mix(currentWind, backData.ba, 0.7);

	// Ocean moisture replenishment
	if (landVal < 0.2) {
		advectedMoisture = mix(advectedMoisture, 0.85, 0.2);
	}

	// Mountain barrier deflection: deflect wind away from steep land gradients
	vec2 landGrad2D = vec2(gradMask.x, gradMask.z) * 0.001;
	advectedWind -= landGrad2D * landVal * 0.005;

	imageStore(
		uImageStorageRGBA32F[nonuniformEXT(push.outStorageIdx)],
		coord,
		vec4(clamp(advectedTemp, 0.0, 1.0), clamp(advectedMoisture, 0.0, 1.0), advectedWind.x, advectedWind.y)
	);
}
