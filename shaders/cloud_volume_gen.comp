#version 450
#extension GL_EXT_nonuniform_qualifier : require

#include "bindless.glsl"
#include "lygia/generative/psrdnoise.glsl"
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(push_constant) uniform CloudVolumeGenPushConstants {
	vec4  cameraPos;            // x, y, z = camera position
	uvec4 cascadeStorageIdx;    // x, y, z = storage bindless indices for cascades 0, 1, 2
	vec4  cascadeExtents;       // x = 20000, y = 80000, z = 320000, w = 15000 (vertical span)
	vec4  cascadeCenterPos[3];  // x, z = center world position for cascade 0, 1, 2
	ivec4 cascadeGridOffset[3]; // x, y = toroidal grid offset (voxels) for cascade 0, 1, 2
	uint  forceRegeneration;
	float cadencePhase;         // Seed/phase derived from update cadence
} push;


vec3 hash33(vec3 p) {
	p = fract(p * vec3(443.897, 441.423, 437.195));
	p += dot(p, p.yxz + 19.19);
	return fract((p.xxy + p.yxx) * p.zyx);
}

float hash13Tile(in vec3 pos, in vec3 period) {
	if (period.x > 0.0) pos = mod(pos, period);
    pos  = fract(pos * vec3(.1031, .1030, .0973));
    pos += dot(pos, pos.zyx + 31.32);
    return fract((pos.x + pos.y) * pos.z);
}

float alligator(vec3 position, float gridsize, vec3 seed, bool tiling) {

    // Only int gridsize if it needs to tile
    if (tiling) gridsize = round(gridsize);
    gridsize = max(1.0, gridsize);

    position *= gridsize;
    position += hash33(vec3(seed)); // offset so FBM grids do not align

    vec3 id = floor(position);
    vec3 grid = position - id; // fract(position)

    float densest = 0.0;
    float secondDensest = 0.0;

    // Search the current cell and its neighbors (3x3x3)
    for (int x = -1; x <= 1; ++x)
    for (int y = -1; y <= 1; ++y)
    for (int z = -1; z <= 1; ++z) {

        vec3 offset = vec3(x, y, z);
        vec3 cell = id + offset;

        // Wrap cell coordinates to make the noise tile over [0,1]
        if (tiling) cell = mod(cell, gridsize);

         // Offset the hash input to avoid hashing zero coordinates
        cell += vec3(seed);

        // Get random center of the Cell
        vec3 center = hash33(cell) + offset;

        float dist = distance(grid, center);

        // 'if(dist < 1.0)' doesn't have any effect and doesn't improve
        // performance. See: https://www.shadertoy.com/view/MflGWM

        // Get random density scaled by the distance to the random point
        float density = hash13Tile(cell, vec3(gridsize)) * smoothstep(0, 1, 1.0 - dist);

        // Keep track of the two largest density values
        if (densest < density) {
            secondDensest = densest;
            densest = density;

        } else if (secondDensest < density) {
            secondDensest = density;
        }
    }
    // The alligator noise is the difference between the two largest densities
    return densest - secondDensest;
}


void main() {
	uvec3 vox = gl_GlobalInvocationID;
	if (vox.x >= 256 || vox.y >= 256 || vox.z >= 256) {
		return;
	}

	const uint NUM_CHUNKS = 16u;
	const uint FADE_FRAMES = 8u;
	const uint STAGGER_FRAMES = 4u; // Start next chunk halfway through current

	// 15 staggers * 4 frames + 8 frames to finish the last one = 68 frames of activity
	const uint ACTIVE_FRAMES = (NUM_CHUNKS - 1u) * STAGGER_FRAMES + FADE_FRAMES;
	const uint REST_FRAMES = 30u; // Adjust this to lengthen/shorten the static period
	const uint CYCLE_FRAMES = ACTIVE_FRAMES + REST_FRAMES; // e.g., 128 frames

	// Current temporal state
	uint cycleFrame = uFrameIndex % CYCLE_FRAMES;
	uint globalPhase = uFrameIndex / CYCLE_FRAMES;

	// uint mCode = bayer3D(vox);
	uint mCode = encodeMorton3D(vox);
	uint chunkId = ((mCode >> 19u) & 15u);

	// uint ditherStep = bayer3D(vox) & 7u; // Equivalent to % 8
	uint ditherStep = encodeMorton3D(vox) & 7u; // Equivalent to % 8

	// uint ditherStep = bayer3D(vox) & 7u; // Equivalent to % 8
	// ditherStep = (encodeMorton3D(vox) & 7u) ^ ditherStep; // Equivalent to % 8

	// 3. Exact target frame for this specific voxel
	uint voxelUpdateFrame = (chunkId * STAGGER_FRAMES) + ditherStep;



	vec3 rawDelta = uCameraPosition.xyz - uPreviousCameraPosition.xyz;

	for (int c = 0; c < 3; ++c) {
		uint storageIdx = push.cascadeStorageIdx[c];
		if (storageIdx == 0xFFFFFFFFu) continue;

		bool needsUpdate = push.forceRegeneration != 0;
		float hExtent = push.cascadeExtents[c];

		float voxelSize = hExtent / 256.0;
		vec3 delta = rawDelta / voxelSize;

		vec2 prevSnappedCenter = floor(uPreviousCameraPosition.xz / voxelSize) * voxelSize;
		vec2 snappedCenter = floor(uCameraPosition.xz / voxelSize) * voxelSize;

		ivec2 gridDelta = ivec2(round((snappedCenter - prevSnappedCenter) / voxelSize));

		if (gridDelta.x > 0 && vox.x >= 256 - gridDelta.x) needsUpdate = true;
		if (gridDelta.x < 0 && vox.x < -gridDelta.x) needsUpdate = true;

		if (gridDelta.y > 0 && vox.z >= 256 - gridDelta.y) needsUpdate = true;
		if (gridDelta.y < 0 && vox.z < -gridDelta.y) needsUpdate = true;

		// if ((linearIdx % cadence) == phaseOffset) needsUpdate = true;
		if (cycleFrame == voxelUpdateFrame) {
			needsUpdate = true;
		}

		if (!needsUpdate) continue;

		float vSpan = push.cascadeExtents.w; // 15000m
		float baseAlt = 5000.0;             // 1km in the air
		vec3 voxelNorm = (vec3(vox) / 256.0) - vec3(0.5, 0.0, 0.5);

		ivec2 gridCenter = ivec2(floor(uCameraPosition.xz / voxelSize));
		ivec2 spatialOffset = ivec2(vox.xz) - ivec2(128);
		ivec2 absoluteGrid = gridCenter + spatialOffset;

		ivec3 localVox = ivec3(
			absoluteGrid.x % 256,
			vox.y,
			absoluteGrid.y % 256
		);

		// GLSL modulo can be negative
		if (localVox.x < 0) localVox.x += 256;
		if (localVox.z < 0) localVox.z += 256;

		vec3 worldPos = vec3(
			snappedCenter.x + float(spatialOffset.x) * voxelSize,
			baseAlt + (float(vox.y) / 256.0) * vSpan,
			snappedCenter.y + float(spatialOffset.y) * voxelSize
		);

		// 3. Frequency-Clamped fBm Evaluation
		float density = 0.0;
		float frequency = 1.0 / 32000.0; // Base shape frequency (100km)
		float amplitude = 1.0;
		float maxAmplitude = 0.0;
		float gridSize = 8.0;

		for (int i = 0; i < 4; i++) {
			float wavelength = 1.0 / (gridSize*frequency);

			// Nyquist clamp: Stop accumulating detail if the noise feature is smaller than 2 voxels.
			// We fade it out smoothly to guarantee that Cascade 0 and Cascade 1 match perfectly at their boundary.
			float fade = clamp((wavelength - 2.0 * voxelSize) / (2.0 * voxelSize), 0.0, 1.0);
			if (fade <= 0.0) break;

			// float n = psrdnoise(worldPos * vec3(frequency, frequency, frequency), vec3(0.0), globalPhase);
			float n = alligator(worldPos * vec3(frequency, frequency, frequency), gridSize, vec3(globalPhase), true);

			density += n * amplitude * fade;
			maxAmplitude += amplitude*amplitude * fade;

			frequency *= 1.87;
			gridSize *= 2.0;
			amplitude *= 0.43; // Or use an exposed roughness parameter
		}

		density = max(0.0, density / sqrt(maxAmplitude));

		// // Shape the final density using global height bounds
		// density *= smoothstep(0.1, 0.15, voxelNorm.y) * (1.0 - smoothstep(0.85, 1.0, voxelNorm.y));

        // float voxelNormY = float(vox.y) / 256.0;
        // density *= smoothstep(0.1, 0.15, voxelNormY) * (1.0 - smoothstep(0.85, 1.0, voxelNormY));
		// density *= smoothstep(0.05, 0.5, density);

        imageStore(uImages3DGenericWrite[nonuniformEXT(storageIdx)], localVox, vec4(density, 0.0, 0.0, 1.0));
	}
}
