#version 450
#extension GL_EXT_nonuniform_qualifier : require

#include "bindless.glsl"
#include "lygia/generative/psrdnoise.glsl"
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(push_constant) uniform CloudVolumeGenPushConstants {
	uint outStorageIdx; // Storage bindless index for the single detail volume
	uint volumeDim;     // 256
} push;


vec3 hash33(vec3 p) {
	p = fract(p * vec3(443.897, 441.423, 437.195));
	p += dot(p, p.yxz + 19.19);
	return fract((p.xxy + p.yxx) * p.zyx);
}

float hash13Tile(in vec3 pos, in vec3 period) {
	if (period.x > 0.0) pos = mod(pos, period);
    pos  = fract(pos * vec3(.1031, .1030, .0973));
    pos += dot(pos, pos.zyx + 31.32);
    return fract((pos.x + pos.y) * pos.z);
}

float alligator(vec3 position, float gridsize, vec3 seed, bool tiling) {

    // Only int gridsize if it needs to tile
    if (tiling) gridsize = round(gridsize);
    gridsize = max(1.0, gridsize);

    position *= gridsize;
    position += hash33(vec3(seed)); // offset so FBM grids do not align

    vec3 id = floor(position);
    vec3 grid = position - id; // fract(position)

    float densest = 0.0;
    float secondDensest = 0.0;

    // Search the current cell and its neighbors (3x3x3)
    for (int x = -1; x <= 1; ++x)
    for (int y = -1; y <= 1; ++y)
    for (int z = -1; z <= 1; ++z) {

        vec3 offset = vec3(x, y, z);
        vec3 cell = id + offset;

        // Wrap cell coordinates to make the noise tile over [0,1]
        if (tiling) cell = mod(cell, gridsize);

         // Offset the hash input to avoid hashing zero coordinates
        cell += vec3(seed);

        // Get random center of the Cell
        vec3 center = hash33(cell) + offset;

        float dist = distance(grid, center);

        // 'if(dist < 1.0)' doesn't have any effect and doesn't improve
        // performance. See: https://www.shadertoy.com/view/MflGWM

        // Get random density scaled by the distance to the random point
        float density = hash13Tile(cell, vec3(gridsize)) * smoothstep(0, 1, 1.0 - dist);

        // Keep track of the two largest density values
        if (densest < density) {
            secondDensest = densest;
            densest = density;

        } else if (secondDensest < density) {
            secondDensest = density;
        }
    }
    // The alligator noise is the difference between the two largest densities
    return densest - secondDensest;
}


void main() {
	uvec3 vox = gl_GlobalInvocationID;
	uint  dim = push.volumeDim;
	if (vox.x >= dim || vox.y >= dim || vox.z >= dim) {
		return;
	}

	// Pure periodic tiling noise: no camera dependency, no altitude curve, no toroidal
	// windowing. The weather coverage map supplies the big-picture shape and the analytic
	// height-gradient (sampled in cloud_render.frag/cloud_shadow_gen.comp) supplies vertical
	// floor/ceiling shaping, so this volume only needs to be isotropic reusable detail noise
	// that tiles seamlessly in all 3 axes -- hence the gridsize-based `alligator` noise (exact
	// periodic wrap) rather than a continuous (non-tiling) fbm.
	//
	// This was reverted to dot_noise_fbm once before, after alligator's sharp Worley-cell-
	// boundary value distribution caused a ~10x GPU regression: neighboring raymarch threads in
	// cloud_shadow_gen.comp/cloud_render.frag's marchClouds() disagreed on threshold branches
	// (density > 0.0, cloudTransmittance < 0.05) far more often than smooth fbm did -- a classic
	// warp/SIMD divergence pathology, where the whole warp pays for the slowest-diverging lane.
	// The root cause was CloudDetailVolume having no mip chain: every sample, at any distance,
	// read the raw unfiltered noise. It now has one (CloudVolumeDownsampleNode, mips 1-4), and
	// cloud_render.frag's sampleCloudVolume() picks a distance-based LOD so distant samples read
	// pre-blurred data instead of hitting alligator's sharp edges directly -- see those two for
	// the other half of this fix.
	vec3 uvw = (vec3(vox) + 0.5) / float(dim);

	float density = 0.0;
	float gridSize = 2.0;
	float amplitude = 1.0;
	float maxAmplitude = 0.0;

	for (int i = 0; i < 8; i++) {
		// Nyquist clamp: stop accumulating detail once a noise cell would be smaller than
		// 2 voxels, faded smoothly so there's no hard cutoff.
		float voxelsPerCell = float(dim) / gridSize;
		float fade = clamp((voxelsPerCell - 2.0) / 2.0, 0.0, 1.0);
		if (fade <= 0.0) break;

		float n = alligator(uvw, gridSize, vec3(float(i) * 17.0), true);

		density += n * amplitude * fade;
		maxAmplitude += amplitude * amplitude * fade;

		gridSize *= 2.0;
		amplitude *= 0.43;
	}

	density = max(0.0, density / sqrt(max(maxAmplitude, 1e-5)));
	float voxelNormY = float(vox.y) / 256.0;
	density *= smoothstep(0.1, 0.15, voxelNormY) * (1.0 - smoothstep(0.85, 1.0, voxelNormY));
	// density *= smoothstep(0.15, 0.85, density);

	ivec3 outVox = ivec3(vox);
	imageStore(uImages3DGenericWrite[nonuniformEXT(push.outStorageIdx)], outVox, vec4(density, 0.0, 0.0, 1.0));
}
