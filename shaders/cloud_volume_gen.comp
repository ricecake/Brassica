	vec4  cameraPos;            // x, y, z = camera position
	uvec4 cascadeStorageIdx;    // x, y, z = storage bindless indices
	vec4  cascadeExtents;       // x=20000, y=80000, z=320000, w=15000 (vertical span)

	// Update Scaffolding
	uvec3 updateOffset;         // Used for scroll updates (the starting local voxel)
	uint  updateMode;           // 0 = Volume/Scroll, 1 = Stochastic Scatter
	uint  frameIndex;           // For the stochastic noise seed
	uint  stochasticBudget;     // Number of voxels to update per frame (e.g., 262144)
} push;

void main() {
	uvec3 vox;

	if (push.updateMode == 1) {
		// Mode 1: Stochastic Regeneration
		// Flatten the 3D dispatch into a 1D thread pool
		uint threadIdx = gl_GlobalInvocationID.x +
						 gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) +
						 gl_GlobalInvocationID.z * (gl_NumWorkGroups.x * gl_WorkGroupSize.x * gl_NumWorkGroups.y * gl_WorkGroupSize.y);

		if (threadIdx >= push.stochasticBudget) return;

		// Use prime hashing to scatter the updates throughout the 256^3 volume
		uint voxelIdx = (push.frameIndex * push.stochasticBudget + threadIdx) * 7919u % (256u*256u*256u);

		vox = uvec3(
			voxelIdx % 256u,
			(voxelIdx / 256u) % 256u,
			voxelIdx / 65536u
		);
	} else {
		// Mode 0: Full initialization or Toroidal Scroll update
		vox = gl_GlobalInvocationID + push.updateOffset;
		if (vox.x >= 256 || vox.y >= 256 || vox.z >= 256) return;
	}

	float baseAlt = 1000.0; // 1km in the air

