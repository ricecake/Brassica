#version 460 core
#include "bindless.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct Particle {
	vec4  position;
	vec4  velocity;
	vec4  color;
	vec4  misc;
	uint  type;
	float lifetime;
	float maxLifetime;
	uint  padding;
};

struct ParticleType {
	vec4  color;
	float size;
	float gravityScale;
	float drag;
	float padding;
};

struct IndirectCommand {
	uint groupCountX;
	uint groupCountY;
	uint groupCountZ;
};

layout(std430, set = 2, binding = 0) buffer Particles {
	Particle uParticles[];
};

layout(std430, set = 2, binding = 1) readonly buffer ParticleTypes {
	ParticleType uParticleTypes[];
};

layout(std430, set = 2, binding = 2) buffer AboveWaterAliveIndices {
	uint uAboveWaterAliveIndices[];
};

layout(std430, set = 2, binding = 3) buffer AboveWaterIndirectCommandBuffer {
	IndirectCommand uAboveWaterIndirectCommand;
};

layout(std430, set = 2, binding = 4) buffer UnderwaterAliveIndices {
	uint uUnderwaterAliveIndices[];
};

layout(std430, set = 2, binding = 5) buffer UnderwaterIndirectCommandBuffer {
	IndirectCommand uUnderwaterIndirectCommand;
};

layout(push_constant) uniform ParticleLivenessPushConstants {
	uint  maxParticles;
	float deltaTime;
	float waterLevel;
	uint  activeParticles;
	uint  birdCutoff;
	uint  fishCutoff;
} uPush;

float hash1(uint n) {
	n = (n << 13U) ^ n;
	return float((n * (n * n * 15731U + 789221U) + 1376312589U) & 0x7fffffffU) / 2147483648.0;
}

vec3 hash3(uint n) {
	return vec3(hash1(n), hash1(n + 1013U), hash1(n + 2017U));
}

void advanceParticleTrajectory(inout Particle p, float dt) {
	if (dt <= 0.001) return;
	if (p.type == 0u) { // Birds
		p.position.xyz += p.velocity.xyz * dt;
		p.misc.x += dt * 3.0; // Flap phase
	} else if (p.type == 1u) { // Fish
		p.position.xyz += p.velocity.xyz * dt;
		p.misc.x += dt * 2.0; // Tail wiggle phase
	} else if (p.type == 2u) { // Fireflies
		float phase = p.misc.x;
		vec3 turb = vec3(sin(phase + dt), cos(phase * 0.7 + dt), sin(phase * 1.3 + dt)) * 0.5;
		p.position.xyz += (p.velocity.xyz + turb) * dt;
		p.misc.x += dt * 2.5;
	}
}

void main() {
	uint idx = gl_GlobalInvocationID.x;

	if (idx >= uPush.activeParticles || idx >= uPush.maxParticles) {
		return;
	}

	vec3 camPos = uCameraPosition.xyz;
	vec3 camFwd = normalize(-uInvViewMatrix[2].xyz);
	vec3 camRight = normalize(uInvViewMatrix[0].xyz);
	vec3 camUp = normalize(uInvViewMatrix[1].xyz);

	// Select type: Birds (0), Fish (1), Fireflies (2) based on allotment cutoffs
	uint pType = 2u; // Fireflies default
	if (idx < uPush.birdCutoff) {
		pType = 0u; // Birds
	} else if (idx < uPush.fishCutoff) {
		pType = 1u; // Fish
	}

	uParticles[idx].type = pType;

	float distToCam = length(uParticles[idx].position.xyz - camPos);
	bool expired = uParticles[idx].lifetime <= 0.0 || distToCam > 300.0;

	if (expired) {
		float totalLifetime = 8.0 + hash1(idx * 7u + uFrameIndex) * 8.0;
		float skippedTime = hash1(idx * 11u + uFrameIndex) * totalLifetime;

		uParticles[idx].maxLifetime = totalLifetime;
		uParticles[idx].lifetime = totalLifetime - skippedTime;

		// World-space ring spawn around camera view line
		float rDist = 20.0 + hash1(idx * 13u + uFrameIndex) * 120.0;
		float rAngle = hash1(idx * 17u + uFrameIndex) * 6.2831853;
		float rHeight = (hash1(idx * 23u + uFrameIndex) - 0.5) * 40.0;

		vec3 spawnCenter = camPos + camFwd * rDist + (camRight * cos(rAngle) + camUp * sin(rAngle)) * (rDist * 0.5);
		spawnCenter.y += rHeight;

		if (pType == 0u) { // Birds (Above water)
			spawnCenter.y = max(spawnCenter.y, max(camPos.y + 2.0, uPush.waterLevel + 5.0));
			vec3 flyDir = normalize(camFwd + camRight * (hash1(idx * 37u) - 0.5) + vec3(0.0, 0.1, 0.0));
			uParticles[idx].velocity = vec4(flyDir * (10.0 + hash1(idx * 41u) * 6.0), 0.0);
			uParticles[idx].color = vec4(0.8, 0.85, 0.9, 1.0);
			uParticles[idx].misc = vec4(hash1(idx * 43u) * 6.28, 0.0, 0.0, 0.0);
		} else if (pType == 1u) { // Fish (Underwater)
			spawnCenter.y = min(spawnCenter.y, uPush.waterLevel - 1.5);
			vec3 swimDir = normalize(camFwd + camRight * (hash1(idx * 37u) - 0.5));
			uParticles[idx].velocity = vec4(swimDir * (4.0 + hash1(idx * 41u) * 4.0), 0.0);
			uParticles[idx].color = vec4(0.4, 0.7, 0.9, 0.9);
			uParticles[idx].misc = vec4(hash1(idx * 43u) * 6.28, 0.0, 0.0, 0.0);
		} else { // Fireflies (Above water / ground level)
			spawnCenter.y = max(spawnCenter.y, uPush.waterLevel + 1.0);
			vec3 driftDir = (hash3(idx * 31u) - 0.5) * 1.5;
			uParticles[idx].velocity = vec4(driftDir, 0.0);
			uParticles[idx].color = vec4(0.9, 1.0, 0.3, 1.0); // Warm yellow-green glow
			uParticles[idx].misc = vec4(hash1(idx * 43u) * 6.28, 0.0, 0.0, 0.0); // x = phase, y = flash counter
		}

		uParticles[idx].position = vec4(spawnCenter, 1.0);

		// Fast-forward particle along its trajectory using skipped time to avoid spawning pops
		advanceParticleTrajectory(uParticles[idx], skippedTime);
	}

	uParticles[idx].lifetime -= uPush.deltaTime;

	if (uParticles[idx].lifetime > 0.0) {
		bool particleAboveWater = uParticles[idx].position.y > uPush.waterLevel;
		bool cameraAboveWater = camPos.y > uPush.waterLevel;
		bool rendersAfterWater = particleAboveWater == cameraAboveWater;

		if (rendersAfterWater) {
			uint aliveSlot = atomicAdd(uAboveWaterIndirectCommand.groupCountX, 1);
			uAboveWaterAliveIndices[aliveSlot] = idx;
		} else {
			uint aliveSlot = atomicAdd(uUnderwaterIndirectCommand.groupCountX, 1);
			uUnderwaterAliveIndices[aliveSlot] = idx;
		}
	}
}
