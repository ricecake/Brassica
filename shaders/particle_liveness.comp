#version 460 core
#include "bindless.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct Particle {
	vec4  position;
	vec4  velocity;
	vec4  misc;
	uint  type;
	float lifetime;
	float maxLifetime;
	uint  padding;
};

struct ParticleType {
	vec4  color;
	float size;
	float gravityScale;
	float drag;
	float padding;
};

struct IndirectCommand {
	uint groupCountX;
	uint groupCountY;
	uint groupCountZ;
};

layout(std430, set = 2, binding = 0) buffer Particles {
	Particle uParticles[];
};

layout(std430, set = 2, binding = 1) readonly buffer ParticleTypes {
	ParticleType uParticleTypes[];
};

layout(std430, set = 2, binding = 2) buffer AboveWaterAliveIndices {
	uint uAboveWaterAliveIndices[];
};

layout(std430, set = 2, binding = 3) buffer AboveWaterIndirectCommandBuffer {
	IndirectCommand uAboveWaterIndirectCommand;
};

layout(std430, set = 2, binding = 4) buffer UnderwaterAliveIndices {
	uint uUnderwaterAliveIndices[];
};

layout(std430, set = 2, binding = 5) buffer UnderwaterIndirectCommandBuffer {
	IndirectCommand uUnderwaterIndirectCommand;
};

layout(push_constant) uniform ParticleLivenessPushConstants {
	uint  maxParticles;
	float deltaTime;
} uPush;

// Pseudo-random helper
float hash1(uint n) {
	n = (n << 13U) ^ n;
	return float((n * (n * n * 15731U + 789221U) + 1376312589U) & 0x7fffffffU) / 2147483648.0;
}

void main() {
	uint idx = gl_GlobalInvocationID.x;

	if (idx >= uPush.maxParticles) {
		return;
	}

	vec3 camPos = uCameraPosition.xyz;
	vec3 camFwd = normalize(-uInvViewMatrix[2].xyz);
	vec3 camRight = normalize(uInvViewMatrix[0].xyz);
	vec3 camUp = normalize(uInvViewMatrix[1].xyz);

	// Even indices are birds (type 0), odd indices are fish (type 1)
	uint pType = (idx % 2u == 0u) ? 0u : 1u;
	uParticles[idx].type = pType;

	float distToCam = length(uParticles[idx].position.xyz - camPos);
	bool expired = uParticles[idx].lifetime <= 0.0 || distToCam > 1500.0;

	if (expired) {
		uParticles[idx].lifetime = 10.0 + hash1(idx * 7u + uFrameIndex) * 10.0;
		uParticles[idx].maxLifetime = uParticles[idx].lifetime;

		float rFwd   = 30.0 + hash1(idx * 13u + uFrameIndex) * 200.0;
		float rRight = (hash1(idx * 17u + uFrameIndex) - 0.5) * 250.0;
		float rUp    = (hash1(idx * 23u + uFrameIndex) - 0.5) * 100.0;

		vec3 spawnCenter = camPos + camFwd * rFwd + camRight * rRight + camUp * rUp;

		if (pType == 0u) { // Birds (Above water)
			spawnCenter.y = max(spawnCenter.y, 10.0 + hash1(idx * 31u) * 40.0);
			vec3 flyDir = normalize(camFwd + camRight * (hash1(idx * 37u) - 0.5));
			uParticles[idx].velocity = vec4(flyDir * (15.0 + hash1(idx * 41u) * 10.0), 0.0);
			uParticles[idx].misc = vec4(hash1(idx * 43u) * 6.28, 0.0, 0.0, 0.0); // Wing flap phase
		} else { // Fish (Underwater)
			spawnCenter.y = min(spawnCenter.y, -5.0 - hash1(idx * 31u) * 20.0);
			vec3 swimDir = normalize(camFwd + camRight * (hash1(idx * 37u) - 0.5));
			uParticles[idx].velocity = vec4(swimDir * (5.0 + hash1(idx * 41u) * 5.0), 0.0);
			uParticles[idx].misc = vec4(hash1(idx * 43u) * 6.28, 0.0, 0.0, 0.0); // Swim wiggle phase
		}

		uParticles[idx].position = vec4(spawnCenter, 1.0);
	}

	uParticles[idx].lifetime -= uPush.deltaTime;

	if (uParticles[idx].lifetime > 0.0) {
		if (pType == 0u) {
			uint aliveSlot = atomicAdd(uAboveWaterIndirectCommand.groupCountX, 1);
			uAboveWaterAliveIndices[aliveSlot] = idx;
		} else {
			uint aliveSlot = atomicAdd(uUnderwaterIndirectCommand.groupCountX, 1);
			uUnderwaterAliveIndices[aliveSlot] = idx;
		}
	}
}
