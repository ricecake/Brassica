#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_KHR_shader_subgroup_ballot : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

#include "bindless.glsl"
#include "common.glsl"
#include "terrain.glsl"
#include "helpers/culling.glsl"

layout(push_constant) uniform WaterPushConstants {
	uvec4 gridParams; // x = numRings, y = meshletsPerRow, z = totalMeshlets, w = textureDim
	vec3  waterColor;
	float waterLevel;
	uint  gPositionIndex;
	uint  gAlbedoIndex;
	uint  gNormalIndex;
	uint  sceneColor;
	uint  minMaxIndex;
}
params;

struct TaskPayload {
	uint meshletIDs[32];
	uint lodLevels[32];
};

taskPayloadSharedEXT TaskPayload payload;

float getWaterRingScale(float ring) {
	return pow(2.0, ring);
}

shared uint meshletCount;

void main() {
	uint threadID = gl_LocalInvocationID.x;
	if (threadID == 0) {
		meshletCount = 0;
	}
	barrier();

	uint meshletID = gl_WorkGroupID.x * 32 + threadID;

	bool visible = false;
	uint ringLevel = 0;

	if (meshletID < params.gridParams.z) {
		uint meshletsPerRow = params.gridParams.y;
		uint totalPerRing = meshletsPerRow * meshletsPerRow;
		uint numRings = params.gridParams.x;
		ringLevel = min(meshletID / totalPerRing, numRings - 1);
		uint localID = meshletID % totalPerRing;

		uint row = localID / meshletsPerRow;
		uint col = localID % meshletsPerRow;

		vec3 camForward = normalize(-uInvViewMatrix[2].xyz);
		float pitch = abs(camForward.y);
		float lowAngleFactor = clamp(1.0 - pitch * 2.5, 0.0, 1.0);
		float angleCompression = mix(1.0, 0.65, lowAngleFactor);

		float baseMeshletSize = 24.0;
		float meshletSize = baseMeshletSize * getWaterRingScale(float(ringLevel)) * angleCompression;

		vec2 cameraSnap = floor(uCameraPosition.xz / meshletSize) * meshletSize;
		vec2 relCameraSnap = cameraSnap - uCameraPosition.xz;
		float maxWaveAmp = 20.0;

		vec3 relMinB = vec3(
			relCameraSnap.x + (float(col) - float(meshletsPerRow) * 0.5) * meshletSize,
			params.waterLevel - maxWaveAmp - uCameraPosition.y,
			relCameraSnap.y + (float(row) - float(meshletsPerRow) * 0.5) * meshletSize
		);
		vec3 relMaxB = relMinB + vec3(meshletSize, 2.0 * maxWaveAmp, meshletSize);

		vec2 maxRel = max(abs(relMinB.xz), abs(relMaxB.xz));
		float maxDropOff = dot(maxRel, maxRel) / (2.0 * FAKE_PLANET_RADIUS);
		relMinB.y -= maxDropOff;

		mat4 viewRel = mat4(mat3(uViewMatrix));
		mat4 viewProjRel = uProjMatrix * viewRel;

		visible = isAABBVisible(relMinB, relMaxB, viewProjRel, vec3(50.0, 100.0, 50.0), -100.0);

		if (visible && ringLevel > 0) {
			float prevMeshletSize = baseMeshletSize * getWaterRingScale(float(ringLevel - 1)) * angleCompression;
			vec2 prevCameraSnap = floor(uCameraPosition.xz / prevMeshletSize) * prevMeshletSize;
			vec2 prevRelSnap = prevCameraSnap - uCameraPosition.xz;
			float prevExtent = float(meshletsPerRow) * 0.5 * prevMeshletSize;

			bool insideX = relMinB.x >= prevRelSnap.x - prevExtent && relMaxB.x <= prevRelSnap.x + prevExtent;
			bool insideZ = relMinB.z >= prevRelSnap.y - prevExtent && relMaxB.z <= prevRelSnap.y + prevExtent;

			if (insideX && insideZ) {
				visible = false;
			}
		}

		// Gentle dry-land cull: if the terrain's lowest point across this whole tile still sits
		// above the highest the water surface can reach, the tile is entirely dry and never
		// visible -- skip mesh shading/rasterizing it. Sampled at a coarser LOD than the tile's
		// own ring so one minmax cluster (4 texels = 2*2^L world units) covers the full
		// meshletSize (= 24*2^ring) footprint with margin; the 3x3 grid absorbs cluster/tile
		// misalignment.
		if (visible && params.minMaxIndex > 0u) {
			vec2 worldMinXZ = uCameraPosition.xz + relMinB.xz;
			vec2 worldMaxXZ = uCameraPosition.xz + relMaxB.xz;
			uint sampleLOD = min(ringLevel + 4u, params.gridParams.x - 1u);

			float tileMinHeight = 1e9;
			for (int j = 0; j < 3; j++) {
				for (int i = 0; i < 3; i++) {
					vec2 t = vec2(float(i), float(j)) * 0.5;
					vec2 sampleXZ = mix(worldMinXZ, worldMaxXZ, t);
					vec2 minMax = sampleTerrainMinMax(params.minMaxIndex, sampleXZ, sampleLOD, params.gridParams.w);
					tileMinHeight = min(tileMinHeight, minMax.x);
				}
			}

			float dryLandMargin = 50.0;
			if (tileMinHeight > params.waterLevel + maxWaveAmp + dryLandMargin) {
				visible = false;
			}
		}

		// Gentle horizon cull: the water surface never rises above waterLevel + maxWaveAmp, so
		// that's the tile's height above the waterLevel reference regardless of ring.
		if (visible) {
			vec2  closestXZ = clamp(vec2(0.0), relMinB.xz, relMaxB.xz);
			float tileDist = length(closestXZ);
			float camAltitude = uCameraPosition.y - params.waterLevel;
			float slack = meshletSize * 4.0 + 500.0;
			if (isBeyondHorizon(tileDist, maxWaveAmp, camAltitude, slack)) {
				visible = false;
			}
		}
	}

	if (visible) {
		uint index = atomicAdd(meshletCount, 1u);
		payload.meshletIDs[index] = meshletID;
		payload.lodLevels[index] = ringLevel;
	}
	barrier();

	if (threadID == 0) {
		EmitMeshTasksEXT(meshletCount, 1, 1);
	}
}
