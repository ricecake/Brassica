#version 460
#extension GL_EXT_nonuniform_qualifier : require

#include "bindless.glsl"
#include "common.glsl"
#include "helpers/octahedral.glsl"

layout(set = 1, binding = 3, rgba32f) uniform image2D uImageStorageRGBA32F[];
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform ClimateInitialPushConstants {
	uint outStorageIdx;  // Storage image index for output (e.g. TerrainWeatherBiomeTexture / PingPong A)
	uint textureDim;     // 2048
	bool forceRegeneration;
	uint pad;
} push;

void main() {
	uvec2 pixel = gl_GlobalInvocationID.xy;
	if (pixel.x >= push.textureDim || pixel.y >= push.textureDim) {
		return;
	}

	vec2 uv = (vec2(pixel) + 0.5) / float(push.textureDim);
	vec3 dir = octahedralUVToDirection(uv);

	vec3 p = dir * FAKE_PLANET_RADIUS;

	float landMask = 0.0;
	vec3 gradMask = vec3(0.0);
	evaluate_soft_voronoi_pseudosphere2(p, 32, landMask, gradMask);

	float landVal = clamp(landMask, 0.0, 1.0);
	float elevation = mix(-200.0, 1200.0, landVal);

	// Latitude (0 at equator, 1 at poles)
	float latitude = abs(dir.y);

	// Base temperature from latitude and elevation lapse rate
	float baseTemp = cos(latitude * 0.5 * PI);
	float lapseRate = max(0.0, elevation) * 0.0003;
	float temp = clamp(baseTemp - lapseRate, 0.0, 1.0);

	// Base moisture: Ocean vs Land + ITCZ equatorial belt
	float baseMoisture = mix(0.85, 0.25, landVal) + 0.35 * exp(-16.0 * latitude * latitude);
	float moisture = clamp(baseMoisture, 0.0, 1.0);

	// 2D Atmospheric Circulation (Hadley/Ferrel/Polar cells)
	vec3 up = abs(dir.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
	vec3 eastTang = normalize(cross(up, dir));
	vec3 northTang = normalize(cross(dir, eastTang));

	float wEast = -0.012 * sin(3.0 * latitude * PI);
	float wNorth = -0.004 * sin(2.0 * latitude * PI) * (dir.y >= 0.0 ? 1.0 : -1.0);

	vec3 dirTarget = normalize(dir + eastTang * wEast + northTang * wNorth);
	vec2 uvTarget = directionToOctahedralUV(dirTarget);
	vec2 wind2D = uvTarget - uv;

	imageStore(
		uImageStorageRGBA32F[nonuniformEXT(push.outStorageIdx)],
		ivec2(pixel),
		vec4(temp, moisture, wind2D.x, wind2D.y)
	);
}
