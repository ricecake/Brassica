#version 460
#extension GL_EXT_nonuniform_qualifier : require

#include "bindless.glsl"
#include "common.glsl"
#include "terrain/generation.glsl"

layout(set = 1, binding = 3, rgba32f) uniform image2D uImageStorageRGBA32F[];
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform ClimateInitialPushConstants {
	uint outStorageIdx1; // Storage image index for Map 1 (elevation, airMoisture, groundwater, vegetation)
	uint outStorageIdx2; // Storage image index for Map 2 (waterLevel, slope, substrate, aerosol)
	uint textureDim;     // e.g. 2048
	uint pad;
} push;

void main() {
	uvec2 pixel = gl_GlobalInvocationID.xy;
	if (pixel.x >= push.textureDim || pixel.y >= push.textureDim) {
		return;
	}

	vec2 uv = (vec2(pixel) + 0.5) / float(push.textureDim);
	float worldExtent = 2.0 * FAKE_PLANET_RADIUS * PI;
	vec2 worldXZ = (uv - 0.5) * worldExtent;
	vec3 worldP = vec3(worldXZ.x, 0.0, worldXZ.y);

	vec3 terrainNormal = vec3(0.0, 1.0, 0.0);
	float waterLevel;
	float ridgeMap;
	float substrate;
	TerrainConfig con = TerrainConfig(0.00001, -100.0, 1000.0, 0.14, 0.5);
	float rawElevation = evaluate_terrain_analytical(worldP, 0.1, 0.75, con, terrainNormal, waterLevel, ridgeMap, substrate);

	// Normalize elevation (0.0 = ocean/sea level, 1.0 = max mountain peak)
	float elevation = clamp(rawElevation * 0.001, 0.0, 1.0);
	float waterLevelNorm = clamp(waterLevel * 0.001, -1.0, 1.0);

	// Directionless slope steepness from terrain surface normal
	float slope = clamp(length(terrainNormal.xz), 0.0, 1.0);

	// Derive sediment/substrate nutrient capacity from substrate map (-1 valley, +1 plain/ridge)
	// and ridge map (-1 crease, +1 ridge)
	float sediment = clamp(0.5 * (substrate + 1.0) + 0.25 * (1.0 - ridgeMap), 0.0, 1.0);

	// Base initial cell state:
	float airMoisture = (elevation <= 0.02) ? 1.0 : 0.4;
	float groundwater = (elevation <= 0.02) ? 1.0 : 0.2;
	float vegetation = clamp(sediment * 0.6 + (1.0 - elevation) * 0.3 - slope * 0.2, 0.0, 1.0);

	// Abstracted aerosol particles (higher in dry/barren regions)
	float aerosol = 0.05 + 0.1 * (1.0 - vegetation);

	imageStore(
		uImageStorageRGBA32F[nonuniformEXT(push.outStorageIdx1)],
		ivec2(pixel),
		vec4(elevation, airMoisture, groundwater, vegetation)
	);

	imageStore(
		uImageStorageRGBA32F[nonuniformEXT(push.outStorageIdx2)],
		ivec2(pixel),
		vec4(waterLevelNorm, slope, sediment, aerosol)
	);
}
