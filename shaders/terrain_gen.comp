#version 460
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_KHR_shader_subgroup_quad : require
#extension GL_KHR_shader_subgroup_vote : require // Required for subgroupAny
#extension GL_KHR_shader_subgroup_clustered : require

#include "bindless.glsl"
#include "common.glsl"
#include "terrain.glsl"
#include "lygia/generative/psrdnoise.glsl"

layout(set = 1, binding = 3, rgba32f) uniform image2DArray uImageArraysRGBA32F[];
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
	uvec4 gridParams;           // x = numLODs, y = meshletsPerRow, z = totalMeshlets, w = textureDim (1088)
	uvec4 lodOffsets0_3;        // packed toroidal gridOffset for LOD 0-3
	uvec4 lodOffsets4_7;        // packed toroidal gridOffset for LOD 4-7
	uvec4 lodOffsets8_11;       // packed toroidal gridOffset for LOD 8-11
	uvec4 lodDeltas0_3;         // packed toroidal delta for LOD 0-3
	uvec4 lodDeltas4_7;         // packed toroidal delta for LOD 4-7
	uvec4 lodDeltas8_11;        // packed toroidal delta for LOD 8-11
	uint  clipmapStorageIdx;    // storage image index for TerrainClipmapTexture
	uint  minMaxStorageIdx;     // storage image index for TerrainMinMaxTexture
	uint  biomeStorageIdx;      // storage image index for TerrainBiomeTexture
	uint  visibilityStorageIdx; // storage image index for TerrainTileVisibilityTexture
	uint  lowResChunkStorageIdx;// storage image index for TerrainLowResChunkTexture
} push;


void main() {
	// 1. Remap the 16x16 local workgroup into 2x2 spatial quads
	uint quad_id = gl_LocalInvocationIndex / 4;
	uint thread_in_quad = gl_LocalInvocationIndex % 4;

	// Map hardware quad lanes [0,1,2,3] to local 2x2 offsets: (0,0), (1,0), (0,1), (1,1)
	uvec2 quad_local_pos = uvec2(thread_in_quad & 1, thread_in_quad >> 1);

	// 64 quads mapped to an 8x8 grid to span the 16x16 workgroup
	uvec2 tile_pos = uvec2(quad_id % 8, quad_id / 8) * 2;

	// Reconstruct globalId to guarantee 2x2 spatial alignment
	uvec3 globalId = uvec3(gl_WorkGroupID.xy * 16 + tile_pos + quad_local_pos, gl_GlobalInvocationID.z);

	uint dim = push.gridParams.w;
	uint lod = globalId.z;

	if (globalId.x >= dim || globalId.y >= dim || lod >= push.gridParams.x) {
		return;
	}

	uvec4 deltas = (lod < 4u) ? push.lodDeltas0_3 : ((lod < 8u) ? push.lodDeltas4_7 : push.lodDeltas8_11);
	uint packedDelta = deltas[lod % 4u];
	int deltaX = int(packedDelta & 0xFFFFu);
	if (deltaX >= 0x8000) deltaX -= 0x10000;
	int deltaZ = int((packedDelta >> 16u) & 0xFFFFu);
	if (deltaZ >= 0x8000) deltaZ -= 0x10000;

	if (uFrameIndex > 0 && deltaX == 0 && deltaZ == 0) {
		return;
	}

	uvec4 offsets = (lod < 4u) ? push.lodOffsets0_3 : ((lod < 8u) ? push.lodOffsets4_7 : push.lodOffsets8_11);
	uint packedOffset = offsets[lod % 4u];
	ivec2 gridOffset = ivec2(int(packedOffset & 0xFFFFu), int((packedOffset >> 16u) & 0xFFFFu));

	ivec2 texelIndex = ivec2(globalId.xy);
	int colIdx = (texelIndex.x - gridOffset.x + int(dim)) % int(dim);
	int rowIdx = (texelIndex.y - gridOffset.y + int(dim)) % int(dim);

	int dimInt = int(dim);
	bool is_dirty = true;

	if (uFrameIndex > 0 && abs(deltaX) < dimInt && abs(deltaZ) < dimInt) {
		bool dirtyX = (deltaX > 0 && colIdx >= dimInt - deltaX) || (deltaX < 0 && colIdx < -deltaX);
		bool dirtyZ = (deltaZ > 0 && rowIdx >= dimInt - deltaZ) || (deltaZ < 0 && rowIdx < -deltaZ);
		is_dirty = dirtyX || dirtyZ;
	}

	// 2. Subgroup Divergence Protection
	// Ensure the entire quad stays active if *any* thread in the 2x2 block needs to compute
	if (!subgroupAny(is_dirty)) {
		return;
	}

	float baseTexelSize = (uCameraPosition.w > 0.0) ? uCameraPosition.w : 0.5;
	float texelSize = baseTexelSize * getLODScale(float(lod));

	vec2 centerWorldPos = floor(uCameraPosition.xz / texelSize) * texelSize;
	vec2 deltaWorld = (vec2(float(colIdx), float(rowIdx)) - vec2(float(dim) * 0.5)) * texelSize;
	vec2 worldXZ = centerWorldPos + deltaWorld;

	TerrainConfig con = TerrainConfig(0.00001, -100.0, 1000.0, 0.14, 0.5);
	vec3 p = vec3(worldXZ.x, 0.0, worldXZ.y);

	// Evaluate height ONCE per thread
	float biome = 0.0;
	float land_mask = 0.0;
	vec3 normal = vec3(0.0, 1.0, 0.0);
	// float h = evaluate_terrain(p, 0.0, 0.75, con, biome, land_mask);
	// float h = evaluate_terrain_analytical(p, 0.0, 0.75, con, normal, biome, land_mask);
	float h = 0.0;
	// evaluate_soft_voronoi(p, 10.0, 5, h, normal);
	// evaluate_soft_voronoi_pseudosphere2(p, 32, h, normal);
	vec3 grad;
	eval_terrain(p, con, h, normal, grad);

	// 3. Quad Swap Differencing & neighboring texel finite differences
	float h_swap_x = subgroupQuadSwapHorizontal(h);
	float h_swap_y = subgroupQuadSwapVertical(h);
	float h_swap_diag = subgroupQuadSwapDiagonal(h);

	float dh_dx = abs(h - h_swap_x);
	float dh_dz = abs(h - h_swap_y);
	float local_finite_diff = max(dh_dx, dh_dz);

	// Calculate required change in resolution measure using noise derivatives and neighboring texel finite differences
	float noise_grad_magnitude = length(grad.xz);
	float estimated_height_error = noise_grad_magnitude * texelSize * 0.5 + local_finite_diff;
	float target_tolerance = 1.0; // 1 meter tolerance
	float res_change_measure = log2(max(1.0, estimated_height_error / target_tolerance));

	// Only run the store logic if this specific thread was actually dirty
	if (is_dirty) {
		// Computes the min/max across clusters of 16 invocations
		float cluster_min = subgroupClusteredMin(h, 16);
		float cluster_max = subgroupClusteredMax(h, 16);

		float quad_min = min(min(h, h_swap_x), min(h_swap_y, h_swap_diag));
		float quad_max = max(max(h, h_swap_x), max(h_swap_y, h_swap_diag));

		// Mean of the quad
		float mean_h = (h + h_swap_x + h_swap_y + h_swap_diag) * 0.25;

		// Mean of the squares
		float h2 = h * h;
		float mean_h2 = (h2 +
						subgroupQuadSwapHorizontal(h2) +
						subgroupQuadSwapVertical(h2) +
						subgroupQuadSwapDiagonal(h2)) * 0.25;

		// True variance
		float variance = max(0.0, mean_h2 - (mean_h * mean_h));

		ivec3 storeCoord = ivec3(globalId.xy, lod);

		imageStore(uImageArraysRGBA32F[nonuniformEXT(push.clipmapStorageIdx)], storeCoord, vec4(h, normal.x, normal.y, normal.z));
		imageStore(uImageArraysRGBA32F[nonuniformEXT(push.minMaxStorageIdx)], storeCoord, vec4(cluster_min, cluster_max, quad_min, quad_max));
		imageStore(uImageArraysRGBA32F[nonuniformEXT(push.biomeStorageIdx)], storeCoord, vec4(clamp(biome, 0.0, 1.0), variance, res_change_measure, land_mask));
		imageStore(uImageArraysRGBA32F[nonuniformEXT(push.visibilityStorageIdx)], storeCoord, vec4(1.0, 1.0, 1.0, 1.0));

		if (push.lowResChunkStorageIdx > 0u && globalId.x < 1024u && globalId.y < 1024u) {
			imageStore(uImageArraysRGBA32F[nonuniformEXT(push.lowResChunkStorageIdx)], storeCoord, vec4(h, variance, res_change_measure, land_mask));
		}
	}
}