#version 460 core

layout(local_size_x = 8, local_size_y = 8) in;

#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require

#define ATMOSPHERE_HEIGHT_DEFINED
#include "../atmosphere/common.glsl"
#include "../bindless.glsl"
#include "../helpers/clouds.glsl"

struct TileQueueHeader {
	uint count;
	uint maxTiles;
	uint spatialUpdateFrames;
	uint frameIndex;
	float minRefreshRate;
	float maxRefreshRate;
	uint tileCols;
	uint tileRows;
	uint totalTiles;
	uint padding;
};

layout(buffer_reference, std430) buffer TileQueueSSBORef {
	TileQueueHeader uHeader;
	uvec2 uTileQueue[];
};

layout(push_constant) uniform CloudRenderPushConstants {
	uint depthTextureIdx;
	uint boundingMapIdx;
	uint weatherMinMaxIdx;
	uint weatherTextureIdx;
	uint volume3DIdx;
	uint packedColorStorageIdx;
	uint packedDepthStorageIdx;
	uint packedVelocityStorageIdx;
	uint errorMapStorageIdx;
	uint pad0;
	uint64_t tileQueueBufferAddr;
	float cloudMaxRayDistance;
	float renderScale;
	float worldScale;
	int cloudMinSamples;
	int cloudMaxSamples;
	float cloudExtinction;
	float deltaTime;
	float cloudAltitude;
	float cloudThickness;
	float cloudDensity;
	float cloudCoverage;
	vec3 cloudExtinctionColor;
	float pad1;
	vec3 cloudAlbedo;
	float pad2;
} push;

float calculateBifurcatedStepSize(
    inout bool in_cloud,
    inout int zero_count,
    float macro_density,
    float B,
    float cheap_mult,
    int escape_threshold
) {
    float cheap_step = B * cheap_mult;

    if (!in_cloud) {
        if (macro_density > 0.01) {
            in_cloud = true;
            zero_count = 0;
            return -cheap_step;
        }
        return cheap_step;
    } else {
        if (macro_density <= 0.0) {
            zero_count++;
            if (zero_count >= escape_threshold) {
                in_cloud = false;
                return cheap_step;
            }
        } else {
            zero_count = 0;
        }
        return B;
    }
}

float InterleavedGradientNoise(vec2 pix, int frame) {
	vec3 magic = vec3(0.06711056, 0.00583715, 52.9829189);
	return fract(magic.z * fract(dot(pix + vec2(frame * 5.588238), magic.xy)));
}

void main() {
	TileQueueSSBORef tileQueue = TileQueueSSBORef(push.tileQueueBufferAddr);

	uint tileIndex = gl_WorkGroupID.x;
	if (tileIndex >= tileQueue.uHeader.count) return;

	uvec2 tileCoord = tileQueue.uTileQueue[tileIndex];
	ivec2 fullResPixel = ivec2(tileCoord * 8u) + ivec2(gl_LocalInvocationID.xy);
	ivec2 fullResSize = imageSize(uImagesRGBA32F[nonuniformEXT(push.packedColorStorageIdx)]);

	if (fullResPixel.x >= fullResSize.x || fullResPixel.y >= fullResSize.y)
		return;

	vec4 tileErrorData = imageLoad(uImagesRGBA32F[nonuniformEXT(push.errorMapStorageIdx)], ivec2(tileCoord));
	float tileStepMult = (tileErrorData.b > 0.01) ? tileErrorData.b : 1.0;

	if (gl_LocalInvocationID.x == 0u && gl_LocalInvocationID.y == 0u) {
		tileErrorData.a = float(tileQueue.uHeader.frameIndex);
		tileErrorData.r = 0.0;
		tileErrorData.g = 0.0;
		imageStore(uImagesRGBA32F[nonuniformEXT(push.errorMapStorageIdx)], ivec2(tileCoord), tileErrorData);
	}

	vec2 TexCoords = (vec2(fullResPixel) + 0.5) / vec2(fullResSize);

	float depth = SAMPLE_NEAREST(push.depthTextureIdx, TexCoords).r;
	float z = depth * 2.0 - 1.0;
	vec4  clipSpacePosition = vec4(TexCoords * 2.0 - 1.0, z, 1.0);
	vec4  viewSpacePosition = uInvProjMatrix * clipSpacePosition;
	viewSpacePosition /= viewSpacePosition.w;
	vec3 worldPos = (uInvViewMatrix * viewSpacePosition).xyz;
	vec3 canonicalRayDir = normalize(worldPos - uCameraPosition.xyz);
	float dist = length(worldPos - uCameraPosition.xyz);

	vec3 rayDir = canonicalRayDir;

	if (depth >= 0.9999) {
		dist = push.cloudMaxRayDistance * push.worldScale;
		worldPos = uCameraPosition.xyz + rayDir * dist;
	}

	CloudProperties props;
	props.altitude = push.cloudAltitude;
	props.thickness = push.cloudThickness;
	props.densityBase = push.cloudDensity;
	props.coverage = push.cloudCoverage;
	props.worldScale = push.worldScale;

	float t_start1, t_end1, t_start2, t_end2;
	bool hitShell = intersectCloudShell(uCameraPosition.xyz, rayDir, push.worldScale, push.cloudAltitude, push.cloudThickness, t_start1, t_end1, t_start2, t_end2);

	int numSegments = 0;
	float rawSegStart[2];
	float rawSegEnd[2];

	if (hitShell) {
		if (t_start1 < t_end1 && t_start1 < dist) {
			rawSegStart[numSegments] = t_start1;
			rawSegEnd[numSegments] = min(t_end1, dist);
			numSegments++;
		}
		if (t_start2 < t_end2 && t_start2 < dist) {
			rawSegStart[numSegments] = t_start2;
			rawSegEnd[numSegments] = min(t_end2, dist);
			numSegments++;
		}
	}

	int samples = push.cloudMaxSamples;
	float jitter = InterleavedGradientNoise(vec2(fullResPixel), int(tileQueue.uHeader.frameIndex));

	vec3 cloudColor = vec3(0.0);
	vec3 cloudTransmittance = vec3(1.0);
	float firstHitDist = -1.0;
	float lastHitDist = -1.0;
	float pathDensity = 0.0;

	vec4 b = SAMPLE_LINEAR(push.boundingMapIdx, TexCoords);
	float b_firstHit = b.r;
	float b_lastHit = b.g;
	float b_totalDensity = b.b;

	if (numSegments == 0 || b_firstHit < 0.0 || b_totalDensity < 0.01) {
		imageStore(uImagesRGBA32F[nonuniformEXT(push.packedColorStorageIdx)], fullResPixel, vec4(0.0, 0.0, 0.0, 1.0));
		imageStore(uImagesRGBA32F[nonuniformEXT(push.packedDepthStorageIdx)], fullResPixel, vec4(push.cloudMaxRayDistance * 0.5 * push.worldScale, push.cloudMaxRayDistance * 0.5 * push.worldScale, 50.0, 0.0));
		imageStore(uImagesRGBA32F[nonuniformEXT(push.packedVelocityStorageIdx)], fullResPixel, vec4(0.0));
		return;
	}

	float bound_margin = 50.0 * push.worldScale;
	float b_start = max(0.0, b_firstHit - bound_margin);
	float b_end = b_lastHit + bound_margin;

	int validSegments = 0;
	float segStart[2];
	float segEnd[2];

	for (int s = 0; s < numSegments; s++) {
		float s_start = max(rawSegStart[s], b_start);
		float s_end   = min(rawSegEnd[s], b_end);
		if (s_start < s_end) {
			segStart[validSegments] = s_start;
			segEnd[validSegments]   = s_end;
			validSegments++;
		}
	}

	if (validSegments == 0) {
		imageStore(uImagesRGBA32F[nonuniformEXT(push.packedColorStorageIdx)], fullResPixel, vec4(0.0, 0.0, 0.0, 1.0));
		imageStore(uImagesRGBA32F[nonuniformEXT(push.packedDepthStorageIdx)], fullResPixel, vec4(push.cloudMaxRayDistance * 0.5 * push.worldScale, push.cloudMaxRayDistance * 0.5 * push.worldScale, 50.0, 0.0));
		imageStore(uImagesRGBA32F[nonuniformEXT(push.packedVelocityStorageIdx)], fullResPixel, vec4(0.0));
		return;
	}

	float firstStepSize = 50.0;
	int MAX_ITERATIONS = 500;

	vec3 rgbExtinction = push.cloudExtinctionColor * push.cloudExtinction;
	vec3 lightEnergy = vec3(0.0);

	vec3 primaryLightDir = vec3(0, 1, 0);

	bool inVolume = false;
	int zero_count = 0;

	for (int s = 0; s < validSegments; s++) {
		float seg_start = segStart[s];
		float seg_end   = segEnd[s];

		float rayDist = seg_end - seg_start;
		if (rayDist <= 0.0) continue;

		float baseStepSize = clamp((rayDist / float(samples)) * tileStepMult, 1.0, 50.0);
		if (s == 0) firstStepSize = baseStepSize;

		float t = min(seg_end, seg_start + jitter * baseStepSize);
		float t_prev = seg_start;
		inVolume = false;
		zero_count = 0;

		for (int i = 0; i < MAX_ITERATIONS; i++) {
			if (t_prev >= dist || t_prev >= seg_end || all(lessThan(cloudTransmittance, vec3(0.05)))) break;

			vec3 p = uCameraPosition.xyz + rayDir * t;
			float currentLod = log2(max(1.0, t * 0.001));

			CloudWeather weather = computeCloudWeather(p, props, currentLod, push.weatherTextureIdx, uTime);
			bool doCheap = (t_prev >= seg_end * 0.5 || all(lessThan(cloudTransmittance, vec3(0.75))));

			CloudDensityResult densityRes = calculateCloudDensity(p, weather, props, uTime, currentLod, doCheap, push.volume3DIdx);
			vec3 d = densityRes.density;

			float nextStepSize = calculateBifurcatedStepSize(inVolume, zero_count, max(d.x, max(d.y, d.z)), baseStepSize, 3.0, 3);

			if (nextStepSize < 0.0) {
				t += nextStepSize;
				continue;
			}

			if (!inVolume) {
				t_prev = t;
				t += nextStepSize;
				continue;
			}

			float stepSize = t - t_prev;
			if (stepSize > 0.0) {
				if (max(d.x, max(d.y, d.z)) > 0.01) {
					if (firstHitDist < 0.0) {
						firstHitDist = t;
						firstStepSize = stepSize;
					}
					lastHitDist = t;
				}

				pathDensity = max(pathDensity, max(d.x, max(d.y, d.z)));

				if (any(greaterThan(d, vec3(0.000)))) {
					vec3 localExtinction = rgbExtinction * densityRes.relativeExtinction;
					vec3 averageDensity = d;
					vec3 stepOpticalDepth = averageDensity * stepSize * localExtinction;
					vec3 transmittanceAtStep = exp(-stepOpticalDepth);

					float shadowFactor = 1.0;
					vec3 S = vec3(shadowFactor) * push.cloudAlbedo;

					vec3 weight = cloudTransmittance * (vec3(1.0) - transmittanceAtStep);
					lightEnergy += S * weight;

					cloudTransmittance *= transmittanceAtStep;
				}
				t_prev = t;
			}

			t += nextStepSize;
			t = min(seg_end, t);
		}

		if (all(lessThan(cloudTransmittance, vec3(0.05)))) break;
	}

	cloudColor = lightEnergy * push.cloudAlbedo;

	vec4 finalColor = vec4(cloudColor, dot(smoothstep(0.05, 1.0, cloudTransmittance), vec3(0.3333)));
	vec4 finalDepth = vec4(firstHitDist, lastHitDist, firstStepSize, pathDensity);

	imageStore(uImagesRGBA32F[nonuniformEXT(push.packedColorStorageIdx)], fullResPixel, finalColor);
	imageStore(uImagesRGBA32F[nonuniformEXT(push.packedDepthStorageIdx)], fullResPixel, finalDepth);
	imageStore(uImagesRGBA32F[nonuniformEXT(push.packedVelocityStorageIdx)], fullResPixel, vec4(0.0));
}
