#version 460 core

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform image2D outPackedColor;
layout(binding = 1, rgba32f) uniform image2D outPackedDepth;
layout(binding = 2, rg16f)   uniform image2D outPackedVelocity;
layout(binding = 3, rgba32f) uniform image2D uErrorMap;

struct TileQueueHeader {
	uint count;
	uint maxTiles;
	uint spatialUpdateFrames;
	uint frameIndex;
	float minRefreshRate;
	float maxRefreshRate;
	uint tileCols;
	uint tileRows;
	uint totalTiles;
	uint padding;
};

layout(std430, binding = 0) buffer TileQueueSSBO {
	TileQueueHeader uHeader;
	uvec2 uTileQueue[];
};

layout(binding = 4) uniform sampler2D depthTexture;

#define uDeltaTime 0.016
#define cloudColorUniform u_cloud.color.rgb

#define ATMOSPHERE_HEIGHT_DEFINED
#include "../atmosphere/common.glsl"
#include "../helpers/clouds.glsl"

layout(binding = 5) uniform sampler2D u_cloudMinMaxBoundingTexture;
layout(binding = 6) uniform sampler2D u_cloudWeatherMinMaxTexture;

#define uCloudMaxRayDistance u_cloud.maxRayDistance
#define uRenderScale u_cloud.renderScale
#define uCloudMinSamples u_cloud.minSamples
#define uCloudMaxSamples u_cloud.maxSamples
#define uCloudExtinction u_cloud.extinctionColor.w
#define uCloudExtinctionColor u_cloud.extinctionColor.rgb
#define uCloudAlbedo u_cloud.albedo.rgb

float calculateBifurcatedStepSize(
    inout bool in_cloud,
    inout int zero_count,
    float macro_density,
    float B,
    float cheap_mult,
    int escape_threshold
) {
    float cheap_step = B * cheap_mult;

    if (!in_cloud) {
        if (macro_density > 0.01) {
            in_cloud = true;
            zero_count = 0;
            return -cheap_step;
        }
        return cheap_step;
    } else {
        if (macro_density <= 0.0) {
            zero_count++;
            if (zero_count >= escape_threshold) {
                in_cloud = false;
                return cheap_step;
            }
        } else {
            zero_count = 0;
        }
        return B;
    }
}

float InterleavedGradientNoise(vec2 pix, int frame) {
	vec3 magic = vec3(0.06711056, 0.00583715, 52.9829189);
	return fract(magic.z * fract(dot(pix + vec2(frame * 5.588238), magic.xy)));
}

void main() {
	float R_earth = kEarthRadius * 1000.0 * worldScale;

	uint tileIndex = gl_WorkGroupID.x;
	if (tileIndex >= uHeader.count) return;

	uvec2 tileCoord = uTileQueue[tileIndex];
	ivec2 fullResPixel = ivec2(tileCoord * 8u) + ivec2(gl_LocalInvocationID.xy);
	ivec2 fullResSize = textureSize(depthTexture, 0);

	if (fullResPixel.x >= fullResSize.x || fullResPixel.y >= fullResSize.y)
		return;

	vec4 tileErrorData = imageLoad(uErrorMap, ivec2(tileCoord));
	float tileStepMult = (tileErrorData.b > 0.01) ? tileErrorData.b : 1.0;

	if (gl_LocalInvocationID.x == 0u && gl_LocalInvocationID.y == 0u) {
		tileErrorData.a = float(uHeader.frameIndex);
		tileErrorData.r = 0.0;
		tileErrorData.g = 0.0;
		imageStore(uErrorMap, ivec2(tileCoord), tileErrorData);
	}

	vec2 TexCoords = (vec2(fullResPixel) + 0.5) / vec2(fullResSize);

	float depth = texture(depthTexture, TexCoords).r;
	float z = depth * 2.0 - 1.0;
	vec4  clipSpacePosition = vec4(TexCoords * 2.0 - 1.0, z, 1.0);
	vec4  viewSpacePosition = uInvProjMatrix * clipSpacePosition;
	viewSpacePosition /= viewSpacePosition.w;
	vec3 worldPos = (uInvViewMatrix * viewSpacePosition).xyz;
	vec3 canonicalRayDir = normalize(worldPos - uCameraPosition.xyz);
	float dist = length(worldPos - uCameraPosition.xyz);

	vec3 rayDir = canonicalRayDir;

	if (depth >= 0.9999) {
		dist = uCloudMaxRayDistance * worldScale;
		worldPos = uCameraPosition.xyz + rayDir * dist;
	}

	CloudProperties props;
	props.altitude = cloudAltitude;
	props.thickness = cloudThickness;
	props.densityBase = cloudDensity;
	props.coverage = cloudCoverage;
	props.worldScale = worldScale;

	float t_start1, t_end1, t_start2, t_end2;
	bool hitShell = intersectCloudShell(uCameraPosition.xyz, rayDir, worldScale, t_start1, t_end1, t_start2, t_end2);

	int numSegments = 0;
	float rawSegStart[2];
	float rawSegEnd[2];

	if (hitShell) {
		if (t_start1 < t_end1 && t_start1 < dist) {
			rawSegStart[numSegments] = t_start1;
			rawSegEnd[numSegments] = min(t_end1, dist);
			numSegments++;
		}
		if (t_start2 < t_end2 && t_start2 < dist) {
			rawSegStart[numSegments] = t_start2;
			rawSegEnd[numSegments] = min(t_end2, dist);
			numSegments++;
		}
	}

	int samples = uCloudMaxSamples;
	float jitter = InterleavedGradientNoise(vec2(fullResPixel), int(uHeader.frameIndex));

	vec3 cloudColor = vec3(0.0);
	vec3 cloudTransmittance = vec3(1.0);
	float totalWeight = 0.0;
	float weightedDistSum = 0.0;
	vec3 weightedAdvectionSum = vec3(0.0);
	vec3 accumulatedOpticalDepth = vec3(0.0);
	float firstHitDist = -1.0;
	float lastHitDist = -1.0;
	float pathDensity = 0.0;

	ivec2 boundingSize = textureSize(u_cloudMinMaxBoundingTexture, 0);
	float b_firstHit = -1.0;
	float b_lastHit = -1.0;
	float b_totalDensity = 0.0;

	for (int y = -1; y <= 1; y++) {
		for (int x = -1; x <= 1; x++) {
			ivec2 samplePixel = clamp(fullResPixel + ivec2(x, y), ivec2(0), boundingSize - 1);
			vec4 b = texelFetch(u_cloudMinMaxBoundingTexture, samplePixel, 0);

			if (b.r >= 0.0) {
				if (b_firstHit < 0.0) {
					b_firstHit = b.r;
				} else {
					b_firstHit = min(b_firstHit, b.r);
				}
				b_lastHit = max(b_lastHit, b.g);
			}
			b_totalDensity = max(b_totalDensity, b.b);
		}
	}

	if (numSegments == 0 || b_firstHit < 0.0 || b_totalDensity < 0.01) {
		imageStore(outPackedColor, fullResPixel, vec4(0.0, 0.0, 0.0, 1.0));
		imageStore(outPackedDepth, fullResPixel, vec4(uCloudMaxRayDistance * 0.5 * worldScale, uCloudMaxRayDistance * 0.5 * worldScale, 50.0, 0.0));
		imageStore(outPackedVelocity, fullResPixel, vec4(0.0));
		return;
	}

	float bound_margin = 50.0 * worldScale;
	float b_start = max(0.0, b_firstHit - bound_margin);
	float b_end = b_lastHit + bound_margin;

	int validSegments = 0;
	float segStart[2];
	float segEnd[2];

	for (int s = 0; s < numSegments; s++) {
		float s_start = max(rawSegStart[s], b_start);
		float s_end   = min(rawSegEnd[s], b_end);
		if (s_start < s_end) {
			segStart[validSegments] = s_start;
			segEnd[validSegments]   = s_end;
			validSegments++;
		}
	}

	if (validSegments == 0) {
		imageStore(outPackedColor, fullResPixel, vec4(0.0, 0.0, 0.0, 1.0));
		imageStore(outPackedDepth, fullResPixel, vec4(uCloudMaxRayDistance * 0.5 * worldScale, uCloudMaxRayDistance * 0.5 * worldScale, 50.0, 0.0));
		imageStore(outPackedVelocity, fullResPixel, vec4(0.0));
		return;
	}

	float firstStepSize = 50.0;
	int MAX_ITERATIONS = 500;
	float steps = 0.0;

	vec3 rgbExtinction = uCloudExtinctionColor * uCloudExtinction;
	vec3 lightEnergy = vec3(0.0);
	vec3 prevDensity = vec3(0.0);

	vec3 primaryLightDir = vec3(0, 1, 0);

	bool inVolume = false;
	int zero_count = 0;

	for (int s = 0; s < validSegments; s++) {
		float seg_start = segStart[s];
		float seg_end   = segEnd[s];

		float rayDist = seg_end - seg_start;
		if (rayDist <= 0.0) continue;

		float baseStepSize = clamp((rayDist / float(samples)) * tileStepMult, 1.0, 50.0);
		if (s == 0) firstStepSize = baseStepSize;

		float t = min(seg_end, seg_start + jitter * baseStepSize);
		float t_prev = seg_start;
		inVolume = false;
		zero_count = 0;

		for (int i = 0; i < MAX_ITERATIONS; i++) {
			steps += 1.0;
			if (t_prev >= dist || t_prev >= seg_end || all(lessThan(cloudTransmittance, vec3(0.05)))) break;

			vec3 p = uCameraPosition.xyz + rayDir * t;
			float currentLod = log2(max(1.0, t * 0.001));

			CloudWeather weather = computeCloudWeather(p, props, currentLod);
			bool doCheap = (t_prev >= seg_end * 0.5 || all(lessThan(cloudTransmittance, vec3(0.75))));

			CloudDensityResult densityRes = calculateCloudDensity(p, weather, props, uTime, currentLod, doCheap);
			vec3 d = densityRes.density;

			float nextStepSize = calculateBifurcatedStepSize(inVolume, zero_count, max(d.x, max(d.y, d.z)), baseStepSize, 3.0, 3);

			if (nextStepSize < 0.0) {
				t += nextStepSize;
				continue;
			}

			if (!inVolume) {
				t_prev = t;
				t += nextStepSize;
				continue;
			}

			float stepSize = t - t_prev;
			if (stepSize > 0.0) {
				float h_norm = getCloudRelativeHeight(p, weather);

				if (max(d.x, max(d.y, d.z)) > 0.01) {
					if (firstHitDist < 0.0) {
						firstHitDist = t;
						firstStepSize = stepSize;
					}
					lastHitDist = t;
				}

				pathDensity = max(pathDensity, max(d.x, max(d.y, d.z)));

				if (any(greaterThan(d, vec3(0.000)))) {
					vec3 localExtinction = rgbExtinction * densityRes.relativeExtinction;
					vec3 averageDensity = d;
					vec3 stepDensity = averageDensity * localExtinction;
					vec3 stepOpticalDepth = averageDensity * stepSize * localExtinction;
					vec3 transmittanceAtStep = exp(-stepOpticalDepth);

					float shadowFactor = calculateCloudShadowFactor(p, primaryLightDir, 1.0);
					vec3 S = vec3(shadowFactor) * uCloudAlbedo;

					vec3 weight = cloudTransmittance * (vec3(1.0) - transmittanceAtStep);
					lightEnergy += S * weight;

					cloudTransmittance *= transmittanceAtStep;
					accumulatedOpticalDepth += stepOpticalDepth;
				}
				prevDensity = d;
				t_prev = t;
			}

			t += nextStepSize;
			t = min(seg_end, t);
		}

		if (all(lessThan(cloudTransmittance, vec3(0.05)))) break;
	}

	cloudColor = lightEnergy * uCloudAlbedo;

	vec4 finalColor = vec4(cloudColor, dot(smoothstep(0.05, 1.0, cloudTransmittance), vec3(0.3333)));
	vec4 finalDepth = vec4(firstHitDist, lastHitDist, firstStepSize, pathDensity);

	imageStore(outPackedColor, fullResPixel, finalColor);
	imageStore(outPackedDepth, fullResPixel, finalDepth);
	imageStore(outPackedVelocity, fullResPixel, vec4(0.0));
}
