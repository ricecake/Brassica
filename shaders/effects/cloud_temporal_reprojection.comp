#version 460 core

layout(local_size_x = 8, local_size_y = 8) in;

#include "../bindless.glsl"

struct TileQueueHeader {
	uint count;
	uint maxTiles;
	uint spatialUpdateFrames;
	uint frameIndex;
	float minRefreshRate;
	float maxRefreshRate;
	uint tileCols;
	uint tileRows;
	uint totalTiles;
	uint padding;
};

layout(std430, set = 2, binding = 0) buffer TileQueueSSBO {
	TileQueueHeader uHeader;
	uvec2 uTileQueue[];
};

layout(push_constant) uniform CloudTemporalPushConstants {
	uint packedFrameIdx;
	uint packedDepthIdx;
	uint packedVelocityIdx;
	uint historyFrameIdx;
	uint historyCloudDepthIdx;
	uint historyMomentsIdx;
	uint boundingMapIdx;
	uint outColorIdx;
	uint outDepthIdx;
	uint outMomentsIdx;
	uint outErrorMapIdx;
	float uCloudTemporalGamma;
	float uCloudMaxHistoryLength;
	float uCloudMaxRayDistance;
	float uRenderScale;
	int uEnableTemporal;
	int uHasHistory;
	int uUseTileQueue;
	float uDeltaTime;
} push;

float luma(vec3 color) {
	return dot(color, vec3(0.299, 0.587, 0.114));
}

void main() {
	ivec2 pixel;
	if (push.uUseTileQueue != 0) {
		uint tileIndex = gl_WorkGroupID.x;
		if (tileIndex >= uHeader.count) return;
		uvec2 tileCoord = uTileQueue[tileIndex];
		pixel = ivec2(tileCoord * 8u) + ivec2(gl_LocalInvocationID.xy);
	} else {
		pixel = ivec2(gl_GlobalInvocationID.xy);
	}
	ivec2 size = imageSize(uImagesRGBA32F[nonuniformEXT(push.outColorIdx)]);
	bool inBounds = (pixel.x < size.x && pixel.y < size.y);

	ivec2 clampedPixel = clamp(pixel, ivec2(0), size - ivec2(1));
	vec2 uv = (vec2(clampedPixel) + 0.5) / vec2(size);

	vec4 currentRGBA = SAMPLE_NEAREST(push.packedFrameIdx, uv);
	vec4 currDepthProps = SAMPLE_NEAREST(push.packedDepthIdx, uv);

	vec4 historyRGBA = (push.uHasHistory != 0) ? SAMPLE_LINEAR(push.historyFrameIdx, uv) : currentRGBA;
	vec4 historyMoments = (push.uHasHistory != 0) ? SAMPLE_LINEAR(push.historyMomentsIdx, uv) : vec4(0.0);
	float historyLength = (push.uHasHistory != 0) ? historyMoments.w : 0.0;

	historyLength = (push.uEnableTemporal != 0) ? min(push.uCloudMaxHistoryLength, historyLength + 1.0) : 1.0;
	float alpha = 1.0 / max(historyLength, 1.0);

	vec4 accumulatedRGBA = mix(historyRGBA, currentRGBA, alpha);
	vec4 accumulatedDepth = currDepthProps;

	float currentLuma = luma(accumulatedRGBA.rgb);
	vec4 accumulatedMoments = vec4(currentLuma, currentLuma * currentLuma, accumulatedDepth.a, historyLength);

	if (inBounds) {
		imageStore(uImagesRGBA32F[nonuniformEXT(push.outColorIdx)], clampedPixel, accumulatedRGBA);
		imageStore(uImagesRGBA32F[nonuniformEXT(push.outDepthIdx)], clampedPixel, accumulatedDepth);
		imageStore(uImagesRGBA32F[nonuniformEXT(push.outMomentsIdx)], clampedPixel, accumulatedMoments);
	}
}
