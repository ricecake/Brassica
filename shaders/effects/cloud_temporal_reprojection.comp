#version 460 core

layout(local_size_x = 8, local_size_y = 8) in;

#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require

#include "../bindless.glsl"

struct TileQueueHeader {
	uint count;
	uint maxTiles;
	uint spatialUpdateFrames;
	uint frameIndex;
	float minRefreshRate;
	float maxRefreshRate;
	uint tileCols;
	uint tileRows;
	uint totalTiles;
	uint padding;
};

layout(buffer_reference, std430) buffer TileQueueSSBORef {
	TileQueueHeader uHeader;
	uvec2 uTileQueue[];
};

layout(push_constant) uniform CloudTemporalPushConstants {
	uint packedColorIdx;
	uint packedDepthIdx;
	uint packedVelocityIdx;
	uint boundingMapIdx;
	uint historyColorIdx;
	uint historyDepthIdx;
	uint historyMomentsIdx;
	uint colorStorageIdx;
	uint depthStorageIdx;
	uint momentsStorageIdx;
	uint errorMapStorageIdx;
	uint pad0;
	uint64_t tileQueueBufferAddr;
	float cloudTemporalGamma;
	float cloudMaxHistoryLength;
	float cloudMaxRayDistance;
	float renderScale;
	float deltaTime;
	int enableTemporal;
	int hasHistory;
	int useTileQueue;
} push;

shared float sharedError[64];
shared float sharedFlow[64];

float luma(vec3 color) {
	return dot(color, vec3(0.299, 0.587, 0.114));
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(uImagesRGBA32F[nonuniformEXT(push.colorStorageIdx)]);
	if (pixel.x >= size.x || pixel.y >= size.y) return;

	vec2 texelSize = 1.0 / vec2(size);
	vec2 uv = (vec2(pixel) + 0.5) * texelSize;

	vec4 currentPackedColor = SAMPLE_NEAREST(push.packedColorIdx, uv);
	vec4 currentPackedDepth = SAMPLE_NEAREST(push.packedDepthIdx, uv);
	vec2 motionVector = SAMPLE_NEAREST(push.packedVelocityIdx, uv).rg;

	if (push.enableTemporal == 0 || push.hasHistory == 0) {
		float l = luma(currentPackedColor.rgb);
		imageStore(uImagesRGBA32F[nonuniformEXT(push.colorStorageIdx)], pixel, currentPackedColor);
		imageStore(uImagesRGBA32F[nonuniformEXT(push.depthStorageIdx)], pixel, currentPackedDepth);
		imageStore(uImagesRGBA32F[nonuniformEXT(push.momentsStorageIdx)], pixel, vec4(l, l * l, 0.0, 1.0));
		return;
	}

	vec2 historyUV = uv - motionVector;
	bool offscreen = any(lessThan(historyUV, vec2(0.0))) || any(greaterThan(historyUV, vec2(1.0)));

	if (offscreen) {
		float l = luma(currentPackedColor.rgb);
		imageStore(uImagesRGBA32F[nonuniformEXT(push.colorStorageIdx)], pixel, currentPackedColor);
		imageStore(uImagesRGBA32F[nonuniformEXT(push.depthStorageIdx)], pixel, currentPackedDepth);
		imageStore(uImagesRGBA32F[nonuniformEXT(push.momentsStorageIdx)], pixel, vec4(l, l * l, 0.0, 1.0));
		return;
	}

	vec4 historyColor = SAMPLE_LINEAR(push.historyColorIdx, historyUV);
	vec4 historyDepth = SAMPLE_LINEAR(push.historyDepthIdx, historyUV);
	vec4 historyMoments = SAMPLE_LINEAR(push.historyMomentsIdx, historyUV);

	float historyLength = min(historyMoments.w + 1.0, push.cloudMaxHistoryLength);
	float alpha = 1.0 / historyLength;

	vec3 mean = currentPackedColor.rgb;
	vec3 var = currentPackedColor.rgb * currentPackedColor.rgb;

	mean /= 9.0;
	var = sqrt(max(vec3(0.0), var / 9.0 - mean * mean));

	vec3 minColor = mean - push.cloudTemporalGamma * var;
	vec3 maxColor = mean + push.cloudTemporalGamma * var;

	vec3 clampedHistoryColor = clamp(historyColor.rgb, minColor, maxColor);
	vec3 blendedColor = mix(clampedHistoryColor, currentPackedColor.rgb, alpha);

	float currentLuma = luma(blendedColor);
	float m1 = mix(historyMoments.x, currentLuma, alpha);
	float m2 = mix(historyMoments.y, currentLuma * currentLuma, alpha);

	imageStore(uImagesRGBA32F[nonuniformEXT(push.colorStorageIdx)], pixel, vec4(blendedColor, currentPackedColor.a));
	imageStore(uImagesRGBA32F[nonuniformEXT(push.depthStorageIdx)], pixel, currentPackedDepth);
	imageStore(uImagesRGBA32F[nonuniformEXT(push.momentsStorageIdx)], pixel, vec4(m1, m2, 0.0, historyLength));
}
