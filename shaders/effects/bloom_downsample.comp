#version 460
#include "bindless.glsl"
#include "types/autoexposure.glsl"
#include "helpers/tonemapping.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform DownsamplePushConstants {
	vec2  srcResolution; // Full resolution of srcTexture
	uint  hdrColorIndex;
	uint  depthIndex;
	uint  outMip0Index;
	uint  outMip1Index;
	uint  outMip2Index;
	uint  outMip3Index;
	uint  outMip4Index;
	uint  outExpMip0Index;
	uint  outExpMip1Index;
	uint  outExpMip2Index;
	uint  outExpMip3Index;
	uint  outExpMip4Index;
	uint  outWgtMip0Index;
	uint  outWgtMip1Index;
	uint  outWgtMip2Index;
	uint  outWgtMip3Index;
	uint  outWgtMip4Index;
	int   numMips;
	float threshold;
	float deltaTime;
	float softness;
	float karisDampening;
	float maxPoolingFactor;
} push;

shared vec3 s_mip[16][16];
shared vec3 s_ltmExp[16][16];
shared vec3 s_ltmWgt[16][16];

// Constants for histogram
const float MIN_LOG_LUMA = -10.0;
const float MAX_LOG_LUMA = 14.0; // Expanded to perfectly cover up to 100k+ lux physical light levels

float get_saturation(vec3 c) {
	float l = dot(c, vec3(0.2126, 0.7152, 0.0722));
	return sqrt(max(dot(c - l, c - l) / 3.0, 0.0));
}

void update_layer_ae(int layerIdx) {
	// Calculate total weight
	float totalWeight = 0.0;
	for (int i = 0; i < 256; i++) {
		totalWeight += float(layers[layerIdx].data.histogram[i]);
	}

	if (totalWeight > 0.0) {
		float lowCutoffWeight = totalWeight * layers[layerIdx].data.histogramLowCutoff;
		float highCutoffWeight = totalWeight * layers[layerIdx].data.histogramHighCutoff;

		float filteredWeightSum = 0.0;
		float weightedLogLumaSum = 0.0;
		float currentWeightAccum = 0.0;

		float minValidLogLuma = MAX_LOG_LUMA;
		float maxValidLogLuma = MIN_LOG_LUMA;

		for (int i = 0; i < 256; i++) {
			float binWeight = float(layers[layerIdx].data.histogram[i]);
			float nextWeightAccum = currentWeightAccum + binWeight;

			// Check if this bin is within our cutoff range
			if (nextWeightAccum > lowCutoffWeight && currentWeightAccum < highCutoffWeight) {
				float validBinWeight = binWeight;
				// Clip bin weight if it crosses the cutoff boundaries
				if (currentWeightAccum < lowCutoffWeight) {
					validBinWeight -= (lowCutoffWeight - currentWeightAccum);
				}
				if (nextWeightAccum > highCutoffWeight) {
					validBinWeight -= (nextWeightAccum - highCutoffWeight);
				}

				float binLogLuma = MIN_LOG_LUMA + (float(i) + 0.5) / 256.0 * (MAX_LOG_LUMA - MIN_LOG_LUMA);
				weightedLogLumaSum += binLogLuma * validBinWeight;
				filteredWeightSum += validBinWeight;

				minValidLogLuma = min(minValidLogLuma, binLogLuma);
				maxValidLogLuma = max(maxValidLogLuma, binLogLuma);
			}
			currentWeightAccum = nextWeightAccum;
		}

		if (filteredWeightSum > 0.0) {
			float logAvgLuma = weightedLogLumaSum / filteredWeightSum;
			float avgLumaVal = exp(logAvgLuma);

			// Standard Deviation calculation
			float weightedLogLumaSqSum = 0.0;
			currentWeightAccum = 0.0;
			for (int i = 0; i < 256; i++) {
				float binWeight = float(layers[layerIdx].data.histogram[i]);
				float nextWeightAccum = currentWeightAccum + binWeight;
				if (nextWeightAccum > lowCutoffWeight && currentWeightAccum < highCutoffWeight) {
					float validBinWeight = binWeight;
					if (currentWeightAccum < lowCutoffWeight) validBinWeight -= (lowCutoffWeight - currentWeightAccum);
					if (nextWeightAccum > highCutoffWeight) validBinWeight -= (nextWeightAccum - highCutoffWeight);

					float binLogLuma = MIN_LOG_LUMA + (float(i) + 0.5) / 256.0 * (MAX_LOG_LUMA - MIN_LOG_LUMA);
					float diff = binLogLuma - logAvgLuma;
					weightedLogLumaSqSum += diff * diff * validBinWeight;
				}
				currentWeightAccum = nextWeightAccum;
			}
			float logStdDev = sqrt(weightedLogLumaSqSum / filteredWeightSum);

			// Update Statistics
			layers[layerIdx].data.minLuma = exp(minValidLogLuma);
			layers[layerIdx].data.maxLuma = exp(maxValidLogLuma);
			layers[layerIdx].data.avgLuma = avgLumaVal;
			layers[layerIdx].data.stdDevLuma = logStdDev;

			// Update adapted luminance (EMA)
			float speed = (avgLumaVal > layers[layerIdx].data.adaptedLuminance) ? layers[layerIdx].data.speedUp : layers[layerIdx].data.speedDown;
			float adaptation = 1.0 - exp(-push.deltaTime * speed);
			layers[layerIdx].data.adaptedLuminance += (avgLumaVal - layers[layerIdx].data.adaptedLuminance) * adaptation;

			// Slow start EMA for statistics
			float statsSpeed = 0.5; // Slightly slower for stability
			float statsAdaptation = 1.0 - exp(-push.deltaTime * statsSpeed);

			layers[layerIdx].data.emaMinLuma = mix(layers[layerIdx].data.emaMinLuma, layers[layerIdx].data.minLuma, statsAdaptation);
			layers[layerIdx].data.emaMaxLuma = mix(layers[layerIdx].data.emaMaxLuma, layers[layerIdx].data.maxLuma, statsAdaptation);
			layers[layerIdx].data.emaAvgLuma = mix(layers[layerIdx].data.emaAvgLuma, layers[layerIdx].data.avgLuma, statsAdaptation);
			layers[layerIdx].data.emaStdDevLuma = mix(layers[layerIdx].data.emaStdDevLuma, layers[layerIdx].data.stdDevLuma, statsAdaptation);

			// Auto-tune Tonemapper
			if (layers[layerIdx].data.autoTuneEnabled != 0) {
				// Contrast derived from standard deviation
				layers[layerIdx].data.autoUchimuraA = clamp(layers[layerIdx].data.emaStdDevLuma * 2.0, layers[layerIdx].data.minContrast, layers[layerIdx].data.maxContrast);

				// Linear start pegged to adapted luminance
				layers[layerIdx].data.autoUchimuraM = clamp(layers[layerIdx].data.adaptedLuminance * 0.5, 0.0, 0.5);

				// Brightness from difference of max and average
				float lumaRange = layers[layerIdx].data.emaMaxLuma - layers[layerIdx].data.emaAvgLuma;
				layers[layerIdx].data.autoUchimuraP = clamp(layers[layerIdx].data.targetBrightness + lumaRange * 0.1, 0.5, 5.0);

				// Defaults for other parameters
				layers[layerIdx].data.autoUchimuraL = 0.4;
				layers[layerIdx].data.autoUchimuraC = 1.33;
				layers[layerIdx].data.autoUchimuraB = 0.0;
			}
		}
	}

	// Reset histogram for next frame
	for (int i = 0; i < 256; i++) {
		layers[layerIdx].data.histogram[i] = 0;
	}
}

void main() {
	ivec2 id = ivec2(gl_GlobalInvocationID.xy);
	ivec2 localId = ivec2(gl_LocalInvocationID.xy);
	ivec2 mip0Size = imageSize(uImagesGenericWrite[nonuniformEXT(push.outMip0Index)]);
	ivec2 numGroups = ivec2(gl_NumWorkGroups.xy);

	vec3 bloomColor = vec3(0.0);
	vec3 ltmExposures = vec3(0.0);
	vec3 ltmWeights = vec3(0.0);

	if (id.x < mip0Size.x && id.y < mip0Size.y) {
		vec2 uv = (vec2(id) + 0.5) / vec2(mip0Size);
		vec2 texelSize = 1.0 / push.srcResolution;

		// Sample center for auto-exposure (unthresholded)
		vec3 centerSample = SAMPLE_NEAREST(push.hdrColorIndex, uv).rgb;
		float centerDepth = SAMPLE_NEAREST(push.depthIndex, uv).r;
		float linearZ = linearizeDepth(centerDepth, uNearPlane, uFarPlane);

		vec2 ndc = uv * 2.0 - 1.0;
		vec4 ray_view = uInvProjMatrix * vec4(ndc, -1.0, 1.0);
		ray_view = vec4(ray_view.xy, -1.0, 0.0);
		vec3 worldDir = normalize((uInvViewMatrix * ray_view).xyz);
		bool isSkyPixel = centerDepth >= 1.0;

		float luma = dot(centerSample, vec3(0.2126, 0.7152, 0.0722));
		float logLuma = log(max(luma, 0.0001));
		float normalizedLogLuma = clamp((logLuma - MIN_LOG_LUMA) / (MAX_LOG_LUMA - MIN_LOG_LUMA), 0.0, 1.0);
		int   bin = int(normalizedLogLuma * 255.0);

		// Loop every exposure layer whose depth range overlaps this pixel (exposureLayerWeight,
		// autoexposure.glsl -- isMain layers always weight 1.0; the default single-layer config
		// reduces this to exactly the old unconditional behavior). Each layer still accumulates
		// its own histogram/adapted-luminance independently (weighted by overlap, not an
		// all-or-nothing scene/sky pick); the per-pixel scalars this dispatch outputs itself
		// (bloom's exposure/dynMaxLuma, the shared LTM exposures/weights) blend across layers in
		// array order with the same sequential mix() idiom tonemap.frag's final color blend uses.
		float exposure = 0.0;
		float dynMaxLuma = 0.0;
		bool  anyLayerWeighted = false;
		bool  anyLtmEnabled = false;

		float remainingWeight = 1.0;

		// Iterate back-to-front (top layer down to main) to calculate the actual visible contribution
		// of each layer. This prevents the main layer's histogram from capturing pixels fully covered
		// by another layer, acting purely as a fallback for the remaining weight.
		for (int li = numExposureLayers - 1; li >= 0; --li) {
			float baseWeight = exposureLayerWeight(layers[li], linearZ, isSkyPixel);
			if (baseWeight <= 0.0 || remainingWeight <= 0.0) {
				continue;
			}

			// How much this layer actually contributes to the final pixel after upper layers take their share
			float effectiveWeight = baseWeight * remainingWeight;

			if (layers[li].data.useAutoExposure != 0) {
				float dist = distance(uv, layers[li].data.focusPoint);
				float centerWeight = exp(-dist * layers[li].data.centerWeightTightness);

				if (isSkyPixel) {
					centerWeight *= smoothstep(-0.05, 0.1, worldDir.y);
				}

				// Atomic add to this layer's own histogram bin using effective visibility
				atomicAdd(layers[li].data.histogram[bin], uint(effectiveWeight * centerWeight * 1024.0));
			}

			// LTM generation for Mip 0
			if (layers[li].data.ltmEnabled != 0) {
				float ltmExposure = layers[li].data.targetLuminance / max(layers[li].data.avgLuma, 0.0001);

				vec3 c1 = centerSample * ltmExposure * exp2(layers[li].data.ltmEvSpread);
				vec3 c2 = centerSample * ltmExposure;
				vec3 c3 = centerSample * ltmExposure * exp2(-layers[li].data.ltmEvSpread);

				vec3 tc1 = aces(c1);
				vec3 tc2 = aces(c2);
				vec3 tc3 = aces(c3);

				float l1 = sqrt(max(dot(tc1, vec3(0.2126, 0.7152, 0.0722)), 0.0));
				float l2 = sqrt(max(dot(tc2, vec3(0.2126, 0.7152, 0.0722)), 0.0));
				float l3 = sqrt(max(dot(tc3, vec3(0.2126, 0.7152, 0.0722)), 0.0));

				vec3 layerExposures = vec3(l1, l2, l3);

				vec3 e;
				e.x = exp(-0.5 * (l1 - layers[li].data.ltmTarget) * (l1 - layers[li].data.ltmTarget) / (layers[li].data.ltmSigma * layers[li].data.ltmSigma));
				e.y = exp(-0.5 * (l2 - layers[li].data.ltmTarget) * (l2 - layers[li].data.ltmTarget) / (layers[li].data.ltmSigma * layers[li].data.ltmSigma));
				e.z = exp(-0.5 * (l3 - layers[li].data.ltmTarget) * (l3 - layers[li].data.ltmTarget) / (layers[li].data.ltmSigma * layers[li].data.ltmSigma));

				vec3 s;
				s.x = get_saturation(tc1);
				s.y = get_saturation(tc2);
				s.z = get_saturation(tc3);

				vec3 layerWeights = pow(max(e, vec3(0.0001)), vec3(layers[li].data.ltmWeightExposedness)) * pow(max(s, vec3(0.0001)), vec3(layers[li].data.ltmWeightSaturation));
				float layerWeightSum = layerWeights.x + layerWeights.y + layerWeights.z;
				layerWeights /= max(layerWeightSum, 0.00001);

				ltmExposures += layerExposures * effectiveWeight;
				ltmWeights += layerWeights * effectiveWeight;
				anyLtmEnabled = true;
			}

			// Exposure for bloom extraction
			float layerExposure;
			if (layers[li].data.useAutoExposure != 0) {
				layerExposure = layers[li].data.targetLuminance / max(layers[li].data.adaptedLuminance, 0.0001);
				layerExposure = clamp(layerExposure, layers[li].data.minExposure, layers[li].data.maxExposure);
			} else {
				layerExposure = (layers[li].data.iso / 100.0) * (1.0 / (layers[li].data.aperture * layers[li].data.aperture)) * layers[li].data.exposureTime;
			}
			float layerDynMaxLuma = mix(10.0, 500.0, smoothstep(0.01, 1000.0, layers[li].data.adaptedLuminance));

			exposure += layerExposure * effectiveWeight;
			dynMaxLuma += layerDynMaxLuma * effectiveWeight;
			anyLayerWeighted = true;

			remainingWeight -= effectiveWeight;
		}

		// Normalize if the sum of weights didn't reach 1.0 (restores the behavior where a
		// single low-weight layer was forced to act as an opaque baseline)
		float totalAccumulatedWeight = 1.0 - remainingWeight;
		if (totalAccumulatedWeight > 0.0 && totalAccumulatedWeight < 1.0) {
			float invWeight = 1.0 / totalAccumulatedWeight;
			exposure *= invWeight;
			dynMaxLuma *= invWeight;
			if (anyLtmEnabled) {
				ltmExposures *= invWeight;
				ltmWeights *= invWeight;
			}
		} else if (!anyLayerWeighted) {
			exposure = 1.0;
			dynMaxLuma = 10.0;
		}

		if (anyLtmEnabled) {
			imageStore(uImagesGenericWrite[nonuniformEXT(push.outExpMip0Index)], id, vec4(ltmExposures, 1.0));
			imageStore(uImagesGenericWrite[nonuniformEXT(push.outWgtMip0Index)], id, vec4(ltmWeights, 1.0));
		}

		float knee = max(push.threshold * push.softness, 0.0001);
		float kneeLower = push.threshold - knee;
		float kneeUpper = knee * 2.0;
		float kneeRecip = 0.25 / knee;

		float spatialWeights[9] = float[9](4.0, 1.0, 1.0, 1.0, 1.0, 0.5, 0.5, 0.5, 0.5);
		vec2 offsets[9] = vec2[9](
			vec2(0.0, 0.0), vec2(-1.0, -1.0), vec2(1.0, -1.0), vec2(-1.0, 1.0),
			vec2(1.0, 1.0), vec2(0.0, -2.0), vec2(0.0, 2.0), vec2(-2.0, 0.0), vec2(2.0, 0.0)
		);

		vec3 weightedColorSum = vec3(0.0);
		float totalWeight = 0.0;
		vec3 maxExtractedColor = vec3(0.0);

		// 9-tap Dual Kawase-style filter with Karis average filtering in post-exposure space
		for (int i = 0; i < 9; ++i) {
			vec3 sRaw = (i == 0) ? centerSample : SAMPLE_NEAREST(push.hdrColorIndex, uv + offsets[i] * texelSize).rgb;

			// A. Apply Exposure
			vec3 tapColor = sRaw * exposure;
			float tapLuma = dot(tapColor, vec3(0.2126, 0.7152, 0.0722));

			// B. Soft-Knee Threshold
			float rq = clamp(tapLuma - kneeLower, 0.0, kneeUpper);
			rq = kneeRecip * rq * rq;
			float brightPassWeight = max(rq, tapLuma - push.threshold) / max(tapLuma, 0.0001);

			vec3 extractedColor = tapColor * brightPassWeight;
			float extractedLuma = tapLuma * brightPassWeight;

			// C. Adaptive Luma-Preserving Clamp
			float clampScale = min(1.0, dynMaxLuma / max(extractedLuma, 0.0001));
			extractedColor *= clampScale;
			float finalLuma = extractedLuma * clampScale;

			maxExtractedColor = max(maxExtractedColor, extractedColor);

			// D. Karis Average (Using the finalized bloom luminance with dampening factor)
			float karisWeight = 1.0 / (1.0 + push.karisDampening * finalLuma);
			float w = spatialWeights[i] * karisWeight;

			weightedColorSum += extractedColor * w;
			totalWeight += w;
		}

		vec3 avgBloom = weightedColorSum / max(totalWeight, 0.0001);
		bloomColor = max(avgBloom, maxExtractedColor * push.maxPoolingFactor);
		imageStore(uImagesGenericWrite[nonuniformEXT(push.outMip0Index)], id, vec4(bloomColor, 1.0));
	}

	s_mip[localId.x][localId.y] = bloomColor;
	s_ltmExp[localId.x][localId.y] = ltmExposures;
	s_ltmWgt[localId.x][localId.y] = ltmWeights;

	barrier();

	if (localId == ivec2(0)) {
		memoryBarrierBuffer();
		uint finished = atomicAdd(workgroupCounter, 1);
		if (finished == numGroups.x * numGroups.y - 1) {
			memoryBarrierBuffer();

			for (int li = 0; li < numExposureLayers; ++li) {
				if (layers[li].data.useAutoExposure != 0) update_layer_ae(li);
			}

			// Ensure results are written before we reset counters
			memoryBarrierBuffer();
			memoryBarrier();
			workgroupCounter = 0;
		}
	}

	// Whether to propagate the LTM exposure/weight mip chain at all -- a uniform buffer read, same
	// across every invocation, so computing it once here and reusing it below (instead of
	// re-deriving the OR of every layer's ltmEnabled 4 times, once per mip level) is a plain
	// dedup, not a behavior change.
	bool anyLayerLtmConfigured = false;
	for (int li = 0; li < numExposureLayers; ++li) {
		if (layers[li].data.ltmEnabled != 0) {
			anyLayerLtmConfigured = true;
			break;
		}
	}

	// Continue with bloom downsample chain (Mip 1-4)
	if (push.numMips > 1 && (localId.x % 2 == 0) && (localId.y % 2 == 0)) {
		bloomColor = (s_mip[localId.x][localId.y] +
					  s_mip[localId.x + 1][localId.y] +
					  s_mip[localId.x][localId.y + 1] +
					  s_mip[localId.x + 1][localId.y + 1]) * 0.25;

		ivec2 outId = id / 2;
		ivec2 mip1Size = imageSize(uImagesGenericWrite[nonuniformEXT(push.outMip1Index)]);
		if (outId.x < mip1Size.x && outId.y < mip1Size.y) {
			imageStore(uImagesGenericWrite[nonuniformEXT(push.outMip1Index)], outId, vec4(bloomColor, 1.0));
		}
		s_mip[localId.x][localId.y] = bloomColor;

		if (anyLayerLtmConfigured) {
			ltmExposures = (s_ltmExp[localId.x][localId.y] +
						  s_ltmExp[localId.x + 1][localId.y] +
						  s_ltmExp[localId.x][localId.y + 1] +
						  s_ltmExp[localId.x + 1][localId.y + 1]) * 0.25;
			ltmWeights = (s_ltmWgt[localId.x][localId.y] +
						  s_ltmWgt[localId.x + 1][localId.y] +
						  s_ltmWgt[localId.x][localId.y + 1] +
						  s_ltmWgt[localId.x + 1][localId.y + 1]) * 0.25;
			if (outId.x < mip1Size.x && outId.y < mip1Size.y) {
				imageStore(uImagesGenericWrite[nonuniformEXT(push.outExpMip1Index)], outId, vec4(ltmExposures, 1.0));
				imageStore(uImagesGenericWrite[nonuniformEXT(push.outWgtMip1Index)], outId, vec4(ltmWeights, 1.0));
			}
			s_ltmExp[localId.x][localId.y] = ltmExposures;
			s_ltmWgt[localId.x][localId.y] = ltmWeights;
		}
	}

	barrier();

	if (push.numMips > 2 && (localId.x % 4 == 0) && (localId.y % 4 == 0)) {
		bloomColor = (s_mip[localId.x][localId.y] +
					  s_mip[localId.x + 2][localId.y] +
					  s_mip[localId.x][localId.y + 2] +
					  s_mip[localId.x + 2][localId.y + 2]) * 0.25;

		ivec2 outId = id / 4;
		ivec2 mip2Size = imageSize(uImagesGenericWrite[nonuniformEXT(push.outMip2Index)]);
		if (outId.x < mip2Size.x && outId.y < mip2Size.y) {
			imageStore(uImagesGenericWrite[nonuniformEXT(push.outMip2Index)], outId, vec4(bloomColor, 1.0));
		}
		s_mip[localId.x][localId.y] = bloomColor;

		if (anyLayerLtmConfigured) {
			ltmExposures = (s_ltmExp[localId.x][localId.y] +
						  s_ltmExp[localId.x + 2][localId.y] +
						  s_ltmExp[localId.x][localId.y + 2] +
						  s_ltmExp[localId.x + 2][localId.y + 2]) * 0.25;
			ltmWeights = (s_ltmWgt[localId.x][localId.y] +
						  s_ltmWgt[localId.x + 2][localId.y] +
						  s_ltmWgt[localId.x][localId.y + 2] +
						  s_ltmWgt[localId.x + 2][localId.y + 2]) * 0.25;
			if (outId.x < mip2Size.x && outId.y < mip2Size.y) {
				imageStore(uImagesGenericWrite[nonuniformEXT(push.outExpMip2Index)], outId, vec4(ltmExposures, 1.0));
				imageStore(uImagesGenericWrite[nonuniformEXT(push.outWgtMip2Index)], outId, vec4(ltmWeights, 1.0));
			}
			s_ltmExp[localId.x][localId.y] = ltmExposures;
			s_ltmWgt[localId.x][localId.y] = ltmWeights;
		}
	}

	barrier();

	if (push.numMips > 3 && (localId.x % 8 == 0) && (localId.y % 8 == 0)) {
		bloomColor = (s_mip[localId.x][localId.y] +
					  s_mip[localId.x + 4][localId.y] +
					  s_mip[localId.x][localId.y + 4] +
					  s_mip[localId.x + 4][localId.y + 4]) * 0.25;

		ivec2 outId = id / 8;
		ivec2 mip3Size = imageSize(uImagesGenericWrite[nonuniformEXT(push.outMip3Index)]);
		if (outId.x < mip3Size.x && outId.y < mip3Size.y) {
			imageStore(uImagesGenericWrite[nonuniformEXT(push.outMip3Index)], outId, vec4(bloomColor, 1.0));
		}
		s_mip[localId.x][localId.y] = bloomColor;

		if (anyLayerLtmConfigured) {
			ltmExposures = (s_ltmExp[localId.x][localId.y] +
						  s_ltmExp[localId.x + 4][localId.y] +
						  s_ltmExp[localId.x][localId.y + 4] +
						  s_ltmExp[localId.x + 4][localId.y + 4]) * 0.25;
			ltmWeights = (s_ltmWgt[localId.x][localId.y] +
						  s_ltmWgt[localId.x + 4][localId.y] +
						  s_ltmWgt[localId.x][localId.y + 4] +
						  s_ltmWgt[localId.x + 4][localId.y + 4]) * 0.25;
			if (outId.x < mip3Size.x && outId.y < mip3Size.y) {
				imageStore(uImagesGenericWrite[nonuniformEXT(push.outExpMip3Index)], outId, vec4(ltmExposures, 1.0));
				imageStore(uImagesGenericWrite[nonuniformEXT(push.outWgtMip3Index)], outId, vec4(ltmWeights, 1.0));
			}
			s_ltmExp[localId.x][localId.y] = ltmExposures;
			s_ltmWgt[localId.x][localId.y] = ltmWeights;
		}
	}

	barrier();

	if (push.numMips > 4 && (localId.x % 16 == 0) && (localId.y % 16 == 0)) {
		bloomColor = (s_mip[localId.x][localId.y] +
					  s_mip[localId.x + 8][localId.y] +
					  s_mip[localId.x][localId.y + 8] +
					  s_mip[localId.x + 8][localId.y + 8]) * 0.25;

		ivec2 outId = id / 16;
		ivec2 mip4Size = imageSize(uImagesGenericWrite[nonuniformEXT(push.outMip4Index)]);
		if (outId.x < mip4Size.x && outId.y < mip4Size.y) {
			imageStore(uImagesGenericWrite[nonuniformEXT(push.outMip4Index)], outId, vec4(bloomColor, 1.0));
		}

		if (anyLayerLtmConfigured) {
			ltmExposures = (s_ltmExp[localId.x][localId.y] +
						  s_ltmExp[localId.x + 8][localId.y] +
						  s_ltmExp[localId.x][localId.y + 8] +
						  s_ltmExp[localId.x + 8][localId.y + 8]) * 0.25;
			ltmWeights = (s_ltmWgt[localId.x][localId.y] +
						  s_ltmWgt[localId.x + 8][localId.y] +
						  s_ltmWgt[localId.x][localId.y + 8] +
						  s_ltmWgt[localId.x + 8][localId.y + 8]) * 0.25;
			if (outId.x < mip4Size.x && outId.y < mip4Size.y) {
				imageStore(uImagesGenericWrite[nonuniformEXT(push.outExpMip4Index)], outId, vec4(ltmExposures, 1.0));
				imageStore(uImagesGenericWrite[nonuniformEXT(push.outWgtMip4Index)], outId, vec4(ltmWeights, 1.0));
			}
		}
	}
}
