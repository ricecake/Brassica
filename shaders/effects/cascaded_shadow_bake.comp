#version 460
#extension GL_EXT_nonuniform_qualifier : require

#include "bindless.glsl"
#include "common.glsl"
#include "terrain.glsl"

layout(set = 1, binding = 3, rgba32f) uniform image2DArray uImageArraysRGBA32F[];
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform ShadowBakePushConstants {
	uvec4 gridParams;          // x = numLODs, y = meshletsPerRow, z = totalMeshlets, w = textureDim
	uint  shadowMapStorageIdx; // Storage index for CascadedShadowMapArray
	uint  clipmapIndex;        // Sampled index for TerrainClipmapTexture
	uint  minMaxIndex;         // Sampled index for TerrainMinMaxTexture
	uint  activeCascadeMask;   // Bitmask: bit c set if cascade c is active this frame
} push;

uint calculateRayLOD(vec2 sampleXZ) {
	vec2  dists = abs(sampleXZ - uCameraPosition.xz);
	float maxDist = max(dists.x, dists.y);
	float baseRadius = 272.0;

	if (maxDist < baseRadius) {
		return 0u;
	}

	float lodFloat = ceil(log2(maxDist / baseRadius));
	return uint(clamp(lodFloat, 0.0, 7.0));
}

vec3 unprojectNDC(vec3 ndc, mat4 invViewProj) {
	vec4 world = invViewProj * vec4(ndc, 1.0);
	return world.xyz / max(0.00001, world.w);
}

void main() {
	uvec2 shadowSize = uvec2(1024u, 1024u);
	if (gl_GlobalInvocationID.x >= shadowSize.x || gl_GlobalInvocationID.y >= shadowSize.y) {
		return;
	}

	vec2 uv = (vec2(gl_GlobalInvocationID.xy) + vec2(0.5)) / vec2(shadowSize);
	vec2 ndcXY = uv * 2.0 - vec2(1.0);

	for (uint c = 0u; c < 4u; ++c) {
		if ((push.activeCascadeMask & (1u << c)) == 0u) {
			continue; // Refresh rate throttling: skip un-refreshed cascade layers
		}

		mat4 invVP = inverse(uCascadeViewProj[c]);
		vec3 rayNear = unprojectNDC(vec3(ndcXY, 0.0), invVP);
		vec3 rayFar  = unprojectNDC(vec3(ndcXY, 1.0), invVP);

		// Sample terrain at rayNear world XZ
		vec2  worldXZ = rayNear.xz;
		uint  stepLod = calculateRayLOD(worldXZ);
		vec2  flatXZ  = worldXZ - uCameraPosition.xz;
		float dropOff = dot(flatXZ, flatXZ) / (2.0 * FAKE_PLANET_RADIUS);

		float terrainHeight = 0.0;
		if (push.clipmapIndex > 0u) {
			vec4 texSample = sampleTerrainClipmap(
				push.clipmapIndex,
				worldXZ,
				stepLod,
				push.gridParams.w
			);
			terrainHeight = texSample.r - dropOff;
		}

		vec3 surfaceWorldPos = vec3(worldXZ.x, terrainHeight, worldXZ.y);
		vec4 lightPos = uCascadeViewProj[c] * vec4(surfaceWorldPos, 1.0);
		float depth = clamp(lightPos.z / max(0.00001, lightPos.w), 0.0, 1.0);

		ivec3 storeCoord = ivec3(gl_GlobalInvocationID.xy, int(c));
		imageStore(uImageArraysRGBA32F[nonuniformEXT(push.shadowMapStorageIdx)], storeCoord, vec4(depth, 0.0, 0.0, 1.0));
	}
}
