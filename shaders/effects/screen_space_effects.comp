#version 460
#include "../bindless.glsl"
#include "../common.glsl"
#include "../helpers/noise.glsl"
#include "../lighting.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform ScreenSpacePushConstants {
	uint  gPositionIndex;
	uint  gNormalIndex;
	uint  gAlbedoIndex;
	uint  gDepthIndex;
	uint  outIndirectAOIndex;
	uint  outShadowMaskIndex;

	uint  ssgiEnabled;
	uint  gtaoEnabled;
	uint  sssEnabled;

	float ssgiRadius;
	float ssgiIntensity;
	uint  ssgiSteps;
	uint  ssgiRayCount;

	float gtaoRadius;
	float gtaoIntensity;
	uint  gtaoSteps;
	uint  gtaoDirections;

	float sssRadius;
	float sssIntensity;
	float sssBias;
	uint  sssSteps;
}
params;

vec4 spatiotemporalNoise(ivec2 pixel, uint frameIndex) {
	vec2 p = vec2(pixel) + vec2(float(frameIndex * 13u), float(frameIndex * 7u));
	vec2 h1 = hash22(p);
	vec2 h2 = hash22(p + vec2(17.1, 31.7));
	return vec4(h1, h2);
}

vec3 getViewPosFromDepth(vec2 uv, float depth) {
	vec4 clipPos = vec4(uv * 2.0 - 1.0, depth, 1.0);
	vec4 viewPos = uInvProjMatrix * clipPos;
	return viewPos.xyz / viewPos.w;
}

// Jimenez 2016 GTAO inner slice integral
float gtaoIntegrateSlice(float h1, float h2, float gamma) {
	float sinGamma = sin(gamma);
	float cosGamma = cos(gamma);

	float i1 = cosGamma + 2.0 * h1 * sinGamma - cos(2.0 * h1 - gamma);
	float i2 = cosGamma + 2.0 * h2 * sinGamma - cos(2.0 * h2 - gamma);

	return (i1 + i2) * 0.25;
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(uImagesRGBA32F[nonuniformEXT(params.outIndirectAOIndex)]);
	if (pixel.x >= size.x || pixel.y >= size.y) return;

	vec2  uv = (vec2(pixel) + 0.5) / vec2(size);
	float depth = SAMPLE_NEAREST(params.gDepthIndex, uv).r;

	if (depth >= 0.99999) {
		if (params.ssgiEnabled != 0u || params.gtaoEnabled != 0u) {
			imageStore(uImagesRGBA32F[nonuniformEXT(params.outIndirectAOIndex)], pixel, vec4(0.0, 0.0, 0.0, 1.0));
		}
		if (params.sssEnabled != 0u) {
			imageStore(uImagesRGBA32F[nonuniformEXT(params.outShadowMaskIndex)], pixel, vec4(1.0, 0.0, 0.0, 1.0));
		}
		return;
	}

	vec3 vPos = getViewPosFromDepth(uv, depth);
	vec3 worldNorm = normalize(SAMPLE_NEAREST(params.gNormalIndex, uv).rgb);
	if (length(worldNorm) < 0.1) {
		if (params.ssgiEnabled != 0u || params.gtaoEnabled != 0u) {
			imageStore(uImagesRGBA32F[nonuniformEXT(params.outIndirectAOIndex)], pixel, vec4(0.0, 0.0, 0.0, 1.0));
		}
		if (params.sssEnabled != 0u) {
			imageStore(uImagesRGBA32F[nonuniformEXT(params.outShadowMaskIndex)], pixel, vec4(1.0, 0.0, 0.0, 1.0));
		}
		return;
	}

	vec3 vNorm = normalize((uViewMatrix * vec4(worldNorm, 0.0)).xyz);

	vec4 bn = spatiotemporalNoise(pixel, uFrameIndex);

	// --- 1. Screen Space Shadows (SSS) ---
	float sssVisibility = 1.0;
	if (params.sssEnabled != 0u) {
		vec3 lightDirWorld = normalize(vec3(0.4, 0.8, 0.4));
		uint numDirectionalCheck = min(uLightCount, 16u);
		for (uint i = 0u; i < numDirectionalCheck; ++i) {
			if (uLights[i].type == LIGHT_TYPE_DIRECTIONAL && uLights[i].intensity > 0.0) {
				lightDirWorld = normalize(-uLights[i].direction);
				break;
			}
		}

		vec3  lightDirView = normalize((uViewMatrix * vec4(lightDirWorld, 0.0)).xyz);
		float dotNL = dot(vNorm, lightDirView);

		if (dotNL <= 0.0) {
			sssVisibility = 1.0;
		} else {
			float maxDist = params.sssRadius * uWorldScale;
			float distBias = params.sssBias * uWorldScale * max(0.05, (1.0 - dotNL) * 0.2);
			vec3  rayStartPos = vPos + (vNorm * 0.5 + lightDirView * 0.5) * distBias;

			float minContactDist = maxDist;
			float finalEdgeFade = 1.0;
			bool  hit = false;

			vec2 texelSize = 1.5 / vec2(size);

			for (uint i = 0u; i < params.sssSteps; ++i) {
				float t = ((float(i) + 1.0 + bn.r) / float(max(1u, params.sssSteps))) * maxDist;
				vec3  rayPos = rayStartPos + lightDirView * t;

				vec4 clipPos = uProjMatrix * vec4(rayPos, 1.0);
				vec3 ndcPos = clipPos.xyz / max(0.0001, clipPos.w);
				vec2 sampleUV = ndcPos.xy * 0.5 + 0.5;

				if (sampleUV.x < 0.0 || sampleUV.x > 1.0 || sampleUV.y < 0.0 || sampleUV.y > 1.0 || ndcPos.z > 1.0 ||
					ndcPos.z < 0.0)
					break;

				if (length(sampleUV - uv) < max(texelSize.x, texelSize.y)) continue;

				float sampleDepth = SAMPLE_NEAREST(params.gDepthIndex, sampleUV).r;
				float sampleZView = getViewPosFromDepth(sampleUV, sampleDepth).z;

				float penetration = sampleZView - rayPos.z;
				if (rayPos.z < sampleZView - 0.005 && penetration > 0.01 * uWorldScale && penetration < 2.0 * uWorldScale) {
					vec2  edgeDist = min(sampleUV, 1.0 - sampleUV);
					float edgeFade = clamp(min(edgeDist.x, edgeDist.y) * 10.0, 0.0, 1.0);
					if (edgeFade > 0.0) {
						sssVisibility = 0.0;
						minContactDist = t;
						finalEdgeFade = edgeFade;
						hit = true;
						break;
					}
				}
			}
			if (hit) {
				float shadowStrength = clamp(minContactDist / maxDist, 0.0, 1.0);
				sssVisibility = mix(1.0, shadowStrength, finalEdgeFade);
			}
		}
		imageStore(
			uImagesRGBA32F[nonuniformEXT(params.outShadowMaskIndex)],
			pixel,
			vec4(sssVisibility, 0.0, 0.0, 1.0)
		);
	}

	// --- 2. Ground Truth Ambient Occlusion (GTAO) ---
	float ao = 1.0;
	vec3  bentNormal = vNorm;
	if (params.gtaoEnabled != 0u) {
		float gtao_ao = 0.0;
		vec3  gtao_bent_normal = vec3(0.0);
		vec3  V = normalize(-vPos);
		vec2  projScale = vec2(uProjMatrix[0][0] * 0.5, abs(uProjMatrix[1][1]) * 0.5);

		for (uint i = 0u; i < params.gtaoDirections; ++i) {
			float angle = (float(i) + bn.x) * (PI / float(params.gtaoDirections));
			vec2  dir = vec2(cos(angle), sin(angle));
			vec2  screenDir = vec2(dir.x * projScale.x, -dir.y * projScale.y) / max(0.1, -vPos.z);

			vec3  T = vec3(cos(angle), sin(angle), 0.0);
			vec3  sliceDir = normalize(T - dot(T, V) * V);

			vec3  axis = cross(sliceDir, V);
			vec3  projN = vNorm - axis * dot(vNorm, axis);
			float projNLen = length(projN);
			vec3  projNNorm = projN / max(0.0001, projNLen);

			float gamma = atan(dot(projNNorm, sliceDir), dot(projNNorm, V));

			float h1 = -PI * 0.5;
			float h2 = -PI * 0.5;

			for (uint j = 1u; j <= params.gtaoSteps; ++j) {
				float stepTexel = float(j) / float(params.gtaoSteps);
				vec2  offset = screenDir * (stepTexel * params.gtaoRadius);

				vec2 uv1 = uv + offset;
				vec2 uv2 = uv - offset;

				if (uv1.x >= 0.0 && uv1.x <= 1.0 && uv1.y >= 0.0 && uv1.y <= 1.0) {
					vec3 p1 = getViewPosFromDepth(uv1, SAMPLE_NEAREST(params.gDepthIndex, uv1).r);
					vec3 v1 = p1 - vPos;
					float d1 = length(v1);
					if (d1 > 0.001 && d1 < params.gtaoRadius) {
						vec3 u1 = v1 / d1;
						if (dot(u1, V) > 0.0) {
							float w = clamp(1.0 - (d1 / params.gtaoRadius), 0.0, 1.0);
							w = w * w;
							float sinH = dot(u1, sliceDir);
							float cosH = dot(u1, V);
							float angleH = atan(sinH, cosH);
							h1 = max(h1, mix(-PI * 0.5, angleH, w));
						}
					}
				}

				if (uv2.x >= 0.0 && uv2.x <= 1.0 && uv2.y >= 0.0 && uv2.y <= 1.0) {
					vec3 p2 = getViewPosFromDepth(uv2, SAMPLE_NEAREST(params.gDepthIndex, uv2).r);
					vec3 v2 = p2 - vPos;
					float d2 = length(v2);
					if (d2 > 0.001 && d2 < params.gtaoRadius) {
						vec3 u2 = v2 / d2;
						if (dot(u2, V) > 0.0) {
							float w = clamp(1.0 - (d2 / params.gtaoRadius), 0.0, 1.0);
							w = w * w;
							float sinH = dot(u2, -sliceDir);
							float cosH = dot(u2, V);
							float angleH = atan(sinH, cosH);
							h2 = max(h2, mix(-PI * 0.5, angleH, w));
						}
					}
				}
			}

			float h1Clamped = clamp(max(h1, gamma - PI * 0.5), -PI * 0.5, PI * 0.5);
			float h2Clamped = clamp(max(h2, -gamma - PI * 0.5), -PI * 0.5, PI * 0.5);

			float sliceAo = projNLen * gtaoIntegrateSlice(h1Clamped, h2Clamped, gamma);
			gtao_ao += max(0.0, sliceAo);

			float bisectorAngle = (h1Clamped + h2Clamped) * 0.5;
			vec3 sliceUnoccludedDir = cos(bisectorAngle) * V + sin(bisectorAngle) * sliceDir;
			gtao_bent_normal += sliceUnoccludedDir * (h1Clamped - h2Clamped);
		}

		float visibility = gtao_ao / float(max(1u, params.gtaoDirections));
		ao = clamp(1.0 - (1.0 - visibility) * params.gtaoIntensity, 0.0, 1.0);

		if (length(gtao_bent_normal) > 0.001) {
			bentNormal = normalize(mix(vNorm, normalize(gtao_bent_normal), params.gtaoIntensity));
		}
	}

	// --- 3. Screen Space Global Illumination (SSGI) ---
	vec3 indirect = vec3(0.0);
	if (params.ssgiEnabled != 0u) {
		vec3  albedo = SAMPLE_NEAREST(params.gAlbedoIndex, uv).rgb;
		vec4  normalSample = SAMPLE_NEAREST(params.gNormalIndex, uv);

		vec3 V = normalize(-vPos);

		for (uint r = 0u; r < params.ssgiRayCount; ++r) {
			vec2 jitterDir = fract(bn.xy + vec2(float(r) * 0.618, float(r) * 0.382));
			vec2 jitterDist = fract(bn.zw + vec2(float(r) * 0.137, float(r) * 0.742));

			vec3 rayDir = hemisphereSample(jitterDir, bentNormal);
			vec3 weight = albedo * params.ssgiIntensity;

			if (dot(rayDir, vNorm) < 0.0) continue;

			float stepSize = params.ssgiRadius / float(params.ssgiSteps);
			float rayDist = stepSize * (0.5 + jitterDist.x);

			for (uint i = 0u; i < params.ssgiSteps; ++i) {
				vec3 samplePos = vPos + rayDir * rayDist;
				vec4 offsetClip = uProjMatrix * vec4(samplePos, 1.0);
				vec2 offsetUV = (offsetClip.xy / max(0.0001, offsetClip.w)) * 0.5 + 0.5;

				if (offsetUV.x < 0.0 || offsetUV.x > 1.0 || offsetUV.y < 0.0 || offsetUV.y > 1.0) break;

				float sampledDepth = SAMPLE_NEAREST(params.gDepthIndex, offsetUV).r;
				float sampledZView = getViewPosFromDepth(offsetUV, sampledDepth).z;

				float penetration = sampledZView - samplePos.z;
				if (samplePos.z < sampledZView - 0.005 && penetration > 0.01 * uWorldScale && penetration < 0.5 * uWorldScale) {
					vec3  hitAlbedo = SAMPLE_NEAREST(params.gAlbedoIndex, offsetUV).rgb;
					float falloff = exp(-rayDist / max(0.001, params.ssgiRadius));
					indirect += hitAlbedo * weight * falloff;
					break;
				}
				rayDist += stepSize;
			}
		}
		indirect /= float(max(1u, params.ssgiRayCount));
	}

	if (params.ssgiEnabled != 0u || params.gtaoEnabled != 0u) {
		imageStore(
			uImagesRGBA32F[nonuniformEXT(params.outIndirectAOIndex)],
			pixel,
			vec4(indirect, ao)
		);
	}
}
