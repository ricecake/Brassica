#version 460 core

layout(local_size_x = 8, local_size_y = 8) in;

#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require

#include "../bindless.glsl"

struct TileQueueHeader {
	uint count;
	uint maxTiles;
	uint spatialUpdateFrames;
	uint frameIndex;
	float minRefreshRate;
	float maxRefreshRate;
	uint tileCols;
	uint tileRows;
	uint totalTiles;
	uint padding;
};

layout(buffer_reference, std430) buffer TileQueueSSBORef {
	TileQueueHeader uHeader;
	uvec2 uTileQueue[];
};

layout(buffer_reference, std430) buffer IndirectDispatchSSBORef {
	uint uDispatchCountX;
	uint uDispatchCountY;
	uint uDispatchCountZ;
};

layout(push_constant) uniform CloudTileSchedulerPushConstants {
	uint boundingMapIdx;
	uint errorMapStorageIdx;
	uint64_t tileQueueBufferAddr;
	uint64_t indirectDispatchBufferAddr;
	int pass; // 0 = Spatial Pass, 1 = Priority Pass
	float priorityErrorWeight;
	float priorityGradWeight;
	float priorityAgeWeight;
	float priorityNeighborErrorWeight;
	float priorityNeighborGradWeight;
	float priorityThreshold;
	uint padding;
} push;

const int bayer8x8[64] = int[64](
	 0, 32,  8, 40,  2, 34, 10, 42,
	48, 16, 56, 24, 50, 18, 58, 26,
	12, 44,  4, 36, 14, 46,  6, 38,
	60, 28, 52, 20, 62, 30, 54, 22,
	 3, 35, 11, 43,  1, 33,  9, 41,
	51, 19, 59, 27, 49, 17, 57, 25,
	15, 47,  7, 39, 13, 45,  5, 37,
	63, 31, 55, 23, 61, 29, 53, 21
);

void main() {
	TileQueueSSBORef tileQueue = TileQueueSSBORef(push.tileQueueBufferAddr);
	IndirectDispatchSSBORef indirectDispatch = IndirectDispatchSSBORef(push.indirectDispatchBufferAddr);

	uvec2 tileCoord = gl_GlobalInvocationID.xy;
	ivec2 tileMapSize = imageSize(uImagesRGBA32F[nonuniformEXT(push.errorMapStorageIdx)]);

	if (tileCoord.x >= tileMapSize.x || tileCoord.y >= tileMapSize.y) return;

	if (gl_GlobalInvocationID.x == 0u && gl_GlobalInvocationID.y == 0u && push.pass == 0) {
		tileQueue.uHeader.count = 0u;
		tileQueue.uHeader.tileCols = uint(tileMapSize.x);
		tileQueue.uHeader.tileRows = uint(tileMapSize.y);
		tileQueue.uHeader.totalTiles = uint(tileMapSize.x * tileMapSize.y);
	}

	barrier();

	uint tileIdx = tileCoord.y * uint(tileMapSize.x) + tileCoord.x;
	int bayerVal = bayer8x8[tileIdx % 64u];
	uint interval = max(1u, tileQueue.uHeader.spatialUpdateFrames);

	vec4 errorData = imageLoad(uImagesRGBA32F[nonuniformEXT(push.errorMapStorageIdx)], ivec2(tileCoord));

	if (push.pass == 0) {
		if ((tileQueue.uHeader.frameIndex + uint(bayerVal)) % interval == 0u) {
			uint slot = atomicAdd(tileQueue.uHeader.count, 1u);
			if (slot < tileQueue.uHeader.maxTiles) {
				tileQueue.uTileQueue[slot] = tileCoord;
				errorData.g = 1.0;
			}
		}
	} else {
		if (errorData.g < 0.5) {
			float priorityScore = errorData.r * push.priorityErrorWeight + errorData.b * push.priorityAgeWeight;
			if (priorityScore > push.priorityThreshold) {
				uint slot = atomicAdd(tileQueue.uHeader.count, 1u);
				if (slot < tileQueue.uHeader.maxTiles) {
					tileQueue.uTileQueue[slot] = tileCoord;
					errorData.g = 1.0;
				}
			}
		}
	}

	imageStore(uImagesRGBA32F[nonuniformEXT(push.errorMapStorageIdx)], ivec2(tileCoord), errorData);

	barrier();

	if (gl_GlobalInvocationID.x == 0u && gl_GlobalInvocationID.y == 0u) {
		indirectDispatch.uDispatchCountX = (tileQueue.uHeader.count + 63u) / 64u;
		indirectDispatch.uDispatchCountY = 1u;
		indirectDispatch.uDispatchCountZ = 1u;
	}
}
