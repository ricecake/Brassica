#version 460 core

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba32f) uniform image2D outFilteredColor;

layout(binding = 1) uniform sampler2D uCloudColor;   // Accumulated RGBA
layout(binding = 2) uniform sampler2D uCloudDepth;   // Accumulated Depth Props
layout(binding = 3) uniform sampler2D uCloudMoments; // Accumulated Moments
layout(binding = 4) uniform sampler2D uErrorMap;     // Tile Error Map

#include "../helpers/cloud_utils.glsl"

#define uStepSize 1
#define uPassIndex 0

#define uCloudPhiLuma 20.0
#define uCloudPhiDensity 0.05
#define uCloudPhiDepth 1.5

#define uCloudSvgfHistoryBoost 4.0
#define uCloudSvgfHistoryThreshold 10.0

const float kernel[5] = float[](1.0/16.0, 1.0/4.0, 3.0/8.0, 1.0/4.0, 1.0/16.0);

float luma(vec3 color) {
	return dot(color, vec3(0.299, 0.587, 0.114));
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(outFilteredColor);
	if (pixel.x >= size.x || pixel.y >= size.y) return;

	vec2 texelSize = 1.0 / vec2(size);
	vec2 uv = (vec2(pixel) + 0.5) * texelSize;

	float centerDepth = texture(uCloudDepth, uv).r;
	vec4 centerColor = texture(uCloudColor, uv);
	vec4 centerMoments = texture(uCloudMoments, uv);

	ivec2 tileCoord = pixel / ivec2(8);
	vec4 tileErrorData = texelFetch(uErrorMap, tileCoord, 0);
	float tileError = tileErrorData.r;

	float centerDensity = centerColor.a;
	float centerHistory = centerMoments.w;

	float varLuma = max(0.0, centerMoments.y - centerMoments.x * centerMoments.x);
	float stdLuma = sqrt(varLuma);
	float historyScale = mix(uCloudSvgfHistoryBoost, 1.0, smoothstep(1.0, max(2.0, uCloudSvgfHistoryThreshold), centerHistory));
	float errorBoost = 1.0 + tileError * 3.0;

	float phiLuma = (uCloudPhiLuma * stdLuma + 0.02) * historyScale * errorBoost;
	float phiDensity = (uCloudPhiDensity * centerDensity + 0.1) * historyScale * errorBoost;
	float phiDepth = (uCloudPhiDepth * centerDepth + 0.05) * historyScale * errorBoost;

	vec4  sumColor = vec4(0.0);
	float sumWeight = 0.0;

	for (int y = -2; y <= 2; y++) {
		for (int x = -2; x <= 2; x++) {
			vec2 offset = vec2(x, y) * float(uStepSize) * texelSize;

			vec4 sampleColor = texture(uCloudColor, uv + offset);
			float sampleDensity = sampleColor.a;
			float sampleDepth = texture(uCloudDepth, uv + offset).r;

			float lumaWeight = exp(-abs(luma(centerColor.rgb) - luma(sampleColor.rgb)) / max(1e-4, phiLuma));
			float densityWeight = exp(-abs(centerDensity - sampleDensity) / max(1e-4, phiDensity));
			float depthWeight = exp(-abs(centerDepth - sampleDepth) / max(1e-4, phiDepth));

			float weight = kernel[x + 2] * kernel[y + 2] * lumaWeight * densityWeight * depthWeight;
			sumColor += sampleColor * weight;
			sumWeight += weight;
		}
	}

	imageStore(outFilteredColor, pixel, sumColor / max(sumWeight, 0.0001));
}
