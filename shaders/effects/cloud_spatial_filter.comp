#version 460 core

layout(local_size_x = 8, local_size_y = 8) in;

#include "../bindless.glsl"

layout(push_constant) uniform CloudSpatialFilterPushConstants {
	uint cloudColorIdx;
	uint cloudDepthIdx;
	uint cloudMomentsIdx;
	uint errorMapIdx;
	uint outFilteredColorIdx;
	int uStepSize;
	int uPassIndex;
	float uCloudPhiLuma;
	float uCloudPhiDensity;
	float uCloudPhiDepth;
	float uCloudSvgfHistoryBoost;
	float uCloudSvgfHistoryThreshold;
} push;

const float kernel[5] = float[](1.0/16.0, 1.0/4.0, 3.0/8.0, 1.0/4.0, 1.0/16.0);

float luma(vec3 color) {
	return dot(color, vec3(0.299, 0.587, 0.114));
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(uImagesRGBA32F[nonuniformEXT(push.outFilteredColorIdx)]);
	if (pixel.x >= size.x || pixel.y >= size.y) return;

	vec2 texelSize = 1.0 / vec2(size);
	vec2 uv = (vec2(pixel) + 0.5) * texelSize;

	float centerDepth = SAMPLE_NEAREST(push.cloudDepthIdx, uv).r;
	vec4 centerColor = SAMPLE_LINEAR(push.cloudColorIdx, uv);
	vec4 centerMoments = SAMPLE_LINEAR(push.cloudMomentsIdx, uv);

	ivec2 tileCoord = pixel / ivec2(8);
	vec4 tileErrorData = imageLoad(uImagesRGBA32F[nonuniformEXT(push.errorMapIdx)], tileCoord);
	float tileError = tileErrorData.r;

	float centerDensity = centerColor.a;
	float centerHistory = centerMoments.w;

	float varLuma = max(0.0, centerMoments.y - centerMoments.x * centerMoments.x);
	float stdLuma = sqrt(varLuma);
	float historyScale = mix(push.uCloudSvgfHistoryBoost, 1.0, smoothstep(1.0, max(2.0, push.uCloudSvgfHistoryThreshold), centerHistory));
	float errorBoost = 1.0 + tileError * 3.0;

	float phiLuma = (push.uCloudPhiLuma * stdLuma + 0.02) * historyScale * errorBoost;
	float phiDensity = (push.uCloudPhiDensity * centerDensity + 0.1) * historyScale * errorBoost;
	float phiDepth = (push.uCloudPhiDepth * centerDepth + 0.05) * historyScale * errorBoost;

	vec4  sumColor = vec4(0.0);
	float sumWeight = 0.0;

	for (int y = -2; y <= 2; y++) {
		for (int x = -2; x <= 2; x++) {
			vec2 offset = vec2(x, y) * float(push.uStepSize) * texelSize;

			vec4 sampleColor = SAMPLE_LINEAR(push.cloudColorIdx, uv + offset);
			float sampleDensity = sampleColor.a;
			float sampleDepth = SAMPLE_NEAREST(push.cloudDepthIdx, uv + offset).r;

			float lumaWeight = exp(-abs(luma(centerColor.rgb) - luma(sampleColor.rgb)) / max(1e-4, phiLuma));
			float densityWeight = exp(-abs(centerDensity - sampleDensity) / max(1e-4, phiDensity));
			float depthWeight = exp(-abs(centerDepth - sampleDepth) / max(1e-4, phiDepth));

			float weight = kernel[x + 2] * kernel[y + 2] * lumaWeight * densityWeight * depthWeight;
			sumColor += sampleColor * weight;
			sumWeight += weight;
		}
	}

	imageStore(uImagesRGBA32F[nonuniformEXT(push.outFilteredColorIdx)], pixel, sumColor / max(sumWeight, 0.0001));
}
