#version 460 core

layout(local_size_x = 8, local_size_y = 8) in;

#define ATMOSPHERE_HEIGHT_DEFINED
#include "../atmosphere/common.glsl"
#include "../helpers/clouds.glsl"

layout(push_constant) uniform CloudShadowBakePushConstants {
	uint weatherMinMaxIdx;
	uint outShadowMapIdx;
	mat4 u_invLightSpaceMatrix;
	vec3 u_primaryLightDir;
	int  u_frameIndex;
} push;

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(uImagesRGBA32F[nonuniformEXT(push.outShadowMapIdx)]);
	if (pixel.x >= size.x || pixel.y >= size.y)
		return;

	// Staggered quarter-resolution schedule (2x2 Bayer grid)
	ivec2 bayer_offsets[4] = ivec2[](
		ivec2(0, 0),
		ivec2(1, 1),
		ivec2(1, 0),
		ivec2(0, 1)
	);
	ivec2 current_offset = bayer_offsets[push.u_frameIndex % 4];
	if ((pixel.x % 2) != current_offset.x || (pixel.y % 2) != current_offset.y) {
		return; // Keep existing pixel values from prior frames
	}

	vec2 uv = (vec2(pixel) + 0.5) / vec2(size);

	vec4 clipSpace = vec4(uv * 2.0 - 1.0, -1.0, 1.0);
	vec4 worldPosNear = push.u_invLightSpaceMatrix * clipSpace;
	worldPosNear /= worldPosNear.w;

	vec3 rayStart = worldPosNear.xyz;
	vec3 rayDir = -normalize(push.u_primaryLightDir);

	float t_start = 1e10;
	float t_end = -1e10;
	intersectCloudShell(rayStart, rayDir, worldScale, t_start, t_end);

	if (t_start >= t_end) {
		imageStore(uImagesRGBA32F[nonuniformEXT(push.outShadowMapIdx)], pixel, vec4(0.0));
		return;
	}

	float accumulated = 0.0;
	float t = t_start;
	int L = 3;
	float baseStepSize = 100.0 * worldScale;

	CloudProperties props;
	props.altitude = cloudAltitude;
	props.thickness = cloudThickness;
	props.densityBase = cloudDensity;
	props.coverage = cloudCoverage;
	props.worldScale = worldScale;

	for (int i = 0; i < 512; ++i) {
		if (t >= t_end) break;

		vec3 p = rayStart + rayDir * t;
		vec3 advect = getCloudWindOffset(uTime);
		vec3 p_advected = p - advect;
		vec2 weatherUV = fract(p_advected.xz / (100000.0 * worldScale));

		vec2 minMax = SAMPLE_LINEAR(push.weatherMinMaxIdx, weatherUV).rg;
		float maxDensity = applyDynamicCoverage(minMax.y, cloudCoverage);
		float shadowPixelSize = (200000.0 * worldScale) / float(size.x);
		CloudWeather weather = computeCloudWeather(p, props, shadowPixelSize);

		float h = getCloudRelativeHeight(p, weather);

		CloudDensityResult densityRes = calculateCloudDensity(p, weather, props, uTime, shadowPixelSize, false);
		float stepDensity = max(0.0, densityRes.density.r) * baseStepSize;

		accumulated += stepDensity;
		t += baseStepSize;
	}

	imageStore(uImagesRGBA32F[nonuniformEXT(push.outShadowMapIdx)], pixel, vec4(accumulated, 0.0, 0.0, 0.0));
}
