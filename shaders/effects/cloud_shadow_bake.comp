#version 460 core

layout(local_size_x = 8, local_size_y = 8) in;

#define ATMOSPHERE_HEIGHT_DEFINED
#include "../atmosphere/common.glsl"
#include "../bindless.glsl"
#include "../helpers/clouds.glsl"

layout(push_constant) uniform CloudShadowBakePushConstants {
	uint weatherMinMaxIdx;
	uint shadowMapStorageIdx;
	uint frameIndex;
	float worldScale;
	float cloudAltitude;
	float cloudThickness;
	uint pad0;
	uint pad1;
	mat4 lightSpaceMatrix;
	mat4 invLightSpaceMatrix;
	vec3 primaryLightDir;
	uint pad2;
} push;

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec3 image_size = imageSize(uImageArrays[nonuniformEXT(push.shadowMapStorageIdx)]);
	ivec2 size = image_size.xy;
	if (pixel.x >= size.x || pixel.y >= size.y)
		return;

	// Staggered quarter-resolution schedule (2x2 Bayer grid)
	ivec2 bayer_offsets[4] = ivec2[](
		ivec2(0, 0),
		ivec2(1, 1),
		ivec2(1, 0),
		ivec2(0, 1)
	);
	ivec2 current_offset = bayer_offsets[push.frameIndex % 4];
	if ((pixel.x % 2) != current_offset.x || (pixel.y % 2) != current_offset.y) {
		return; // Keep existing pixel values from prior frames
	}

	vec2 uv = (vec2(pixel) + 0.5) / vec2(size);

	vec4 clipSpace = vec4(uv * 2.0 - 1.0, -1.0, 1.0);
	vec4 worldPosNear = push.invLightSpaceMatrix * clipSpace;
	worldPosNear /= worldPosNear.w;

	vec3 rayStart = worldPosNear.xyz;
	vec3 rayDir = -normalize(push.primaryLightDir);

	float t_start = 1e10;
	float t_end = -1e10;
	intersectCloudShell(rayStart, rayDir, push.worldScale, push.cloudAltitude, push.cloudThickness, t_start, t_end);

	if (t_start >= t_end) {
		for (int layer = 0; layer < image_size.z; ++layer) {
			imageStore(uImageArrays[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(pixel, layer), vec4(0.0));
		}
		return;
	}

	float rayLength = t_end - t_start;
	float stepSize = rayLength / float(image_size.z);

	float accumulatedDensity = 0.0;
	for (int layer = 0; layer < image_size.z; ++layer) {
		float t = t_start + (float(layer) + 0.5) * stepSize;
		vec3 p = rayStart + rayDir * t;

		vec2 weatherUV = p.xz * 0.0001;
		vec2 minMax = textureLod(sampler2D(uTextures2D[nonuniformEXT(push.weatherMinMaxIdx)], uSamplers[BRASSICA_SAMPLER_LINEAR_CLAMP]), weatherUV, 0.0).rg;
		accumulatedDensity += minMax.y * stepSize;

		imageStore(uImageArrays[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(pixel, layer), vec4(accumulatedDensity));
	}
}
