#version 460
#include "bindless.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform BloomUpsamplePushConstants {
	uint  srcIndex;      // coarser mip, sampled bilinearly
	uint  dstReadIndex;  // finer mip, sampled to read its existing (already-downsampled) content
	uint  dstWriteIndex; // finer mip, storage-image target for the accumulated result
	uint  _pad0;
	vec2  srcResolution; // resolution of the coarser mip (srcIndex)
	vec2  dstResolution; // resolution of the finer mip (dstReadIndex/dstWriteIndex)
	float filterRadius;
} push;

// Dual Kawase blur upsample with tent filter, additively accumulated onto the next-finer mip's
// own bright-pass result -- same shape as a progressive dual-Kawase bloom chain, just expressed
// as one dispatch per mip transition instead of framebuffer blending.
void main() {
	ivec2 id = ivec2(gl_GlobalInvocationID.xy);
	ivec2 dstSize = ivec2(push.dstResolution);
	if (id.x >= dstSize.x || id.y >= dstSize.y) return;

	vec2 uv = (vec2(id) + 0.5) / push.dstResolution;
	vec2 texelSize = 1.0 / push.srcResolution;
	float radius = push.filterRadius;

	// 9-tap tent filter for smooth upsampling
	vec3 result = vec3(0.0);

	// Center sample (weight 4)
	result += SAMPLE_LINEAR(push.srcIndex, uv).rgb * 4.0;

	// Diagonal samples at half-pixel offset (weight 1 each)
	result += SAMPLE_LINEAR(push.srcIndex, uv + vec2(-radius, -radius) * texelSize).rgb;
	result += SAMPLE_LINEAR(push.srcIndex, uv + vec2(radius, -radius) * texelSize).rgb;
	result += SAMPLE_LINEAR(push.srcIndex, uv + vec2(-radius, radius) * texelSize).rgb;
	result += SAMPLE_LINEAR(push.srcIndex, uv + vec2(radius, radius) * texelSize).rgb;

	// Cardinal samples at half-pixel offset (weight 2 each)
	result += SAMPLE_LINEAR(push.srcIndex, uv + vec2(0.0, -radius) * texelSize).rgb * 2.0;
	result += SAMPLE_LINEAR(push.srcIndex, uv + vec2(0.0, radius) * texelSize).rgb * 2.0;
	result += SAMPLE_LINEAR(push.srcIndex, uv + vec2(-radius, 0.0) * texelSize).rgb * 2.0;
	result += SAMPLE_LINEAR(push.srcIndex, uv + vec2(radius, 0.0) * texelSize).rgb * 2.0;

	vec3 upsampled = result / 16.0;
	vec3 existing = SAMPLE_NEAREST(push.dstReadIndex, uv).rgb;

	imageStore(uImagesGenericWrite[nonuniformEXT(push.dstWriteIndex)], id, vec4(upsampled + existing, 1.0));
}
