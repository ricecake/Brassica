#version 460 core

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba16f) uniform image2D outWeatherMap;
layout(binding = 1, rg16f) uniform image2D outMinMaxMap;

#include "../bindless.glsl"
#include "../common.glsl"

layout(push_constant) uniform CloudWeatherBakePushConstants {
	float uWorldScale;
	float uCloudCoverage;
	float uCloudThickness;
	float uTime;
} push;

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(outWeatherMap);
	if (pixel.x >= size.x || pixel.y >= size.y) return;

	vec2 uv = (vec2(pixel) + 0.5) / vec2(size);

	float period1 = 16.0;
	float period2 = 8.0;
	float period4 = 2.0;

	float macro = dot_noise_fbm(vec3(uv * period2, 0.0), 4.0, 0.0);
	float worley = length(cross_noise_fbm(vec3(uv * period1, 0.0), 4.0, 0.0));

	float finalCoverage = remapClamp(macro, worley, 1.0, 0.0, 1.0);
	finalCoverage = smaxCubic(finalCoverage, worley, 0.1);

	float typeValue = dot_noise_fbm(vec3((uv + 0.25 * macro) * period4, 0.0), 2.0, 0.0);
	float ridgeChannel = length(cross_noise_fbm(vec3(uv * period2 + vec2(0.5), 0.0), 3.0, 0.0));
	float moistureMap = clamp(dot_noise_fbm(vec3(uv * period1 + vec2(0.13, 0.37), 0.0), 4.0, 0.0), 0.0, 1.0);

	imageStore(outWeatherMap, pixel, vec4(finalCoverage, typeValue, ridgeChannel, moistureMap));
	imageStore(outMinMaxMap, pixel, vec4(finalCoverage, finalCoverage, moistureMap, 1.0));
}
