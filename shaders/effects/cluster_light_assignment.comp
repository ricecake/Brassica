#version 460 core
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 16, local_size_y = 9, local_size_z = 1) in;

#define CLUSTER_GRID_WRITABLE
#include "../bindless.glsl"
#include "../lighting.glsl"

layout(push_constant) uniform ClusterLightAssignmentPushConstants {
	uint cpuLightsIndex;
	uint gpuLightsIndex;
} push;

void main() {
	uvec3 clusterID = gl_GlobalInvocationID;
	if (clusterID.x >= 16 || clusterID.y >= 9 || clusterID.z >= 24) {
		return;
	}

	float z_near = uNearPlane;
	float z_far = uFarPlane;

	// Slices in view space (negative Z)
	float zNearSlice = -z_near * pow(z_far / z_near, float(clusterID.z) / 24.0);
	float zFarSlice = -z_near * pow(z_far / z_near, float(clusterID.z + 1) / 24.0);

	// Compute X/Y tile bounds in projection/view space factors
	float x_min_factor = (2.0 * float(clusterID.x) / 16.0) - 1.0;
	float x_max_factor = (2.0 * float(clusterID.x + 1) / 16.0) - 1.0;
	float y_min_factor = (2.0 * float(clusterID.y) / 9.0) - 1.0;
	float y_max_factor = (2.0 * float(clusterID.y + 1) / 9.0) - 1.0;

	// Map factors to view-space limits using the projection matrix
	float tan_half_fov_x = 1.0 / uProjMatrix[0][0];
	float tan_half_fov_y = 1.0 / uProjMatrix[1][1];

	// Evaluate tile boundaries at near and far planes of this Z slice
	float x_min_near = x_min_factor * tan_half_fov_x * (-zNearSlice);
	float x_max_near = x_max_factor * tan_half_fov_x * (-zNearSlice);
	float y_min_near = y_min_factor * tan_half_fov_y * (-zNearSlice);
	float y_max_near = y_max_factor * tan_half_fov_y * (-zNearSlice);

	float x_min_far = x_min_factor * tan_half_fov_x * (-zFarSlice);
	float x_max_far = x_max_factor * tan_half_fov_x * (-zFarSlice);
	float y_min_far = y_min_factor * tan_half_fov_y * (-zFarSlice);
	float y_max_far = y_max_factor * tan_half_fov_y * (-zFarSlice);

	float exposureScale = 1.0;

	const float GLOBAL_LIGHT_RADIUS_THRESHOLD = 500.0;

	uint cpuCount = uCpuLightsBuffers[nonuniformEXT(push.cpuLightsIndex)].count;
	uint gpuCount = uGpuLightsBuffers[nonuniformEXT(push.gpuLightsIndex)].count;

	// Populate global lights bucket at uClusters[3456] -- CPU and GPU lights each get their own
	// small/large list (ClusterGPU's cpuLightIndices/cpuCount vs. lightIndices/count), rather
	// than one shared list with a buffer-tag bit on each index: CPU lights beyond sun/moon
	// (indices 0/1, handled by clustered_lighting.glsl's own directional fast path, never
	// entering this loop) are rare, so a small separate list avoids a bit-tagging dereference
	// scattered across every consumer for a size difference this lopsided.
	if (clusterID == uvec3(0, 0, 0)) {
		uint globalCpuCount = 0;
		uint totalCpuLights = min(cpuCount, 1024u);
		for (uint i = 2; i < totalCpuLights; ++i) {
			Light light = uCpuLightsBuffers[nonuniformEXT(push.cpuLightsIndex)].lights[i];
			if (light.intensity <= 0.0) continue;

			float radius = 0.0;
			if (light.type == LIGHT_TYPE_POINT) {
				radius = light.outerCutoff > 0.0 ? light.outerCutoff * exposureScale
				                                 : sqrt(max(0.1, light.intensity)) * 100.0 * exposureScale;
			} else if (light.type == LIGHT_TYPE_SPOT || light.type == LIGHT_TYPE_EMISSIVE) {
				radius = sqrt(max(0.1, light.intensity)) * 100.0;
				if (light.type == LIGHT_TYPE_EMISSIVE) radius += light.innerCutoff;
				radius *= exposureScale;
			} else if (light.type == LIGHT_TYPE_FLASH) {
				radius = 2.0 * light.innerCutoff * exposureScale;
			} else {
				continue;
			}

			if (radius >= GLOBAL_LIGHT_RADIUS_THRESHOLD && globalCpuCount < 8) {
				uClusters[3456].cpuLightIndices[globalCpuCount] = i;
				globalCpuCount++;
			}
		}
		uClusters[3456].cpuCount = globalCpuCount;

		uint globalGpuCount = 0;
		uint totalGpuLights = min(gpuCount, 1024u);
		for (uint i = 0; i < totalGpuLights; ++i) {
			Light light = uGpuLightsBuffers[nonuniformEXT(push.gpuLightsIndex)].lights[i];
			if (light.intensity <= 0.0) continue;

			float radius = 0.0;
			if (light.type == LIGHT_TYPE_POINT) {
				radius = light.outerCutoff > 0.0 ? light.outerCutoff * exposureScale
				                                 : sqrt(max(0.1, light.intensity)) * 100.0 * exposureScale;
			} else if (light.type == LIGHT_TYPE_SPOT || light.type == LIGHT_TYPE_EMISSIVE) {
				radius = sqrt(max(0.1, light.intensity)) * 100.0;
				if (light.type == LIGHT_TYPE_EMISSIVE) radius += light.innerCutoff;
				radius *= exposureScale;
			} else if (light.type == LIGHT_TYPE_FLASH) {
				radius = 2.0 * light.innerCutoff * exposureScale;
			} else {
				continue;
			}

			if (radius >= GLOBAL_LIGHT_RADIUS_THRESHOLD && globalGpuCount < 64) {
				uClusters[3456].lightIndices[globalGpuCount] = i;
				globalGpuCount++;
			}
		}
		uClusters[3456].count = globalGpuCount;
	}

	groupMemoryBarrier();
	barrier();

	// Determine Axis-Aligned Bounding Box (AABB) in view space
	vec3 aabbMin = vec3(
		min(min(x_min_near, x_max_near), min(x_min_far, x_max_far)),
		min(min(y_min_near, y_max_near), min(y_min_far, y_max_far)),
		min(zNearSlice, zFarSlice)
	);
	vec3 aabbMax = vec3(
		max(max(x_min_near, x_max_near), max(x_min_far, x_max_far)),
		max(max(y_min_near, y_max_near), max(y_min_far, y_max_far)),
		max(zNearSlice, zFarSlice)
	);

	uint cluster_index = clusterID.x + clusterID.y * 16 + clusterID.z * 16 * 9;

	// CPU local lights (rare beyond sun/moon, indices 0/1 skipped -- same reasoning as the
	// global bucket above).
	uint localCpuCount = 0;
	uint localCpuIndices[8];
	uint totalCpuLights = min(cpuCount, 1024u);
	for (uint i = 2; i < totalCpuLights; ++i) {
		Light light = uCpuLightsBuffers[nonuniformEXT(push.cpuLightsIndex)].lights[i];
		if (light.intensity <= 0.0) continue;

		vec3 light_pos = light.position;
		if ((light.flags & LIGHT_FLAG_CAMERA_RELATIVE) != 0) {
			light_pos += uCameraPosition.xyz;
		}
		vec4 light_view_pos = uViewMatrix * vec4(light_pos, 1.0);

		float radius = 0.0;
		if (light.type == LIGHT_TYPE_POINT) {
			radius = light.outerCutoff > 0.0 ? light.outerCutoff * exposureScale
			                                 : sqrt(max(0.1, light.intensity)) * 100.0 * exposureScale;
		} else if (light.type == LIGHT_TYPE_SPOT || light.type == LIGHT_TYPE_EMISSIVE) {
			radius = sqrt(max(0.1, light.intensity)) * 100.0;
			if (light.type == LIGHT_TYPE_EMISSIVE) radius += light.innerCutoff;
			radius *= exposureScale;
		} else if (light.type == LIGHT_TYPE_FLASH) {
			radius = 2.0 * light.innerCutoff * exposureScale;
		} else {
			continue;
		}

		if (radius >= GLOBAL_LIGHT_RADIUS_THRESHOLD) continue;

		float dist_sq = 0.0;
		for (int d = 0; d < 3; ++d) {
			float v = light_view_pos[d];
			if (v < aabbMin[d]) {
				dist_sq += (aabbMin[d] - v) * (aabbMin[d] - v);
			} else if (v > aabbMax[d]) {
				dist_sq += (v - aabbMax[d]) * (v - aabbMax[d]);
			}
		}

		if (dist_sq <= radius * radius && localCpuCount < 8) {
			localCpuIndices[localCpuCount] = i;
			localCpuCount++;
		}
	}
	uClusters[cluster_index].cpuCount = localCpuCount;
	for (uint i = 0; i < localCpuCount; ++i) {
		uClusters[cluster_index].cpuLightIndices[i] = localCpuIndices[i];
	}

	// GPU local lights (fireflies/lightning) -- same AABB test, same 64-slot cap as before.
	uint local_count = 0;
	uint local_light_indices[64];
	uint totalGpuLights = min(gpuCount, 1024u);
	for (uint i = 0; i < totalGpuLights; ++i) {
		Light light = uGpuLightsBuffers[nonuniformEXT(push.gpuLightsIndex)].lights[i];
		if (light.intensity <= 0.0) continue;

		vec3 light_pos = light.position;
		if ((light.flags & LIGHT_FLAG_CAMERA_RELATIVE) != 0) {
			light_pos += uCameraPosition.xyz;
		}
		vec4 light_view_pos = uViewMatrix * vec4(light_pos, 1.0);

		float radius = 0.0;
		if (light.type == LIGHT_TYPE_POINT) {
			radius = light.outerCutoff > 0.0 ? light.outerCutoff * exposureScale
			                                 : sqrt(max(0.1, light.intensity)) * 100.0 * exposureScale;
		} else if (light.type == LIGHT_TYPE_SPOT || light.type == LIGHT_TYPE_EMISSIVE) {
			radius = sqrt(max(0.1, light.intensity)) * 100.0;
			if (light.type == LIGHT_TYPE_EMISSIVE) radius += light.innerCutoff;
			radius *= exposureScale;
		} else if (light.type == LIGHT_TYPE_FLASH) {
			radius = 2.0 * light.innerCutoff * exposureScale;
		} else {
			continue;
		}

		if (radius >= GLOBAL_LIGHT_RADIUS_THRESHOLD) continue;

		float dist_sq = 0.0;
		for (int d = 0; d < 3; ++d) {
			float v = light_view_pos[d];
			if (v < aabbMin[d]) {
				dist_sq += (aabbMin[d] - v) * (aabbMin[d] - v);
			} else if (v > aabbMax[d]) {
				dist_sq += (v - aabbMax[d]) * (v - aabbMax[d]);
			}
		}

		if (dist_sq <= radius * radius && local_count < 64) {
			local_light_indices[local_count] = i;
			local_count++;
		}
	}
	uClusters[cluster_index].count = local_count;
	for (uint i = 0; i < local_count; ++i) {
		uClusters[cluster_index].lightIndices[i] = local_light_indices[i];
	}
}
