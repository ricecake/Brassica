#version 450
#extension GL_EXT_nonuniform_qualifier : require

#include "bindless.glsl"

// F4: real rewrite matching boidish's cloud_spatial_filter.comp -- a genuine a-trous
// edge-stopping wavelet filter (SVGF's spatial half) with 4 edge-stopping terms (luma, path
// density, depth, time) instead of the earlier 2-term (luma, depth) version, a per-tile
// errorBoost that widens every phi when CloudTileErrorMap flags a tile as noisy, and a
// timeWeight that kills blending across a fresh/stale tile boundary -- exactly the artifact
// Stage D's tile-skipping would otherwise risk at tile seams. Dispatched twice
// (CloudSpatialFilterNode, step sizes 1 then 2 -- simplified from boidish's 2-4 pass
// progression, unchanged from the earlier version of this stage) by the same shader.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform CloudSpatialFilterPushConstants {
	uint colorIndex;
	uint transmittanceIndex;
	uint momentsIndex;
	uint depthIndex; // CloudAccumulatedDepth -- r=dist, a=pathDensity
	uint errorMapBufferIdx;
	uint outColorStorageIdx;
	uint outTransmittanceStorageIdx;
	uint stepSize;
	uint passIndex; // 0 or 1 -- only pass 0 applies the low-confidence spatial-variance fallback
	uint tileCols;
	uint outputWidth;
	uint outputHeight;
} push;

layout(std430, set = 1, binding = 6) readonly buffer CloudTileErrorMapBuffer {
	vec4 tiles[]; // x = error, y = flow, z = step multiplier, w = last-raymarched frame index
}
uErrorMaps[];

float luminance(vec3 c) {
	return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

uint tileIdxOf(ivec2 pixel) {
	uvec2 tc = uvec2(pixel) / 8u;
	return tc.y * push.tileCols + tc.x;
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if (pixel.x >= int(push.outputWidth) || pixel.y >= int(push.outputHeight)) {
		return;
	}
	vec2 pixelSize = vec2(1.0) / vec2(push.outputWidth, push.outputHeight);
	vec2 centerUV = (vec2(pixel) + 0.5) * pixelSize;

	vec3  centerColor = SAMPLE_NEAREST(push.colorIndex, centerUV).rgb;
	vec3  centerTransmittance = SAMPLE_NEAREST(push.transmittanceIndex, centerUV).rgb;
	vec4  centerMoments = SAMPLE_NEAREST(push.momentsIndex, centerUV);
	vec4  centerDepthProps = SAMPLE_NEAREST(push.depthIndex, centerUV);
	float centerDepth = centerDepthProps.r;
	float centerDensity = centerDepthProps.a;
	float centerLuma = luminance(centerColor);
	float centerHistory = centerMoments.w; // CloudMoments: x=lumaMean, y=lumaSqMean, z=density^2Mean, w=historyLength

	float tileError = uErrorMaps[push.errorMapBufferIdx].tiles[tileIdxOf(pixel)].x;
	float centerTimestamp = uErrorMaps[push.errorMapBufferIdx].tiles[tileIdxOf(pixel)].w;

	float varLuma = max(0.0, centerMoments.y - centerMoments.x * centerMoments.x);

	// Low-confidence fallback: short history -> estimate variance from a 3x3 spatial
	// neighborhood of luma instead of trusting barely-accumulated temporal moments. Only on
	// pass 0, matching boidish exactly (pass 1's larger step size works from pass 0's already-
	// filtered result, which no longer needs this correction).
	const float kSvgfHistoryThreshold = 10.0; // boidish's cloud_svgf_history_threshold_ default
	if (push.passIndex == 0u && centerHistory < kSvgfHistoryThreshold) {
		float sum = 0.0;
		float sumSq = 0.0;
		for (int dy = -1; dy <= 1; dy++) {
			for (int dx = -1; dx <= 1; dx++) {
				ivec2 samplePixel = clamp(pixel + ivec2(dx, dy), ivec2(0), ivec2(push.outputWidth, push.outputHeight) - 1);
				vec2  sampleUV = (vec2(samplePixel) + 0.5) * pixelSize;
				float l = luminance(SAMPLE_NEAREST(push.colorIndex, sampleUV).rgb);
				sum += l;
				sumSq += l * l;
			}
		}
		float mean = sum / 9.0;
		float spatialVar = max(0.0, (sumSq / 9.0) - mean * mean);
		varLuma = mix(spatialVar, varLuma, smoothstep(0.0, kSvgfHistoryThreshold, centerHistory));
	}

	float stdLuma = sqrt(varLuma);
	// boidish's cloud_svgf_history_boost_ default -- widens the filter early on (low
	// historyLength), narrowing back to 1x once enough real temporal samples have accumulated.
	const float kSvgfHistoryBoost = 4.0;
	float historyScale = mix(kSvgfHistoryBoost, 1.0, smoothstep(1.0, kSvgfHistoryThreshold, centerHistory));
	float errorBoost = 1.0 + tileError * 3.0;

	// boidish's AtmosphereEffect.h defaults (cloud_phi_luma_/cloud_phi_density_/cloud_phi_depth_).
	float phiLuma = (20.0 * stdLuma + 0.02) * historyScale * errorBoost;
	float phiDensity = (0.05 * centerDensity + 0.1) * historyScale * errorBoost;
	float phiDepth = (1.5 * centerDepth + 0.05) * historyScale * errorBoost;
	const float phiTime = 1.0;

	const float kWeights1D[5] = float[5](0.0625, 0.25, 0.375, 0.25, 0.0625);

	vec3  colorSum = vec3(0.0);
	vec3  transmittanceSum = vec3(0.0);
	float weightSum = 0.0;

	for (int dy = -2; dy <= 2; dy++) {
		for (int dx = -2; dx <= 2; dx++) {
			ivec2 offset = ivec2(dx, dy) * int(push.stepSize);
			ivec2 samplePixel = clamp(pixel + offset, ivec2(0), ivec2(push.outputWidth, push.outputHeight) - 1);
			vec2  sampleUV = (vec2(samplePixel) + 0.5) * pixelSize;

			vec3  sampleColor = SAMPLE_NEAREST(push.colorIndex, sampleUV).rgb;
			vec3  sampleTransmittance = SAMPLE_NEAREST(push.transmittanceIndex, sampleUV).rgb;
			vec4  sampleDepthProps = SAMPLE_NEAREST(push.depthIndex, sampleUV);
			float sampleLuma = luminance(sampleColor);
			float sampleTimestamp = uErrorMaps[push.errorMapBufferIdx].tiles[tileIdxOf(samplePixel)].w;
			float timeDelta = abs(centerTimestamp - sampleTimestamp);

			float kernelWeight = kWeights1D[dx + 2] * kWeights1D[dy + 2];
			float lumaWeight = exp(-abs(sampleLuma - centerLuma) / phiLuma);
			float densityWeight = exp(-abs(sampleDepthProps.a - centerDensity) / phiDensity);
			float depthWeight = exp(-abs(sampleDepthProps.r - centerDepth) / phiDepth);
			float timeWeight = exp(-timeDelta / phiTime);

			float w = kernelWeight * lumaWeight * densityWeight * depthWeight * timeWeight;

			colorSum += sampleColor * w;
			transmittanceSum += sampleTransmittance * w;
			weightSum += w;
		}
	}

	vec3 filteredColor = weightSum > 0.0001 ? (colorSum / weightSum) : centerColor;
	vec3 filteredTransmittance = weightSum > 0.0001 ? (transmittanceSum / weightSum) : centerTransmittance;

	imageStore(uImagesGenericWrite[nonuniformEXT(push.outColorStorageIdx)], pixel, vec4(filteredColor, 0.0));
	imageStore(
		uImagesGenericWrite[nonuniformEXT(push.outTransmittanceStorageIdx)], pixel, vec4(filteredTransmittance, 0.0)
	);
}
