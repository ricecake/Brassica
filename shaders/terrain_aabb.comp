#version 460
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_scalar_block_layout : require

#include "bindless.glsl"
#include "common.glsl"
#include "terrain.glsl"

struct VkAabbPositionsKHR {
	float minX;
	float minY;
	float minZ;
	float maxX;
	float maxY;
	float maxZ;
};

layout(buffer_reference, scalar) buffer AABBBuffer {
	uint               count;
	uint               padding;
	VkAabbPositionsKHR aabbs[];
};

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
	uvec2 aabbBufferAddr;
	uint  clipmapIndex; // Replaces padding.xyz
	uint  minMaxIndex;
	uvec4 gridParams;   // x = numLODs, y = meshletsPerRow (16), z = totalMeshlets, w = textureDim (1088)
} push;

void main() {
	uint gId = gl_GlobalInvocationID.x;
	uint numLODs = push.gridParams.x;
	uint meshletsPerRow = push.gridParams.y;
	uint totalMeshlets = push.gridParams.z;

	if (gId >= totalMeshlets) {
		return;
	}

	uint lod = gId / (meshletsPerRow * meshletsPerRow);
	uint rem = gId % (meshletsPerRow * meshletsPerRow);
	uint row = rem / meshletsPerRow;
	uint col = rem % meshletsPerRow;

	float baseMeshletSize = 32.0;
	float meshletSize = baseMeshletSize * getLODScale(float(lod));
	vec2  cameraSnap = floor(uCameraPosition.xz / meshletSize) * meshletSize;

	vec3 minB = vec3(
		cameraSnap.x + (float(col) - float(meshletsPerRow) * 0.5) * meshletSize,
		0.0,
		cameraSnap.y + (float(row) - float(meshletsPerRow) * 0.5) * meshletSize
	);
	vec3 maxB = minB + vec3(meshletSize, 0.0, meshletSize);

	bool activeMeshlet = true;
	if (lod > 0u) {
		float prevMeshletSize = baseMeshletSize * getLODScale(float(lod - 1u));
		float safeInnerRadius = (float(meshletsPerRow) * 0.5 - 1.0) * prevMeshletSize;
		vec2  maxOffset = max(abs(minB.xz - uCameraPosition.xz), abs(maxB.xz - uCameraPosition.xz));
		float maxDistToCam = length(maxOffset);
		if (maxDistToCam < safeInnerRadius) {
			activeMeshlet = false;
		}
	}

	if (activeMeshlet) {
		float minH = 1e9;
		float maxH = -1e9;

		// 5x5 grid perfectly covers the footprint. Each fetch evaluates
		// the subgroup bounds of a 4x4 texel cluster.
		for (int sz = 0; sz <= 4; ++sz) {
			float tz = float(sz) / 4.0;
			float sampleZ = minB.z + tz * meshletSize;

			for (int sx = 0; sx <= 4; ++sx) {
				float tx = float(sx) / 4.0;
				float sampleX = minB.x + tx * meshletSize;

				vec2 worldXZ = vec2(sampleX, sampleZ);

				// Assuming sampleTerrainClipmap accepts the generic bindless index.
				// .r is cluster_min, .g is cluster_max from terrain_gen.comp.
				vec4 minMaxData = sampleTerrainClipmap(
					push.minMaxIndex,
					worldXZ,
					lod,
					push.gridParams.w
				);

				float clusterMin = minMaxData.r;
				float clusterMax = minMaxData.g;

				// Calculate precise spherical dropoff for this specific coordinate
				vec2  flatXZ = worldXZ - uCameraPosition.xz;
				float dropOff = dot(flatXZ, flatXZ) / (2.0 * FAKE_PLANET_RADIUS);

				minH = min(minH, clusterMin - dropOff);
				maxH = max(maxH, clusterMax - dropOff);
			}
		}

		// Retain ±20 padding to safely enclose vertices during LOD boundary morphing
		// and to account for any drop-off curvature existing within a 4x4 texel cluster.
		minB.y = minH - 20.0;
		maxB.y = maxH + 20.0;

		if (lod <= 1u) {
			minB.y = min(minB.y, -500.0);
			maxB.y = max(maxB.y, 2500.0);
		}
	} else {
		minB = vec3(cameraSnap.x, 0.0, cameraSnap.y);
		maxB = minB;
	}

	AABBBuffer outAABBs = AABBBuffer(push.aabbBufferAddr);
	outAABBs.aabbs[gId] = VkAabbPositionsKHR(minB.x, minB.y, minB.z, maxB.x, maxB.y, maxB.z);
}