#version 460
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_scalar_block_layout : require

#include "bindless.glsl"
#include "common.glsl"
#include "terrain.glsl"

struct VkAabbPositionsKHR {
	float minX;
	float minY;
	float minZ;
	float maxX;
	float maxY;
	float maxZ;
};

layout(buffer_reference, scalar) buffer AABBBuffer {
	uint               count;
	uint               padding;
	VkAabbPositionsKHR aabbs[];
};

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
	uvec2 aabbBufferAddr;
	uvec2 padding;
	uvec4 gridParams; // x = numLODs, y = meshletsPerRow (16), z = totalMeshlets, w = textureDim (1088)
	uvec4 lodOffsets0_3;
	uvec4 lodOffsets4_7;
	uvec4 lodOffsets8_11;
} push;

float aabb_fbm(vec2 p, int octaves) {
	float val = 0.0;
	float amp = 0.5;
	float freq = 1.0;
	for (int i = 0; i < octaves; ++i) {
		val += amp * dot_noise(vec3(p.x * freq, 0.0, p.y * freq));
		freq *= 2.0;
		amp *= 0.5;
	}
	return val;
}

float evalHeightFromComponents(float baseVal, float detailVal, float maskVal, float biomeVal) {
	float biome = clamp(biomeVal, 0.0, 1.0);
	float mountainFactor = clamp((maskVal - (-0.1)) / 0.4, 0.0, 1.0);
	mountainFactor = mountainFactor * mountainFactor * (3.0 - 2.0 * mountainFactor);
	float detailFactor = (0.15 + 0.85 * mountainFactor) * mix(0.3, 1.2, biome);

	float baseOffset = mix(-35.0, 30.0, biome);
	float baseHeightScale = mix(40.0, 120.0, biome);
	float detailHeightScale = mix(20.0, 80.0, biome);

	return baseOffset + baseVal * baseHeightScale + detailVal * detailHeightScale * detailFactor;
}

float evalTerrainHeight(vec2 worldXZ, out float outBiome, out float outMask) {
	outBiome = dot_noise(vec3(worldXZ.x * 0.0003, 0.0, worldXZ.y * 0.0003)) * 0.5 + 0.5;
	outMask = dot_noise(vec3(worldXZ.x * 0.0008, 0.0, worldXZ.y * 0.0008));
	float baseVal = aabb_fbm(worldXZ * 0.0015, 4);
	float detailVal = aabb_fbm(worldXZ * 0.006, 4);

	return evalHeightFromComponents(baseVal, detailVal, outMask, outBiome);
}

void main() {
	uint gId = gl_GlobalInvocationID.x;
	uint numLODs = push.gridParams.x;
	uint meshletsPerRow = push.gridParams.y;
	uint totalMeshlets = push.gridParams.z;

	if (gId >= totalMeshlets) {
		return;
	}

	uint lod = gId / (meshletsPerRow * meshletsPerRow);
	uint rem = gId % (meshletsPerRow * meshletsPerRow);
	uint row = rem / meshletsPerRow;
	uint col = rem % meshletsPerRow;

	float baseMeshletSize = 32.0;
	float meshletSize = baseMeshletSize * getLODScale(float(lod));
	vec2  cameraSnap = floor(uCameraPosition.xz / meshletSize) * meshletSize;

	vec3 minB = vec3(
		cameraSnap.x + (float(col) - float(meshletsPerRow) * 0.5) * meshletSize,
		0.0,
		cameraSnap.y + (float(row) - float(meshletsPerRow) * 0.5) * meshletSize
	);
	vec3 maxB = minB + vec3(meshletSize, 0.0, meshletSize);

	bool activeMeshlet = true;
	if (lod > 0u) {
		float prevMeshletSize = baseMeshletSize * getLODScale(float(lod - 1u));
		float safeInnerRadius = (float(meshletsPerRow) * 0.5 - 1.0) * prevMeshletSize;
		vec2  maxOffset = max(abs(minB.xz - uCameraPosition.xz), abs(maxB.xz - uCameraPosition.xz));
		float maxDistToCam = length(maxOffset);
		if (maxDistToCam < safeInnerRadius) {
			activeMeshlet = false;
		}
	}

	if (activeMeshlet) {
		float minH = 1e9;
		float maxH = -1e9;
		for (int sz = 0; sz < 5; ++sz) {
			float tz = float(sz) / 4.0;
			float sampleZ = minB.z + tz * meshletSize;
			for (int sx = 0; sx < 5; ++sx) {
				float tx = float(sx) / 4.0;
				float sampleX = minB.x + tx * meshletSize;
				float dummyB, dummyM;
				vec2  flatXZ = vec2(sampleX, sampleZ) - uCameraPosition.xz;
				float dropOff = dot(flatXZ, flatXZ) / (2.0 * FAKE_PLANET_RADIUS);
				float h = evalTerrainHeight(vec2(sampleX, sampleZ), dummyB, dummyM) - dropOff;
				minH = min(minH, h);
				maxH = max(maxH, h);
			}
		}
		minB.y = minH - 5.0;
		maxB.y = maxH + 5.0;
	} else {
		minB = vec3(cameraSnap.x, 0.0, cameraSnap.y);
		maxB = minB;
	}

	AABBBuffer outAABBs = AABBBuffer(push.aabbBufferAddr);
	outAABBs.aabbs[gId] = VkAabbPositionsKHR(minB.x, minB.y, minB.z, maxB.x, maxB.y, maxB.z);
}
