#version 450
#extension GL_EXT_nonuniform_qualifier : require

#include "bindless.glsl"
#include "common.glsl"
#include "lighting.glsl"
#include "helpers/lighting.glsl"
#include "helpers/cloud_shadow.glsl"
#include "terrain.glsl"
#include "atmosphere/common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform VolumetricFroxelGenPushConstants {
	vec4  cameraPos;   // xyz = camera position, w = time
	vec4  camForward;  // xyz = camera forward vector, w = tanHalfFov
	vec4  camUp;       // xyz = camera up vector, w = aspect
	vec4  sunDir;      // xyz = sun direction, w = sun intensity
	vec4  sunColor;    // rgb = sun color/radiance, w = phase anisotropy g
	vec4  fogParams;   // x = fog density, y = fog height falloff, z = fog base height, w = gridTextureDim
	uvec4 indices0;    // x = scat0|scat1, y = scat2|ext0, z = ext1|ext2, w = noise|skyView
	// x = clipmap|minMax, y = cloudShadow|weatherBiome, z = shadowMap|unused, w = bit-cast float
	// mieHumidityBoost (uintBitsToFloat) -- repurposing a confirmed-always-0, never-read uint
	// slot instead of growing this struct past 128 bytes.
	uvec4 indices1;
} push;

uint unpackLow16(uint val) {
	return val & 0xFFFFu;
}

uint unpackHigh16(uint val) {
	return (val >> 16u) & 0xFFFFu;
}

float dualHenyeyGreenstein(float cosTheta, float g) {
	float g1 = g;
	float g2 = -0.3;
	float alpha = 0.7;

	float hg1 = (1.0 - g1 * g1) / (4.0 * PI * max(0.0001, pow(1.0 + g1 * g1 - 2.0 * g1 * cosTheta, 1.5)));
	float hg2 = (1.0 - g2 * g2) / (4.0 * PI * max(0.0001, pow(1.0 + g2 * g2 - 2.0 * g2 * cosTheta, 1.5)));

	return mix(hg2, hg1, alpha);
}

// Maps normalized slice coordinate [0..1] to ray distance exponentially
float froxelNormToDist(float zNorm, float maxDist, float alpha) {
	return maxDist * (exp(alpha * zNorm) - 1.0) / (exp(alpha) - 1.0);
}

float calculateVolumetricTerrainShadow(vec3 worldPos, vec3 lightDir, uint shadowMapIndex, uint gridDim) {
	if (shadowMapIndex == 0xFFFFu || shadowMapIndex == 0u) return 1.0;

	float softVal = evaluateTerrainShadowFromMap(shadowMapIndex, worldPos, lightDir, gridDim);
	return mix(0.15, 1.0, softVal);
}

void main() {
	uvec2 xy = gl_GlobalInvocationID.xy;
	if (xy.x >= 128 || xy.y >= 96) return;

	uint scat0 = unpackLow16(push.indices0.x);
	uint scat1 = unpackHigh16(push.indices0.x);
	uint scat2 = unpackLow16(push.indices0.y);
	uint ext0  = unpackHigh16(push.indices0.y);
	uint ext1  = unpackLow16(push.indices0.z);
	uint ext2  = unpackHigh16(push.indices0.z);
	uint noiseTextureIdx = unpackLow16(push.indices0.w);
	uint skyViewIndex    = unpackHigh16(push.indices0.w);
	uint clipmapIndex      = unpackLow16(push.indices1.x);
	uint minMaxIndex       = unpackHigh16(push.indices1.x);
	uint cloudShadowIndex  = unpackLow16(push.indices1.y);
	uint weatherBiomeIndex = unpackHigh16(push.indices1.y);
	uint shadowMapIndex    = unpackLow16(push.indices1.z);
	float mieHumidityBoost = uintBitsToFloat(push.indices1.w);

	uint cascadeScatteringIdx[3] = uint[3](scat0, scat1, scat2);
	uint cascadeExtinctionIdx[3] = uint[3](ext0, ext1, ext2);

	vec3 camRight = normalize(cross(push.camForward.xyz, push.camUp.xyz));

	float ndcX = (((float(xy.x) + 0.5) / 128.0) * 2.0 - 1.0);
	float ndcY = 1.0 - (((float(xy.y) + 0.5) / 96.0) * 2.0);

	float tanHalfFov = push.camForward.w;
	float aspect = push.camUp.w;

	vec3 viewRayDir = normalize(
		ndcX * aspect * tanHalfFov * camRight +
		ndcY * tanHalfFov * push.camUp.xyz +
		push.camForward.xyz
	);

	float cascadeRanges[3] = float[3](300.0, 3000.0, 100000.0);
	const float kExpAlpha = 3.5;

	for (int c = 0; c < 3; ++c) {
		uint scatIdx = cascadeScatteringIdx[c];
		uint extIdx = cascadeExtinctionIdx[c];
		if (scatIdx == 0xFFFFu || extIdx == 0xFFFFu) continue;

		float maxDist = cascadeRanges[c];

		vec3 accumulatedScattering = vec3(0.0);
		vec3 accumulatedTransmittance = vec3(1.0);
		bool hasOccluded = false;

		// float jitter = InterleavedGradientNoise(vec2(xy), int(uFrameIndex));

		// float jitter = mortonOwenThreshold(ivec2(floatBitsToInt(xy.x), floatBitsToInt(xy.y)), int(uFrameIndex));
		for (int z = 0; z < 64; ++z) {
			ivec3 vox = ivec3(xy.x, xy.y, z);

			float zNearNorm = float(z) / 64.0;
			float zFarNorm = float(z + 1) / 64.0;
			float zCenterNorm = (float(z) + 0.5) / 64.0;

			float distNear = froxelNormToDist(zNearNorm, maxDist, kExpAlpha);
			float distFar = froxelNormToDist(zFarNorm, maxDist, kExpAlpha);
			float dist = froxelNormToDist(zCenterNorm, maxDist, kExpAlpha);
			float voxelSizeZ = max(0.001, distFar - distNear);

			vec3 worldPos = push.cameraPos.xyz + viewRayDir * dist;

			// Sample weather map at worldPos XZ
			float worldExtent = 2.0 * FAKE_PLANET_RADIUS * PI;
			vec2 weatherUV = fract((worldPos.xz / worldExtent) + 0.5);
			vec4 weatherSample = vec4(0.0);
			if (weatherBiomeIndex > 0u && weatherBiomeIndex != 0xFFFFu) {
				weatherSample = SAMPLE_LINEAR(weatherBiomeIndex, weatherUV);
			}
			float weatherCoverage  = weatherSample.r; // Cloud coverage [0..1]
			float weatherType      = weatherSample.g; // Weather type [0..1]
			float weatherMoisture  = weatherSample.b; // Moisture content [0..1]

			// Determine rain intensity factor (high moisture + cloud coverage)
			float rainFactor = smoothstep(0.35, 0.8, weatherMoisture) * smoothstep(0.2, 0.6, weatherCoverage);

			// Weather-dependent fog adjustments
			float fogBase = push.fogParams.z;
			float fogFalloff = push.fogParams.y * mix(1.0, 0.8, clamp(weatherMoisture * 0.6 + weatherCoverage * 0.4, rainFactor, 1.0));
			float baseDensity =  push.fogParams.x * (0.25 + 0.125 * weatherMoisture + 0.8 * weatherCoverage);

			// Rain increases fog density
			float densityMult = mix(1.0, 2.5, rainFactor);

			float heightDiff = max(0.0, worldPos.y - fogBase);

			float noiseCuttoff = 1.0 - smoothstep(10000, 40000, dist);
			float noise = 1.0;
			if (noiseCuttoff > 0.0) {
				noise = noiseCuttoff*dot_noise_fbm((worldPos)*mix(0.0005, 0.025, 1.0-smoothstep(500, 1000, dist)), 3, 0.25*uTime);
			}
			float density = baseDensity * densityMult * exp(-fogFalloff * heightDiff)  * clamp(0.5+0.5*(noise), 0.125, 1.0);

			// Rain optical properties: neutral spectral scattering
			// Rain and moisture optical properties
			vec3 baseScatteringCoeff = vec3(0.92, 0.95, 1.0);
			vec3 rainScatteringCoeff = vec3(0.98, 0.99, 1.0);
			vec3 fogScatCoeff = density * mix(baseScatteringCoeff, rainScatteringCoeff, rainFactor);

			// FIX: Force ALL moisture to strictly conserve energy.
			// Remove the arbitrary 1.8 multiplier and ensure albedo == 1.0 everywhere.
			vec3 fogExtCoeff = fogScatCoeff;
			float emissivity = 0.01 * density;

			// Atmospheric Rayleigh and Mie scattering coefficients
			float heightM = max(0.0, worldPos.y);
			float rayleighDensity = exp(-heightM / 8000.0);
			vec3 rayleighScat = vec3(5.8e-6, 1.35e-5, 3.31e-5) * rayleighDensity;
			vec3 rayleighExt = rayleighScat;

			// Humidity (weatherMoisture, already sampled above for rain density/tint) boosts
			// mie scattering/extinction -- real atmospheric haze/mist thickens with moisture.
			// Volumetric-lighting reinterpretation of boidish's humidity-to-mie coupling: that
			// coupling was originally scoped for aerial_perspective.glsl, which turned out to
			// have zero callers anywhere in the pipeline (unwired scaffolding), so it's applied
			// here instead, in the live fog system that already has the moisture sample in scope.
			float humidityFactor = 1.0 + weatherMoisture * mieHumidityBoost;
			float mieDensity = exp(-heightM / 1200.0);
			vec3 mieScat = vec3(3.996e-6) * mieDensity * humidityFactor;
			vec3 mieExt = vec3(3.996e-6 + 4.4e-6) * mieDensity * humidityFactor;

			vec3 totalScatCoeff = fogScatCoeff + rayleighScat + mieScat;
			vec3 totalExtCoeff = fogExtCoeff + rayleighExt + mieExt;

			// Low sun elevation godray boost and anisotropy
			float sunElevation = max(0.0, push.sunDir.y);
			float lowSunFactor = 1.0 - smoothstep(0.0, 0.45, sunElevation);
			float directSunScatteringBoost = 1.0 + lowSunFactor * 1.5;
			float sunAnisotropyG = mix(push.sunColor.w, 0.82, lowSunFactor * 0.7);
			float effectiveG = mix(sunAnisotropyG, 0.88, rainFactor);

			uint gridDim = uint(push.fogParams.w);
			float shadowTerm = calculateVolumetricTerrainShadow(worldPos, push.sunDir.xyz, shadowMapIndex, gridDim);

			// --- 1. CLOUD SHADOW EVALUATION ---
			vec4 cloudShadowData = vec4(0.0, 0.0, 0.0, 1.0);
			float cloudTransmittance = 1.0;

			if (cloudShadowIndex > 0u && cloudShadowIndex != 0xFFFFu && push.sunDir.y > 0.001) {
				cloudShadowData = sampleCloudShadow(cloudShadowIndex, clipmapIndex, worldPos, push.sunDir.xyz, push.cameraPos.xyz, 320000.0);
				// Emphasize cloud shadow contrast
				cloudTransmittance = pow(clamp(cloudShadowData.a, 0.0, 1.0), 1.8);
				shadowTerm *= cloudTransmittance;
			}

			// --- 2. DIRECT SUN SCATTERING ---
			float cosTheta = dot(viewRayDir, push.sunDir.xyz);
			float rayleighPhase = (3.0 / (16.0 * PI)) * (1.0 + cosTheta * cosTheta);

			float miePhase = dualHenyeyGreenstein(cosTheta, effectiveG);
			float msPhase = dualHenyeyGreenstein(cosTheta, effectiveG * 0.15);
			float msWeight = clamp(weatherMoisture * 1.5 + rainFactor, 0.15, 1.5);
			float finalMiePhase = miePhase + (msPhase * msWeight);

			vec3 sunScat = push.sunColor.rgb * push.sunDir.w * shadowTerm * directSunScatteringBoost;
			vec3 directSun = (fogScatCoeff * finalMiePhase + rayleighScat * rayleighPhase + mieScat * finalMiePhase) * sunScat;

			// --- 3. CLOUD IRRADIANCE & SKY AMBIENT ---
			vec3 skyAmbient = vec3(0.20, 0.35, 0.55) * max(0.2, push.sunDir.y) + vec3(0.05, 0.08, 0.12);
			if (skyViewIndex != 0xFFFFu && skyViewIndex != 0u) {
				vec3 zenithSky = sampleSkyView(skyViewIndex, vec3(0.0, 1.0, 0.0));
				vec3 horizonSky = sampleSkyView(skyViewIndex, normalize(vec3(push.sunDir.x, 0.1, push.sunDir.z)));
				skyAmbient = mix(zenithSky, horizonSky, 0.35);
			}

			float opticalDepth = max(0.0, cloudShadowData.z);
			vec3 msTransmittance = vec3(exp(-opticalDepth), exp(-opticalDepth * 0.25), exp(-opticalDepth * 0.05));

			// Added 0.05 base diffusion so ultra-dense storm cores don't go pitch black
			float diffusedTransmittance = dot(msTransmittance, vec3(0.15, 0.45, 0.40)) + 0.05;
			float powder = 1.0 - exp(-opticalDepth * 2.0);

			vec3 cloudTint = push.sunColor.rgb * push.sunDir.w * max(0.0, push.sunDir.y);
			skyAmbient += cloudTint * (diffusedTransmittance * powder) * 0.6;

			float ambientMSBoost = 1.0 + clamp(weatherMoisture + rainFactor * 1.2, 0.0, 1.5);
			skyAmbient *= ambientMSBoost;
			vec3 ambientScat = (fogScatCoeff + mieScat) * skyAmbient + (rayleighScat * length(skyAmbient));

			// --- 4. UPWELLING GROUND BOUNCE ---
			// Sun hits the terrain and bounces back UP into the fog.
			// When looking down from the air, this creates highly-visible forward scattering.
			vec3 averageTerrainAlbedo = vec3(0.18, 0.16, 0.12);
			vec3 upwellingEnergy = push.sunColor.rgb * push.sunDir.w * max(0.0, push.sunDir.y) * shadowTerm * averageTerrainAlbedo;

			// The light source is the ground (Vector to light points straight DOWN)
			float upwellingCosTheta = dot(viewRayDir, vec3(0.0, -1.0, 0.0));
			float upwellingPhase = dualHenyeyGreenstein(upwellingCosTheta, effectiveG * 0.3); // Diffused by the bounce

			vec3 groundBounceScat = (fogScatCoeff + mieScat) * upwellingEnergy * upwellingPhase;

			// --- 5. LOCAL LIGHTS & INTEGRATION ---
			vec3 localLightScattering = vec3(0.0);
			uint maxLightsToSample = min(uLightCount, 32u);
			for (uint li = 0u; li < maxLightsToSample; ++li) {
				if (uLights[li].intensity <= 0.0) continue;
				if (uLights[li].type == LIGHT_TYPE_DIRECTIONAL) continue;

				vec3 lightPos = uLights[li].position;
				if ((uLights[li].flags & LIGHT_FLAG_CAMERA_RELATIVE) != 0) {
					lightPos += push.cameraPos.xyz;
				}

				vec3 L;
				float attenuation;
				calculateLightContribution(
					uLights[li].type, lightPos, uLights[li].direction, uLights[li].innerCutoff,
					uLights[li].outerCutoff, uLights[li].intensity, worldPos, L, attenuation
				);

				if (attenuation <= 0.0) continue;

				float cosL = dot(viewRayDir, L);
				float localPhase = dualHenyeyGreenstein(cosL, effectiveG);
				localLightScattering += uLights[li].color * uLights[li].intensity * attenuation * localPhase;
			}

			// Add the groundBounceScat to the final cell energy
			vec3 cellScattering = directSun + ambientScat + groundBounceScat + localLightScattering + vec3(emissivity);//*vec3(0,100000,0);

			vec3 sliceTransmittance = exp(-totalExtCoeff * voxelSizeZ);
			vec3 integratedScattering = cellScattering * (vec3(1.0) - sliceTransmittance) / max(vec3(1e-7), totalExtCoeff);

			accumulatedScattering += integratedScattering * accumulatedTransmittance;
			accumulatedTransmittance *= sliceTransmittance;

			imageStore(
				uImages3DGenericWrite[nonuniformEXT(scatIdx)],
				vox,
				vec4(accumulatedScattering, emissivity)
			);

			imageStore(
				uImages3DGenericWrite[nonuniformEXT(extIdx)],
				vox,
				vec4(accumulatedTransmittance, 1.0)
			);
		}
	}
}
