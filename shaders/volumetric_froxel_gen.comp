#version 450
#extension GL_EXT_nonuniform_qualifier : require

#include "bindless.glsl"
#include "common.glsl"
#include "terrain.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform VolumetricFroxelGenPushConstants {
	vec4  cameraPos;            // x, y, z = camera position, w = time
	vec4  camForward;           // xyz = camera forward vector
	vec4  camUp;                // xyz = camera up vector
	vec4  camRight;             // xyz = camera right vector
	vec4  sunDir;               // x, y, z = sun direction, w = sun intensity
	vec4  sunColor;             // rgb = sun color/radiance
	vec4  fogParams;            // x = fog density, y = fog height falloff, z = fog base height, w = phase anisotropy g
	vec4  fovAspect;            // x = tanHalfFov, y = aspect ratio
	uvec4 cascadeScatteringIdx; // x, y, z = bindless storage indices for cascade 0, 1, 2 scattering
	uvec4 cascadeExtinctionIdx; // x, y, z = bindless storage indices for cascade 0, 1, 2 extinction
	uint  noiseTextureIdx;      // bindless index for VolumetricNoiseTexture
	uint  clipmapIndex;         // bindless index for TerrainClipmapTexture
	uint  minMaxIndex;          // bindless index for TerrainMinMaxTexture
	uint  gridTextureDim;       // terrain map dimension (1024)
} push;

float dualHenyeyGreenstein(float cosTheta, float g) {
	float g1 = g;
	float g2 = -0.3;
	float alpha = 0.7;

	float hg1 = (1.0 - g1 * g1) / (4.0 * PI * max(0.0001, pow(1.0 + g1 * g1 - 2.0 * g1 * cosTheta, 1.5)));
	float hg2 = (1.0 - g2 * g2) / (4.0 * PI * max(0.0001, pow(1.0 + g2 * g2 - 2.0 * g2 * cosTheta, 1.5)));

	return mix(hg2, hg1, alpha);
}

// Raymarches along sun direction to calculate terrain volumetric shadowing (god rays)
float calculateVolumetricTerrainShadow(vec3 worldPos, vec3 lightDir) {
	if (push.clipmapIndex == 0xFFFFFFFFu && push.minMaxIndex == 0xFFFFFFFFu) return 1.0;

	float shadow = 1.0;
	float stepSize = 100.0;
	int numSteps = 5;

	for (int i = 1; i <= numSteps; ++i) {
		vec3 sampleP = worldPos + lightDir * (float(i) * stepSize);

		vec2 flatXZ = sampleP.xz - push.cameraPos.xz;
		float dropOff = dot(flatXZ, flatXZ) / (2.0 * FAKE_PLANET_RADIUS);

		float terrainHeight = -dropOff;
		if (push.clipmapIndex != 0xFFFFFFFFu && push.clipmapIndex > 0u) {
			vec4 texSample = sampleTerrainClipmap(push.clipmapIndex, sampleP.xz, 0u, push.gridTextureDim > 0u ? push.gridTextureDim : 1024u);
			terrainHeight = texSample.r - dropOff;
		}

		if (sampleP.y < terrainHeight) {
			shadow = 0.15; // Soft shadow in mountain occlusion
			break;
		}
	}
	return shadow;
}

void main() {
	uvec2 xy = gl_GlobalInvocationID.xy;
	if (xy.x >= 64 || xy.y >= 64) return;

	// Camera view frustum directions
	float ndcX = (((float(xy.x) + 0.5) / 64.0) * 2.0 - 1.0);
	float ndcY = (((float(xy.y) + 0.5) / 64.0) * 2.0 - 1.0);

	float tanHalfFov = push.fovAspect.x;
	float aspect = push.fovAspect.y;

	vec3 viewRayDir = normalize(
		ndcX * aspect * tanHalfFov * push.camRight.xyz +
		ndcY * tanHalfFov * push.camUp.xyz +
		push.camForward.xyz
	);

	// Cascades covering extended distances: C0 = 200m, C1 = 1600m, C2 = 12800m
	float cascadeRanges[3] = float[3](200.0, 1600.0, 12800.0);

	for (int c = 0; c < 3; ++c) {
		uint scatIdx = push.cascadeScatteringIdx[c];
		uint extIdx = push.cascadeExtinctionIdx[c];
		if (scatIdx == 0xFFFFFFFFu || extIdx == 0xFFFFFFFFu) continue;

		float maxDist = cascadeRanges[c];
		float voxelSizeZ = maxDist / 64.0;

		vec3 accumulatedScattering = vec3(0.0);
		float accumulatedTransmittance = 1.0;

		for (int z = 0; z < 64; ++z) {
			ivec3 vox = ivec3(xy.x, xy.y, z);

			float dist = ((float(z) + 0.5) / 64.0) * maxDist;
			vec3 worldPos = push.cameraPos.xyz + viewRayDir * dist;

			// Sample logarithmically proportioned 2D noise map
			vec2 noiseUV = worldPos.xz * (0.0005 * pow(2.0, float(c)));
			vec4 noiseVal = vec4(0.5);
			if (push.noiseTextureIdx != 0xFFFFFFFFu) {
				noiseVal = textureLod(sampler2D(uTextures2D[nonuniformEXT(push.noiseTextureIdx)], uSamplers[BRASSICA_SAMPLER_LINEAR_CLAMP]), noiseUV, 0.0);
			}
			float noiseMod = noiseVal.r * 0.5 + noiseVal.g * 0.25 + noiseVal.b * 0.125 + noiseVal.a * 0.125;

			// Analytical exponential height fog
			float fogBase = push.fogParams.z;
			float fogFalloff = push.fogParams.y;
			float baseDensity = push.fogParams.x;

			float heightDiff = max(0.0, worldPos.y - fogBase);
			float density = baseDensity * exp(-fogFalloff * heightDiff) * clamp(noiseMod * 1.5, 0.2, 2.0);

			// White/blue atmospheric scattering albedo
			vec3 scatteringCoeff = density * vec3(0.92, 0.95, 1.0);
			float extinctionCoeff = density * 1.0;
			float emissivity = 0.01 * density;

			// Volumetric shadowing for god rays
			float shadowTerm = calculateVolumetricTerrainShadow(worldPos, push.sunDir.xyz);

			// Direct sun light + phase function along viewRayDir
			float cosTheta = dot(viewRayDir, push.sunDir.xyz);
			float phase = dualHenyeyGreenstein(cosTheta, push.fogParams.w);

			vec3 directSun = push.sunColor.rgb * push.sunDir.w * phase * shadowTerm;

			// Bright ambient sky illumination so fog is vibrant blue/sky-tinted rather than black
			vec3 skyAmbient = vec3(0.20, 0.35, 0.55) * max(0.2, push.sunDir.y) + vec3(0.05, 0.08, 0.12);

			vec3 totalIllumination = directSun + skyAmbient;
			vec3 cellScattering = scatteringCoeff * totalIllumination + vec3(emissivity);

			// Wronski 2014 analytical slice integration over voxel depth voxelSizeZ
			float sliceTransmittance = exp(-extinctionCoeff * voxelSizeZ);
			vec3 integratedScattering = cellScattering * (1.0 - sliceTransmittance) / max(0.00001, extinctionCoeff);

			accumulatedScattering += integratedScattering * accumulatedTransmittance;
			accumulatedTransmittance *= sliceTransmittance;

			// Store pre-integrated scattering and transmittance into froxel 3D volume textures
			imageStore(
				uImages3DGenericWrite[nonuniformEXT(scatIdx)],
				vox,
				vec4(accumulatedScattering, emissivity)
			);

			imageStore(
				uImages3DGenericWrite[nonuniformEXT(extIdx)],
				vox,
				vec4(vec3(accumulatedTransmittance), 1.0)
			);
		}
	}
}
