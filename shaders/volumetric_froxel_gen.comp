#version 450
#extension GL_EXT_nonuniform_qualifier : require

#include "bindless.glsl"
#include "common.glsl"
#include "lighting.glsl"
#include "helpers/lighting.glsl"
#include "terrain.glsl"
#include "atmosphere/common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform VolumetricFroxelGenPushConstants {
	vec4  cameraPos;             // x, y, z = camera position, w = time
	vec4  scaledCamRight;        // xyz = camRight * aspect * tanHalfFov
	vec4  scaledCamUp;           // xyz = camUp * tanHalfFov
	vec4  fogParams;             // x = fog density, y = fog height falloff, z = fog base height, w = phase anisotropy g
	uvec4 cascadeScatExtIdx01;   // x,y = C0 scat/ext, z,w = C1 scat/ext
	uvec4 cascadeScatExtIdx23;   // x,y = C2 scat/ext, z,w = C3 scat/ext
	uvec4 texturesConfig;        // x = noiseTexture, y = minMax, z = skyView, w = gridDim
	uint  numLevels;             // terrain clipmap level count
	float waterLevel;            // water surface elevation
	float waterBlendDepth;       // underwater blend depth
	uint  _pad;
} push;

float dualHenyeyGreenstein(float cosTheta, float g) {
	float g1 = g;
	float g2 = -0.3;
	float alpha = 0.7;

	float hg1 = (1.0 - g1 * g1) / (4.0 * PI * max(0.0001, pow(1.0 + g1 * g1 - 2.0 * g1 * cosTheta, 1.5)));
	float hg2 = (1.0 - g2 * g2) / (4.0 * PI * max(0.0001, pow(1.0 + g2 * g2 - 2.0 * g2 * cosTheta, 1.5)));

	return mix(hg2, hg1, alpha);
}

// Calculates terrain volumetric shadowing (god rays) using the terrain library occlusion system
float calculateVolumetricTerrainShadow(vec3 worldPos, vec3 lightDir) {
	uint minMaxIndex = push.texturesConfig.y;
	uint gridTextureDim = push.texturesConfig.w;
	if (minMaxIndex == 0u || minMaxIndex == 0xFFFFFFFFu) return 1.0;

	TerrainOcclusionContext occCtx = makeTerrainOcclusionContext(
		minMaxIndex,
		gridTextureDim,
		push.numLevels,
		push.waterLevel
	);

	float near = 0.0;
	float distanceInOut = 50000.0;
	bool hit = isDirectionOccludedByTerrain(occCtx, worldPos, lightDir, distanceInOut, near);

	if (hit) {
		return clamp(near * distanceInOut, 0.0, 1.0) * 0.15;
	}
	return 1.0;
}

void main() {
	uvec2 xy = gl_GlobalInvocationID.xy;
	if (xy.x >= 64 || xy.y >= 64) return;

	// Camera view frustum directions (xy.y = 0 points UP along +scaledCamUp to match top of image/frustum)
	float ndcX = (((float(xy.x) + 0.5) / 64.0) * 2.0 - 1.0);
	float ndcY = 1.0 - (((float(xy.y) + 0.5) / 64.0) * 2.0);

	vec3 camForward = normalize(cross(push.scaledCamUp.xyz, push.scaledCamRight.xyz));

	vec3 viewRayDir = normalize(
		ndcX * push.scaledCamRight.xyz +
		ndcY * push.scaledCamUp.xyz +
		camForward
	);

	// Cascades covering extended distances: C0 = 200m, C1 = 1600m, C2 = 12800m, C3 = 51200m
	float cascadeRanges[4] = float[4](200.0, 1600.0, 12800.0, 51200.0);

	uvec4 scatExtIndices[4] = uvec4[4](
		push.cascadeScatExtIdx01.xy,
		push.cascadeScatExtIdx01.zw,
		push.cascadeScatExtIdx23.xy,
		push.cascadeScatExtIdx23.zw
	);

	uint noiseTextureIdx = push.texturesConfig.x;
	uint skyViewIndex = push.texturesConfig.z;

	for (int c = 0; c < 4; ++c) {
		uint scatIdx = scatExtIndices[c].x;
		uint extIdx = scatExtIndices[c].y;
		if (scatIdx == 0xFFFFFFFFu || extIdx == 0xFFFFFFFFu) continue;

		float maxDist = cascadeRanges[c];
		float voxelSizeZ = maxDist / 64.0;

		vec3 accumulatedScattering = vec3(0.0);
		vec3 accumulatedTransmittance = vec3(1.0);

		for (int z = 0; z < 64; ++z) {
			ivec3 vox = ivec3(xy.x, xy.y, z);

			float dist = ((float(z) + 0.5) / 64.0) * maxDist;
			vec3 worldPos = push.cameraPos.xyz + viewRayDir * dist;

			// Cascade noise scaling: Cascade 0 (near camera) samples higher spatial frequencies
			// for crisp, detailed fog wisps, while Cascades 1 & 2 sample lower frequencies for smooth broad mist.
			float noiseScale = 0.018 / pow(2.5, float(c));
			vec2 noiseUV = worldPos.xz * noiseScale;
			vec4 noiseVal = vec4(0.5);
			if (noiseTextureIdx != 0xFFFFFFFFu) {
				noiseVal = textureLod(sampler2D(uTextures2D[nonuniformEXT(noiseTextureIdx)], uSamplers[BRASSICA_SAMPLER_LINEAR_CLAMP]), noiseUV, 0.0);
			}

			float noiseMod = 0.5;
			if (c == 0) {
				// Near camera: emphasize fine wisp channels (b & a)
				noiseMod = noiseVal.r * 0.15 + noiseVal.g * 0.25 + noiseVal.b * 0.35 + noiseVal.a * 0.25;
			} else if (c == 1) {
				noiseMod = noiseVal.r * 0.30 + noiseVal.g * 0.40 + noiseVal.b * 0.20 + noiseVal.a * 0.10;
			} else if (c == 2) {
				// Far distance: smooth broad features (r & g)
				noiseMod = noiseVal.r * 0.60 + noiseVal.g * 0.30 + noiseVal.b * 0.10;
			} else {
				// Very far distance: ultra-broad features
				noiseMod = noiseVal.r * 0.80 + noiseVal.g * 0.20;
			}

			// Analytical exponential height fog
			float fogBase = push.fogParams.z;
			float fogFalloff = push.fogParams.y;
			float baseDensity = push.fogParams.x;

			float heightDiff = max(0.0, worldPos.y - fogBase);
			float density = baseDensity * exp(-fogFalloff * heightDiff) * clamp(noiseMod * 1.5, 0.2, 2.0);

			// Air scattering and extinction coefficients (per meter)
			vec3 airScatteringCoeff = density * vec3(0.92, 0.95, 1.0);
			vec3 airExtinctionCoeff = vec3(density * 1.0);

			// Underwater optical properties (converted from AtmosphereUBO per-km to per-meter)
			vec3 waterScatCoeff = (kWaterScattering * u_waterScale) / 1000.0;
			vec3 waterExtCoeff = (kWaterExtinction * u_waterScale) / 1000.0;

			// Evaluate water submergence
			float depthInWater = max(0.0, push.waterLevel - worldPos.y);
			float blendDepth = max(0.1, push.waterBlendDepth);
			float waterBlend = clamp(depthInWater / blendDepth, 0.0, 1.0);

			vec3 scatteringCoeff = mix(airScatteringCoeff, waterScatCoeff, waterBlend);
			vec3 extinctionCoeffVec = mix(airExtinctionCoeff, waterExtCoeff, waterBlend);
			float emissivity = 0.01 * density * (1.0 - waterBlend);

			// Volumetric shadowing for god rays
			vec3 sunDir = uLights[0].direction != vec3(0.0) ? normalize(-uLights[0].direction) : vec3(0.0, 1.0, 0.0);
			vec3 sunColor = uLights[0].color * uLights[0].intensity;
			float shadowTerm = calculateVolumetricTerrainShadow(worldPos, sunDir);

			// Direct sun light + phase function along viewRayDir
			float cosTheta = dot(viewRayDir, sunDir);
			float phase = dualHenyeyGreenstein(cosTheta, push.fogParams.w);

			vec3 directSun = sunColor * phase * shadowTerm;

			// Apply water depth attenuation to direct sun light when underwater
			vec3 sunWaterAtten = exp(-waterExtCoeff * depthInWater);
			directSun = mix(directSun, directSun * sunWaterAtten, waterBlend);

			// Sample physical sky radiance from SkyViewLUT for atmospheric ambient, or aquatic teal tint underwater
			vec3 skyAmbient = vec3(0.20, 0.35, 0.55) * max(0.2, sunDir.y) + vec3(0.05, 0.08, 0.12);
			if (skyViewIndex != 0xFFFFFFFFu) {
				vec3 zenithSky = sampleSkyView(skyViewIndex, vec3(0.0, 1.0, 0.0));
				vec3 viewSky = sampleSkyView(skyViewIndex, viewRayDir);
				skyAmbient = mix(zenithSky, viewSky, 0.5);
			}
			vec3 underwaterAmbient = vec3(0.02, 0.18, 0.28) * max(0.2, sunDir.y) + vec3(0.005, 0.03, 0.05);
			skyAmbient = mix(skyAmbient, underwaterAmbient, waterBlend);

			// Evaluate local point and spot light sources for volumetric light shafts
			vec3 localLightScattering = vec3(0.0);
			uint maxLightsToSample = min(uLightCount, 32u);
			for (uint li = 0u; li < maxLightsToSample; ++li) {
				if (uLights[li].intensity <= 0.0) continue;
				if (uLights[li].type == LIGHT_TYPE_DIRECTIONAL) continue;

				vec3 lightPos = uLights[li].position;
				if ((uLights[li].flags & LIGHT_FLAG_CAMERA_RELATIVE) != 0) {
					lightPos += push.cameraPos.xyz;
				}

				vec3 L;
				float attenuation;
				calculateLightContribution(
					uLights[li].type,
					lightPos,
					uLights[li].direction,
					uLights[li].innerCutoff,
					uLights[li].outerCutoff,
					uLights[li].intensity,
					worldPos,
					L,
					attenuation
				);

				if (attenuation <= 0.0) continue;

				float cosL = dot(viewRayDir, L);
				float localPhase = dualHenyeyGreenstein(cosL, push.fogParams.w);
				localLightScattering += uLights[li].color * uLights[li].intensity * attenuation * localPhase;
			}

			vec3 totalIllumination = directSun + skyAmbient + localLightScattering;
			vec3 cellScattering = scatteringCoeff * totalIllumination + vec3(emissivity);

			// Wronski 2014 analytical slice integration over voxel depth voxelSizeZ
			vec3 sliceTransmittance = exp(-extinctionCoeffVec * voxelSizeZ);
			vec3 integratedScattering = cellScattering * (vec3(1.0) - sliceTransmittance) / max(vec3(0.00001), extinctionCoeffVec);

			accumulatedScattering += integratedScattering * accumulatedTransmittance;
			accumulatedTransmittance *= sliceTransmittance;

			// Store pre-integrated scattering and transmittance into froxel 3D volume textures
			imageStore(
				uImages3DGenericWrite[nonuniformEXT(scatIdx)],
				vox,
				vec4(accumulatedScattering, emissivity)
			);

			imageStore(
				uImages3DGenericWrite[nonuniformEXT(extIdx)],
				vox,
				vec4(accumulatedTransmittance, 1.0)
			);
		}
	}
}
