#version 460
#extension GL_EXT_mesh_shader : require

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 128, max_primitives = 128) out;

#include "bindless.glsl"
#include "common.glsl"
#include "terrain.glsl"
#include "foliage_archetype.glsl"

layout(push_constant) uniform FoliageBakePushConstants {
	FoliageArchetypeVertexRef vertexBuf;
	FoliageArchetypeIndexRef  indexBuf;
	FoliageArchetypeMetaRef   metaBuf;
}
push;

// emitBushItem/emitPalmTreeItem/emitPineTreeItem/emitDeciduousTreeItem/emitCactusItem read
// params.lengthMultiplier/params.widthMultiplier directly -- the live per-frame path
// (foliage.mesh) wants those user-adjustable, but a baked archetype shape must not have a
// snapshot of whatever the sliders happened to read at bake time frozen into it forever, since
// length/width (and the rest of FoliageState's multipliers) are meant to be applied per-instance
// at draw time instead (see foliage_archetype.glsl's own comment). A neutral (1.0) stand-in here
// bakes the unscaled shape; Stage 3's render pass is where the real multiplier gets applied.
struct FoliageBakeNeutralParams {
	float lengthMultiplier;
	float widthMultiplier;
};
const FoliageBakeNeutralParams params = FoliageBakeNeutralParams(1.0, 1.0);

// foliage_emit.glsl writes to these identifiers (and gl_PrimitiveTriangleIndicesEXT) expecting
// real mesh-shader Output-storage-class variables, exactly what foliage.mesh provides -- but
// SPIR-V's MeshEXT execution model forbids ever reading an Output-storage-class variable back
// (VUID-StandaloneSpirv-MeshEXT-07107), and this bake pass's whole point is reading the generated
// vertices/triangles back out to copy into a persistent buffer. Redirecting these names to plain
// local arrays via #define, instead of real `out` variables, sidesteps the restriction entirely
// without touching foliage_emit.glsl: the textual substitution applies to every write site inside
// the included functions exactly as if they'd been writing to a local array all along.
// gl_MeshVerticesEXT[...].gl_Position is left alone -- it's genuinely write-only here (never read
// back), so the real builtin is fine for it.
vec3  bakeWorldPos[128];
vec3  bakeNormal[128];
vec2  bakeUV[128];
vec4  bakeColor[128];
uint  bakeMaterialType[128];
float bakeFade[128];
uvec3 bakeTriangles[128];

#define outWorldPos bakeWorldPos
#define outNormal bakeNormal
#define outUV bakeUV
#define outColor bakeColor
#define outMaterialType bakeMaterialType
#define outFade bakeFade
#define gl_PrimitiveTriangleIndicesEXT bakeTriangles

#include "foliage_emit.glsl"

void main() {
	uint archetypeIndex = gl_WorkGroupID.x;
	if (archetypeIndex >= kFoliageArchetypeCount) {
		SetMeshOutputsEXT(0u, 0u);
		return;
	}

	// Fixed, distinct seed per slot -- just needs to be deterministic and spread out, not any
	// particular value. basePos = 0, sway = 0, fade = 1: see foliage_archetype.glsl's comment --
	// position/sway/fade become per-instance, runtime-applied transforms in Stage 3, not baked.
	uint  itemSeed = archetypeIndex * 7919u + 12345u;
	vec3  basePos = vec3(0.0);
	float angle = pcg_hash(itemSeed + 999u) * TAU;
	vec3  sway = vec3(0.0);
	vec3  terrainNormal = vec3(0.0, 1.0, 0.0); // unused by every emit function called below
	float fade = 1.0;

	uint vCount = 0u;
	uint pCount = 0u;

	if (archetypeIndex < kFoliageTreeArchetypeCount) {
		// Bakes a specific sub-type directly instead of going through emitTreeItem's biome-driven
		// getWhittakerTreeType dispatch -- a bake slot wants one fixed sub-type, not a biome pick.
		// Sub-type numbering matches getWhittakerTreeType's own (0 pine, 1 deciduous, 2 palm, 3 cactus).
		uint treeSubtype = archetypeIndex / kFoliageTreeVariantsPerSubtype;
		if (treeSubtype == 0u) {
			emitPineTreeItem(basePos, 1.0, 1.0, angle, sway, itemSeed, terrainNormal, fade, vCount, pCount);
		} else if (treeSubtype == 1u) {
			emitDeciduousTreeItem(basePos, 1.0, 1.0, angle, sway, itemSeed, terrainNormal, fade, vCount, pCount);
		} else if (treeSubtype == 2u) {
			emitPalmTreeItem(basePos, 1.0, 1.0, angle, sway, itemSeed, terrainNormal, fade, vCount, pCount);
		} else {
			emitCactusItem(basePos, 1.0, 1.0, angle, itemSeed, terrainNormal, fade, vCount, pCount);
		}
	} else {
		emitBushItem(basePos, angle, 0.0, itemSeed, terrainNormal, vCount, pCount);
	}

	SetMeshOutputsEXT(vCount, pCount);

	// Copy this slot's geometry into the persistent archetype buffers, undoing the
	// + uCameraPosition.xyz every emit function bakes into outWorldPos (correct for the live
	// per-frame path's world-space output, not what a cached local-space shape wants) -- basePos
	// was zero above, so subtracting it back out recovers exactly the local-space position.
	uint vertBase = archetypeIndex * kFoliageArchetypeMaxVerts;
	uint triBase = archetypeIndex * kFoliageArchetypeMaxTris;
	for (uint i = 0u; i < vCount; ++i) {
		FoliageArchetypeVertex v;
		v.position = outWorldPos[i] - uCameraPosition.xyz;
		v.normal = outNormal[i];
		v.uv = outUV[i];
		v.color = outColor[i];
		v.materialType = outMaterialType[i];
		push.vertexBuf.vertices[vertBase + i] = v;
	}
	for (uint i = 0u; i < pCount; ++i) {
		push.indexBuf.triangles[triBase + i] = gl_PrimitiveTriangleIndicesEXT[i];
	}
	push.metaBuf.slots[archetypeIndex] = FoliageArchetypeMeta(vCount, pCount);
}
