#version 460 core
#include "bindless.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct Particle {
	vec4  position;
	vec4  velocity;
	vec4  misc;
	uint  type;
	float lifetime;
	float maxLifetime;
	uint  padding;
};

struct ParticleType {
	vec4  color;
	float size;
	float gravityScale;
	float drag;
	float padding;
};

layout(std430, set = 2, binding = 0) buffer Particles {
	Particle uParticles[];
};

layout(std430, set = 2, binding = 1) readonly buffer ParticleTypes {
	ParticleType uParticleTypes[];
};

layout(push_constant) uniform ParticleBehaviorPushConstants {
	uint  maxParticles;
	float deltaTime;
} uPush;

void main() {
	uint idx = gl_GlobalInvocationID.x;

	if (idx >= uPush.maxParticles) {
		return;
	}

	Particle p = uParticles[idx];
	if (p.lifetime <= 0.0) {
		return;
	}

	if (p.type == 0u) { // Birds
		p.misc.x += uPush.deltaTime * 8.0; // Wing flap animation phase
		// Curved flight vector perturbation
		vec3 perturbation = vec3(cos(p.misc.x * 0.2), sin(p.misc.x * 0.4) * 0.3, sin(p.misc.x * 0.2)) * 2.0;
		p.position.xyz += (p.velocity.xyz + perturbation) * uPush.deltaTime;
		p.position.y = max(p.position.y, 2.0); // Stay above water
	} else { // Fish
		p.misc.x += uPush.deltaTime * 6.0; // Tail wiggle animation phase
		// Swimming undulating path
		vec3 perturbation = vec3(sin(p.misc.x * 0.5) * 1.5, cos(p.misc.x * 0.8) * 0.2, cos(p.misc.x * 0.5) * 1.5);
		p.position.xyz += (p.velocity.xyz + perturbation) * uPush.deltaTime;
		p.position.y = min(p.position.y, -1.0); // Stay below water
	}

	uParticles[idx] = p;
}
