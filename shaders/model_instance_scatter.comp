#version 460

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "model_instance.glsl"

layout(push_constant) uniform ModelInstanceScatterPushConstants {
	uint instanceBufIdx;
	uint writeBufIdx;
	uint writeCount;
}
push;

void main() {
	uint i = gl_GlobalInvocationID.x;
	if (i >= push.writeCount) {
		return;
	}

	ModelInstanceWrite w = uModelInstanceWriteBuffers[nonuniformEXT(push.writeBufIdx)].writes[i];
	uModelInstanceBuffers[nonuniformEXT(push.instanceBufIdx)].instances[w.slot] = w.record;
}
