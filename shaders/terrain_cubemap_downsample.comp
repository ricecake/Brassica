#version 460
#extension GL_EXT_nonuniform_qualifier : require

#include "bindless.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform CubemapDownsamplePushConstants {
	uint srcMinMaxStorageIdx; // bindless sampled index for TerrainCubemapMinMaxTexture
	uint dstMinMaxStorageIdx; // bindless storage index for TerrainCubemapMinMaxTexture mip m
	uint dstDim;              // width/height of target mip m
	uint srcDim;              // width/height of source mip m-1
	uint srcMip;              // source mip level (m-1)
} push;

void main() {
	uvec3 globalId = gl_GlobalInvocationID;
	if (globalId.x >= push.dstDim || globalId.y >= push.dstDim || globalId.z >= 6u) {
		return;
	}

	uint face = globalId.z;
	ivec2 srcPos = ivec2(globalId.xy) * 2;

	// Fetch 2x2 min/max values from source mip
	ivec3 p00 = ivec3(srcPos, face);
	ivec3 p10 = ivec3(min(srcPos + ivec2(1, 0), ivec2(push.srcDim - 1u)), face);
	ivec3 p01 = ivec3(min(srcPos + ivec2(0, 1), ivec2(push.srcDim - 1u)), face);
	ivec3 p11 = ivec3(min(srcPos + ivec2(1, 1), ivec2(push.srcDim - 1u)), face);

	// Read RG32F min (r) and max (g)
	vec2 a = texelFetch(sampler2DArray(uTextureArrays[nonuniformEXT(push.srcMinMaxStorageIdx)], uSamplers[BRASSICA_SAMPLER_NEAREST_CLAMP]), p00, int(push.srcMip)).rg;
	vec2 b = texelFetch(sampler2DArray(uTextureArrays[nonuniformEXT(push.srcMinMaxStorageIdx)], uSamplers[BRASSICA_SAMPLER_NEAREST_CLAMP]), p10, int(push.srcMip)).rg;
	vec2 c = texelFetch(sampler2DArray(uTextureArrays[nonuniformEXT(push.srcMinMaxStorageIdx)], uSamplers[BRASSICA_SAMPLER_NEAREST_CLAMP]), p01, int(push.srcMip)).rg;
	vec2 d = texelFetch(sampler2DArray(uTextureArrays[nonuniformEXT(push.srcMinMaxStorageIdx)], uSamplers[BRASSICA_SAMPLER_NEAREST_CLAMP]), p11, int(push.srcMip)).rg;

	float minH = min(min(a.x, b.x), min(c.x, d.x));
	float maxH = max(max(a.y, b.y), max(c.y, d.y));

	ivec3 dstPos = ivec3(globalId.xy, face);
	imageStore(uImageArraysGenericWrite[nonuniformEXT(push.dstMinMaxStorageIdx)], dstPos, vec4(minH, maxH, 0.0, 0.0));
}
