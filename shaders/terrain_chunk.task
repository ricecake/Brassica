#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

#include "bindless.glsl"
#include "common.glsl"
#include "terrain.glsl"
#include "terrain_chunk_payload.glsl"
#include "helpers/culling.glsl"

struct TerrainPageTableEntry {
	uint physicalSlot; // 0xFFFFFFFF if unallocated
	int  coordX;       // grid cell X
	int  coordZ;       // grid cell Z
	uint lod;
};

layout(scalar, buffer_reference) buffer PageTableRef {
	TerrainPageTableEntry entries[];
};

layout(push_constant) uniform TerrainChunkRenderPushConstants {
	uvec2 pageTableBufferAddr;
	uvec2 vertexBufferAddr;
	uvec4 gridParams; // x = numLODs, y = chunksPerRow, z = totalChunks, w = maxAllocatedChunks
	float baseChunkSize;
	float waterLevel;
	uint  minMaxIndex;
	uint  hizIndex;
} push;

shared uint chunkEmitCount;

void main() {
	uint threadID = gl_LocalInvocationID.x;
	if (threadID == 0) {
		chunkEmitCount = 0;
	}
	barrier();

	uint virtualChunkId = gl_WorkGroupID.x * 16 + (threadID / 2);
	uint halfIdx = threadID % 2; // 0 = top half (rows 0..7), 1 = bottom half (rows 8..14)

	bool visible = false;
	uint physicalSlot = 0xFFFFFFFFu;
	uint lod = 0;

	if (virtualChunkId < push.gridParams.z) {
		PageTableRef pt = PageTableRef(push.pageTableBufferAddr);
		TerrainPageTableEntry entry = pt.entries[virtualChunkId];
		physicalSlot = entry.physicalSlot;

		if (physicalSlot != 0xFFFFFFFFu && physicalSlot < push.gridParams.w) {
			lod = entry.lod;
			float baseChunkSize = (push.baseChunkSize > 0.0) ? push.baseChunkSize : 64.0;
			float chunkSize = baseChunkSize * getLODScale(float(lod));

			vec2 chunkMinXZ = vec2(float(entry.coordX) * chunkSize, float(entry.coordZ) * chunkSize);
			vec2 maxRel = max(abs(chunkMinXZ - uCameraPosition.xz), abs(chunkMinXZ + vec2(chunkSize) - uCameraPosition.xz));
			float maxDropOff = dot(maxRel, maxRel) / (2.0 * FAKE_PLANET_RADIUS);

			vec3 relMinB = vec3(chunkMinXZ.x - uCameraPosition.x, -2000.0 - uCameraPosition.y - maxDropOff, chunkMinXZ.y - uCameraPosition.z);
			vec3 relMaxB = vec3(chunkMinXZ.x + chunkSize - uCameraPosition.x, 4000.0 - uCameraPosition.y, chunkMinXZ.y + chunkSize - uCameraPosition.z);

			mat4 viewRel = mat4(mat3(uViewMatrix));
			mat4 viewProjRel = uProjMatrix * viewRel;

			// Generous frustum culling
			visible = isAABBVisible(relMinB, relMaxB, viewProjRel, vec3(chunkSize * 2.0, 1000.0, chunkSize * 2.0), -500.0);

			// Inner LOD culling: prevent coarse LOD chunks from rendering over finer LOD chunks
			if (visible && lod > 0u) {
				uint chunksPerRow = push.gridParams.y;
				float prevChunkSize = baseChunkSize * getLODScale(float(lod - 1u));
				vec2  prevCameraSnap = floor(uCameraPosition.xz / prevChunkSize) * prevChunkSize;
				float prevExtent = float(chunksPerRow) * 0.5 * prevChunkSize;

				bool insideInnerX = (chunkMinXZ.x >= prevCameraSnap.x - prevExtent) &&
				                    (chunkMinXZ.x + chunkSize <= prevCameraSnap.x + prevExtent);
				bool insideInnerZ = (chunkMinXZ.y >= prevCameraSnap.y - prevExtent) &&
				                    (chunkMinXZ.y + chunkSize <= prevCameraSnap.y + prevExtent);

				if (insideInnerX && insideInnerZ) {
					visible = false;
				}
			}

			// HiZ occlusion culling (disabled by default to avoid false rejection)
			#if 0
			if (visible && push.hizIndex > 0u && lod >= 3u) {
				if (isAABBOccludedByHiZ(relMinB, relMaxB, viewProjRel, push.hizIndex)) {
					visible = false;
				}
			}
			#endif
		}
	}

	if (visible) {
		uint writeIdx = atomicAdd(chunkEmitCount, 1u);
		if (writeIdx < 32u) {
			chunkPayload.physicalSlots[writeIdx] = (physicalSlot & 0x7FFFFFFFu) | (halfIdx << 31u);
			chunkPayload.virtualChunkIds[writeIdx] = virtualChunkId;
			chunkPayload.lodLevels[writeIdx] = lod;
		}
	}

	barrier();

	if (threadID == 0) {
		EmitMeshTasksEXT(min(chunkEmitCount, 32u), 1, 1);
	}
}
