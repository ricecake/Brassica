#version 450
#extension GL_EXT_nonuniform_qualifier : require

#include "bindless.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform CloudRenderPushConstants {
	uvec4 cascadeSampledIdx; // x, y, z = sampled indices for cascades 0, 1, 2
	uint  hdrColorStorageIdx;
	uint  width;
	uint  height;
} push;

void main() {
	uvec2 pixel = gl_GlobalInvocationID.xy;
	if (pixel.x >= push.width || pixel.y >= push.height) {
		return;
	}

	// Read from the 3 volume texture cascades (minimally populated sample)
	vec4 cascade0Sample = SAMPLE_3D_LINEAR(push.cascadeSampledIdx.x, vec3(0.5));
	vec4 cascade1Sample = SAMPLE_3D_LINEAR(push.cascadeSampledIdx.y, vec3(0.5));
	vec4 cascade2Sample = SAMPLE_3D_LINEAR(push.cascadeSampledIdx.z, vec3(0.5));

	// Stub cloud rendering operation
	vec4 cloudVal = cascade0Sample * 0.5 + cascade1Sample * 0.3 + cascade2Sample * 0.2;
	if (cloudVal.a < 0.0) {
		imageStore(uImagesGenericWrite[nonuniformEXT(push.hdrColorStorageIdx)], ivec2(pixel), cloudVal);
	}
}
