#version 460
#extension GL_EXT_mesh_shader : require

#include "common.glsl"
#include "bindless.glsl"

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
// Bumped from 128/256 to support up to N=4 subdivisions per cube face
layout(max_vertices = 216, max_primitives = 216, triangles) out;

struct TaskPayload {
    vec4 positionAndScale;
    vec4 color;
    uvec4 params;
};

taskPayloadSharedEXT TaskPayload IN;

layout(location = 0) out vec3 vWorldPos[];
layout(location = 1) out vec3 vNormal[];
layout(location = 2) out vec4 vColor[];

void main() {
    vec3 center = IN.positionAndScale.xyz;
    float radius = IN.positionAndScale.w;
    vec4 color = IN.color;

    // params.x dictates the number of grid subdivisions per cube face.
    uint N = IN.params.x > 0u ? IN.params.x : 4u;
    uint vertsPerFace = (N + 1u) * (N + 1u);
    uint numVertices = 6u * vertsPerFace;

    uint trisPerFace = N * N * 2u;
    uint numPrimitives = 6u * trisPerFace;

    SetMeshOutputsEXT(numVertices, numPrimitives);

    uint tid = gl_LocalInvocationIndex;

    // 1. Spherified Cube Vertices
    // Note: Edge vertices are purposely duplicated between adjacent faces to keep
    // thread evaluation independent and avoid complex cross-face seam deduplication.
    for (uint i = tid; i < numVertices; i += 32u) {
        uint face = i / vertsPerFace;
        uint idx = i % vertsPerFace;
        uint x = idx % (N + 1u);
        uint y = idx / (N + 1u);

        // Map grid coordinates to a [-1, 1] range across the face
        float u = (float(x) / float(N)) * 2.0 - 1.0;
        float v = (float(y) / float(N)) * 2.0 - 1.0;

        vec3 pos;
        if (face == 0u)      pos = vec3( u,  v,  1.0); // +Z
        else if (face == 1u) pos = vec3( u,  v, -1.0); // -Z
        else if (face == 2u) pos = vec3( u,  1.0,  v); // +Y
        else if (face == 3u) pos = vec3( u, -1.0,  v); // -Y
        else if (face == 4u) pos = vec3( 1.0,  u,  v); // +X
        else                 pos = vec3(-1.0,  u,  v); // -X

        // Normalization inflates the cube structure into a perfect sphere
        vec3 norm = normalize(pos);
        vec3 worldPos = center + norm * radius;

        float distSq = dot(worldPos.xz - uCameraPosition.xz, worldPos.xz - uCameraPosition.xz);
        worldPos.y -= distSq / (2.0 * FAKE_PLANET_RADIUS);

        gl_MeshVerticesEXT[i].gl_Position = uViewProjMatrix * vec4(worldPos, 1.0);
        vWorldPos[i] = worldPos;
        vNormal[i] = norm;
        vColor[i] = color;
    }

    // 2. Face Grid Primitives
    uint numQuads = 6u * N * N;
    for (uint p = tid; p < numQuads; p += 32u) {
        uint face = p / (N * N);
        uint idx = p % (N * N);
        uint x = idx % N;
        uint y = idx / N;

        uint vOffset = face * vertsPerFace;
        uint v00 = vOffset + y * (N + 1u) + x;
        uint v10 = vOffset + y * (N + 1u) + (x + 1u);
        uint v01 = vOffset + (y + 1u) * (N + 1u) + x;
        uint v11 = vOffset + (y + 1u) * (N + 1u) + (x + 1u);

        // Maintain CCW winding: Faces -Z, +Y, and -X require flipped indices
        // based on the orientation of the UV mapping applied in the vertex step.
        bool flip = (face == 1u || face == 2u || face == 5u);

        if (flip) {
            gl_PrimitiveTriangleIndicesEXT[p * 2u] = uvec3(v00, v11, v10);
            gl_PrimitiveTriangleIndicesEXT[p * 2u + 1u] = uvec3(v00, v01, v11);
        } else {
            gl_PrimitiveTriangleIndicesEXT[p * 2u] = uvec3(v00, v10, v11);
            gl_PrimitiveTriangleIndicesEXT[p * 2u + 1u] = uvec3(v00, v11, v01);
        }
    }
}
