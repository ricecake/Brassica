#version 460
#extension GL_EXT_nonuniform_qualifier : require

#include "bindless.glsl"
#include "common.glsl" // pulls in helpers/distribution.glsl's mortonOwenScramble

// F3: real rewrite matching boidish's cloud_tile_scheduler.comp exactly -- a genuine 2-pass
// priority scheduler, not a fixed Bayer round-robin (that simpler scheme is what the already-
// ported CloudShadowGenNode's quarter-res stagger uses). Dispatched 3 times by
// CloudTileSchedulerNode with different push.phase values (reset, spatial, priority), one
// thread per tile (8x8 tiles, matching cloud_raymarch.comp's local_size). scheduledBySpatial is
// a pure function of (tileCoord, frameIndex, spatialUpdateFrames) -- both phases recompute it
// locally, no cross-phase error-map write needed for that part (boidish's own spatial pass
// never touches the error map at all).
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#define PHASE_RESET 0u
#define PHASE_SPATIAL 1u
#define PHASE_PRIORITY 2u

layout(push_constant) uniform CloudTileSchedulerPushConstants {
	uint tileQueueBufferIdx;
	uint dispatchArgsBufferIdx;
	uint errorMapBufferIdx;
	uint boundingMapIndex; // sampled: CloudBoundingMap (Stage E), the real density-delta signal
	uint tileCols;
	uint tileRows;
	uint maxTilesPerFrame;
	uint spatialUpdateFrames; // every tile gets a guaranteed refresh at least this often
	uint phase;
} push;

layout(std430, set = 1, binding = 6) buffer CloudTileQueueBuffer {
	uint tiles[];
}
uTileQueues[];

layout(std430, set = 1, binding = 6) buffer CloudTileDispatchArgsBuffer {
	uint groupCountX;
	uint groupCountY;
	uint groupCountZ;
}
uDispatchArgs[];

layout(std430, set = 1, binding = 6) buffer CloudTileErrorMapBuffer {
	vec4 tiles[]; // x = error, y = flow, z = step multiplier, w = last-raymarched frame index
}
uErrorMaps[];

// Standard 8x8 Bayer dither matrix (values 0..63) -- boidish's own temporally-dithered priority
// threshold uses this exact table shape.
const uint kBayer8x8[64] = uint[64](
	0, 32, 8, 40, 2, 34, 10, 42,
	48, 16, 56, 24, 50, 18, 58, 26,
	12, 44, 4, 36, 14, 46, 6, 38,
	60, 28, 52, 20, 62, 30, 54, 22,
	3, 35, 11, 43, 1, 33, 9, 41,
	51, 19, 59, 27, 49, 17, 57, 25,
	15, 47, 7, 39, 13, 45, 5, 37,
	63, 31, 55, 23, 61, 29, 53, 21
);

vec2 tileCenterUVOf(uvec2 coord) {
	return (vec2(coord) * 8.0 + 4.0) / vec2(push.tileCols * 8u, push.tileRows * 8u);
}

void main() {
	if (push.phase == PHASE_RESET) {
		if (gl_GlobalInvocationID.x == 0u && gl_GlobalInvocationID.y == 0u) {
			uDispatchArgs[push.dispatchArgsBufferIdx].groupCountX = 0u;
			uDispatchArgs[push.dispatchArgsBufferIdx].groupCountY = 1u;
			uDispatchArgs[push.dispatchArgsBufferIdx].groupCountZ = 1u;
		}
		return;
	}

	uvec2 tileCoord = gl_GlobalInvocationID.xy;
	if (tileCoord.x >= push.tileCols || tileCoord.y >= push.tileRows) {
		return;
	}
	uint tileIdx = tileCoord.y * push.tileCols + tileCoord.x;
	uint totalTiles = push.tileCols * push.tileRows;

	// Guaranteed periodic refresh, permuted by an Owen-scrambled Morton code (not plain Bayer
	// round-robin) so no tile ever starves and the refresh order isn't a visible scanning
	// pattern. Pure function of (tileCoord, frameIndex) -- recomputed identically in both phases.
	uint scrambled = mortonOwenScramble(tileCoord, 0u);
	bool scheduledBySpatial = (scrambled % push.spatialUpdateFrames) == (uFrameIndex % push.spatialUpdateFrames);

	// Real density signal from Stage E's bounding map, not a luma/variance proxy. .r >= 0 means
	// the ray actually hit the cloud shell; .b is the coarse march's totalDensity; .a is that
	// SAME pixel's totalDensity from whenever it was last updated (self-referential, see
	// CloudBoundingMap's own comment) -- "wasEmpty" + "now has density" is boidish's
	// newlyAppeared fast path, the single biggest contributor to priority score. Single
	// representative-pixel sample at the tile center (CloudBoundingMap has no mip chain, unlike
	// boidish's own textureLod-downsampled read here) -- a documented resolution adaptation, not
	// an algorithm simplification.
	vec4 bData = SAMPLE_NEAREST(push.boundingMapIndex, tileCenterUVOf(tileCoord));
	bool tileHasCloudDensity = (bData.r >= 0.0 && bData.b > 0.001);
	bool wasEmpty = (bData.a <= 0.001);
	bool newlyAppeared = tileHasCloudDensity && wasEmpty;

	if (push.phase == PHASE_SPATIAL) {
		// Empty tiles have no density and are skipped without consuming tile budget, matching
		// boidish exactly -- no error-map touch at all in this pass.
		if (tileHasCloudDensity && scheduledBySpatial) {
			uint slot = atomicAdd(uDispatchArgs[push.dispatchArgsBufferIdx].groupCountX, 1u);
			if (slot < totalTiles) {
				uTileQueues[push.tileQueueBufferIdx].tiles[slot] = tileIdx;
			}
		}
		return;
	}

	// PHASE_PRIORITY
	vec4  errorData = uErrorMaps[push.errorMapBufferIdx].tiles[tileIdx];
	float errorVal = errorData.x;
	float densityGrad = errorData.y;
	float currentStepMult = (errorData.z > 0.01) ? errorData.z : 1.0;
	uint  lastUpdatedFrame = uint(round(errorData.w));

	uint  age = (uFrameIndex > lastUpdatedFrame) ? (uFrameIndex - lastUpdatedFrame) : 0u;
	float velocityWeightedAge = float(age) * (1.0 + densityGrad * 10.0);

	float densityDeltaScore = newlyAppeared ? 100.0 : max(bData.b - bData.a, 0.0);

	// 4-orthogonal-neighbor max error/grad, skipped for a newly-appeared tile (which already
	// scores the flat 100.0 above and needs no further justification).
	float maxNeighborError = 0.0;
	float maxNeighborGrad = 0.0;
	if (!newlyAppeared) {
		if (tileCoord.x > 0u) {
			vec4 n = uErrorMaps[push.errorMapBufferIdx].tiles[tileIdx - 1u];
			maxNeighborError = max(maxNeighborError, n.x);
			maxNeighborGrad = max(maxNeighborGrad, n.y);
		}
		if (tileCoord.x + 1u < push.tileCols) {
			vec4 n = uErrorMaps[push.errorMapBufferIdx].tiles[tileIdx + 1u];
			maxNeighborError = max(maxNeighborError, n.x);
			maxNeighborGrad = max(maxNeighborGrad, n.y);
		}
		if (tileCoord.y > 0u) {
			vec4 n = uErrorMaps[push.errorMapBufferIdx].tiles[tileIdx - push.tileCols];
			maxNeighborError = max(maxNeighborError, n.x);
			maxNeighborGrad = max(maxNeighborGrad, n.y);
		}
		if (tileCoord.y + 1u < push.tileRows) {
			vec4 n = uErrorMaps[push.errorMapBufferIdx].tiles[tileIdx + push.tileCols];
			maxNeighborError = max(maxNeighborError, n.x);
			maxNeighborGrad = max(maxNeighborGrad, n.y);
		}
	}

	// boidish's real AtmosphereEffect.h defaults (cloud_priority_*_weight_/cloud_priority_threshold_).
	const float kPriorityErrorWeight = 2.5;
	const float kPriorityGradWeight = 2.0;
	const float kPriorityAgeWeight = 0.05;
	const float kPriorityNeighborErrorWeight = 1.5;
	const float kPriorityNeighborGradWeight = 1.0;
	const float kPriorityThreshold = 0.05;

	float selfScore =
		densityDeltaScore + errorVal * kPriorityErrorWeight + densityGrad * kPriorityGradWeight +
		velocityWeightedAge * kPriorityAgeWeight;
	float neighborScore = maxNeighborError * kPriorityNeighborErrorWeight + maxNeighborGrad * kPriorityNeighborGradWeight;
	float priorityScore = selfScore + neighborScore;

	// Temporally-dithered, budget-aware threshold -- a Bayer value offset by the frame index (so
	// the dither pattern itself cycles, not a static per-tile bias), divided by the fraction of
	// tiles the frame budget actually allows.
	uint  bayerVal = kBayer8x8[(tileCoord.y % 8u) * 8u + (tileCoord.x % 8u)];
	uint  temporalBayer = (bayerVal + uFrameIndex * 17u) % 64u;
	float ditherMask = float(temporalBayer) / 64.0;
	float budgetRatio = float(push.maxTilesPerFrame) / max(1.0, float(totalTiles));
	float dynamicThreshold = (kPriorityThreshold + ditherMask) / max(0.01, budgetRatio);

	bool needsPriorityUpdate = !scheduledBySpatial && tileHasCloudDensity &&
		((priorityScore > dynamicThreshold) || (lastUpdatedFrame == 0u) || newlyAppeared);

	if (needsPriorityUpdate) {
		uint slot = atomicAdd(uDispatchArgs[push.dispatchArgsBufferIdx].groupCountX, 1u);
		if (slot < totalTiles) {
			uTileQueues[push.tileQueueBufferIdx].tiles[slot] = tileIdx;
		}
	}

	bool scheduled = (scheduledBySpatial || needsPriorityUpdate) && tileHasCloudDensity;

	// Adaptive step-size multiplier: urgent tiles (high priority score) get a finer step next
	// time they're raymarched, calm tiles get a coarser one -- smoothed, not snapped, and
	// clamped to a sane range. cloud_raymarch.comp reads this directly as a baseStepSize scale.
	float targetStepMult = 1.0;
	if (priorityScore > 0.35) {
		targetStepMult = 0.6;
	} else if (priorityScore < 0.08) {
		targetStepMult = 1.5;
	}
	float updatedStepMult = clamp(mix(currentStepMult, targetStepMult, 0.25), 0.5, 2.0);
	errorData.z = updatedStepMult;

	if (!scheduled) {
		// Decay error/flow for tiles not actually rendered this frame, so stale signals fade
		// out instead of permanently inflating a tile's priority.
		errorData.x *= 0.99;
		errorData.y *= 0.99;
	}

	uErrorMaps[push.errorMapBufferIdx].tiles[tileIdx] = errorData;
}
