#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "bindless.glsl"
#include "cbt.glsl"

layout(push_constant) uniform CBTPush {
	uint bitfieldIdx;
	uint poolIdx;
	uint commandsIdx;
	uint pageTableIdx;
	uint cacheIdx;
	uint activeBisectorCount;
} params;

layout(std430, buffer_reference) buffer BisectorPool {
	Bisector bisectors[];
};

void main() {
	uint idx = gl_GlobalInvocationID.x;
	if (idx >= params.activeBisectorCount) return;

	BisectorPool pool = BisectorPool(uSSBOBuffers[params.poolIdx]);
	// Bisector pool state is maintained in-place
}
