#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

#include "bindless.glsl"

layout(push_constant) uniform CBTPush {
	uint bitfieldIdx;
	uint poolIdx;
	uint commandsIdx;
	uint pageTableIdx;
	uint cacheIdx;
} params;

layout(std430, buffer_reference) buffer CommandsBuffer {
	uint splitCount;
	uint mergeCount;
	uint freePageHead;
	uint freePageCount;
};

void main() {
	if (gl_GlobalInvocationID.x == 0u) {
		CommandsBuffer cmd = CommandsBuffer(uSSBOBuffers[params.commandsIdx]);
		cmd.splitCount = 0u;
		cmd.mergeCount = 0u;
	}
}
