#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "bindless.glsl"
#include "common.glsl"
#include "cbt.glsl"

layout(push_constant) uniform TerrainPushConstants {
	uvec4 gridParams;
	uint  clipmapIndex;
	uint  minMaxIndex;
	uint  biomeIndex;
	float waterLevel;
	uint  weatherBiomeIndex;
	uint  cbtBitfieldIndex;
	uint  cbtPoolIndex;
	uint  cbtCommandsIndex;
	uint  cbtPageTableIndex;
	uint  cbtCacheIndex;
	uint  activeBisectorCount;
	uint  _pad0;
} params;

layout(std430, buffer_reference) buffer BisectorPool {
	Bisector bisectors[];
};

layout(std430, buffer_reference) buffer CommandsBuffer {
	uint       splitCount;
	uint       mergeCount;
	uint       freePageHead;
	uint       freePageCount;
	CBTCommand commands[];
};

void main() {
	uint idx = gl_GlobalInvocationID.x;
	if (idx >= params.activeBisectorCount) return;

	BisectorPool pool = BisectorPool(uSSBOBuffers[params.cbtPoolIndex]);
	CommandsBuffer cmd = CommandsBuffer(uSSBOBuffers[params.cbtCommandsIndex]);

	Bisector b = pool.bisectors[idx];

	vec2 center2D = (b.v0 + b.v1 + b.v2) / 3.0;
	float drop0 = cbt_apply_fake_curvature(b.v0);
	float drop1 = cbt_apply_fake_curvature(b.v1);
	float drop2 = cbt_apply_fake_curvature(b.v2);

	vec3 p0 = vec3(b.v0.x, drop0 - uCameraPosition.y, b.v0.y);
	vec3 p1 = vec3(b.v1.x, drop1 - uCameraPosition.y, b.v1.y);
	vec3 p2 = vec3(b.v2.x, drop2 - uCameraPosition.y, b.v2.y);

	vec3 center3D = (p0 + p1 + p2) / 3.0;
	float distToCam = max(length(center3D), 1.0);

	uint targetDepth = uint(clamp(floor(18.0 - log2(distToCam / 50.0)), 0.0, float(CBT_MAX_DEPTH)));

	if (b.depth < targetDepth && b.depth < CBT_MAX_DEPTH) {
		cmd.commands[idx].bisectorIdx = idx;
		cmd.commands[idx].type = 1u;
		atomicAdd(cmd.splitCount, 1u);
	} else if (b.depth > targetDepth && b.depth > 0u) {
		cmd.commands[idx].bisectorIdx = idx;
		cmd.commands[idx].type = 2u;
		atomicAdd(cmd.mergeCount, 1u);
	} else {
		cmd.commands[idx].bisectorIdx = idx;
		cmd.commands[idx].type = 0u;
	}
}
