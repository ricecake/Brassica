#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

#include "bindless.glsl"

layout(push_constant) uniform TerrainPushConstants {
	uvec4 gridParams;
	uint  clipmapIndex;
	uint  minMaxIndex;
	uint  biomeIndex;
	float waterLevel;
	uint  weatherBiomeIndex;
	uint  cbtBitfieldIndex;
	uint  cbtPoolIndex;
	uint  cbtCommandsIndex;
	uint  cbtPageTableIndex;
	uint  cbtCacheIndex;
	uint  activeBisectorCount;
	uint  _pad0;
} params;

layout(std430, buffer_reference) buffer CommandsBuffer {
	uint splitCount;
	uint mergeCount;
	uint freePageHead;
	uint freePageCount;
};

void main() {
	if (gl_GlobalInvocationID.x == 0u) {
		CommandsBuffer cmd = CommandsBuffer(uSSBOBuffers[params.cbtCommandsIndex]);
		cmd.splitCount = clamp(cmd.splitCount, 0u, 16384u);
		cmd.mergeCount = clamp(cmd.mergeCount, 0u, 16384u);
	}
}
