#version 460
#extension GL_EXT_mesh_shader : require

#include "bindless.glsl"
#include "common.glsl"
#include "terrain.glsl"

layout(local_size_x = 11, local_size_y = 11, local_size_z = 1) in;
layout(triangles, max_vertices = 141, max_primitives = 240) out;

layout(push_constant) uniform WaterPushConstants {
	uvec4 gridParams; // x = numRings, y = meshletsPerRow, z = totalMeshlets, w = textureDim
	vec3  waterColor;
	float waterLevel;
	uint  gPositionIndex;
	uint  gAlbedoIndex;
	uint  gNormalIndex;
	uint  sceneColor;
	uint  minMaxIndex;
	uint  gMaterialIndex;
	uint  skyViewIndex;
}
params;

struct TaskPayload {
	uint meshletIDs[32];
	uint lodLevels[32];
};

taskPayloadSharedEXT TaskPayload payload;

layout(location = 0) out vec3 outWorldPos[];
layout(location = 1) out vec3 outNormal[];

float getWaterRingScale(float ring) {
	return pow(2.0, ring);
}

// Samples underlying terrain height from TerrainMinMaxTexture
float getTerrainBedHeight(vec2 worldXZ, uint ringLevel) {
	if (params.minMaxIndex == 0u || params.minMaxIndex == 0xFFFFFFFFu) {
		return params.waterLevel - 50.0;
	}
	uint sampleLOD = min(ringLevel, params.gridParams.x - 1u);
	vec2 minMax = sampleTerrainMinMax(params.minMaxIndex, worldXZ, sampleLOD, params.gridParams.w);
	return minMax.x;
}

// Calculates water wave displacement and analytical normal using phasor noise aligned with terrain height gradient.
// Shading (the returned normal) always carries full wave detail, independent of distance or
// mesh resolution, so the surface never looks dead-flat far away. Only the actual vertex
// displacement (the returned offset) is gated by distance/mesh density -- a far, coarse ring's
// triangles don't have the density to move by much without folding over -- unless the water is
// shallow, in which case shoreline/shallow-bay chop keeps moving even far from the camera.
vec3 calculatePhasorOffsetAndNormal(vec2 uv, float time, float distToCam, float ringLevel, float vertexSpacing, out vec3 normal) {
	// 1. Sample underlying terrain height gradient
	float eps = max(2.0, vertexSpacing);
	float hC  = getTerrainBedHeight(uv, uint(ringLevel));
	float hE  = getTerrainBedHeight(uv + vec2(eps, 0.0), uint(ringLevel));
	float hW  = getTerrainBedHeight(uv - vec2(eps, 0.0), uint(ringLevel));
	float hN  = getTerrainBedHeight(uv + vec2(0.0, eps), uint(ringLevel));
	float hS  = getTerrainBedHeight(uv - vec2(0.0, eps), uint(ringLevel));

	vec2 terrainGrad = vec2((hE - hW) / (2.0 * eps), (hN - hS) / (2.0 * eps));
	float gradLen = length(terrainGrad);

	// Wave alignment: waves tend to refract and align with depth contours, traveling up the slope / towards shore
	vec2 waveDir;
	if (gradLen > 0.005) {
		// Normal wave vector points in direction of increasing height (towards shore)
		waveDir = terrainGrad / gradLen;
	} else {
		// Default prevailing current/wave direction
		waveDir = vec2(0.7071, 0.7071);
	}

	vec3 waveDir3D = vec3(waveDir.x, 0.0, waveDir.y);
	vec3 waveF_3D  = waveDir3D;

	// Water depth at this vertex
	float waterDepth = max(0.0, params.waterLevel - hC);
	float shallowFactor = 1.0 - smoothstep(0.0, 30.0, waterDepth);
	float speed = mix(1.2, 0.6, shallowFactor); // Waves slow down in shallower water

	// Shading amplitude: what the normal/lighting sees. Never capped by this ring's vertex
	// spacing and never faded by distance -- the surface always looks like it has waves, even on
	// a far/coarse ring whose mesh stays flat (geometryAmp below). Still scales down in shallow
	// water, same relationship as before.
	float shadingAmp = mix(0.3, 1.8, clamp(waterDepth / 15.0, 0.0, 1.0));

	// Geometry amplitude: what actually displaces the vertex. Capped by this ring's own vertex
	// spacing so the mesh can't be asked to fold over into a steeper slope than it has triangles
	// to represent, and gated to fade out with distance -- unless the water here is shallow, in
	// which case the mesh keeps moving regardless of distance (shoreline/shallow-bay chop is a
	// geometric feature worth keeping even far from the camera, not just a shading one).
	float geometryMaxAmp = min(vertexSpacing * 0.35, 1.8);
	float geometryDistanceGate = 1.0 - smoothstep(2000.0, 8000.0, distToCam);
	float geometryGate = max(geometryDistanceGate, shallowFactor);
	float geometryAmp = mix(0.3, geometryMaxAmp, clamp(waterDepth / 15.0, 0.0, 1.0)) * geometryGate;

	// 2. Dynamic LOD frequency cascade (same calculateDynamicLOD technique as terrain.frag's
	// Macro/Medium/Micro noise): blend 3 octaves continuously by distToCam instead of picking one
	// frequency from the current ring's vertex spacing. The old vertexSpacing-driven frequency
	// only ever changed in lockstep with discrete LOD ring transitions as the camera moved, which
	// showed up as the wave pattern's frequency visibly popping at ring boundaries. Unlike the
	// amplitude split above, this frequency is shared by shading and geometry and is NOT capped by
	// vertex spacing: capping it there was this function's own earlier mistake -- it tied the
	// normal's level of detail to mesh topology too, so the maximum normal tilt changed with LOD.
	// Geometry's own anti-fold-over safety now comes entirely from geometryAmp above (bounded
	// proportional to vertexSpacing), not from suppressing frequency.
	// lodDistanceScale/baseFrequency are a first-pass tuning for water's much shorter wavelength
	// range than terrain's (terrain's own 0.001/0.050 are tuned for planet-scale geography) --
	// they still need a visual pass to confirm.
	float lodDistanceScale = 1.0 / 60.0;
	float baseFrequency = 0.08;
	float growthFactor = 2.0;
	NoiseCascade cascade = calculateDynamicLOD(distToCam * lodDistanceScale, baseFrequency, growthFactor);

	// Scale each tier's time by its own frequency (terrain.frag's identical fix) so the
	// long-wavelength tier doesn't visually race across the surface at the rate its short-
	// wavelength sibling does once both are blended together.
	vec3 tierTime = time * speed * clamp(cascade.frequencies, 0.125, 1.0);

	// 3. Phasor noise evaluation with analytical gradient, once per cascade tier
	vec3 basePos = vec3(uv.x, 0.0, uv.y);
	vec3 warpNoise = 5.0 * cross_noise(0.125 * basePos, time);

	vec3 gradNear, gradMid, gradFar;
	vec2 phaseNear = phasorNoise3DGrad((basePos + warpNoise) * cascade.frequencies.x, 1.0, waveF_3D, waveDir3D, 1.0, tierTime.x, gradNear);
	vec2 phaseMid  = phasorNoise3DGrad((basePos + warpNoise) * cascade.frequencies.y, 1.0, waveF_3D, waveDir3D, 1.0, tierTime.y, gradMid);
	vec2 phaseFar  = phasorNoise3DGrad((basePos + warpNoise) * cascade.frequencies.z, 1.0, waveF_3D, waveDir3D, 1.0, tierTime.z, gradFar);

	float valNear = phaseNear.x / max(length(phaseNear), 0.001);
	float valMid  = phaseMid.x  / max(length(phaseMid),  0.001);
	float valFar  = phaseFar.x  / max(length(phaseFar),  0.001);

	float waveH = (valNear * cascade.weights.x + valMid * cascade.weights.y + valFar * cascade.weights.z) * geometryAmp;

	// gradNear/Mid/Far are already the gradient of the normalized (phase.x / |phase|) ratio above
	// -- phasorNoise3DGrad's own internal chain rule, see its doc comment -- so only the frequency
	// chain rule from scaling the position argument needs applying here, matching terrain.frag's
	// identical pattern. Soft-clamped per tier (same as terrain.frag's macroGrad/mediumGrad/
	// microGrad) before blending: phasorNoise3DGrad's gradient has a genuine singularity as the
	// phasor sum's own magnitude approaches zero, and an unclamped spike from just one tier could
	// swing the blended slope far past anything the real wave shape implies, reading as a
	// grazing-angle dark patch on the side of a crest. (It can't actually be a downward-facing
	// normal -- the vec3(-dx, 1, -dz) construction below has a fixed, always-positive "1", so
	// normalize() can never flip its sign -- but an extreme-enough tilt looks just as wrong.)
	vec2 gNear = gradNear.xz * cascade.frequencies.x;
	vec2 gMid  = gradMid.xz  * cascade.frequencies.y;
	vec2 gFar  = gradFar.xz  * cascade.frequencies.z;
	gNear /= (1.0 + length(gNear));
	gMid  /= (1.0 + length(gMid));
	gFar  /= (1.0 + length(gFar));

	vec2 dH_dxz = (gNear * cascade.weights.x + gMid * cascade.weights.y + gFar * cascade.weights.z) * shadingAmp;

	// Surface normal from height gradient
	vec3 n = vec3(-dH_dxz.x, 1.0, -dH_dxz.y);
	normal = normalize(n);

	return vec3(0.0, waveH, 0.0);
}

void main() {
	uint taskIndex = gl_WorkGroupID.x;
	uint meshletID = payload.meshletIDs[taskIndex];
	uint ringLevel = payload.lodLevels[taskIndex];

	SetMeshOutputsEXT(141, 240);

	uint lx = gl_LocalInvocationID.x;
	uint ly = gl_LocalInvocationID.y;
	uint vertexIndex = ly * 11 + lx;

	uint meshletsPerRow = params.gridParams.y;
	uint totalPerRing = meshletsPerRow * meshletsPerRow;
	uint localID = meshletID % totalPerRing;

	uint row = localID / meshletsPerRow;
	uint col = localID % meshletsPerRow;

	vec3  camForward = normalize(-uInvViewMatrix[2].xyz);
	float pitch = abs(camForward.y);
	float lowAngleFactor = clamp(1.0 - pitch * 2.5, 0.0, 1.0);
	float angleCompression = mix(1.0, 0.65, lowAngleFactor);

	float baseMeshletSize = 24.0;
	float meshletSize = baseMeshletSize * getWaterRingScale(float(ringLevel)) * angleCompression;

	float texelSize = (uCameraPosition.w > 0.0 ? uCameraPosition.w : 0.5) * getWaterRingScale(float(ringLevel));
	vec2 cameraSnap = floor(uCameraPosition.xz / texelSize) * texelSize;
	vec2 relCameraSnap = cameraSnap - uCameraPosition.xz;
	vec2 relMeshletMinXZ = relCameraSnap + (vec2(float(col), float(row)) - float(meshletsPerRow) * 0.5) * meshletSize;
	// Absolute-space counterpart of relMeshletMinXZ, built straight from cameraSnap instead of
	// through uCameraPosition.xz -- used only for the noise-sampling position below.
	// uCameraPosition.xz + relCameraSnap only cancels back to cameraSnap in real-number math; in
	// float32 the rounding residue tracks camPos's own continuously-changing bit pattern even
	// though the intended sample position is a pure function of the snapped grid cell, which
	// showed up as the wave shape (and its normal) visibly shimmering as the camera moved (same
	// fix as terrain.mesh's morphedWorldXZ).
	vec2 absMeshletMinXZ = cameraSnap + (vec2(float(col), float(row)) - float(meshletsPerRow) * 0.5) * meshletSize;

	vec2 localPos = vec2(float(lx) / 10.0, float(ly) / 10.0) * meshletSize;
	vec2 relBaseXZ = relMeshletMinXZ + localPos;
	vec2 absBaseXZ = absMeshletMinXZ + localPos;

	vec2 offsetDist = abs(relBaseXZ);
	float distToCam = max(offsetDist.x, offsetDist.y);
	float outerDist = (float(meshletsPerRow) * 0.5) * meshletSize;
	vec2 relMorphedXZ = relBaseXZ;
	vec2 absMorphedXZ = absBaseXZ;

	if (ringLevel < params.gridParams.x - 1 && outerDist > 0.0) {
		float morphWidth = 2.0 * meshletSize;
		float morphStart = max(0.0, outerDist - morphWidth);
		if (distToCam > morphStart) {
			float alpha = clamp((distToCam - morphStart) / max(outerDist - morphStart, 0.001), 0.0, 1.0);
			alpha = alpha * alpha * (3.0 - 2.0 * alpha);

			vec2 targetLocalPos = vec2(floor(float(lx) / 2.0) * 2.0, floor(float(ly) / 2.0) * 2.0) * (meshletSize / 10.0);
			vec2 relTargetXZ = relMeshletMinXZ + targetLocalPos;
			vec2 absTargetXZ = absMeshletMinXZ + targetLocalPos;
			relMorphedXZ = mix(relBaseXZ, relTargetXZ, alpha);
			absMorphedXZ = mix(absBaseXZ, absTargetXZ, alpha);
		}
	}

	vec2 worldXZ = absMorphedXZ;

	float vertexSpacing = meshletSize / 10.0;
	vec3 waveNormal;
	vec3 waveOffset = calculatePhasorOffsetAndNormal(worldXZ, uTime, length(relMorphedXZ), float(ringLevel), vertexSpacing, waveNormal);

	float distSq = dot(relMorphedXZ, relMorphedXZ);
	float dropOff = distSq / (2.0 * FAKE_PLANET_RADIUS);

	vec3 relWorldPos = vec3(relMorphedXZ.x, params.waterLevel - uCameraPosition.y, relMorphedXZ.y) + waveOffset - vec3(0.0, dropOff, 0.0);

	vec3 viewPos = mat3(uViewMatrix) * relWorldPos;
	gl_MeshVerticesEXT[vertexIndex].gl_Position = uProjMatrix * vec4(viewPos, 1.0);
	outWorldPos[vertexIndex] = relWorldPos;
	outNormal[vertexIndex] = waveNormal;

	bool isBoundarySample = (lx % 2 == 0) && (ly % 2 == 0) && (lx == 0 || lx == 10 || ly == 0 || ly == 10);
	if (isBoundarySample) {
		uint skirtID;
		if (ly == 0) {
			skirtID = lx / 2;
		} else if (ly == 10) {
			skirtID = 6 + lx / 2;
		} else if (lx == 0) {
			skirtID = 12 + (ly / 2 - 1);
		} else {
			skirtID = 16 + (ly / 2 - 1);
		}
		uint skirtIdx = 121 + skirtID;

		float skirtDepth = max(0.0, meshletSize * 0.005);
		vec3  relSkirtPos = relWorldPos - vec3(0.0, skirtDepth, 0.0);

		vec3 skirtViewPos = mat3(uViewMatrix) * relSkirtPos;
		gl_MeshVerticesEXT[skirtIdx].gl_Position = uProjMatrix * vec4(skirtViewPos, 1.0);
		outWorldPos[skirtIdx] = relSkirtPos;
		outNormal[skirtIdx] = waveNormal;
	}

	if (lx < 10 && ly < 10) {
		uint quadIdx = ly * 10 + lx;
		uint v0 = ly * 11 + lx;
		uint v1 = ly * 11 + (lx + 1);
		uint v2 = (ly + 1) * 11 + lx;
		uint v3 = (ly + 1) * 11 + (lx + 1);

		gl_PrimitiveTriangleIndicesEXT[quadIdx * 2 + 0] = uvec3(v0, v2, v1);
		gl_PrimitiveTriangleIndicesEXT[quadIdx * 2 + 1] = uvec3(v1, v2, v3);

		bool cullQuad = false;
		if (ringLevel > 0) {
			float prevMeshletSize = baseMeshletSize * getWaterRingScale(float(ringLevel - 1)) * angleCompression;
			float prevTexelSize = (uCameraPosition.w > 0.0 ? uCameraPosition.w : 0.5) * getWaterRingScale(float(ringLevel - 1));
			vec2  prevRelSnap = floor(uCameraPosition.xz / prevTexelSize) * prevTexelSize - uCameraPosition.xz;
			float prevExtent = float(meshletsPerRow) * 0.5 * prevMeshletSize;

			vec2 quadCenterLocal = vec2(float(lx) + 0.5, float(ly) + 0.5) / 10.0 * meshletSize;
			vec2 quadCenterRel = relMeshletMinXZ + quadCenterLocal;

			vec2 dist = abs(quadCenterRel - prevRelSnap);
			if (max(dist.x, dist.y) < prevExtent - (meshletSize * 0.01)) {
				cullQuad = true;
			}
		}

		gl_MeshPrimitivesEXT[quadIdx * 2 + 0].gl_CullPrimitiveEXT = cullQuad;
		gl_MeshPrimitivesEXT[quadIdx * 2 + 1].gl_CullPrimitiveEXT = cullQuad;
	}

	if (ly == 0 && lx < 10 && lx % 2 == 0) { // Top edge
		uint s = lx / 2;
		uint v0 = lx;
		uint v1 = lx + 2;
		uint k0 = 121 + s;
		uint k1 = 121 + s + 1;
		uint primIdx = 200 + s * 2;

		gl_PrimitiveTriangleIndicesEXT[primIdx + 0] = uvec3(v0, k0, v1);
		gl_PrimitiveTriangleIndicesEXT[primIdx + 1] = uvec3(v1, k0, k1);
		gl_MeshPrimitivesEXT[primIdx + 0].gl_CullPrimitiveEXT = true;
		gl_MeshPrimitivesEXT[primIdx + 1].gl_CullPrimitiveEXT = true;
	}

	if (ly == 10 && lx < 10 && lx % 2 == 0) { // Bottom edge
		uint s = lx / 2;
		uint v0 = 110 + lx;
		uint v1 = 110 + lx + 2;
		uint k0 = 121 + 6 + s;
		uint k1 = 121 + 6 + s + 1;
		uint primIdx = 210 + s * 2;

		gl_PrimitiveTriangleIndicesEXT[primIdx + 0] = uvec3(v1, k1, v0);
		gl_PrimitiveTriangleIndicesEXT[primIdx + 1] = uvec3(v0, k1, k0);
		gl_MeshPrimitivesEXT[primIdx + 0].gl_CullPrimitiveEXT = true;
		gl_MeshPrimitivesEXT[primIdx + 1].gl_CullPrimitiveEXT = true;
	}

	if (lx == 0 && ly < 10 && ly % 2 == 0) { // Left edge
		uint s = ly / 2;
		uint v0 = ly * 11;
		uint v1 = (ly + 2) * 11;
		uint k0 = (s == 0) ? 121 : (121 + 12 + (s - 1));
		uint k1 = (s + 1 == 5) ? 127 : (121 + 12 + s);
		uint primIdx = 220 + s * 2;

		gl_PrimitiveTriangleIndicesEXT[primIdx + 0] = uvec3(v1, k1, v0);
		gl_PrimitiveTriangleIndicesEXT[primIdx + 1] = uvec3(v0, k1, k0);
		gl_MeshPrimitivesEXT[primIdx + 0].gl_CullPrimitiveEXT = true;
		gl_MeshPrimitivesEXT[primIdx + 1].gl_CullPrimitiveEXT = true;
	}

	if (lx == 10 && ly < 10 && ly % 2 == 0) { // Right edge
		uint s = ly / 2;
		uint v0 = ly * 11 + 10;
		uint v1 = (ly + 2) * 11 + 10;
		uint k0 = (s == 0) ? 126 : (121 + 16 + (s - 1));
		uint k1 = (s + 1 == 5) ? 132 : (121 + 16 + s);
		uint primIdx = 230 + s * 2;

		gl_PrimitiveTriangleIndicesEXT[primIdx + 0] = uvec3(v0, k0, v1);
		gl_PrimitiveTriangleIndicesEXT[primIdx + 1] = uvec3(v1, k0, k1);
		gl_MeshPrimitivesEXT[primIdx + 0].gl_CullPrimitiveEXT = true;
		gl_MeshPrimitivesEXT[primIdx + 1].gl_CullPrimitiveEXT = true;
	}
}
