#version 460
#extension GL_EXT_mesh_shader : require

#include "bindless.glsl"
#include "common.glsl"
#include "lygia/generative/gerstnerWave.glsl"
#include "terrain.glsl"

layout(local_size_x = 11, local_size_y = 11, local_size_z = 1) in;
layout(triangles, max_vertices = 141, max_primitives = 240) out;

layout(push_constant) uniform WaterPushConstants {
	uvec4 gridParams; // x = numRings, y = meshletsPerRow, z = totalMeshlets, w = textureDim
	vec3  waterColor;
	float waterLevel;
	uint  gPositionIndex;
	uint  gAlbedoIndex;
	uint  gNormalIndex;
	uint  biomeIndex;
	uint  visibilityIndex;
	uint  clipmapIndex;
	uint  padding0;
	uint  padding1;
	uvec4 lodOffsets0_3;
	uvec4 lodOffsets4_7;
} params;

struct TaskPayload {
	uint meshletIDs[32];
	uint lodLevels[32];
};

taskPayloadSharedEXT TaskPayload payload;

layout(location = 0) out vec3 outWorldPos[];
layout(location = 1) out vec3 outNormal[];

// Water ring distance scale: continuous growth with distance from camera
float getWaterRingScale(float ring) {
	// if (ring <= 3.0) {
		return pow(2.0, ring);
	// }
	// return 8.0 * pow(2.25, ring - 3.0);
}

float estTerrainHeight(vec2 worldXZ) {
	vec3 pos = vec3(worldXZ.x, 0.0, worldXZ.y);
	vec3 warp = cross_noise_fbm(pos * 0.005, 3, 0.0);
	pos += 50.0 * warp;
	float b = dot_noise(pos * 0.0003, 0.0);
	float m = dot_noise(pos * 0.0008, 0.0);
	float baseVal = dot_noise_fbm(pos * 0.0015, 4, 0.0);
	float detailVal = dot_noise_fbm(pos * 0.006, 4, 0.0);

	float biome = clamp(b, 0.0, 1.0);
	float mountainFactor = clamp((m - (-0.1)) / 0.4, 0.0, 1.0);
	mountainFactor = mountainFactor * mountainFactor * (3.0 - 2.0 * mountainFactor);
	float detailFactor = (0.15 + 0.85 * mountainFactor) * mix(0.3, 1.2, biome);

	float baseOffset = mix(-35.0, 30.0, biome);
	float baseHeightScale = mix(40.0, 120.0, biome);
	float detailHeightScale = mix(20.0, 80.0, biome);

	return baseOffset + baseVal * baseHeightScale + detailVal * detailHeightScale * detailFactor;
}

// Add this above calculateGerstnerOffsetAndNormal
float estSmoothTerrainHeight(vec2 worldXZ) {
	vec3 pos = vec3(worldXZ.x, 0.0, worldXZ.y);

	// Only evaluate the lowest frequency noise. Skip FBM and detail noise.
	float b = dot_noise(pos * 0.0003, 0.0);
	float baseVal = dot_noise(pos * 0.0015, 0.0);

	float biome = clamp(b, 0.0, 1.0);
	float baseOffset = mix(-35.0, 30.0, biome);
	float baseHeightScale = mix(40.0, 120.0, biome);

	return baseOffset + baseVal * baseHeightScale;
}

vec3 calculateGerstnerOffsetAndNormal(vec2 uv, float time, float distToCam, float ringLevel, float vertexSpacing, out vec3 normal) {
	if (ringLevel >= 4.0) {
		normal = vec3(0.0, 1.0, 0.0);
		return vec3(0.0);
	}

	vec3 tangent = vec3(1.0, 0.0, 0.0);
	vec3 binormal = vec3(0.0, 0.0, 1.0);
	vec3 totalOffset = vec3(0.0);

	// Distance-proportional wave amplitude damping
	float mainWaveFade = clamp(1.0 - (distToCam - 600.0) / 2200.0, 0.0, 1.0);
	float mediumWaveFade = clamp(1.0 - (distToCam - 300.0) / 1200.0, 0.0, 1.0);
	float rippleFade = clamp(1.0 - distToCam / 400.0, 0.0, 1.0);

	// Dynamic wave directions shifting continuously over time
	vec2 d1 = normalize(vec2(0.8 + 0.15 * sin(time * 0.05), 0.6 + 0.15 * cos(time * 0.06)));
	vec2 d2 = normalize(vec2(-0.6 + 0.12 * cos(time * 0.04), 0.8 + 0.12 * sin(time * 0.07)));
	vec2 d3 = normalize(vec2(0.3 + 0.18 * sin(time * 0.08), -0.95 + 0.12 * cos(time * 0.09)));
	vec2 d4 = normalize(vec2(-0.85 + 0.15 * cos(time * 0.06), -0.3 + 0.15 * sin(time * 0.05)));

	vec2 globalWindDir = normalize(cross_noise(vec3(uv.x, 0.0, uv.y) * 0.001, time * 0.010).xz);

	// Sample fluid flow map and shoreline distance
	vec2 flowMap = vec2(0.0, 1.0);
	float shoreDist = 100.0;
	float flowStrength = 0.0;

	if (params.biomeIndex > 0u && params.visibilityIndex > 0u) {
		flowMap = sampleTerrainFlow(params.biomeIndex, uv, 0u, params.gridParams.w, params.lodOffsets0_3, params.lodOffsets4_7);
		vec4 visData = sampleTerrainTileVisibility(params.visibilityIndex, uv, 0u, params.gridParams.w, params.lodOffsets0_3, params.lodOffsets4_7);
		shoreDist = visData.r;
		flowStrength = visData.g;
	}

	if (dot(flowMap, flowMap) > 0.0001) {
		flowMap = normalize(flowMap);
	} else {
		flowMap = globalWindDir;
	}

	float shoreWeight = clamp(1.0 - shoreDist / 50.0, 0.0, 1.0);
	float flowWeight = max(shoreWeight, clamp(flowStrength, 0.0, 1.0));

	if (flowWeight > 0.01) {
		d1 = normalize(mix(d1, flowMap, flowWeight * 0.85));
		d2 = normalize(mix(d2, flowMap, flowWeight * 0.75));
		d3 = normalize(mix(d3, flowMap, flowWeight * 0.65));
		d4 = normalize(mix(d4, flowMap, flowWeight * 0.50));
	}

	// Default deep water parameters
	float wl1 = 60.0, spd1 = 1.2;
	float wl2 = 38.0, spd2 = 1.5;
	float wl3 = 22.0, spd3 = 2.0;
	float wl4 = 12.0, spd4 = 2.8;

	// Nyquist frequency limits on Gerstner wave octaves based on vertex grid spacing
	float nyquistMinWavelength = 2.0 * vertexSpacing;

	float waveAttn1 = clamp((wl1 - nyquistMinWavelength) / (nyquistMinWavelength * 0.5 + 0.001), 0.0, 1.0);
	float waveAttn2 = clamp((wl2 - nyquistMinWavelength) / (nyquistMinWavelength * 0.5 + 0.001), 0.0, 1.0);
	float waveAttn3 = clamp((wl3 - nyquistMinWavelength) / (nyquistMinWavelength * 0.5 + 0.001), 0.0, 1.0);
	float waveAttn4 = clamp((wl4 - nyquistMinWavelength) / (nyquistMinWavelength * 0.5 + 0.001), 0.0, 1.0);

	// Primary swell
	if (mainWaveFade > 0.001) {
		float vectorAdjustment = dot(d1, d2) * 0.5 + 0.5;
		mainWaveFade *= vectorAdjustment;
		if (waveAttn1 > 0.001) totalOffset += vectorAdjustment * gerstnerWave(uv, d1, 0.18 * mainWaveFade * waveAttn1, wl1, time * spd1, tangent, binormal);
		if (waveAttn2 > 0.001) totalOffset += vectorAdjustment * gerstnerWave(uv, d2, 0.14 * mainWaveFade * waveAttn2, wl2, time * spd2, tangent, binormal);
	}

	// Medium waves
	if (mediumWaveFade > 0.001) {
		float vectorAdjustment = dot(d3, d4) * 0.5 + 0.5;
		mediumWaveFade *= vectorAdjustment;
		if (waveAttn3 > 0.001) totalOffset += vectorAdjustment * gerstnerWave(uv, d3, 0.10 * mediumWaveFade * waveAttn3, wl3, time * spd3, tangent, binormal);
		if (waveAttn4 > 0.001) totalOffset += vectorAdjustment * gerstnerWave(uv, d4, 0.06 * mediumWaveFade * waveAttn4, wl4, time * spd4, tangent, binormal);
	}

	// Micro ripples
	float wl5 = 5.0, wl6 = 2.5;
	float waveAttn5 = clamp((wl5 - nyquistMinWavelength) / (nyquistMinWavelength * 0.5 + 0.001), 0.0, 1.0);
	float waveAttn6 = clamp((wl6 - nyquistMinWavelength) / (nyquistMinWavelength * 0.5 + 0.001), 0.0, 1.0);

	if (rippleFade > 0.001 && (waveAttn5 > 0.001 || waveAttn6 > 0.001)) {
		vec2 d5 = normalize(vec2(0.95 + 0.05 * sin(time * 0.1), 0.1 + 0.05 * cos(time * 0.12)));
		vec2 d6 = normalize(vec2(-0.2 + 0.05 * cos(time * 0.11), 0.98 + 0.05 * sin(time * 0.13)));

		if (flowWeight > 0.01) {
			d5 = normalize(mix(d5, flowMap, flowWeight * 0.40));
			d6 = normalize(mix(d6, flowMap, flowWeight * 0.30));
		}

		float vectorAdjustment = dot(d5, d6) * 0.5 + 0.5;
		rippleFade *= vectorAdjustment;

		if (waveAttn5 > 0.001) totalOffset += vectorAdjustment * gerstnerWave(uv, d5, 0.04 * rippleFade * waveAttn5, wl5, time * 1.0, tangent, binormal);
		if (waveAttn6 > 0.001) totalOffset += vectorAdjustment * gerstnerWave(uv, d6, 0.03 * rippleFade * waveAttn6, wl6, time * 1.2, tangent, binormal);
	}

	float blend = step(3, ringLevel) * smoothstep(3000, 4000, distToCam);

	normal = normalize(cross(binormal, tangent));
	normal = mix(normal, vec3(0.0), blend);
	return mix(totalOffset, totalOffset, blend);
}

void main() {
	uint taskIndex = gl_WorkGroupID.x;
	uint meshletID = payload.meshletIDs[taskIndex];
	uint ringLevel = payload.lodLevels[taskIndex];

	SetMeshOutputsEXT(141, 240);

	uint lx = gl_LocalInvocationID.x;
	uint ly = gl_LocalInvocationID.y;
	uint vertexIndex = ly * 11 + lx;

	uint meshletsPerRow = params.gridParams.y;
	uint totalPerRing = meshletsPerRow * meshletsPerRow;
	uint localID = meshletID % totalPerRing;

	uint row = localID / meshletsPerRow;
	uint col = localID % meshletsPerRow;

	// Low camera pitch angle detection: boost density when camera angle is grazing horizontal
	vec3  camForward = normalize(-uInvViewMatrix[2].xyz);
	float pitch = abs(camForward.y);
	float lowAngleFactor = clamp(1.0 - pitch * 2.5, 0.0, 1.0);
	float angleCompression = mix(1.0, 0.65, lowAngleFactor);

	float baseMeshletSize = 24.0;
	float meshletSize = baseMeshletSize * getWaterRingScale(float(ringLevel)) * angleCompression;

	vec2 cameraSnap = floor(uCameraPosition.xz / meshletSize) * meshletSize;
	vec3 meshletMin = vec3(
		cameraSnap.x + (float(col) - float(meshletsPerRow) * 0.5) * meshletSize,
		params.waterLevel,
		cameraSnap.y + (float(row) - float(meshletsPerRow) * 0.5) * meshletSize
	);

// 	vec2 localPos = vec2(float(lx) / 10.0, float(ly) / 10.0) * meshletSize;
// 	vec2 baseWorldXZ = meshletMin.xz + localPos;
// 	vec2 worldXZ = baseWorldXZ;

// 	// Low camera angle forward-view density boost: compress vertex distribution towards view direction
// 	if (lowAngleFactor > 0.01) {
// 		vec2  toVertex = worldXZ - uCameraPosition.xz;
// 		float distToCam = length(toVertex);
// 		if (distToCam > 1.0) {
// 			vec2  dir = toVertex / distToCam;
// 			float viewDot = dot(dir, normalize(camForward.xz + vec2(0.0001)));
// 			if (viewDot > 0.0) {
// 				float bias = lowAngleFactor * 0.15 * viewDot * exp(-distToCam * 0.001);
// 				worldXZ -= dir * (distToCam * bias);
// 			}
// 		}
// 	}

// 	// // Shoreline vertex density refinement: shift vertices towards shoreline depth contour to prevent triangular wave shapes
// 	// float estH = estTerrainHeight(worldXZ);
// 	// float depth = params.waterLevel - estH;
// 	// float shoreFactor = clamp(1.0 - abs(depth - 2.0) / 10.0, 0.0, 1.0);
// 	// if (shoreFactor > 0.01) {
// 	// 	float eps = 2.0;
// 	// 	vec2  grad = vec2(
// 	// 		estTerrainHeight(worldXZ + vec2(eps, 0.0)) - estTerrainHeight(worldXZ - vec2(eps, 0.0)),
// 	// 		estTerrainHeight(worldXZ + vec2(0.0, eps)) - estTerrainHeight(worldXZ - vec2(0.0, eps))
// 	// 	);
// 	// 	float gradLenSq = dot(grad, grad);
// 	// 	if (gradLenSq > 0.0001) {
// 	// 		vec2 shoreShift = normalize(grad) * (shoreFactor * 1.5);
// 	// 		worldXZ += shoreShift * 0.35;
// 	// 	}
// 	// }

// vec2 offsetDist = abs(worldXZ - cameraSnap);
// float distToCam = max(offsetDist.x, offsetDist.y);
// 	// float distToCam = length(worldXZ - uCameraPosition.xz);

// 	// Morphing towards coarse grid at outer boundaries
// 	float outerDist = (float(meshletsPerRow) * 0.5) * meshletSize;
// 	if (ringLevel < params.gridParams.x - 1 && outerDist > 0.0) {
// 		float morphWidth = 2.0 * meshletSize;
// 		float morphStart = max(0.0, outerDist - morphWidth);
// 		if (distToCam > morphStart) {
// 			float alpha = clamp((distToCam - morphStart) / max(outerDist - morphStart, 0.001), 0.0, 1.0);
// 			alpha = alpha * alpha * (3.0 - 2.0 * alpha);

// 			float nextMeshletSize = baseMeshletSize * getWaterRingScale(float(ringLevel + 1)) * angleCompression;
// 			float targetCellSize = nextMeshletSize * 0.1;
// vec2 targetLocalPos = vec2(
//     floor(float(lx) / 2.0) * 2.0,
//     floor(float(ly) / 2.0) * 2.0
// ) * (meshletSize / 10.0);

// vec2 targetXZ = meshletMin.xz + targetLocalPos;

// // Apply morph
// worldXZ = mix(worldXZ, targetXZ, alpha);

// 		}
// 	}




	vec2 localPos = vec2(float(lx) / 10.0, float(ly) / 10.0) * meshletSize;
	vec2 baseWorldXZ = meshletMin.xz + localPos;

	// 1. Evaluate morphing against the pure, unshifted grid
	vec2 offsetDist = abs(baseWorldXZ - cameraSnap);
	float distToCam = max(offsetDist.x, offsetDist.y);
	float outerDist = (float(meshletsPerRow) * 0.5) * meshletSize;
	vec2 morphedXZ = baseWorldXZ;

	if (ringLevel < params.gridParams.x - 1 && outerDist > 0.0) {
		float morphWidth = 2.0 * meshletSize;
		float morphStart = max(0.0, outerDist - morphWidth);
		if (distToCam > morphStart) {
			float alpha = clamp((distToCam - morphStart) / max(outerDist - morphStart, 0.001), 0.0, 1.0);
			alpha = alpha * alpha * (3.0 - 2.0 * alpha);

			vec2 targetLocalPos = vec2(floor(float(lx) / 2.0) * 2.0, floor(float(ly) / 2.0) * 2.0) * (meshletSize / 10.0);
			vec2 targetXZ = meshletMin.xz + targetLocalPos;
			morphedXZ = mix(baseWorldXZ, targetXZ, alpha);
		}
	}

	vec2 worldXZ = morphedXZ;

	// // 2. Apply camera angle density boost to the already-morphed coordinates
	// if (lowAngleFactor > 0.01) {
	// 	vec2 toVertex = worldXZ - uCameraPosition.xz;
	// 	float actualDist = length(toVertex);
	// 	if (actualDist > 1.0) {
	// 		vec2 dir = toVertex / actualDist;
	// 		float viewDot = dot(dir, normalize(camForward.xz + vec2(0.0001)));
	// 		if (viewDot > 0.0) {
	// 			float bias = lowAngleFactor * 0.15 * viewDot * exp(-actualDist * 0.001);
	// 			worldXZ -= dir * (actualDist * bias);
	// 		}
	// 	}
	// }

	// 3. Generate Gerstner waves at final coordinate
	vec3 waveNormal;
	float vertexSpacing = meshletSize / 10.0;
	vec3 waveOffset = calculateGerstnerOffsetAndNormal(worldXZ, uTime, length(worldXZ - uCameraPosition.xz), float(ringLevel), vertexSpacing, waveNormal);

	// vec3 waveNormal;
	// vec3 waveOffset = calculateGerstnerOffsetAndNormal(worldXZ, uTime, distToCam, float(ringLevel), waveNormal);
	vec3 finalWorldPos = vec3(worldXZ.x, params.waterLevel, worldXZ.y) + waveOffset;

	// Curved planet horizon dropoff
	vec2  flatXZ = worldXZ - uCameraPosition.xz;
	float distSq = dot(flatXZ, flatXZ);
	float dropOff = distSq / (2.0 * FAKE_PLANET_RADIUS);
	finalWorldPos.y -= dropOff;

	gl_MeshVerticesEXT[vertexIndex].gl_Position = uViewProjMatrix * vec4(finalWorldPos, 1.0);
	outWorldPos[vertexIndex] = finalWorldPos;
	outNormal[vertexIndex] = waveNormal;

	// Boundary skirt vertices along meshlet borders to prevent gaps
	bool isBoundarySample = (lx % 2 == 0) && (ly % 2 == 0) && (lx == 0 || lx == 10 || ly == 0 || ly == 10);
	if (isBoundarySample) {
		uint skirtID;
		if (ly == 0) {
			skirtID = lx / 2;
		} else if (ly == 10) {
			skirtID = 6 + lx / 2;
		} else if (lx == 0) {
			skirtID = 12 + (ly / 2 - 1);
		} else {
			skirtID = 16 + (ly / 2 - 1);
		}
		uint skirtIdx = 121 + skirtID;

		float skirtDepth = max(0.0, meshletSize * 0.005);
		vec3  skirtPos = finalWorldPos - vec3(0.0, skirtDepth, 0.0);

		gl_MeshVerticesEXT[skirtIdx].gl_Position = uViewProjMatrix * vec4(skirtPos, 1.0);
		outWorldPos[skirtIdx] = skirtPos;
		outNormal[skirtIdx] = waveNormal;
	}

	// Quad primitives output (10x10 quads = 200 triangles)
	if (lx < 10 && ly < 10) {
		uint quadIdx = ly * 10 + lx;
		uint v0 = ly * 11 + lx;
		uint v1 = ly * 11 + (lx + 1);
		uint v2 = (ly + 1) * 11 + lx;
		uint v3 = (ly + 1) * 11 + (lx + 1);

		gl_PrimitiveTriangleIndicesEXT[quadIdx * 2 + 0] = uvec3(v0, v2, v1);
		gl_PrimitiveTriangleIndicesEXT[quadIdx * 2 + 1] = uvec3(v1, v2, v3);

		bool cullQuad = false;
		if (ringLevel > 0) {
			float prevMeshletSize = baseMeshletSize * getWaterRingScale(float(ringLevel - 1)) * angleCompression;
			vec2  prevCameraSnap = floor(uCameraPosition.xz / prevMeshletSize) * prevMeshletSize;
			float prevExtent = float(meshletsPerRow) * 0.5 * prevMeshletSize;

			vec2 quadCenterLocal = vec2(float(lx) + 0.5, float(ly) + 0.5) / 10.0 * meshletSize;
			vec2 quadCenterWorld = meshletMin.xz + quadCenterLocal;

			vec2 dist = abs(quadCenterWorld - prevCameraSnap);
			if (max(dist.x, dist.y) < prevExtent - (meshletSize * 0.01)) {
				cullQuad = true;
			}
		}

		gl_MeshPrimitivesEXT[quadIdx * 2 + 0].gl_CullPrimitiveEXT = cullQuad;
		gl_MeshPrimitivesEXT[quadIdx * 2 + 1].gl_CullPrimitiveEXT = cullQuad;
	}

	// Boundary skirt triangles
	if (ly == 0 && lx < 10 && lx % 2 == 0) { // Top edge
		uint s = lx / 2;
		uint v0 = lx;
		uint v1 = lx + 2;
		uint k0 = 121 + s;
		uint k1 = 121 + s + 1;
		uint primIdx = 200 + s * 2;

		gl_PrimitiveTriangleIndicesEXT[primIdx + 0] = uvec3(v0, k0, v1);
		gl_PrimitiveTriangleIndicesEXT[primIdx + 1] = uvec3(v1, k0, k1);
		gl_MeshPrimitivesEXT[primIdx + 0].gl_CullPrimitiveEXT = true;
		gl_MeshPrimitivesEXT[primIdx + 1].gl_CullPrimitiveEXT = true;
	}

	if (ly == 10 && lx < 10 && lx % 2 == 0) { // Bottom edge
		uint s = lx / 2;
		uint v0 = 110 + lx;
		uint v1 = 110 + lx + 2;
		uint k0 = 121 + 6 + s;
		uint k1 = 121 + 6 + s + 1;
		uint primIdx = 210 + s * 2;

		gl_PrimitiveTriangleIndicesEXT[primIdx + 0] = uvec3(v1, k1, v0);
		gl_PrimitiveTriangleIndicesEXT[primIdx + 1] = uvec3(v0, k1, k0);
		gl_MeshPrimitivesEXT[primIdx + 0].gl_CullPrimitiveEXT = true;
		gl_MeshPrimitivesEXT[primIdx + 1].gl_CullPrimitiveEXT = true;
	}

	if (lx == 0 && ly < 10 && ly % 2 == 0) { // Left edge
		uint s = ly / 2;
		uint v0 = ly * 11;
		uint v1 = (ly + 2) * 11;
		uint k0 = (s == 0) ? 121 : (121 + 12 + (s - 1));
		uint k1 = (s + 1 == 5) ? 127 : (121 + 12 + s);
		uint primIdx = 220 + s * 2;

		gl_PrimitiveTriangleIndicesEXT[primIdx + 0] = uvec3(v1, k1, v0);
		gl_PrimitiveTriangleIndicesEXT[primIdx + 1] = uvec3(v0, k1, k0);
		gl_MeshPrimitivesEXT[primIdx + 0].gl_CullPrimitiveEXT = true;
		gl_MeshPrimitivesEXT[primIdx + 1].gl_CullPrimitiveEXT = true;
	}

	if (lx == 10 && ly < 10 && ly % 2 == 0) { // Right edge
		uint s = ly / 2;
		uint v0 = ly * 11 + 10;
		uint v1 = (ly + 2) * 11 + 10;
		uint k0 = (s == 0) ? 126 : (121 + 16 + (s - 1));
		uint k1 = (s + 1 == 5) ? 132 : (121 + 16 + s);
		uint primIdx = 230 + s * 2;

		gl_PrimitiveTriangleIndicesEXT[primIdx + 0] = uvec3(v0, k0, v1);
		gl_PrimitiveTriangleIndicesEXT[primIdx + 1] = uvec3(v1, k0, k1);
		gl_MeshPrimitivesEXT[primIdx + 0].gl_CullPrimitiveEXT = true;
		gl_MeshPrimitivesEXT[primIdx + 1].gl_CullPrimitiveEXT = true;
	}
}
