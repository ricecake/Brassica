#version 460
#extension GL_EXT_mesh_shader : require

#include "bindless.glsl"
#include "common.glsl"
#include "terrain.glsl"

layout(local_size_x = 11, local_size_y = 11, local_size_z = 1) in;
layout(triangles, max_vertices = 141, max_primitives = 240) out;

layout(push_constant) uniform WaterPushConstants {
	uvec4 gridParams; // x = numRings, y = meshletsPerRow, z = totalMeshlets, w = textureDim
	vec3  waterColor;
	float waterLevel;
	uint  gPositionIndex;
	uint  gAlbedoIndex;
	uint  gNormalIndex;
	uint  sceneColor;
	uint  minMaxIndex;
	uint  gMaterialIndex;
	uint  skyViewIndex;
}
params;

struct TaskPayload {
	uint meshletIDs[32];
	uint lodLevels[32];
};

taskPayloadSharedEXT TaskPayload payload;

layout(location = 0) out vec3 outWorldPos[];
layout(location = 1) out vec3 outNormal[];

float getWaterRingScale(float ring) {
	return pow(2.0, ring);
}

// Samples underlying terrain height from TerrainMinMaxTexture
float getTerrainBedHeight(vec2 worldXZ, uint ringLevel) {
	if (params.minMaxIndex == 0u || params.minMaxIndex == 0xFFFFFFFFu) {
		return params.waterLevel - 50.0;
	}
	uint sampleLOD = min(ringLevel, params.gridParams.x - 1u);
	vec2 minMax = sampleTerrainMinMax(params.minMaxIndex, worldXZ, sampleLOD, params.gridParams.w);
	return minMax.x;
}

// Calculates water wave displacement and analytical normal using phasor noise aligned with terrain height gradient
vec3 calculatePhasorOffsetAndNormal(vec2 uv, float time, float distToCam, float ringLevel, float vertexSpacing, out vec3 normal) {
	// If too far or ringLevel high, fade out wave deformation
	if (ringLevel >= 8.0) {
		normal = vec3(0.0, 1.0, 0.0);
		return vec3(0.0);
	}

	// 1. Sample underlying terrain height gradient
	float eps = max(2.0, vertexSpacing);
	float hC  = getTerrainBedHeight(uv, uint(ringLevel));
	float hE  = getTerrainBedHeight(uv + vec2(eps, 0.0), uint(ringLevel));
	float hW  = getTerrainBedHeight(uv - vec2(eps, 0.0), uint(ringLevel));
	float hN  = getTerrainBedHeight(uv + vec2(0.0, eps), uint(ringLevel));
	float hS  = getTerrainBedHeight(uv - vec2(0.0, eps), uint(ringLevel));

	vec2 terrainGrad = vec2((hE - hW) / (2.0 * eps), (hN - hS) / (2.0 * eps));
	float gradLen = length(terrainGrad);

	// Wave alignment: waves tend to refract and align with depth contours, traveling up the slope / towards shore
	vec2 waveDir;
	if (gradLen > 0.005) {
		// Normal wave vector points in direction of increasing height (towards shore)
		waveDir = terrainGrad / gradLen;
	} else {
		// Default prevailing current/wave direction
		waveDir = vec2(0.7071, 0.7071);
	}

	vec3 waveDir3D = vec3(waveDir.x, 0.0, waveDir.y);
	vec3 waveF_3D  = waveDir3D;

	// Water depth at this vertex
	float waterDepth = max(0.0, params.waterLevel - hC);
	float shallowFactor = 1.0 - smoothstep(0.0, 30.0, waterDepth);

	// 2. Vertex spacing frequency and scale bounds (Nyquist limit: wavelength lambda >= 2.5 * vertexSpacing)
	float minWavelength = max(2.5 * vertexSpacing, 4.0);
	float maxFreq = (2.0 * PI) / minWavelength;

	// Base wave frequencies bounded by maxFreq
	float baseFreq = clamp(0.08, 0.001, maxFreq);
	float speed = mix(1.2, 0.6, shallowFactor); // Waves slow down in shallower water

	// Amplitude scaled to vertex spacing to avoid steep slope fold-overs
	float maxAmp = min(vertexSpacing * 0.35, 1.8);
	float amp = mix(0.3, maxAmp, clamp(waterDepth / 15.0, 0.0, 1.0));
	amp *= (1.0 - smoothstep(2000.0, 8000.0, distToCam));

	if (amp <= 0.001) {
		normal = vec3(0.0, 1.0, 0.0);
		return vec3(0.0);
	}

	// 3. Phasor noise evaluation with analytical gradient
	vec3 p = vec3(uv.x, 0.0, uv.y) * baseFreq;
	vec3 phasorGrad;
	vec2 phase = phasorNoise3DGrad(p, 1.0, waveF_3D, waveDir3D, 0.45, time * speed, phasorGrad);

	// Wave height from phase.x normalized
	float phaseNorm = max(length(phase), 0.001);
	float waveH = (phase.x / phaseNorm) * amp;

	// Convert phasor spatial gradient to world space gradient dH/dx and dH/dz
	// Chain rule: d(phase)/dx = phasorGrad.x * baseFreq
	vec2 dH_dxz = (phasorGrad.xz * (baseFreq * amp / phaseNorm));

	// Surface normal from height gradient, clamped to avoid inverted/backward facing normals
	vec3 n = vec3(-dH_dxz.x, 1.0, -dH_dxz.y);
	n.y = max(0.2, n.y);
	normal = normalize(n);

	return vec3(0.0, waveH, 0.0);
}

void main() {
	uint taskIndex = gl_WorkGroupID.x;
	uint meshletID = payload.meshletIDs[taskIndex];
	uint ringLevel = payload.lodLevels[taskIndex];

	SetMeshOutputsEXT(141, 240);

	uint lx = gl_LocalInvocationID.x;
	uint ly = gl_LocalInvocationID.y;
	uint vertexIndex = ly * 11 + lx;

	uint meshletsPerRow = params.gridParams.y;
	uint totalPerRing = meshletsPerRow * meshletsPerRow;
	uint localID = meshletID % totalPerRing;

	uint row = localID / meshletsPerRow;
	uint col = localID % meshletsPerRow;

	vec3  camForward = normalize(-uInvViewMatrix[2].xyz);
	float pitch = abs(camForward.y);
	float lowAngleFactor = clamp(1.0 - pitch * 2.5, 0.0, 1.0);
	float angleCompression = mix(1.0, 0.65, lowAngleFactor);

	float baseMeshletSize = 24.0;
	float meshletSize = baseMeshletSize * getWaterRingScale(float(ringLevel)) * angleCompression;

	float texelSize = (uCameraPosition.w > 0.0 ? uCameraPosition.w : 0.5) * getWaterRingScale(float(ringLevel));
	vec2 cameraSnap = floor(uCameraPosition.xz / texelSize) * texelSize;
	vec2 relCameraSnap = cameraSnap - uCameraPosition.xz;
	vec2 relMeshletMinXZ = relCameraSnap + (vec2(float(col), float(row)) - float(meshletsPerRow) * 0.5) * meshletSize;

	vec2 localPos = vec2(float(lx) / 10.0, float(ly) / 10.0) * meshletSize;
	vec2 relBaseXZ = relMeshletMinXZ + localPos;

	vec2 offsetDist = abs(relBaseXZ);
	float distToCam = max(offsetDist.x, offsetDist.y);
	float outerDist = (float(meshletsPerRow) * 0.5) * meshletSize;
	vec2 relMorphedXZ = relBaseXZ;

	if (ringLevel < params.gridParams.x - 1 && outerDist > 0.0) {
		float morphWidth = 2.0 * meshletSize;
		float morphStart = max(0.0, outerDist - morphWidth);
		if (distToCam > morphStart) {
			float alpha = clamp((distToCam - morphStart) / max(outerDist - morphStart, 0.001), 0.0, 1.0);
			alpha = alpha * alpha * (3.0 - 2.0 * alpha);

			vec2 targetLocalPos = vec2(floor(float(lx) / 2.0) * 2.0, floor(float(ly) / 2.0) * 2.0) * (meshletSize / 10.0);
			vec2 relTargetXZ = relMeshletMinXZ + targetLocalPos;
			relMorphedXZ = mix(relBaseXZ, relTargetXZ, alpha);
		}
	}

	vec2 worldXZ = uCameraPosition.xz + relMorphedXZ;

	float vertexSpacing = meshletSize / 10.0;
	vec3 waveNormal;
	vec3 waveOffset = calculatePhasorOffsetAndNormal(worldXZ, uTime, length(relMorphedXZ), float(ringLevel), vertexSpacing, waveNormal);

	float distSq = dot(relMorphedXZ, relMorphedXZ);
	float dropOff = distSq / (2.0 * FAKE_PLANET_RADIUS);

	vec3 relWorldPos = vec3(relMorphedXZ.x, params.waterLevel - uCameraPosition.y, relMorphedXZ.y) + waveOffset - vec3(0.0, dropOff, 0.0);

	vec3 viewPos = mat3(uViewMatrix) * relWorldPos;
	gl_MeshVerticesEXT[vertexIndex].gl_Position = uProjMatrix * vec4(viewPos, 1.0);
	outWorldPos[vertexIndex] = relWorldPos;
	outNormal[vertexIndex] = waveNormal;

	bool isBoundarySample = (lx % 2 == 0) && (ly % 2 == 0) && (lx == 0 || lx == 10 || ly == 0 || ly == 10);
	if (isBoundarySample) {
		uint skirtID;
		if (ly == 0) {
			skirtID = lx / 2;
		} else if (ly == 10) {
			skirtID = 6 + lx / 2;
		} else if (lx == 0) {
			skirtID = 12 + (ly / 2 - 1);
		} else {
			skirtID = 16 + (ly / 2 - 1);
		}
		uint skirtIdx = 121 + skirtID;

		float skirtDepth = max(0.0, meshletSize * 0.005);
		vec3  relSkirtPos = relWorldPos - vec3(0.0, skirtDepth, 0.0);

		vec3 skirtViewPos = mat3(uViewMatrix) * relSkirtPos;
		gl_MeshVerticesEXT[skirtIdx].gl_Position = uProjMatrix * vec4(skirtViewPos, 1.0);
		outWorldPos[skirtIdx] = relSkirtPos;
		outNormal[skirtIdx] = waveNormal;
	}

	if (lx < 10 && ly < 10) {
		uint quadIdx = ly * 10 + lx;
		uint v0 = ly * 11 + lx;
		uint v1 = ly * 11 + (lx + 1);
		uint v2 = (ly + 1) * 11 + lx;
		uint v3 = (ly + 1) * 11 + (lx + 1);

		gl_PrimitiveTriangleIndicesEXT[quadIdx * 2 + 0] = uvec3(v0, v2, v1);
		gl_PrimitiveTriangleIndicesEXT[quadIdx * 2 + 1] = uvec3(v1, v2, v3);

		bool cullQuad = false;
		if (ringLevel > 0) {
			float prevMeshletSize = baseMeshletSize * getWaterRingScale(float(ringLevel - 1)) * angleCompression;
			float prevTexelSize = (uCameraPosition.w > 0.0 ? uCameraPosition.w : 0.5) * getWaterRingScale(float(ringLevel - 1));
			vec2  prevRelSnap = floor(uCameraPosition.xz / prevTexelSize) * prevTexelSize - uCameraPosition.xz;
			float prevExtent = float(meshletsPerRow) * 0.5 * prevMeshletSize;

			vec2 quadCenterLocal = vec2(float(lx) + 0.5, float(ly) + 0.5) / 10.0 * meshletSize;
			vec2 quadCenterRel = relMeshletMinXZ + quadCenterLocal;

			vec2 dist = abs(quadCenterRel - prevRelSnap);
			if (max(dist.x, dist.y) < prevExtent - (meshletSize * 0.01)) {
				cullQuad = true;
			}
		}

		gl_MeshPrimitivesEXT[quadIdx * 2 + 0].gl_CullPrimitiveEXT = cullQuad;
		gl_MeshPrimitivesEXT[quadIdx * 2 + 1].gl_CullPrimitiveEXT = cullQuad;
	}

	if (ly == 0 && lx < 10 && lx % 2 == 0) { // Top edge
		uint s = lx / 2;
		uint v0 = lx;
		uint v1 = lx + 2;
		uint k0 = 121 + s;
		uint k1 = 121 + s + 1;
		uint primIdx = 200 + s * 2;

		gl_PrimitiveTriangleIndicesEXT[primIdx + 0] = uvec3(v0, k0, v1);
		gl_PrimitiveTriangleIndicesEXT[primIdx + 1] = uvec3(v1, k0, k1);
		gl_MeshPrimitivesEXT[primIdx + 0].gl_CullPrimitiveEXT = true;
		gl_MeshPrimitivesEXT[primIdx + 1].gl_CullPrimitiveEXT = true;
	}

	if (ly == 10 && lx < 10 && lx % 2 == 0) { // Bottom edge
		uint s = lx / 2;
		uint v0 = 110 + lx;
		uint v1 = 110 + lx + 2;
		uint k0 = 121 + 6 + s;
		uint k1 = 121 + 6 + s + 1;
		uint primIdx = 210 + s * 2;

		gl_PrimitiveTriangleIndicesEXT[primIdx + 0] = uvec3(v1, k1, v0);
		gl_PrimitiveTriangleIndicesEXT[primIdx + 1] = uvec3(v0, k1, k0);
		gl_MeshPrimitivesEXT[primIdx + 0].gl_CullPrimitiveEXT = true;
		gl_MeshPrimitivesEXT[primIdx + 1].gl_CullPrimitiveEXT = true;
	}

	if (lx == 0 && ly < 10 && ly % 2 == 0) { // Left edge
		uint s = ly / 2;
		uint v0 = ly * 11;
		uint v1 = (ly + 2) * 11;
		uint k0 = (s == 0) ? 121 : (121 + 12 + (s - 1));
		uint k1 = (s + 1 == 5) ? 127 : (121 + 12 + s);
		uint primIdx = 220 + s * 2;

		gl_PrimitiveTriangleIndicesEXT[primIdx + 0] = uvec3(v1, k1, v0);
		gl_PrimitiveTriangleIndicesEXT[primIdx + 1] = uvec3(v0, k1, k0);
		gl_MeshPrimitivesEXT[primIdx + 0].gl_CullPrimitiveEXT = true;
		gl_MeshPrimitivesEXT[primIdx + 1].gl_CullPrimitiveEXT = true;
	}

	if (lx == 10 && ly < 10 && ly % 2 == 0) { // Right edge
		uint s = ly / 2;
		uint v0 = ly * 11 + 10;
		uint v1 = (ly + 2) * 11 + 10;
		uint k0 = (s == 0) ? 126 : (121 + 16 + (s - 1));
		uint k1 = (s + 1 == 5) ? 132 : (121 + 16 + s);
		uint primIdx = 230 + s * 2;

		gl_PrimitiveTriangleIndicesEXT[primIdx + 0] = uvec3(v0, k0, v1);
		gl_PrimitiveTriangleIndicesEXT[primIdx + 1] = uvec3(v1, k0, k1);
		gl_MeshPrimitivesEXT[primIdx + 0].gl_CullPrimitiveEXT = true;
		gl_MeshPrimitivesEXT[primIdx + 1].gl_CullPrimitiveEXT = true;
	}
}
