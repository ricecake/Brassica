#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_KHR_shader_subgroup_ballot : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

#include "bindless.glsl"
#include "common.glsl"
#include "terrain.glsl"
#include "helpers/culling.glsl"

layout(push_constant) uniform FoliagePushConstants {
	uvec4 gridParams; // x = numLODs, y = tilesPerRow, z = totalTiles, w = textureDim
	uint  clipmapIndex;
	uint  minMaxIndex;
	uint  biomeIndex; // reserved -- see FoliageNode.hpp
	uint  weatherBiomeIndex;
	float windTime;
	float lodBaseRange;
	float lodScaleFactor;
	float baseTileSize;
	float flowerRatio;
	float fernRatio;
	float rockRatio;
	float seaweedRatio;
	float bushRatio;
	float lengthMultiplier;
	float widthMultiplier;
	float densityMultiplier;
	float windMultiplier;
	float rigidityMultiplier;
	uint  biomeTableIndex;
	float baseScale;
	float waterLevel;
	uint  terrainNumLevels;
	uint  foliageFlags; // bit 0: terrain occlusion culling
	uint  hizIndex;
}
params;

// Each surviving tile now hands its clumps a continuous density/fade curve (foliage.mesh) instead
// of a precomputed step count -- the task shader's only remaining job is deciding which tiles are
// worth emitting at all (frustum/parent-nesting/occlusion), not how dense they'll be.
struct FoliageTaskPayload {
	vec2  relTileMinXZ[32];
	float tileSize[32];
	uint  lodLevel[32];
};

taskPayloadSharedEXT FoliageTaskPayload payload;

shared uint tileCount;

void main() {
	uint threadID = gl_LocalInvocationID.x;

	if (threadID == 0) {
		tileCount = 0;
	}
	barrier();

	uint tileID = gl_WorkGroupID.x * 32 + threadID;
	bool visible = false;

	if (tileID < params.gridParams.z) {
		uint tilesPerRow = params.gridParams.y;
		uint totalPerLOD = tilesPerRow * tilesPerRow;
		uint lodLevel = min(tileID / totalPerLOD, params.gridParams.x - 1);
		uint localID = tileID % totalPerLOD;

		uint row = localID / tilesPerRow;
		uint col = localID % tilesPerRow;

		float baseSize = params.baseTileSize > 0.0 ? params.baseTileSize : 16.0;
		float tileSize = baseSize * getLODScale(float(lodLevel));

		vec2 cameraSnap = floor(uCameraPosition.xz / tileSize) * tileSize;
		vec2 relCameraSnap = cameraSnap - uCameraPosition.xz;

		vec3 relMinB = vec3(
			relCameraSnap.x + (float(col) - float(tilesPerRow) * 0.5) * tileSize,
			-200.0 - uCameraPosition.y,
			relCameraSnap.y + (float(row) - float(tilesPerRow) * 0.5) * tileSize
		);
		vec3 relMaxB = relMinB + vec3(tileSize, 1500.0, tileSize);

		if (params.minMaxIndex > 0u) {
			vec2 centerXZ = cameraSnap + (vec2(float(col), float(row)) - float(tilesPerRow) * 0.5 + vec2(0.5)) * tileSize;
			vec2 minMax = sampleTerrainMinMax(
				params.minMaxIndex,
				centerXZ,
				lodLevel,
				params.gridParams.w
			);
			relMinB.y = minMax.x - 10.0 - uCameraPosition.y;
			relMaxB.y = minMax.y + 20.0 - uCameraPosition.y;
		}

		mat4 viewRel = mat4(mat3(uViewMatrix));
		mat4 viewProjRel = uProjMatrix * viewRel;

		visible = isAABBVisible(relMinB, relMaxB, viewProjRel, vec3(20.0, 50.0, 20.0), -50.0);

		if (visible && lodLevel > 0) {
			float prevTileSize = baseSize * getLODScale(float(lodLevel - 1));
			vec2 prevCameraSnap = floor(uCameraPosition.xz / prevTileSize) * prevTileSize;
			vec2 prevRelSnap = prevCameraSnap - uCameraPosition.xz;
			float prevExtent = float(tilesPerRow) * 0.5 * prevTileSize;

			bool insideX = relMinB.x >= prevRelSnap.x - prevExtent && relMaxB.x <= prevRelSnap.x + prevExtent;
			bool insideZ = relMinB.z >= prevRelSnap.y - prevExtent && relMaxB.z <= prevRelSnap.y + prevExtent;

			if (insideX && insideZ) {
				visible = false;
			}
		}

		// Self-occlusion cull: a tile fully hidden behind nearer, higher scene geometry or terrain is never worth
		// dispatching a mesh workgroup for. Skipped for the nearest ring (lodLevel 0).
		// Toggle via FoliageState::enableOcclusionCulling (foliageFlags bit 0).
		if (visible && lodLevel >= 1u && (params.foliageFlags & 1u) != 0u) {
			if (params.hizIndex > 0u) {
				if (isAABBOccludedByHiZ(relMinB, relMaxB, viewProjRel, params.hizIndex)) {
					visible = false;
				}
			} else if (params.minMaxIndex > 0u) {
				TerrainOcclusionContext occCtx = makeTerrainOcclusionContext(
					params.minMaxIndex,
					params.gridParams.w,
					params.terrainNumLevels,
					params.waterLevel
				);
				vec3 worldMinB = relMinB + uCameraPosition.xyz;
				vec3 worldMaxB = relMaxB + uCameraPosition.xyz;
				float occlusionSlack = tileSize * 2.0 + 50.0;
				if (isAABBOccludedByTerrain(occCtx, worldMinB, worldMaxB, occlusionSlack)) {
					visible = false;
				}
			}
		}

		if (visible) {
			uint idx = atomicAdd(tileCount, 1u);
			if (idx < 32u) {
				payload.relTileMinXZ[idx] = relMinB.xz;
				payload.tileSize[idx] = tileSize;
				payload.lodLevel[idx] = lodLevel;
			}
		}
	}

	barrier();

	if (threadID == 0) {
		// 16 clumps per tile -- see foliage.mesh, which now gives each clump its own mesh
		// workgroup/vertex budget instead of sharing one 128-vertex budget across a whole tile.
		EmitMeshTasksEXT(min(tileCount, 32u) * 16u, 1, 1);
	}
}
