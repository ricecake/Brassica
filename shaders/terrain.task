#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

#include "bindless.glsl"
#include "common.glsl"
#include "cbt.glsl"
#include "helpers/culling.glsl"

layout(push_constant) uniform TerrainPushConstants {
	uvec4 gridParams;
	uint  clipmapIndex;
	uint  minMaxIndex;
	uint  biomeIndex;
	float waterLevel;
	uint  weatherBiomeIndex;
	uint  cbtPoolIndex;
	uint  cbtCacheIndex;
	uint  activeBisectorCount;
} params;

struct TaskPayload {
	uint64_t bisectorID[32];
	uint     cachePage[32];
	uint     depth[32];
	vec2     v0[32];
	vec2     v1[32];
	vec2     v2[32];
	uint     twinDepth[32];
	uint     nextDepth[32];
	uint     prevDepth[32];
};

taskPayloadSharedEXT TaskPayload payload;

shared uint meshletCount;

layout(std430, buffer_reference) buffer BisectorPool {
	Bisector bisectors[];
};

layout(std430, buffer_reference) buffer GeometryCacheBuffer {
	GeometryCacheHeader headers[];
};

void main() {
	uint threadID = gl_LocalInvocationID.x;

	if (threadID == 0) {
		meshletCount = 0;
	}
	barrier();

	uint bisectorIdx = gl_WorkGroupID.x * 32u + threadID;

	bool visible = false;
	if (bisectorIdx < params.activeBisectorCount && params.cbtPoolIndex > 0u) {
		BisectorPool pool = BisectorPool(uSSBOBuffers[params.cbtPoolIndex]);
		Bisector b = pool.bisectors[bisectorIdx];

		vec2 center2D = (b.v0 + b.v1 + b.v2) / 3.0;
		float drop0 = cbt_apply_fake_curvature(b.v0);
		float drop1 = cbt_apply_fake_curvature(b.v1);
		float drop2 = cbt_apply_fake_curvature(b.v2);

		vec2 minMaxH = vec2(-100.0, 500.0);
		if (params.cbtCacheIndex > 0u && b.cachePage != CBT_INVALID_PAGE) {
			GeometryCacheBuffer cache = GeometryCacheBuffer(uSSBOBuffers[params.cbtCacheIndex]);
			minMaxH = cache.headers[b.cachePage].minMax;
		}

		vec3 p0 = vec3(b.v0.x, minMaxH.x + drop0 - uCameraPosition.y, b.v0.y);
		vec3 p1 = vec3(b.v1.x, minMaxH.y + drop1 - uCameraPosition.y, b.v1.y);
		vec3 p2 = vec3(b.v2.x, minMaxH.y + drop2 - uCameraPosition.y, b.v2.y);

		vec3 relMinB = min(p0, min(p1, p2));
		vec3 relMaxB = max(p0, max(p1, p2));

		mat4 viewRel = mat4(mat3(uViewMatrix));
		mat4 viewProjRel = uProjMatrix * viewRel;

		visible = isAABBVisible(relMinB, relMaxB, viewProjRel, vec3(100.0, 300.0, 100.0), -200.0);

		if (visible) {
			uint writeIdx = atomicAdd(meshletCount, 1u);
			if (writeIdx < 32u) {
				payload.bisectorID[writeIdx] = b.id;
				payload.cachePage[writeIdx] = b.cachePage;
				payload.depth[writeIdx] = b.depth;
				payload.v0[writeIdx] = b.v0;
				payload.v1[writeIdx] = b.v1;
				payload.v2[writeIdx] = b.v2;
				payload.twinDepth[writeIdx] = b.depth;
				payload.nextDepth[writeIdx] = b.depth;
				payload.prevDepth[writeIdx] = b.depth;
			}
		}
	}

	barrier();

	if (threadID == 0) {
		EmitMeshTasksEXT(min(meshletCount, 32u), 1, 1);
	}
}
