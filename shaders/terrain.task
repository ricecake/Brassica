#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_KHR_shader_subgroup_ballot : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

#include "bindless.glsl"
#include "common.glsl"
#include "terrain.glsl"

layout(push_constant) uniform TerrainPushConstants {
	uvec4 gridParams; // x = windowLODs, y = meshletsPerRow, z = totalMeshlets, w = textureDim
	uint  clipmapIndex;
	uint  minMaxIndex;
	uint  biomeIndex;
	uint  visibilityIndex;
	uint  baseLOD;
	uint  maxLODs;
	uint  pad0;
	uint  pad1;
}
params;

struct TaskPayload {
	uint meshletIDs[32];
	uint lodLevels[32];
};

taskPayloadSharedEXT TaskPayload payload;

// Check AABB against frustum planes in camera-relative space
bool isAABBVisible(vec3 relMinB, vec3 relMaxB, mat4 vp) {
	// Camera origin (0,0,0) containment check with safety margin
	vec3 margin = vec3(100.0, 300.0, 100.0);
	if (relMinB.x <= margin.x && relMaxB.x >= -margin.x &&
	    relMinB.z <= margin.z && relMaxB.z >= -margin.z &&
	    relMinB.y <= margin.y && relMaxB.y >= -margin.y) {
		return true;
	}

	vec4 planes[6];
	planes[0] = vec4(vp[0][3] + vp[0][0], vp[1][3] + vp[1][0], vp[2][3] + vp[2][0], vp[3][3] + vp[3][0]); // Left
	planes[1] = vec4(vp[0][3] - vp[0][0], vp[1][3] - vp[1][0], vp[2][3] - vp[2][0], vp[3][3] - vp[3][0]); // Right
	planes[2] = vec4(vp[0][3] + vp[0][1], vp[1][3] + vp[1][1], vp[2][3] + vp[2][1], vp[3][3] + vp[3][1]); // Bottom
	planes[3] = vec4(vp[0][3] - vp[0][1], vp[1][3] - vp[1][1], vp[2][3] - vp[2][1], vp[3][3] - vp[3][1]); // Top
	planes[4] = vec4(vp[0][2], vp[1][2], vp[2][2], vp[3][2]); // Near (Vulkan 0 <= z <= w)
	planes[5] = vec4(vp[0][3] - vp[0][2], vp[1][3] - vp[1][2], vp[2][3] - vp[2][2], vp[3][3] - vp[3][2]); // Far

	for (int i = 0; i < 6; i++) {
		vec3 pVertex = relMinB;
		if (planes[i].x >= 0.0) pVertex.x = relMaxB.x;
		if (planes[i].y >= 0.0) pVertex.y = relMaxB.y;
		if (planes[i].z >= 0.0) pVertex.z = relMaxB.z;

		float len = length(planes[i].xyz);
		vec4 normPlane = (len > 0.0001) ? planes[i] / len : planes[i];

		if (dot(normPlane.xyz, pVertex) + normPlane.w < -200.0) {
			return false;
		}
	}
	return true;
}

shared uint meshletCount;

void main() {
	uint threadID = gl_LocalInvocationID.x;

	if (threadID == 0) {
		meshletCount = 0;
	}
	barrier();

	uint meshletID = gl_WorkGroupID.x * 32 + threadID;

	bool visible = false;
	uint lodLevel = 0;

	if (meshletID < params.gridParams.z) {
		uint meshletsPerRow = params.gridParams.y;
		uint totalPerLOD = meshletsPerRow * meshletsPerRow;
		uint relLOD = min(meshletID / totalPerLOD, params.gridParams.x - 1);
		lodLevel = params.baseLOD + relLOD;
		uint localID = meshletID % totalPerLOD;

		uint row = localID / meshletsPerRow;
		uint col = localID % meshletsPerRow;

		float baseMeshletSize = 32.0;
		float meshletSize = baseMeshletSize * getLODScale(float(lodLevel));

		vec2 cameraSnap = floor(uCameraPosition.xz / meshletSize) * meshletSize;
		vec2 relCameraSnap = cameraSnap - uCameraPosition.xz;

		vec3 relMinB = vec3(
			relCameraSnap.x + (float(col) - float(meshletsPerRow) * 0.5) * meshletSize,
			-500.0 - uCameraPosition.y,
			relCameraSnap.y + (float(row) - float(meshletsPerRow) * 0.5) * meshletSize
		);
		vec3 relMaxB = relMinB + vec3(meshletSize, 2500.0, meshletSize);

		if (params.minMaxIndex > 0u) {
			vec2 centerXZ = cameraSnap + (vec2(float(col), float(row)) - float(meshletsPerRow) * 0.5 + vec2(0.5)) * meshletSize;
			vec2 minMax = sampleTerrainMinMax(
				params.minMaxIndex,
				centerXZ,
				lodLevel,
				params.gridParams.w
			);
			relMinB.y = minMax.x - 100.0 - uCameraPosition.y;
			relMaxB.y = minMax.y + 100.0 - uCameraPosition.y;
		}

		vec2 maxRel = max(abs(relMinB.xz), abs(relMaxB.xz));
		float maxDropOff = dot(maxRel, maxRel) / (2.0 * FAKE_PLANET_RADIUS);
		relMinB.y -= maxDropOff;

		if (lodLevel <= 1 || max(maxRel.x, maxRel.y) < meshletSize * 2.5) {
			relMinB.y = min(relMinB.y, -1000.0 - uCameraPosition.y);
			relMaxB.y = max(relMaxB.y, 3000.0 - uCameraPosition.y);
		}

		mat4 viewRel = mat4(mat3(uViewMatrix));
		mat4 viewProjRel = uProjMatrix * viewRel;

		visible = isAABBVisible(relMinB, relMaxB, viewProjRel);

		if (visible && relLOD > 0) {
			float prevMeshletSize = baseMeshletSize * getLODScale(float(lodLevel - 1));
			vec2 prevCameraSnap = floor(uCameraPosition.xz / prevMeshletSize) * prevMeshletSize;
			vec2 prevRelSnap = prevCameraSnap - uCameraPosition.xz;
			float prevExtent = float(meshletsPerRow) * 0.5 * prevMeshletSize;

			bool insideX = relMinB.x >= prevRelSnap.x - prevExtent && relMaxB.x <= prevRelSnap.x + prevExtent;
			bool insideZ = relMinB.z >= prevRelSnap.y - prevExtent && relMaxB.z <= prevRelSnap.y + prevExtent;

			if (insideX && insideZ) {
				visible = false;
			}
		}
	}

	if (visible) {
		uint index = atomicAdd(meshletCount, 1u);
		payload.meshletIDs[index] = meshletID;
		payload.lodLevels[index] = lodLevel;
	}
	barrier();

	if (threadID == 0) {
		EmitMeshTasksEXT(meshletCount, 1, 1);
	}
}
