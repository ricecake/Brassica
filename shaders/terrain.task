#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_KHR_shader_subgroup_ballot : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

#include "bindless.glsl"
#include "common.glsl"
#include "terrain.glsl"
#include "helpers/culling.glsl"

layout(push_constant) uniform TerrainPushConstants {
	uvec4 gridParams; // x = numLODs, y = meshletsPerRow, z = totalMeshlets, w = textureDim
	uint  clipmapIndex;
	uint  minMaxIndex;
	uint  biomeIndex;
	uint  visibilityIndex;
	float waterLevel;
}
params;

struct TaskPayload {
    vec2 relMeshletMinXZ[512];
    uint renderLOD[512];
    uint morphLOD[512];
    uint childXY[512];         // NEW: (cy << 16) | cx
};

taskPayloadSharedEXT TaskPayload payload;

shared uint meshletCount;

void main() {
	uint threadID = gl_LocalInvocationID.x;

	if (threadID == 0) {
		meshletCount = 0;
	}
	barrier();

	uint meshletID = gl_WorkGroupID.x * 32 + threadID;

	bool visible = false;
	uint lodLevel = 0;

	if (meshletID < params.gridParams.z) {
		uint meshletsPerRow = params.gridParams.y;
		uint totalPerLOD = meshletsPerRow * meshletsPerRow;
		lodLevel = min(meshletID / totalPerLOD, params.gridParams.x - 1);
		uint localID = meshletID % totalPerLOD;

		uint row = localID / meshletsPerRow;
		uint col = localID % meshletsPerRow;

		float baseMeshletSize = 32.0;
		float meshletSize = baseMeshletSize * getLODScale(float(lodLevel));

		vec2 cameraSnap = floor(uCameraPosition.xz / meshletSize) * meshletSize;
		vec2 relCameraSnap = cameraSnap - uCameraPosition.xz;

		vec3 relMinB = vec3(
			relCameraSnap.x + (float(col) - float(meshletsPerRow) * 0.5) * meshletSize,
			-500.0 - uCameraPosition.y,
			relCameraSnap.y + (float(row) - float(meshletsPerRow) * 0.5) * meshletSize
		);
		vec3 relMaxB = relMinB + vec3(meshletSize, 2500.0, meshletSize);

		if (params.minMaxIndex > 0u) {
			vec2 centerXZ = cameraSnap + (vec2(float(col), float(row)) - float(meshletsPerRow) * 0.5 + vec2(0.5)) * meshletSize;
			vec2 minMax = sampleTerrainMinMax(
				params.minMaxIndex,
				centerXZ,
				lodLevel,
				params.gridParams.w
			);
			relMinB.y = minMax.x - 100.0 - uCameraPosition.y;
			relMaxB.y = minMax.y + 100.0 - uCameraPosition.y;
		}

		vec2 maxRel = max(abs(relMinB.xz), abs(relMaxB.xz));
		float maxDropOff = dot(maxRel, maxRel) / (2.0 * FAKE_PLANET_RADIUS);
		relMinB.y -= maxDropOff;

		bool skipHorizonCull = (lodLevel <= 1 || max(maxRel.x, maxRel.y) < meshletSize * 2.5);
		if (skipHorizonCull) {
			relMinB.y = min(relMinB.y, -1000.0 - uCameraPosition.y);
			relMaxB.y = max(relMaxB.y, 3000.0 - uCameraPosition.y);
		}

		mat4 viewRel = mat4(mat3(uViewMatrix));
		mat4 viewProjRel = uProjMatrix * viewRel;

		visible = isAABBVisible(relMinB, relMaxB, viewProjRel, vec3(100.0, 300.0, 100.0), -200.0);

		// Gentle horizon cull: skip it for the near/low-LOD tiles above, whose Y bounds were
		// just artificially widened to a fixed [-1000,3000] band -- feeding that fabricated
		// height into the horizon test would produce a meaningless result.
		if (visible && !skipHorizonCull) {
			vec2  closestXZ = clamp(vec2(0.0), relMinB.xz, relMaxB.xz);
			float tileDist = length(closestXZ);
			float camAltitude = uCameraPosition.y - params.waterLevel;
			float tileMaxYAboveRef = (relMaxB.y + uCameraPosition.y) - params.waterLevel;
			float slack = meshletSize * 4.0 + 500.0;
			if (isBeyondHorizon(tileDist, tileMaxYAboveRef, camAltitude, slack)) {
				visible = false;
			}
		}

		if (visible && lodLevel > 0) {
			float prevMeshletSize = baseMeshletSize * getLODScale(float(lodLevel - 1));
			vec2 prevCameraSnap = floor(uCameraPosition.xz / prevMeshletSize) * prevMeshletSize;
			vec2 prevRelSnap = prevCameraSnap - uCameraPosition.xz;
			float prevExtent = float(meshletsPerRow) * 0.5 * prevMeshletSize;

			bool insideX = relMinB.x >= prevRelSnap.x - prevExtent && relMaxB.x <= prevRelSnap.x + prevExtent;
			bool insideZ = relMinB.z >= prevRelSnap.y - prevExtent && relMaxB.z <= prevRelSnap.y + prevExtent;

			if (insideX && insideZ) {
				visible = false;
			}
		}

		if (visible) {
			// 1. Sample Variance
			vec2 centerXZ = uCameraPosition.xz + relMinB.xz + (meshletSize * 0.5);
			float variance = sampleTerrainBiome(params.biomeIndex, centerXZ, lodLevel, params.gridParams.w).g;

			// 2. Calculate Screen-Space Error (SSE)
			float nodeSpacing = meshletSize / 10.0;
			float geomError = variance * nodeSpacing * 2.5; // Scale to your specific heightmap amplitude

			vec3 closestPoint = clamp(vec3(0.0), relMinB, relMaxB); // Camera is at 0,0,0
			float dist = max(length(closestPoint), 1.0);

			float K = 1000.0; // Pass ScreenHeight / (2 * tan(FOV/2)) via push constants later
			float sse = (geomError * K) / dist;

			// 3. Determine Subdivision (Target LOD)
			uint targetLOD = lodLevel;
			if (sse > 4.0 && lodLevel >= 2) targetLOD = lodLevel - 2; // Subdivide into 16
			else if (sse > 1.5 && lodLevel >= 1) targetLOD = lodLevel - 1; // Subdivide into 4

			// 4. Allocate and Emit
			uint lodDiff = lodLevel - targetLOD;
			uint emitCount = 1 << (lodDiff * 2); // 1, 4, or 16 meshlets

			uint baseIdx = atomicAdd(meshletCount, emitCount);

			float subSize = baseMeshletSize * getLODScale(float(targetLOD));
			uint gridDim = 1 << lodDiff;

			// Inside the emit loop in terrain.task
			for (uint i = 0; i < emitCount; i++) {
				uint lx = i % gridDim;
				uint ly = i / gridDim;

				uint writeIdx = baseIdx + i;
				payload.relMeshletMinXZ[writeIdx] = relMinB.xz + vec2(lx, ly) * subSize;
				payload.renderLOD[writeIdx] = targetLOD;
				payload.morphLOD[writeIdx] = lodLevel;
				payload.childXY[writeIdx] = (ly << 16) | lx; // Track local grid position
			}
		}
	}

	barrier();

	if (threadID == 0) {
		EmitMeshTasksEXT(meshletCount, 1, 1);
	}
}
