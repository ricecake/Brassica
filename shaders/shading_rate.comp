#version 460

#include "bindless.glsl"
#include "helpers/hash.glsl"
#include "helpers/distribution.glsl"

layout(local_size_x = [[SHADING_RATE_TILE_WIDTH]], local_size_y = [[SHADING_RATE_TILE_HEIGHT]]) in;

layout(push_constant) uniform ShadingRatePushConstants {
	uint  prevShadingRateIndex; // bindless STORAGE index, History<ShadingRateMap>
	uint  outShadingRateIndex;  // bindless STORAGE index, ShadingRateMap (this frame)
	uint  hdrColorIndex;        // bindless SAMPLED index, HdrColor (this frame, fully composited)
	uint  frameCounter;
	uvec2 screenSize; // pixels, not tiles
} push;

const uint RATE_1X1 = 0u;  // (0 << 2) | 0
const uint RATE_2X2 = 5u;  // (1 << 2) | 1
const uint RATE_4X4 = 10u; // (2 << 2) | 2

const uint TILE_W = [[SHADING_RATE_TILE_WIDTH]];
const uint TILE_H = [[SHADING_RATE_TILE_HEIGHT]];
const uint HALO_W = TILE_W + 2u;
const uint HALO_H = TILE_H + 2u;

// Perceptual (Y_comp, Cb, Cr) for the tile plus a 1-pixel border on all four sides,
// eliminating 2x2 quad blind spots and cross-tile boundary seams.
shared vec3  sharedPerceptual[HALO_W * HALO_H];
shared float sharedMaxContrast[TILE_W * TILE_H];

// Maps linear HDR RGB into a highlight-compressed perceptual YCbCr space so shadow and
// midtone detail isn't crushed while bright HDR highlights don't blow out the metric.
vec3 ToPerceptualYCbCr(vec3 hdr) {
	hdr = max(hdr, vec3(0.0));
	float Y = dot(hdr, vec3(0.2126, 0.7152, 0.0722));
	float Ycomp = Y / (1.0 + 0.5 * Y);
	float scale = (Y > 1e-6) ? (Ycomp / Y) : 1.0;
	vec3  c = hdr * scale;
	return vec3(Ycomp, c.b - Ycomp, c.r - Ycomp);
}

// Weber-Fechner contrast between two perceptual samples, combining luminance contrast
// with attenuated chrominance contrast to catch isoluminant color edges.
float PairContrast(vec3 a, vec3 b) {
	// Dark-adaptation floor (~0.03 linear) prevents near-black quantization noise from
	// firing while preserving sensitivity to subtle shadow and midtone steps.
	float denom = min(a.x, b.x) + 0.03;
	float dY = abs(a.x - b.x) / denom;
	float dC = length(a.yz - b.yz) / denom;
	return max(dY, 0.5 * dC);
}

void main() {
	ivec2 tileCoord = ivec2(gl_WorkGroupID.xy);
	ivec2 tileOrigin = tileCoord * ivec2(TILE_W, TILE_H);
	uint  localIndex = gl_LocalInvocationIndex;
	uint  totalInvocations = TILE_W * TILE_H;

	// Populate the (TILE_W + 2) x (TILE_H + 2) perceptual tile + 1px apron uniformly.
	const uint haloCount = HALO_W * HALO_H;
	for (uint i = localIndex; i < haloCount; i += totalInvocations) {
		ivec2 haloOffset = ivec2(i % HALO_W, i / HALO_W) - ivec2(1);
		ivec2 samplePixel = clamp(tileOrigin + haloOffset, ivec2(0), ivec2(push.screenSize) - 1);
		vec2  uv = (vec2(samplePixel) + 0.5) / vec2(push.screenSize);
		vec3  hdr = SAMPLE_NEAREST(push.hdrColorIndex, uv).rgb;
		sharedPerceptual[i] = ToPerceptualYCbCr(hdr);
	}
	barrier();

	// Evaluate isotropic contrast across all 8 neighbors (every pixel boundary, including
	// quad seams and tile-to-tile edges).
	uint centerIdx = (gl_LocalInvocationID.y + 1u) * HALO_W + (gl_LocalInvocationID.x + 1u);
	vec3 center = sharedPerceptual[centerIdx];

	float cardinal = max(
		max(PairContrast(center, sharedPerceptual[centerIdx - 1u]),
		    PairContrast(center, sharedPerceptual[centerIdx + 1u])),
		max(PairContrast(center, sharedPerceptual[centerIdx - HALO_W]),
		    PairContrast(center, sharedPerceptual[centerIdx + HALO_W]))
	);

	float diagonal = max(
		max(PairContrast(center, sharedPerceptual[centerIdx - HALO_W - 1u]),
		    PairContrast(center, sharedPerceptual[centerIdx - HALO_W + 1u])),
		max(PairContrast(center, sharedPerceptual[centerIdx + HALO_W - 1u]),
		    PairContrast(center, sharedPerceptual[centerIdx + HALO_W + 1u]))
	) * 0.70710678;

	sharedMaxContrast[localIndex] = max(cardinal, diagonal);
	barrier();

	for (uint stride = totalInvocations / 2u; stride > 0u; stride >>= 1u) {
		if (localIndex < stride) {
			sharedMaxContrast[localIndex] = max(sharedMaxContrast[localIndex], sharedMaxContrast[localIndex + stride]);
		}
		barrier();
	}

	if (localIndex != 0u) {
		return;
	}

	ivec2 outSize = imageSize(uImagesR8UI[nonuniformEXT(push.outShadingRateIndex)]);
	if (tileCoord.x >= outSize.x || tileCoord.y >= outSize.y) {
		return;
	}

	uint  prevRate = imageLoad(uImagesR8UI[nonuniformEXT(push.prevShadingRateIndex)], tileCoord).r;
	float maxContrast = sharedMaxContrast[0];

	// 8x8 Bayer probe: 8 phases of 8 tiles refresh every tile at 1x1 once every 8 frames.
	uint ditherIndex = uint(getBayer8x8Dither(tileCoord) * 64.0 + 0.5);
	uint phase = ditherIndex / 8u;
	bool isMeasurementTile = (phase == (push.frameCounter % 8u));

	// ~4.5% Weber contrast keeps crisp edges at 1x1; <1.5% allows stepping down to 4x4.
	const float DETAIL_THRESHOLD = 0.045;
	const float ULTRA_FLAT_THRESHOLD = 0.015;

	uint newRate;
	if (maxContrast > DETAIL_THRESHOLD || isMeasurementTile) {
		// Immediate wake-up on any visible edge regardless of previous coarseness,
		// plus periodic 1x1 probes to catch sub-pixel detail missed while coarse.
		newRate = RATE_1X1;
	} else if (prevRate == RATE_1X1) {
		newRate = RATE_2X2;
	} else if (prevRate == RATE_2X2) {
		// Dwell at 2x2 for at least one extra frame and require ultra-low contrast before
		// committing to 4x4.
		bool canStepTo4x4 = (maxContrast < ULTRA_FLAT_THRESHOLD) && ((phase & 1u) == (push.frameCounter & 1u));
		newRate = canStepTo4x4 ? RATE_4X4 : RATE_2X2;
	} else {
		newRate = RATE_4X4;
	}

	imageStore(uImagesR8UI[nonuniformEXT(push.outShadingRateIndex)], tileCoord, uvec4(newRate, 0u, 0u, 0u));
}
