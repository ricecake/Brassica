#version 460
#extension GL_EXT_mesh_shader : require

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    vec4 uPositionAndScale;
    vec4 uColor;
    uvec4 uParams; // x = rings, y = pointsPerRing
} push;

struct TaskPayload {
    vec4 positionAndScale;
    vec4 color;
    uvec4 params;
};

taskPayloadSharedEXT TaskPayload OUT;

void main() {
    OUT.positionAndScale = push.uPositionAndScale;
    OUT.color = push.uColor;
    OUT.params = push.uParams;

    EmitMeshTasksEXT(1, 1, 1);
}
