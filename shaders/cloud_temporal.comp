#version 450
#extension GL_EXT_nonuniform_qualifier : require

#include "bindless.glsl"

// Stage B of the tile-based temporal pipeline: reprojects last frame's accumulated cloud result
// (History<CloudAccumulatedColor/Transmittance/Moments>, see ResourceKeys.hpp's comment on the
// self-referential ping-pong) using camera motion (uPreviousViewProjMatrix, its first real
// consumer) plus this pixel's own non-camera wind velocity (CloudVelocity, from
// cloud_raymarch.comp), and blends with this frame's fresh raymarch (CloudColor/Transmittance/
// Depth) using disocclusion-aware rejection and a 3x3-neighborhood AABB color clip (a Karis-
// style TAA variance clip, not a naive lerp -- the simplified RGB-space variant of boidish's
// YCoCg clipAABB, not byte-for-byte identical to it).
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform CloudTemporalPushConstants {
	uint colorIndex;
	uint transmittanceIndex;
	uint depthIndex;
	uint velocityIndex;
	uint historyColorIndex;
	uint historyTransmittanceIndex;
	uint historyMomentsIndex;
	uint outColorStorageIdx;
	uint outTransmittanceStorageIdx;
	uint outMomentsStorageIdx;
	uint outputWidth;
	uint outputHeight;
	uint gPositionIndex; // NEW
	uint gAlbedoIndex;   // NEW
} push;

float luminance(vec3 c) {
	return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

vec3 RGBToYCoCg(vec3 rgb) {
		return vec3(
			dot(rgb, vec3(0.25, 0.5, 0.25)),
			dot(rgb, vec3(0.5, 0.0, -0.5)),
			dot(rgb, vec3(-0.25, 0.5, -0.25))
		);
	}

	vec3 YCoCgToRGB(vec3 ycocg) {
		float y = ycocg.x; float co = ycocg.y; float cg = ycocg.z;
		return vec3(y + co - cg, y + cg, y - co - cg);
	}

// Mitchell-Netravali Weight Function
float mitchell(float x, float B, float C) {
	float ax = abs(x);
	if (ax < 1.0) {
		return ((12.0 - 9.0 * B - 6.0 * C) * ax * ax * ax +
				(-18.0 + 12.0 * B + 6.0 * C) * ax * ax +
				(6.0 - 2.0 * B)) / 6.0;
	} else if (ax < 2.0) {
		return ((-B - 6.0 * C) * ax * ax * ax +
				(5.0 * B + 30.0 * C) * ax * ax +
				(-8.0 * B - 48.0 * C) * ax +
				(4.0 * B + 24.0 * C)) / 6.0;
	}
	return 0.0;
}

// Custom manual texture fetch for sharp history retention
vec3 textureMitchellColor(uint texIndex, vec2 uv, vec2 textureSize) {
	vec2 texelSize = 1.0 / textureSize;
	uv = uv * textureSize - 0.5;
	vec2 f = fract(uv);
	vec2 c = floor(uv);
	vec3 color = vec3(0.0);
	float weightsSum = 0.0;
	for (int j = -1; j <= 2; j++) {
		float wy = mitchell(float(j) - f.y, 0.0, 0.75); // C=0.75 adds the sharpening lobe
		for (int i = -1; i <= 2; i++) {
			float wx = mitchell(float(i) - f.x, 0.0, 0.75);
			float weight = wx * wy;
			vec2 pos = (c + vec2(i, j) + 0.5) * texelSize;

			// Use NEAREST to fetch the exact pixel for the manual kernel
			color += SAMPLE_NEAREST(texIndex, pos).rgb * weight;
			weightsSum += weight;
		}
	}
	return color / max(weightsSum, 0.0001);
}


void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if (pixel.x >= int(push.outputWidth) || pixel.y >= int(push.outputHeight)) {
		return;
	}

const ivec2 bayer_offsets[16] = ivec2[](
    ivec2(0,0), ivec2(2,0), ivec2(0,2), ivec2(2,2), // Indices 0-3
    ivec2(1,1), ivec2(3,1), ivec2(1,3), ivec2(3,3), // Indices 4-7
    ivec2(2,1), ivec2(0,1), ivec2(2,3), ivec2(0,3), // Indices 8-11
    ivec2(3,0), ivec2(1,0), ivec2(3,2), ivec2(1,2)  // Indices 12-15
);
	ivec2 offset = bayer_offsets[uFrameIndex % 16];
	bool freshPixel = (pixel % 4) == offset;

vec2 uv = (vec2(pixel) + 0.5) / vec2(push.outputWidth, push.outputHeight);

	// 1. Get THIS thread's actual scene depth from the G-Buffer
	vec4 albedo = SAMPLE_NEAREST(push.gAlbedoIndex, uv);
	vec3 relPos = SAMPLE_NEAREST(push.gPositionIndex, uv).rgb;
	float threadSurfaceDist = (albedo.a >= 0.01) ? length(relPos) : 1e9;
	bool isForeground = threadSurfaceDist < 1e8;

	// 2. Depth-Aware Bilateral Search: Find the best fresh pixel in a 3x3 block neighborhood
	// that matches our thread's scene depth. Prevents sky/cloud from bleeding into trees.
	ivec2 blockOrigin = pixel & ~3;
	ivec2 bestFreshCoord = blockOrigin + offset;
	float minDepthDiff = 1e9;

	for (int dy = -1; dy <= 1; dy++) {
		for (int dx = -1; dx <= 1; dx++) {
			ivec2 neighborBlock = blockOrigin + ivec2(dx * 4, dy * 4);
			ivec2 testCoord = clamp(neighborBlock + offset, ivec2(0), ivec2(push.outputWidth, push.outputHeight) - 1);
			vec2 testUV = (vec2(testCoord) + 0.5) / vec2(push.outputWidth, push.outputHeight);

			vec4 testAlbedo = SAMPLE_NEAREST(push.gAlbedoIndex, testUV);
			vec3 testRelPos = SAMPLE_NEAREST(push.gPositionIndex, testUV).rgb;
			float testSurfaceDist = (testAlbedo.a >= 0.01) ? length(testRelPos) : 1e9;

			float diff = abs(threadSurfaceDist - testSurfaceDist);
			if (diff < minDepthDiff) {
				minDepthDiff = diff;
				bestFreshCoord = testCoord;
			}
		}
	}

vec2 freshUV = (vec2(bestFreshCoord) + 0.5) / vec2(push.outputWidth, push.outputHeight);

vec3  curColor = SAMPLE_NEAREST(push.colorIndex, freshUV).rgb;
	vec3  curTransmittance = SAMPLE_NEAREST(push.transmittanceIndex, freshUV).rgb;
	float curDepth = SAMPLE_NEAREST(push.depthIndex, freshUV).r;
	vec2  curVelocity = SAMPLE_NEAREST(push.velocityIndex, freshUV).rg;

	// FIX 1: Mask Dilated Search. If this thread is on a foreground tree AND the
	// raymarch missed the cloud (1e9), do NOT search neighbors. The tree occludes it!
	bool cloudOccludedByForeground = isForeground && (curDepth > 1e8);

	float closestCloudDepth = 1e9;
	vec2 dilatedVelocity = curVelocity;
	vec2 dilatedFreshUV = freshUV;

	if (!cloudOccludedByForeground) {
		for (int dy = -1; dy <= 1; dy++) {
			for (int dx = -1; dx <= 1; dx++) {
				ivec2 neighborBlock = blockOrigin + ivec2(dx * 4, dy * 4);
				ivec2 neighborFreshCoord = clamp(neighborBlock + offset, ivec2(0), ivec2(push.outputWidth, push.outputHeight) - 1);
				vec2 sampleUV = (vec2(neighborFreshCoord) + 0.5) / vec2(push.outputWidth, push.outputHeight);

				float sDepth = SAMPLE_NEAREST(push.depthIndex, sampleUV).r;
				if (sDepth < closestCloudDepth) {
					closestCloudDepth = sDepth;
					dilatedVelocity = SAMPLE_NEAREST(push.velocityIndex, sampleUV).rg;
					dilatedFreshUV = sampleUV;
				}
			}
		}
	}

	float reprojDepth = closestCloudDepth;
	bool hasCloud = reprojDepth < 1e8;

	if (!hasCloud && !isForeground) {
		float staticHistDepth = SAMPLE_NEAREST(push.historyMomentsIndex, uv).w;
		if (staticHistDepth < 1e8) {
			reprojDepth = staticHistDepth;
			hasCloud = true;
		}
	}

	vec2 historyUV = uv;
	bool inBounds = false;
	vec2 totalMotion = vec2(0.0); // FIX 2: Track total motion (Camera + Wind)

	if (hasCloud) {
		vec2 freshClipCoord = dilatedFreshUV * 2.0 - 1.0;
		vec4 freshViewRay4 = uInvProjMatrix * vec4(freshClipCoord, 1.0, 1.0);
		vec3 freshViewDir = freshViewRay4.xyz / freshViewRay4.w;
		vec3 freshWorldRay = normalize((uInvViewMatrix * vec4(freshViewDir, 0.0)).xyz);
		vec3 freshWorldPos = uCameraPosition.xyz + freshWorldRay * reprojDepth;

		vec4 prevClip = uPreviousViewProjMatrix * vec4(freshWorldPos, 1.0);
		vec2 prevFreshUV = (prevClip.xy / prevClip.w) * 0.5 + 0.5;

		vec2 cameraMotion = prevFreshUV - dilatedFreshUV;
		totalMotion = cameraMotion - dilatedVelocity;
		historyUV = uv + totalMotion;
		inBounds = all(greaterThanEqual(historyUV, vec2(0.0))) && all(lessThanEqual(historyUV, vec2(1.0)));
	}

	vec3 histColor = vec3(0.0);
	vec3 histTransmittance = vec3(1.0);
	vec4 histMoments = vec4(0.0);
	bool validHistory = hasCloud && inBounds;

	if (validHistory) {
		vec2 texSize = vec2(push.outputWidth, push.outputHeight);

		// Use the Mitchell filter to fetch history, instantly fixing camera motion blur
		histColor = textureMitchellColor(push.historyColorIndex, historyUV, texSize);
		histTransmittance = textureMitchellColor(push.historyTransmittanceIndex, historyUV, texSize);

		// Moments can remain bilinear; sharp tracking is only strictly needed for visual channels
		histMoments = SAMPLE_LINEAR(push.historyMomentsIndex, historyUV);
	}

	// FIX 3: Transmittance Parallax Rejection
	// Ported from the older shader to instantly destroy smearing on disocclusion
	float curOpacity = 1.0 - dot(curTransmittance, vec3(0.3333));
	float histOpacity = 1.0 - dot(histTransmittance, vec3(0.3333));
	float relativeDiff = (curOpacity - histOpacity) / max(max(curOpacity, histOpacity), 0.001);

	// If cloud leaves pixel during strafe (-), or enters pixel (+)
	float trailingEdgeRejection = 1.0 - smoothstep(-0.6, -0.2, relativeDiff);
	float leadingEdgeRejection = smoothstep(0.5, 0.9, relativeDiff);
	float edgeRejection = max(trailingEdgeRejection, leadingEdgeRejection);

	float historyLength = min(8.0, histMoments.z + 1.0);
	if (validHistory && freshPixel) {
		historyLength = mix(historyLength, 1.0, edgeRejection); // Force reset on heavy disocclusion
	}

	float alpha = 1.0 / historyLength;

	vec3 m1 = vec3(0.0);
	vec3 m2 = vec3(0.0);
	vec3 t_m1 = vec3(0.0); // Transmittance mean
	vec3 t_m2 = vec3(0.0); // Transmittance squared mean
	float weightSum = 0.0;
	float weights[3] = float[](0.25, 0.5, 0.25);

	for (int dy = -1; dy <= 1; dy++) {
		for (int dx = -1; dx <= 1; dx++) {
			ivec2 neighborBlock = blockOrigin + ivec2(dx * 4, dy * 4);
			ivec2 neighborFreshCoord = clamp(neighborBlock + offset, ivec2(0), ivec2(push.outputWidth, push.outputHeight) - 1);
			vec2 sampleUV = (vec2(neighborFreshCoord) + 0.5) / vec2(push.outputWidth, push.outputHeight);

			vec3 c = SAMPLE_NEAREST(push.colorIndex, sampleUV).rgb;
			vec3 t = SAMPLE_NEAREST(push.transmittanceIndex, sampleUV).rgb;
			vec3 ycocg = RGBToYCoCg(c);

			float w = weights[abs(dx)] * weights[abs(dy)];
			m1 += ycocg * w;
			m2 += ycocg * ycocg * w;
			t_m1 += t * w;
			t_m2 += t * t * w;
			weightSum += w;
		}
	}
	m1 /= weightSum;
	m2 /= weightSum;
	t_m1 /= weightSum;
	t_m2 /= weightSum;

	// Color Sigma & Bounds
	vec3 sigma = sqrt(max(vec3(0.0), m2 - m1 * m1));
	vec3 nMin = m1 - 1.5 * sigma;
	vec3 nMax = m1 + 1.5 * sigma;

	// Transmittance Sigma & Bounds
	vec3 t_sigma = sqrt(max(vec3(0.0), t_m2 - t_m1 * t_m1));
	vec3 t_nMin = t_m1 - 1.5 * t_sigma;
	vec3 t_nMax = t_m1 + 1.5 * t_sigma;

	vec3 historyYCoCg = RGBToYCoCg(histColor);
	vec3 clippedYCoCg = clamp(historyYCoCg, nMin, nMax);
	vec3 clippedTrans = clamp(histTransmittance, t_nMin, t_nMax);

	// FIX 4: Use TOTAL motion for confidence, and override if edge is rejecting
	float pixelSpeed = length(totalMotion * vec2(push.outputWidth, push.outputHeight));
	float motionConfidenceFactor = smoothstep(3.0, 0.5, pixelSpeed);
	motionConfidenceFactor *= (1.0 - edgeRejection); // Don't relax clip on tearing edges

	vec3 blendedYCoCg = mix(clippedYCoCg, historyYCoCg, motionConfidenceFactor * 0.9);
	vec3 blendedTrans = mix(clippedTrans, histTransmittance, motionConfidenceFactor * 0.9);

	vec3 clippedHistColor = YCoCgToRGB(blendedYCoCg);
	vec3 clippedHistTrans = blendedTrans;

	vec3 blendedColor;
	vec3 blendedTransmittance;

	if (validHistory) {
		if (freshPixel) {
			blendedColor = mix(clippedHistColor, curColor, alpha);
			blendedTransmittance = mix(clippedHistTrans, curTransmittance, alpha);
		} else {
			blendedColor = clippedHistColor;
			blendedTransmittance = clippedHistTrans;
		}
	} else {
		// 5. Foreground-Aware Disocclusion Fallback
		if (hasCloud) {
			// Newly appeared cloud: use local neighborhood average
			// FIX 1: m1 is in YCoCg space! It MUST be converted back to RGB.
			blendedColor = YCoCgToRGB(m1);
			blendedTransmittance = t_m1;
			historyLength = 1.0;
		} else {
			// Empty sky or solid foreground object: INSTANTLY output empty space.
			// This prevents the neighborhood average (m1) from smearing cloud shadows onto trees.
			blendedColor = curColor; // vec3(0.0)
			blendedTransmittance = curTransmittance; // vec3(1.0)
			historyLength = 0.0;
		}
	}

	// Clean up phantom depths once the soft edge fully fades into empty sky
	if (all(greaterThan(blendedTransmittance, vec3(0.99)))) {
		reprojDepth = 1e9;
	}

	float blendedLuma = luminance(blendedColor);
	vec4 outMoments = vec4(blendedLuma, blendedLuma * blendedLuma, historyLength, reprojDepth);

	imageStore(uImagesGenericWrite[nonuniformEXT(push.outColorStorageIdx)], pixel, vec4(blendedColor, 0.0));
	imageStore(uImagesGenericWrite[nonuniformEXT(push.outTransmittanceStorageIdx)], pixel, vec4(blendedTransmittance, 0.0));
	imageStore(uImagesGenericWrite[nonuniformEXT(push.outMomentsStorageIdx)], pixel, outMoments);
}
