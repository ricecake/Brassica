#version 450
#extension GL_EXT_nonuniform_qualifier : require

#include "bindless.glsl"
#include "atmosphere/common.glsl"
#include "common.glsl"
#include "terrain.glsl"
#include "helpers/cloud_density.glsl"
#include "helpers/cloud_shadow_mapping.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform CloudShadowGenPushConstants {
	vec4  sunDir;                // xyz = sun direction
	uvec4 volumeIndices;         // x = sampled bindless index for CloudDetailVolume
	vec4  cameraPos;             // xyz = camera position, w = shadowMapExtent (320000.0)
	uint  weatherBiomeIndex;     // bindless index for weather map
	uint  minMaxIndex;           // bindless index for TerrainMinMaxTexture
	uint  shadowMapStorageIdx;   // bindless index for storage image array
} push;

// Density and extinction-coefficient formulas live in helpers/cloud_density.glsl, shared with
// cloud_raymarch.comp -- this used to be an independent, hand-tuned formula (different height
// shaping, no coverage erosion, no wind advection, and a vertical volume-texture axis sampled
// differently than the main pass), so the shadows this casts didn't actually match the clouds
// being rendered, and didn't respond to the cloudExtinctionScale/Color sliders at all.
float sampleCloudExtinction(vec3 p_cloud) {
	float distFromCam = length(p_cloud - push.cameraPos.xyz);
	float hFrac = heightFraction(p_cloud, distFromCam);
	if (hFrac < 0.0 || hFrac > 1.0) return 0.0;

	float worldExtent = 2.0 * FAKE_PLANET_RADIUS * 3.14159265359;
	vec2 weatherUV = fract((p_cloud.xz / worldExtent) + 0.5);

	float weatherCoverage = 0.0;
	float weatherType = 0.0;
	float weatherMoisture = 0.0;
	if (push.weatherBiomeIndex > 0u) {
		vec4 weatherSample = SAMPLE_LINEAR(push.weatherBiomeIndex, weatherUV);
		weatherCoverage = weatherSample.r;
		weatherType = weatherSample.g;
		weatherMoisture = weatherSample.b;
	}

	if (weatherCoverage <= 0.05) return 0.0;

	// Same wind advection as cloud_raymarch.comp, so shadows don't drift away from the clouds
	// casting them over a session. Deliberately skips the curl-noise warp the main pass also
	// applies: that warp moves samples by tens of metres, well under a 312m shadow-map texel, so
	// it would cost a noise evaluation here for no visible benefit.
	vec3 advectedPos = p_cloud - getCloudAdvectionSpeed(clamp(hFrac, 0.0, 1.0)) * uTime;
	float baseDensity = sampleCloudVolume(advectedPos, distFromCam, push.volumeIndices.x);
	float density = cloudShapeDensity(baseDensity, hFrac, weatherCoverage, weatherType, weatherMoisture);
	if (density <= 0.05) return 0.0;

	// Collapsed to a scalar the same way cloud_raymarch.comp's own reprojection heuristic does
	// (averaging channels), since the shadow map stores one scalar optical depth, not per-channel.
	vec3  rgbExtinction = cloudExtinctionCoefficient(hFrac, weatherType, weatherMoisture);
	float scalarExtinction = (rgbExtinction.r + rgbExtinction.g + rgbExtinction.b) / 3.0;
	return density * scalarExtinction;
}

void main() {
	ivec2 vox = ivec2(gl_GlobalInvocationID.xy);
	if (vox.x >= 1024 || vox.y >= 1024) return;

	// Staggered quarter-resolution schedule (2x2 Bayer grid), ported from boidish's
	// cloud_shadow_bake.comp: only 1/4 of texels get recomputed each frame, cycling through
	// all 4 phases over 4 frames, amortizing the raymarch below across them. Untouched texels
	// simply keep whatever they wrote last time they were in-phase -- CloudShadowMap
	// (passes/clouds/resources.hpp) is marked Lifetime::Persistent so that memory reliably
	// survives. The gate has to sit here, before EVEN the placeholder write below, or every
	// "skipped" texel would get stomped with placeholder/empty data every frame instead of
	// retaining its real value. Startup transient: for the first ~4 frames, 3/4 of texels
	// haven't been written yet and hold whatever the fresh allocation's initial content is --
	// boidish's reference has the identical transient, not treated as worth special-casing
	// there either. Toroidal addressing (helpers/cloud_shadow_mapping.glsl) means this schedule
	// is now purely a refresh-rate amortization: a texel not refreshed this frame still holds
	// correct (if a few frames stale) data for the exact world location it represents, since
	// that mapping never changes with camera movement.
	ivec2 bayerOffsets[4] = ivec2[](ivec2(0, 0), ivec2(1, 1), ivec2(1, 0), ivec2(0, 1));
	ivec2 currentOffset = bayerOffsets[int(uFrameIndex % 4u)];
	if ((vox.x % 2) != currentOffset.x || (vox.y % 2) != currentOffset.y) {
		return;
	}

	float shadowExtent = push.cameraPos.w > 0.0 ? push.cameraPos.w : 320000.0;

	float sunLen = length(push.sunDir.xyz);

	vec4 emptyData = vec4(20000.0, 0.0, 0.0, 1.0);
	imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, 0), emptyData);

	if (sunLen < 0.001 || push.sunDir.y <= 0.001) {
		vec4 nightData = vec4(0.0, 0.0, 100.0, 0.0);
		for (int l = 1; l <= 4; ++l) {
			imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, l), nightData);
		}
		return;
	}

	vec3 sunDir = push.sunDir.xyz / sunLen;
	float raySunY = max(sunDir.y, 0.05);

	vec2 centerXZ = push.cameraPos.xz - sunDir.xz * clamp(10000.0 / raySunY, 0.0, 100000.0);
	vec2 label = cloudShadowWriteLabel(vox, centerXZ, shadowExtent);

	// Anchored at the flat y=0 plane rather than real terrain height -- see
	// helpers/cloud_shadow_mapping.glsl's comment on cloudShadowLabel for why. bottomY is a
	// generous floor below any realistic terrain trough; traceTerrainOcclusion's hierarchical
	// mip trace finds the real intersection within that bound regardless of how loose it is, so
	// this no longer needs an actual terrain height sample (which also removes the TerrainClipmapTexture
	// dependency this node used to have).
	float topY = 20000.0;
	float bottomY = -5000.0;
	vec3 p_top = vec3(label.x, 0.0, label.y) + (topY / raySunY) * sunDir;
	float maxRayDist = (topY - bottomY) / raySunY;

	float distToTerrain = maxRayDist;
	if (push.minMaxIndex > 0u && push.minMaxIndex != 0xFFFFFFFFu) {
		TerrainOcclusionContext occCtx = makeTerrainOcclusionContext(push.minMaxIndex, 1088u, 11u, 0.0);
		traceTerrainOcclusion(occCtx, p_top, -sunDir, maxRayDist, distToTerrain);
	}

	vec3 p_terrain = p_top + distToTerrain * (-sunDir);
	float terrainIntersectionY = p_terrain.y;

	const int numSteps = 64;
	float stepSize = distToTerrain / float(numSteps);

	float cloudStartDist = -1.0;
	float cloudStartHeight = topY;
	const float kCloudThreshold = 0.0001;

	for (int i = 0; i < numSteps; ++i) {
		float t = (float(i) + 0.5) * stepSize;
		vec3 p = p_top + t * (-sunDir);
		if (p.y < terrainIntersectionY) break;

		float cloudExt = sampleCloudExtinction(p);
		float fogDiff = max(0.0, p.y - u_fogBaseHeight);
		float fogExt = u_fogDensity * exp(-u_fogHeightFalloff * fogDiff);
		float ext = cloudExt + fogExt;

		if (ext > kCloudThreshold) {
			cloudStartDist = t;
			cloudStartHeight = p.y;
			break;
		}
	}

	if (cloudStartDist < 0.0) {
		vec4 clearDataMeta = vec4(topY, terrainIntersectionY, 0.0, 1.0);
		imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, 0), clearDataMeta);
		vec4 clearLayer = vec4(0.0, 0.0, 0.0, 1.0);
		for (int l = 1; l <= 4; ++l) {
			imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, l), clearLayer);
		}
		return;
	}

	float activeRayLen = max(1.0, distToTerrain - cloudStartDist);
	vec3 p_cloudStart = p_top + cloudStartDist * (-sunDir);

	float activeStepSize = activeRayLen / float(numSteps);
	float maxExt = 0.0;
	float optDepth = 0.0;
	float distTraveled = 0.0;

	float fractionTargets[5] = float[5](0.0, 0.25, 0.50, 0.75, 1.00);
	bool savedLayer[5] = bool[5](false, false, false, false, false);

	// Layer 0: Metadata layer (r = cloudStartHeight, g = cloudEndHeight, b = 0.0 optical depth, a = 1.0 transmittance)
	vec4 layer0Data = vec4(cloudStartHeight, terrainIntersectionY, 0.0, 1.0);
	imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, 0), layer0Data);
	savedLayer[0] = true;

	for (int i = 0; i < numSteps; ++i) {
		float t = (float(i) + 0.5) * activeStepSize;
		vec3 p = p_cloudStart + t * (-sunDir);
		if (p.y < terrainIntersectionY) break;

		float cloudExt = sampleCloudExtinction(p);
		float fogDiff = max(0.0, p.y - u_fogBaseHeight);
		float fogExt = u_fogDensity * exp(-u_fogHeightFalloff * fogDiff);
		float ext = cloudExt + fogExt;
		ext *= smoothstep(0.01, 0.02, ext);

		maxExt = max(maxExt, ext);
		optDepth += ext * activeStepSize;
		distTraveled += activeStepSize;

		float currentFraction = clamp(float(i + 1) / float(numSteps), 0.0, 1.0);
		float avgExt = optDepth / max(distTraveled, 0.001);
		float transmittance = exp(-optDepth);

		vec4 layerData = vec4(maxExt, avgExt, optDepth, transmittance);

		if (!savedLayer[1] && currentFraction >= fractionTargets[1]) {
			imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, 1), layerData);
			savedLayer[1] = true;
		}
		if (!savedLayer[2] && currentFraction >= fractionTargets[2]) {
			imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, 2), layerData);
			savedLayer[2] = true;
		}
		if (!savedLayer[3] && currentFraction >= fractionTargets[3]) {
			imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, 3), layerData);
			savedLayer[3] = true;
		}
	}

	float avgExt = optDepth / max(distTraveled, 0.001);
	float finalTransmittance = exp(-optDepth);
	vec4 finalData = vec4(maxExt, avgExt, optDepth, finalTransmittance);

	for (int l = 1; l <= 4; ++l) {
		if (!savedLayer[l]) {
			imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, l), finalData);
		}
	}
}
