#version 450
#extension GL_EXT_nonuniform_qualifier : require

#include "bindless.glsl"
#include "atmosphere/common.glsl"
#include "common.glsl"
#include "terrain.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform CloudShadowGenPushConstants {
	vec4  sunDir;                // xyz = sun direction
	uvec4 cascadeSampledIdx;     // xyz = sampled bindless indices for volume cascades 0, 1, 2
	vec4  cameraPos;             // xyz = camera position, w = shadowMapExtent (320000.0)
	vec4  fogParams;             // x = fog density, y = fog height falloff, z = fog base height
	uvec4 gridParams;            // x = numLODs, y = meshletsPerRow, z = totalMeshlets, w = mapDim
	uint  weatherBiomeIndex;     // bindless index for weather map
	uint  shadowMapStorageIdx;   // bindless index for storage image array
	uint  terrainShadowMapIdx;   // bindless index for terrain shadow map
	uint  clipmapIndex;          // bindless index for terrain clipmap
} push;

float sampleCloudCascades(vec3 worldPos, float distFromCam) {
	float distSq = distFromCam * distFromCam;
	float dropOff = distSq / (2.0 * FAKE_PLANET_RADIUS);
	float adjustedY = worldPos.y + dropOff;

	float uv_y = (adjustedY - 5000.0) / 15000.0;
	if (uv_y < 0.0 || uv_y > 1.0) return 0.0;

	vec3 uvw0 = vec3(fract(worldPos.x / 20000.0),  uv_y, fract(worldPos.z / 20000.0));
	vec3 uvw1 = vec3(fract(worldPos.x / 80000.0),  uv_y, fract(worldPos.z / 80000.0));
	vec3 uvw2 = vec3(fract(worldPos.x / 320000.0), uv_y, fract(worldPos.z / 320000.0));

	float density = 0.0;
	if (distFromCam < 10000.0) {
		float d0 = SAMPLE_3D_LINEAR(push.cascadeSampledIdx.x, uvw0).r;
		if (distFromCam > 8000.0) {
			float d1 = SAMPLE_3D_LINEAR(push.cascadeSampledIdx.y, uvw1).r;
			density = mix(d0, d1, smoothstep(8000.0, 10000.0, distFromCam));
		} else {
			density = d0;
		}
	} else if (distFromCam < 40000.0) {
		float d1 = SAMPLE_3D_LINEAR(push.cascadeSampledIdx.y, uvw1).r;
		if (distFromCam > 32000.0) {
			float d2 = SAMPLE_3D_LINEAR(push.cascadeSampledIdx.z, uvw2).r;
			density = mix(d1, d2, smoothstep(32000.0, 40000.0, distFromCam));
		} else {
			density = d1;
		}
	} else {
		density = SAMPLE_3D_LINEAR(push.cascadeSampledIdx.z, uvw2).r;
	}

	return density;
}

float sampleCloudExtinction(vec3 p_cloud, vec3 camPos) {
	float distFromCam = length(p_cloud - camPos);
	float worldExtent = 2.0 * FAKE_PLANET_RADIUS * 3.14159265359;
	vec2 weatherUV = fract((p_cloud.xz / worldExtent) + 0.5);

	float weatherCoverage = 0.0;
	float weatherMoisture = 0.0;
	if (push.weatherBiomeIndex > 0u) {
		vec4 weatherSample = SAMPLE_LINEAR(push.weatherBiomeIndex, weatherUV);
		weatherCoverage = weatherSample.r;
		weatherMoisture = weatherSample.b;
	}

	if (weatherCoverage > 0.01) {
		float baseDensity = sampleCloudCascades(p_cloud, distFromCam) * weatherCoverage;
		float density = 10.0 * baseDensity * (0.5 + 1.5 * weatherMoisture);
		if (density > 0.0) {
			// Realistic physical cloud extinction allowing smooth optical depth accumulation across the entire cloud volume
			return max(0.0, density * (0.0005 + 0.002 * weatherMoisture));
		}
	}
	return 0.0;
}

void main() {
	ivec2 vox = ivec2(gl_GlobalInvocationID.xy);
	if (vox.x >= 1024 || vox.y >= 1024) return;

	vec2 gridUV = (vec2(vox) + 0.5) / 1024.0;
	float shadowExtent = push.cameraPos.w > 0.0 ? push.cameraPos.w : 320000.0;

	float sunLen = length(push.sunDir.xyz);

	// Layer 0: Top of cloud layer (20,000m) - unoccluded baseline
	imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, 0), vec4(0.0, 0.0, 0.0, 1.0));

	if (sunLen < 0.001) {
		vec4 nightData = vec4(0.0, 0.0, 100.0, 0.0);
		imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, 1), nightData);
		imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, 2), nightData);
		imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, 3), nightData);
		imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, 4), nightData);
		return;
	}

	vec3 sunDir = push.sunDir.xyz / sunLen;

	if (sunDir.y <= 0.001) {
		vec4 nightData = vec4(0.0, 0.0, 100.0, 0.0);
		imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, 1), nightData);
		imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, 2), nightData);
		imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, 3), nightData);
		imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, 4), nightData);
		return;
	}

	float raySunY = max(sunDir.y, 0.05);
	vec2 centerXZ = push.cameraPos.xz - sunDir.xz * clamp(10000.0 / raySunY, 0.0, 100000.0);
	vec2 worldXZ = centerXZ + (gridUV - 0.5) * shadowExtent;

	vec3 p_ground = vec3(worldXZ.x, 0.0, worldXZ.y);
	float topY = 20000.0;
	vec3 p_top = p_ground + (topY / raySunY) * sunDir;
	float totalDist = topY / raySunY;

	const int numSteps = 64;
	float stepSize = totalDist / float(numSteps);

	float maxExt = 0.0;
	float optDepth = 0.0;
	float distTraveled = 0.0;
	float minTerrainShadow = 1.0;

	bool savedL1 = false;
	bool savedL2 = false;
	bool savedL3 = false;

	for (int i = 0; i < numSteps; ++i) {
		float t = (float(i) + 0.5) * stepSize;
		vec3 p = p_top + t * (-sunDir);
		float currentY = p.y;

		float cloudExt = sampleCloudExtinction(p, push.cameraPos.xyz);
		float fogDiff = max(0.0, p.y - push.fogParams.z);
		float fogExt = push.fogParams.x * exp(-push.fogParams.y * fogDiff);
		float ext = cloudExt + fogExt;
		maxExt = max(maxExt, ext);
		optDepth += ext * stepSize;
		distTraveled += stepSize;

		// 1. Solid terrain clipmap height check across the whole 320km domain
		if (push.clipmapIndex > 0u && push.clipmapIndex != 0xFFFFFFFFu) {
			uint lodLevel = terrainClipmapLevelFor(p.xz, push.gridParams.w, push.gridParams.x);
			float terrH = sampleTerrainClipmap(push.clipmapIndex, p.xz, lodLevel, push.gridParams.w).r;
			float drop = terrainDropOff(p.xz);
			if (p.y <= terrH - drop + 0.5) {
				minTerrainShadow = 0.0;
			}
		}

		// 2. Soft terrain shadow map check with boundary edge fade
		if (minTerrainShadow > 0.0 && push.terrainShadowMapIdx > 0u && push.terrainShadowMapIdx != 0xFFFFFFFFu) {
			float softVal = evaluateTerrainShadowFromMap(push.terrainShadowMapIdx, p, sunDir, push.gridParams.w);
			vec2 offsetFromCam = p.xz - push.cameraPos.xz;
			float distXZ = max(abs(offsetFromCam.x), abs(offsetFromCam.y));
			float maxRange = float(push.gridParams.w) * texelSize(6u) * 0.5;
			float fade = smoothstep(maxRange * 0.7, maxRange * 0.95, distXZ);
			float terrSoftShadow = mix(softVal, 1.0, fade);
			minTerrainShadow = min(minTerrainShadow, terrSoftShadow);
		}

		float avgExt = optDepth / max(distTraveled, 0.001);
		float transmittance = exp(-optDepth) * minTerrainShadow;

		if (!savedL1 && currentY <= 12500.0) {
			imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, 1), vec4(maxExt, avgExt, optDepth, transmittance));
			savedL1 = true;
		}
		if (!savedL2 && currentY <= 5000.0) {
			imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, 2), vec4(maxExt, avgExt, optDepth, transmittance));
			savedL2 = true;
		}
		if (!savedL3 && currentY <= 2500.0) {
			imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, 3), vec4(maxExt, avgExt, optDepth, transmittance));
			savedL3 = true;
		}
	}

	float avgExt = optDepth / max(distTraveled, 0.001);
	float transmittance = exp(-optDepth) * minTerrainShadow;
	vec4 finalData = vec4(maxExt, avgExt, optDepth, transmittance);

	if (!savedL1) imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, 1), finalData);
	if (!savedL2) imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, 2), finalData);
	if (!savedL3) imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, 3), finalData);
	// Layer 4: Ground level / totals (0m)
	imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, 4), finalData);
}
