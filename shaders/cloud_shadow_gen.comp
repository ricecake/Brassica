#version 450
#extension GL_EXT_nonuniform_qualifier : require

#include "bindless.glsl"
#include "atmosphere/common.glsl"
#include "common.glsl"
#include "terrain.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform CloudShadowGenPushConstants {
	vec4  sunDir;                // xyz = sun direction
	uvec4 cascadeSampledIdx;     // xyz = sampled bindless indices for volume cascades 0, 1, 2
	vec4  cameraPos;             // xyz = camera position, w = shadowMapExtent (320000.0)
	vec4  fogParams;             // x = fog density, y = fog height falloff, z = fog base height
	uint  weatherBiomeIndex;     // bindless index for weather map
	uint  clipmapIndex;          // bindless index for TerrainClipmapTexture
	uint  minMaxIndex;           // bindless index for TerrainMinMaxTexture
	uint  shadowMapStorageIdx;   // bindless index for storage image array
} push;

float sampleCloudCascades(vec3 worldPos, float distFromCam) {
	float distSq = distFromCam * distFromCam;
	float dropOff = distSq / (2.0 * FAKE_PLANET_RADIUS);
	float adjustedY = worldPos.y + dropOff;

	float uv_y = (adjustedY - 5000.0) / 15000.0;
	if (uv_y < 0.0 || uv_y > 1.0) return 0.0;

	vec3 uvw0 = vec3(fract(worldPos.x / 20000.0),  uv_y, fract(worldPos.z / 20000.0));
	vec3 uvw1 = vec3(fract(worldPos.x / 80000.0),  uv_y, fract(worldPos.z / 80000.0));
	vec3 uvw2 = vec3(fract(worldPos.x / 320000.0), uv_y, fract(worldPos.z / 320000.0));

	float density = 0.0;
	if (distFromCam < 10000.0) {
		float d0 = SAMPLE_3D_LINEAR(push.cascadeSampledIdx.x, uvw0).r;
		if (distFromCam > 8000.0) {
			float d1 = SAMPLE_3D_LINEAR(push.cascadeSampledIdx.y, uvw1).r;
			density = mix(d0, d1, smoothstep(8000.0, 10000.0, distFromCam));
		} else {
			density = d0;
		}
	} else if (distFromCam < 40000.0) {
		float d1 = SAMPLE_3D_LINEAR(push.cascadeSampledIdx.y, uvw1).r;
		if (distFromCam > 32000.0) {
			float d2 = SAMPLE_3D_LINEAR(push.cascadeSampledIdx.z, uvw2).r;
			density = mix(d1, d2, smoothstep(32000.0, 40000.0, distFromCam));
		} else {
			density = d1;
		}
	} else {
		density = SAMPLE_3D_LINEAR(push.cascadeSampledIdx.z, uvw2).r;
	}

	return density;
}

float sampleCloudExtinction(vec3 p_cloud, vec3 camPos) {
	float distFromCam = length(p_cloud - camPos);
	float worldExtent = 2.0 * FAKE_PLANET_RADIUS * 3.14159265359;
	vec2 weatherUV = fract((p_cloud.xz / worldExtent) + 0.5);

	float weatherCoverage = 0.0;
	float weatherMoisture = 0.0;
	if (push.weatherBiomeIndex > 0u) {
		vec4 weatherSample = SAMPLE_LINEAR(push.weatherBiomeIndex, weatherUV);
		weatherCoverage = weatherSample.r;
		weatherMoisture = weatherSample.b;
	}

	if (weatherCoverage > 0.01) {
		float baseDensity = sampleCloudCascades(p_cloud, distFromCam) * weatherCoverage;
		float density = 10.0 * baseDensity * (0.5 + 1.5 * weatherMoisture);
		if (density > 0.0) {
			// Realistic physical cloud extinction allowing smooth optical depth accumulation across the entire cloud volume
			return max(0.0, density * (0.0005 + 0.002 * weatherMoisture));
		}
	}
	return 0.0;
}

void main() {
	ivec2 vox = ivec2(gl_GlobalInvocationID.xy);
	if (vox.x >= 1024 || vox.y >= 1024) return;

	vec2 gridUV = (vec2(vox) + 0.5) / 1024.0;
	float shadowExtent = push.cameraPos.w > 0.0 ? push.cameraPos.w : 320000.0;

	float sunLen = length(push.sunDir.xyz);

	vec4 emptyData = vec4(0.0, 20000.0, 0.0, 1.0);
	imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, 0), emptyData);

	if (sunLen < 0.001 || push.sunDir.y <= 0.001) {
		vec4 nightData = vec4(0.0, 0.0, 100.0, 0.0);
		for (int l = 1; l <= 4; ++l) {
			imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, l), nightData);
		}
		return;
	}

	vec3 sunDir = push.sunDir.xyz / sunLen;
	float raySunY = max(sunDir.y, 0.05);

	vec2 centerXZ = push.cameraPos.xz - sunDir.xz * clamp(10000.0 / raySunY, 0.0, 100000.0);
	vec2 worldXZ = centerXZ + (gridUV - 0.5) * shadowExtent;

	float dropOff = terrainDropOff(worldXZ);
	float terrainH = (push.clipmapIndex > 0u && push.clipmapIndex != 0xFFFFFFFFu) ? sampleTerrainClipmap(push.clipmapIndex, worldXZ, 0u, 1088u).r : 0.0;
	float groundY = terrainH - dropOff;

	vec3 p_ground = vec3(worldXZ.x, groundY, worldXZ.y);
	float topY = 20000.0;
	float rayHeightSpan = max(0.0, topY - groundY);
	vec3 p_top = p_ground + (rayHeightSpan / raySunY) * sunDir;
	float maxRayDist = rayHeightSpan / raySunY;

	float distToTerrain = maxRayDist;
	if (push.minMaxIndex > 0u && push.minMaxIndex != 0xFFFFFFFFu) {
		TerrainOcclusionContext occCtx = makeTerrainOcclusionContext(push.minMaxIndex, 1088u, 11u, 0.0);
		traceTerrainOcclusion(occCtx, p_top, -sunDir, maxRayDist, distToTerrain);
	}

	vec3 p_terrain = p_top + distToTerrain * (-sunDir);
	float terrainIntersectionY = p_terrain.y;

	const int numSteps = 64;
	float stepSize = distToTerrain / float(numSteps);

	float cloudStartDist = -1.0;
	float cloudStartHeight = topY;
	const float kCloudThreshold = 0.0001;

	for (int i = 0; i < numSteps; ++i) {
		float t = (float(i) + 0.5) * stepSize;
		vec3 p = p_top + t * (-sunDir);
		if (p.y < terrainIntersectionY) break;

		float cloudExt = sampleCloudExtinction(p, push.cameraPos.xyz);
		float fogDiff = max(0.0, p.y - push.fogParams.z);
		float fogExt = push.fogParams.x * exp(-push.fogParams.y * fogDiff);
		float ext = cloudExt + fogExt;

		if (ext > kCloudThreshold) {
			cloudStartDist = t;
			cloudStartHeight = p.y;
			break;
		}
	}

	if (cloudStartDist < 0.0) {
		vec4 clearData = vec4(0.0, topY, terrainIntersectionY, 1.0);
		for (int l = 0; l <= 4; ++l) {
			imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, l), clearData);
		}
		return;
	}

	float activeRayLen = max(1.0, distToTerrain - cloudStartDist);
	vec3 p_cloudStart = p_top + cloudStartDist * (-sunDir);

	float activeStepSize = activeRayLen / float(numSteps);
	float maxExt = 0.0;
	float optDepth = 0.0;
	float distTraveled = 0.0;

	float fractionTargets[5] = float[5](0.0, 0.25, 0.50, 0.75, 1.00);
	bool savedLayer[5] = bool[5](false, false, false, false, false);

	vec4 layer0Data = vec4(0.0, cloudStartHeight, terrainIntersectionY, 1.0);
	imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, 0), layer0Data);
	savedLayer[0] = true;

	for (int i = 0; i < numSteps; ++i) {
		float t = (float(i) + 0.5) * activeStepSize;
		vec3 p = p_cloudStart + t * (-sunDir);
		if (p.y < terrainIntersectionY) break;

		float cloudExt = sampleCloudExtinction(p, push.cameraPos.xyz);
		float fogDiff = max(0.0, p.y - push.fogParams.z);
		float fogExt = push.fogParams.x * exp(-push.fogParams.y * fogDiff);
		float ext = cloudExt + fogExt;

		maxExt = max(maxExt, ext);
		optDepth += ext * activeStepSize;
		distTraveled += activeStepSize;

		float currentFraction = clamp(float(i + 1) / float(numSteps), 0.0, 1.0);
		float avgExt = optDepth / max(distTraveled, 0.001);
		float transmittance = exp(-optDepth);

		vec4 layerData = vec4(maxExt, avgExt, optDepth, transmittance);

		if (!savedLayer[1] && currentFraction >= fractionTargets[1]) {
			imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, 1), layerData);
			savedLayer[1] = true;
		}
		if (!savedLayer[2] && currentFraction >= fractionTargets[2]) {
			imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, 2), layerData);
			savedLayer[2] = true;
		}
		if (!savedLayer[3] && currentFraction >= fractionTargets[3]) {
			imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, 3), layerData);
			savedLayer[3] = true;
		}
	}

	float avgExt = optDepth / max(distTraveled, 0.001);
	float finalTransmittance = exp(-optDepth);
	vec4 finalData = vec4(maxExt, avgExt, optDepth, finalTransmittance);

	for (int l = 1; l <= 4; ++l) {
		if (!savedLayer[l]) {
			imageStore(uImageArraysGenericWrite[nonuniformEXT(push.shadowMapStorageIdx)], ivec3(vox, l), finalData);
		}
	}
}
