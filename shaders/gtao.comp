#version 460
#include "bindless.glsl"
#include "bindless_tlas.glsl"
#include "common.glsl"

layout(push_constant) uniform GTAOPushConstants {
	uint  gPositionIndex;
	uint  gNormalIndex;
	uint  gDepthIndex;
	uint  outGtaoIndex;
	uvec2 screenSize;
	float radiusWorld;
	float intensity;
	uint  decorTlasIndex;
}
params;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

float spatialJitter(ivec2 p) {
	return fract(sin(dot(vec2(p), vec2(12.9898, 78.233))) * 43758.5453);
}

// Cosine-weighted hemisphere sample direction `i` of `count` around `normal`, via Malley's
// method (uniform disk -> hemisphere projection). `jitter` (the same per-pixel spatialJitter
// noise already used for the screen-space slices above) rotates the golden-ratio quasi-random
// sequence per pixel so neighboring pixels' probe directions decorrelate instead of banding.
vec3 cosineHemisphereSample(vec3 normal, uint i, uint count, float jitter) {
	float u1 = fract((float(i) + jitter) / float(count));
	float u2 = fract(float(i) * 0.6180339887498949 + jitter);
	float r = sqrt(u1);
	float theta = 2.0 * PI * u2;
	vec3  localDir = vec3(r * cos(theta), r * sin(theta), sqrt(max(0.0, 1.0 - u1)));

	vec3 up = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
	vec3 tangent = normalize(cross(up, normal));
	vec3 bitangent = cross(normal, tangent);
	return tangent * localDir.x + bitangent * localDir.y + normal * localDir.z;
}

// Ray-traced decor (trees/bushes/rocks) occlusion probe against DecorTLAS -- model-shadows AO
// stage, reusing the same occlusion-only rayQuery pattern deferred.frag's evaluateDecorShadow
// already established (gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT: every BLAS
// geometry in DecorTLAS is built eOpaque, so no any-hit confirmation loop is needed). Casts
// NUM_AO_RAYS short, cosine-weighted hemisphere probes (reach = radiusWorld, the same tunable
// world-space distance the screen-space horizon search above already uses) and returns the
// fraction unoccluded -- multiplied into the screen-space visibility below, not blended with
// min(): these are two independent estimates of the same "is this point unoccluded" quantity,
// not stacked attenuation layers the way cloud shadow's multiplicative term is either.
float evaluateDecorAO(vec3 rayOrigin, vec3 normal, float jitter) {
	const uint NUM_AO_RAYS = 4u;
	uint       hitCount = 0u;

	for (uint i = 0u; i < NUM_AO_RAYS; ++i) {
		vec3 dir = cosineHemisphereSample(normal, i, NUM_AO_RAYS, jitter);

		rayQueryEXT rq;
		rayQueryInitializeEXT(
			rq,
			uTLAS[nonuniformEXT(params.decorTlasIndex)],
			gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT,
			0xFF,
			rayOrigin,
			0.01,
			dir,
			params.radiusWorld
		);

		while (rayQueryProceedEXT(rq)) {
		}

		if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
			++hitCount;
		}
	}

	return 1.0 - (float(hitCount) / float(NUM_AO_RAYS));
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if (pixel.x >= params.screenSize.x || pixel.y >= params.screenSize.y) {
		return;
	}

	vec2 uv = (vec2(pixel) + 0.5) / vec2(params.screenSize);
	vec4 posSample = SAMPLE_NEAREST(params.gPositionIndex, uv);
	vec4 normalSample = SAMPLE_NEAREST(params.gNormalIndex, uv);

	// If background / unrendered pixel, write 1.0 (unoccluded)
	if (posSample.a <= 0.0 || normalSample.a <= 0.0 || length(normalSample.rgb) < 0.1 || length(posSample.rgb) < 0.001) {
		imageStore(uImagesGenericWrite[nonuniformEXT(params.outGtaoIndex)], pixel, vec4(1.0, 0.0, 0.0, 0.0));
		return;
	}

	// GBufferPosition stores camera-relative position (posWorld - uCameraPosition.xyz).
	// Multiplying by mat3(uViewMatrix) applies view-rotation to transform to view-space.
	vec3 viewPos = mat3(uViewMatrix) * posSample.rgb;
	float viewDist = length(viewPos);
	if (viewDist < 0.001) {
		imageStore(uImagesGenericWrite[nonuniformEXT(params.outGtaoIndex)], pixel, vec4(1.0, 0.0, 0.0, 0.0));
		return;
	}
	vec3 viewNorm = normalize(mat3(uViewMatrix) * normalSample.rgb);
	vec3 V = -viewPos / viewDist;

	float noise = spatialJitter(pixel);

	const int NUM_SLICES = 4;
	const int NUM_STEPS = 4;

	// Convert the world-space search radius to a screen-space pixel radius using the
	// camera's actual vertical focal length, so the AO reach stays physically consistent
	// across resolution/FOV/distance instead of being an arbitrary pixel count.
	float focalLenPx = uProjMatrix[1][1] * float(params.screenSize.y) * 0.5;
	float radiusScreen = clamp(
		params.radiusWorld * focalLenPx / max(-viewPos.z, 0.1),
		2.0,
		float(params.screenSize.y)
	);

	float totalVis = 0.0;
	float totalWeight = 0.0;

	for (int s = 0; s < NUM_SLICES; ++s) {
		float sliceAngle = (float(s) + noise) * (PI / float(NUM_SLICES));
		vec2 sliceDir = vec2(cos(sliceAngle), sin(sliceAngle));

		vec3 dir3 = vec3(sliceDir, 0.0);
		vec3 slicePlaneNorm = cross(dir3, V);
		float slicePlaneLen = length(slicePlaneNorm);

		float lenNproj = 0.0;
		float n = 0.0;

		if (slicePlaneLen > 0.001) {
			slicePlaneNorm /= slicePlaneLen;
			vec3 projNorm = viewNorm - slicePlaneNorm * dot(viewNorm, slicePlaneNorm);
			lenNproj = length(projNorm);

			if (lenNproj > 0.001) {
				vec3 projNormHat = projNorm / lenNproj;
				float cosN = clamp(dot(projNormHat, V), -1.0, 1.0);
				float sgnN = sign(dot(projNorm, dir3));
				n = sgnN * acos(cosN);
			}
		}

		float maxH1 = -1.0;
		float maxH2 = -1.0;

		for (int step = 1; step <= NUM_STEPS; ++step) {
			float stepDist = (float(step) + noise) * (radiusScreen / float(NUM_STEPS));

			// Horizon step 1 (+sliceDir)
			vec2 sampleUV1 = uv + sliceDir * stepDist / vec2(params.screenSize);
			if (sampleUV1.x >= 0.0 && sampleUV1.x <= 1.0 && sampleUV1.y >= 0.0 && sampleUV1.y <= 1.0) {
				vec3 sPos1 = mat3(uViewMatrix) * SAMPLE_NEAREST(params.gPositionIndex, sampleUV1).rgb;
				vec3 delta1 = sPos1 - viewPos;
				float len1 = length(delta1);
				if (len1 > 0.001 && len1 < 20.0) {
					float cosTheta1 = dot(delta1 / len1, V);
					maxH1 = max(maxH1, cosTheta1);
				}
			}

			// Horizon step 2 (-sliceDir)
			vec2 sampleUV2 = uv - sliceDir * stepDist / vec2(params.screenSize);
			if (sampleUV2.x >= 0.0 && sampleUV2.x <= 1.0 && sampleUV2.y >= 0.0 && sampleUV2.y <= 1.0) {
				vec3 sPos2 = mat3(uViewMatrix) * SAMPLE_NEAREST(params.gPositionIndex, sampleUV2).rgb;
				vec3 delta2 = sPos2 - viewPos;
				float len2 = length(delta2);
				if (len2 > 0.001 && len2 < 20.0) {
					float cosTheta2 = dot(delta2 / len2, V);
					maxH2 = max(maxH2, cosTheta2);
				}
			}
		}

		// Horizon angles relative to V
		float theta1 = -acos(clamp(maxH1, -1.0, 1.0)); // range [-PI, 0]
		float theta2 = acos(clamp(maxH2, -1.0, 1.0));  // range [0, PI]

		// Clamp horizon angles to normal hemisphere [n - PI/2, n + PI/2]
		float h1 = n + max(-PI * 0.5, theta1 - n);
		float h2 = n + min(PI * 0.5, theta2 - n);

		float sliceVis = clamp((sin(h2 - n) - sin(h1 - n)) * 0.5, 0.0, 1.0);

		float weight = max(lenNproj, 0.001);
		totalVis += sliceVis * weight;
		totalWeight += weight;
	}

	float visibility = (totalWeight > 0.0) ? clamp(totalVis / totalWeight, 0.0, 1.0) : 1.0;

	// Strength control: scale the occlusion amount (not the raw visibility) so intensity=1.0
	// reproduces the unscaled horizon-based result exactly.
	float occlusion = clamp(1.0 - visibility, 0.0, 1.0) * params.intensity;
	visibility = clamp(1.0 - occlusion, 0.0, 1.0);

	// Ray-traced decor occlusion -- independent estimate of the same quantity, multiplied in
	// (not min()'d) same reasoning as evaluateDecorAO's own comment. World-space origin: posSample
	// is camera-relative (this shader's own comment above), same convention deferred.frag's
	// decor-shadow rays already use. Same params.intensity scaling as the screen-space term above,
	// for one unified strength knob rather than two independent ones.
	vec3  worldPos = posSample.rgb + uCameraPosition.xyz;
	vec3  rtOrigin = worldPos + normalSample.rgb * 0.05;
	float rtVisibility = evaluateDecorAO(rtOrigin, normalSample.rgb, noise);
	float rtOcclusion = clamp(1.0 - rtVisibility, 0.0, 1.0) * params.intensity;
	visibility *= clamp(1.0 - rtOcclusion, 0.0, 1.0);

	imageStore(uImagesGenericWrite[nonuniformEXT(params.outGtaoIndex)], pixel, vec4(visibility, 0.0, 0.0, 0.0));
}
