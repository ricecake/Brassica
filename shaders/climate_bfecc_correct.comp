#version 460
#extension GL_EXT_nonuniform_qualifier : require

#include "bindless.glsl"
#include "common.glsl"

layout(set = 1, binding = 3, rgba32f) uniform image2D uImageStorageRGBA32F[];
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform ClimateBFECCCorrectPushConstants {
	uint  forwardStorageIdx;  // phi1 (the forward-advected state)
	uint  originalStorageIdx; // phi0 (the original state before advection)
	uint  outStorageIdx;      // phi0_tilde (the corrected state, overwritten in place)
	uint  textureDim;         // 1024
	float dt;                 // Advection step size
} push;

void main() {
	uvec2 pixel = gl_GlobalInvocationID.xy;
	if (pixel.x >= push.textureDim || pixel.y >= push.textureDim) {
		return;
	}

	vec2 uv = (vec2(pixel) + 0.5) / float(push.textureDim);
	ivec2 coord = ivec2(pixel);

	// Read forward-advected velocity at this cell
	vec4 forwardData = imageLoad(uImageStorageRGBA32F[nonuniformEXT(push.forwardStorageIdx)], coord);
	vec2 forwardWind = forwardData.ba;

	// Backward semi-Lagrangian trace along the reverse velocity field
	vec2 backtrackUV = uv + forwardWind * push.dt;
	backtrackUV = fract(backtrackUV);

	ivec2 backtrackCoord = ivec2(clamp(backtrackUV * float(push.textureDim), vec2(0.0), vec2(float(push.textureDim - 1))));

	// Sample the original field phi0 at the backtraced position: phi0_star = phi0(x + v*dt)
	vec4 originalSample = imageLoad(uImageStorageRGBA32F[nonuniformEXT(push.originalStorageIdx)], backtrackCoord);

	// Read phi0 at this cell
	vec4 phi0 = imageLoad(uImageStorageRGBA32F[nonuniformEXT(push.originalStorageIdx)], coord);

	// Pointwise BFECC correction: phi0_tilde = phi0 + 0.5 * (phi0 - phi0_star)
	vec4 corrected = phi0 + 0.5 * (phi0 - originalSample);

	imageStore(
		uImageStorageRGBA32F[nonuniformEXT(push.outStorageIdx)],
		coord,
		vec4(clamp(corrected.r, 0.0, 1.0), clamp(corrected.g, 0.0, 1.0), corrected.b, corrected.a)
	);
}
