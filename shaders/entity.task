#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint64_t uEntityBufferAddress;
    uint uTotalInstances;
    uint uBaseInstanceIndex;
} push;

struct EntityInstanceData {
    vec4 positionAndScale;
    vec4 color;
    uvec4 params;   // x = meshType (0=Ball, 1=Cylinder, 2=Cow), y = numVertices, z = numTriangles, w = numMeshlets
    vec4 material;
    vec4 rotation;
    uint64_t vertexBufferAddress;
    uint64_t indexBufferAddress;
    uint64_t meshletBufferAddress;
    uint64_t meshletVertBufferAddress;
    uint64_t meshletTriBufferAddress;
};

layout(buffer_reference, std430) readonly buffer EntityBufferRef {
    EntityInstanceData instances[];
};

struct TaskPayload {
    uint instanceIndex;
    uint meshletIndex;
};

taskPayloadSharedEXT TaskPayload OUT;

void main() {
    uint instanceIdx = push.uBaseInstanceIndex + gl_WorkGroupID.x;
    if (instanceIdx >= push.uTotalInstances) {
        EmitMeshTasksEXT(0, 0, 0);
        return;
    }

    EntityBufferRef entityBuf = EntityBufferRef(push.uEntityBufferAddress);
    EntityInstanceData inst = entityBuf.instances[instanceIdx];

    uint meshType = inst.params.x;
    uint numMeshlets = 1u;

    if (meshType == 2u) { // GLB model / Cow mesh
        numMeshlets = inst.params.w;
        if (numMeshlets == 0u) numMeshlets = 1u;
    }

    OUT.instanceIndex = instanceIdx;
    OUT.meshletIndex = gl_LocalInvocationID.x;

    EmitMeshTasksEXT(numMeshlets, 1, 1);
}
