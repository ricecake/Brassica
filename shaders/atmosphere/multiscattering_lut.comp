#version 460 core
#include "bindless.glsl"

layout(local_size_x = 32, local_size_y = 32) in;

layout(push_constant) uniform MultiScatteringPushConstants {
	uint outIndex;
	uint transmittanceIndex;
}
push;

#include "atmosphere/common.glsl"
vec3 getTransmittance(float r, float mu) {
	vec2 uv = transmittanceToUV(r, mu);
	return SAMPLE_LINEAR(push.transmittanceIndex, uv).rgb;
}

void main() {
	ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
	vec2  size = vec2(imageSize(uImagesRGBA32F[nonuniformEXT(push.outIndex)]));
	if (any(greaterThanEqual(texel, ivec2(size))))
		return;

	float cosSun = (float(texel.x) / size.x) * 2.0 - 1.0;
	float r = kEarthRadius + (float(texel.y) / size.y) * kAtmosphereHeight;

	const int nSamples = 64;
	vec3      totalL = vec3(0.0);
	vec3      totalF = vec3(0.0);

	for (int i = 0; i < nSamples; ++i) {
		float phi = 2.0 * PI * (float(i) / float(nSamples));
		float theta = acos(1.0 - 2.0 * (float(i) + 0.5) / float(nSamples));
		vec3  rd = vec3(sin(theta) * cos(phi), cos(theta), sin(theta) * sin(phi));

		float t0, t1;
		if (intersectSphere(vec3(0, r, 0), rd, kTopRadius, t0, t1)) {
			float t_max = t1;
			float p0, p1;
			// Epsilon tolerance, not > 0.0: at texel row y=0, r is exactly kEarthRadius, so the ray
			// origin sits exactly ON the ground sphere. intersectSphere's near root p0 works out to
			// -b-sqrt(b*b-c) with c=(len(ro)-radius)*(len(ro)+radius) -- mathematically 0 here, but
			// len(ro) (itself a sqrt) subtracting a ~600-magnitude radius is exactly the setup for
			// floating-point cancellation error, so p0 lands at a tiny *nonzero* value of either
			// sign, not a clean 0.0. A strict "> 0.0" (or even ">= 0.0") check then unpredictably
			// misses the "ray points into the ground" case, and t_max silently falls back to the
			// full top-of-atmosphere distance (~100km) instead of ~0. Confirmed by hand: this was
			// inflating the multi-scattering estimate ~10,000x at ground level -- the altitude
			// every camera normally sits at.
			const float kGroundEpsilonKM = 0.001;
			if (intersectSphere(vec3(0, r, 0), rd, kEarthRadius, p0, p1) && p0 > -kGroundEpsilonKM)
				t_max = max(0.0, p0);

			const int kInnerSteps = 8;
			float     dt = t_max / float(kInnerSteps);
			vec3      L_ray = vec3(0.0);
			vec3      f_ray = vec3(0.0);
			vec3      T_ray = vec3(1.0);

			for (int j = 0; j < kInnerSteps; ++j) {
				float    t = (float(j) + 0.5) * dt;
				vec3     p = vec3(0, r, 0) + rd * t;
				float    h = length(p) - kEarthRadius;
				Sampling s = getAtmosphereProperties(h);

				vec3 Ts = getTransmittance(length(p), cosSun);

				vec3 scattering = s.rayleigh + s.mie;
				L_ray += T_ray * scattering * Ts * dt;
				f_ray += T_ray * scattering * dt;
				T_ray *= exp(-s.extinction * dt);
			}

			totalL += L_ray;
			totalF += f_ray;
		}
	}

	vec3 L_avg = (totalL / float(nSamples)) / (4.0 * PI);
	vec3 f_avg = totalF / float(nSamples);

	vec3 multiScat = L_avg / max(vec3(0.1), vec3(1.0) - min(f_avg, vec3(0.9)));
	imageStore(uImagesRGBA32F[nonuniformEXT(push.outIndex)], texel, vec4(multiScat, 1.0));
}
