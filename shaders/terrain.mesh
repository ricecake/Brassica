#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_fragment_shading_rate : require
#include "bindless.glsl"

layout(local_size_x = 11, local_size_y = 11, local_size_z = 1) in;
layout(triangles, max_vertices = 161, max_primitives = 280) out;

layout(push_constant) uniform TerrainPushConstants {
	uvec4 gridParams; // x = numLODs, y = meshletsPerRow, z = totalMeshlets
	uvec4 lodOffsets0_3;
	uvec4 lodOffsets4_7;
	uint  clipmapIndex;
} params;

vec2 sampleToroidalUV(vec2 worldXZ, uint level) {
	float baseTexelSize = uCameraPosition.w;
	float texelSize = baseTexelSize * pow(2.0, float(level));
	uint textureDim = (params.gridParams.w > 0u) ? params.gridParams.w : 1088u;

	uvec4 offsets = (level < 4) ? params.lodOffsets0_3 : params.lodOffsets4_7;
	uint packed = offsets[level % 4];
	ivec2 gridOffset = ivec2(int(packed & 0xFFFFu), int((packed >> 16u) & 0xFFFFu));

	vec2 centerWorldPos = floor(uCameraPosition.xz / texelSize) * texelSize;
	vec2 deltaWorld = worldXZ - centerWorldPos;
	vec2 texelCoord = deltaWorld / texelSize + vec2(float(textureDim) * 0.5) + vec2(gridOffset);

	return fract(texelCoord / float(textureDim));
}

struct TaskPayload {
	uint meshletIDs[32];
	uint lodLevels[32];
};

taskPayloadSharedEXT TaskPayload payload;

layout(location = 0) out vec3 outPosition[];
layout(location = 1) out vec3 outNormal[];
layout(location = 2) out vec4 outAlbedo[];

vec3 pal( in float t, in vec3 a, in vec3 b, in vec3 c, in vec3 d )
{
	return a + b*cos( 6.28318*(c*t+d) );
}

void main() {
	uint taskIndex = gl_WorkGroupID.x;
	uint meshletID = payload.meshletIDs[taskIndex];
	uint lodLevel = payload.lodLevels[taskIndex];

	SetMeshOutputsEXT(161, 280);

	uint lx = gl_LocalInvocationID.x;
	uint ly = gl_LocalInvocationID.y;
	uint vertexIndex = ly * 11 + lx;

	uint meshletsPerRow = params.gridParams.y;
	uint totalPerLOD = meshletsPerRow * meshletsPerRow;
	uint localID = meshletID % totalPerLOD;

	uint row = localID / meshletsPerRow;
	uint col = localID % meshletsPerRow;

	float baseMeshletSize = 32.0;
	float meshletSize = baseMeshletSize * pow(2.0, float(lodLevel));

	vec2 cameraSnap = floor(uCameraPosition.xz / meshletSize) * meshletSize;
	vec3 meshletMin = vec3(cameraSnap.x + (float(col) - float(meshletsPerRow) * 0.5) * meshletSize, 0.0, cameraSnap.y + (float(row) - float(meshletsPerRow) * 0.5) * meshletSize);

	vec2 localPos = vec2(float(lx) / 10.0, float(ly) / 10.0) * meshletSize;
	vec3 worldPos = meshletMin + vec3(localPos.x, 0.0, localPos.y);

	vec2 uv = sampleToroidalUV(worldPos.xz, lodLevel);
	vec4 texSample = SAMPLE_ARRAY_WRAP(params.clipmapIndex, vec3(uv, float(lodLevel)));
	float height = texSample.r;
	vec3 normal = texSample.gba;
	if (length(normal) < 0.1) normal = vec3(0.0, 1.0, 0.0);

	vec2 offsetDist = abs(worldPos.xz - uCameraPosition.xz);
	float distToCam = max(offsetDist.x, offsetDist.y); // CDLOD Chebyshev/box distance metric
	float outerDist = (float(meshletsPerRow) * 0.5) * meshletSize;

	if (lodLevel < params.gridParams.x - 1 && outerDist > 0.0) {
		float morphWidth = 2.5 * meshletSize;
		float morphStart = max(0.0, outerDist - morphWidth);
		float morphEnd = outerDist;

		if (distToCam > morphStart) {
			float alpha = clamp((distToCam - morphStart) / max(morphEnd - morphStart, 0.001), 0.0, 1.0);
			alpha = alpha * alpha * (3.0 - 2.0 * alpha); // Smoothstep blending for CDLOD transition

			vec2 uvNext = sampleToroidalUV(worldPos.xz, lodLevel + 1);
			vec4 texNext = SAMPLE_ARRAY_WRAP(params.clipmapIndex, vec3(uvNext, float(lodLevel + 1)));
			float nextHeight = texNext.r;
			vec3 nextNormal = texNext.gba;

			height = mix(height, nextHeight, alpha);
			if (length(nextNormal) >= 0.1) {
				normal = normalize(mix(normal, nextNormal, alpha));
			}
		}
	}

	worldPos.y = height;

	vec4 clipPos = uViewProjMatrix * vec4(worldPos, 1.0);
	gl_MeshVerticesEXT[vertexIndex].gl_Position = clipPos;

	outPosition[vertexIndex] = worldPos;
	outNormal[vertexIndex] = normal;

	vec3 lodColor = vec3(0.2, 0.6, 0.2);
	vec3 sand = vec3(0.9, 0.8, 0.5);
	vec3 snow = vec3(0.9, 0.95, 1.0);
	vec3 rock = vec3(0.3, 0.22, 0.2);

	lodColor = mix(rock, lodColor, smoothstep(0.25, 1.0, normal.y));
	lodColor = mix(sand, lodColor, smoothstep(-2.0, 5.0, height));
	lodColor = mix(lodColor, snow, smoothstep(700.0, 800.0, height));

	// Translucent blue water layer over areas where terrain height is below zero
	if (height < 0.0) {
		vec3 waterColor = vec3(0.05, 0.45, 0.85);
		float depth = -height;
		float waterAlpha = clamp(0.35 + depth * 0.04, 0.35, 0.85);
		lodColor = mix(lodColor, waterColor, waterAlpha);
	}
	// lodColor += vec3(1,0,0) * lodLevel;
	// lodColor = vec3(0.1, 0.1, lodLevel/7.0);
	// lodColor = vec3(step(5.0, lodLevel), 0.1, lodLevel/7.0);

	outAlbedo[vertexIndex] = vec4(lodColor, 1.0);

	// Generate skirt vertex for boundary vertices to seal tile seams
	if (lx == 0 || lx == 10 || ly == 0 || ly == 10) {
		uint skirtID;
		if (ly == 0) {
			skirtID = lx;
		} else if (ly == 10) {
			skirtID = 11 + lx;
		} else if (lx == 0) {
			skirtID = 22 + (ly - 1);
		} else {
			skirtID = 31 + (ly - 1);
		}
		uint skirtIdx = 121 + skirtID;

		float skirtDepth = max(10.0, meshletSize * 0.1);
		vec3 skirtPos = worldPos - vec3(0.0, skirtDepth, 0.0);

		gl_MeshVerticesEXT[skirtIdx].gl_Position = uViewProjMatrix * vec4(skirtPos, 1.0);
		outPosition[skirtIdx] = skirtPos;
		outNormal[skirtIdx] = normal;
		outAlbedo[skirtIdx] = vec4(lodColor, 1.0);
	}

	// Determine shading rate based on clipmap LOD
	int shadingRate = 0; // Default 1x1

	if (lodLevel >= 4) {
		shadingRate = gl_ShadingRateFlag4HorizontalPixelsEXT | gl_ShadingRateFlag4VerticalPixelsEXT;
	} else if (lodLevel >= 2) {
		shadingRate = gl_ShadingRateFlag2HorizontalPixelsEXT | gl_ShadingRateFlag2VerticalPixelsEXT;
	}

	// Generate 10x10 quad primitives (200 triangles)
	if (lx < 10 && ly < 10) {
		uint quadIdx = ly * 10 + lx;
		uint v0 = ly * 11 + lx;
		uint v1 = ly * 11 + (lx + 1);
		uint v2 = (ly + 1) * 11 + lx;
		uint v3 = (ly + 1) * 11 + (lx + 1);

		gl_PrimitiveTriangleIndicesEXT[quadIdx * 2 + 0] = uvec3(v0, v2, v1);
		gl_PrimitiveTriangleIndicesEXT[quadIdx * 2 + 1] = uvec3(v1, v2, v3);

		gl_MeshPrimitivesEXT[quadIdx * 2 + 0].gl_PrimitiveShadingRateEXT = shadingRate;
		gl_MeshPrimitivesEXT[quadIdx * 2 + 1].gl_PrimitiveShadingRateEXT = shadingRate;

		// Fine-grained overlap culling
		bool cullQuad = false;
		if (lodLevel > 0) {
			float prevMeshletSize = baseMeshletSize * pow(2.0, float(lodLevel - 1));
			vec2 prevCameraSnap = floor(uCameraPosition.xz / prevMeshletSize) * prevMeshletSize;
			float prevExtent = float(meshletsPerRow) * 0.5 * prevMeshletSize;

			vec2 quadCenterLocal = vec2(float(lx) + 0.5, float(ly) + 0.5) / 10.0 * meshletSize;
			vec2 quadCenterWorld = meshletMin.xz + quadCenterLocal;

			vec2 dist = abs(quadCenterWorld - prevCameraSnap);

			// Cull if the quad center is strictly inside the previous LOD's active area.
			// The -0.01 margin prevents floating point inaccuracies from culling edge quads.
			if (max(dist.x, dist.y) < prevExtent - (meshletSize * 0.01)) {
				cullQuad = true;
			}
		}

		gl_MeshPrimitivesEXT[quadIdx * 2 + 0].gl_CullPrimitiveEXT = cullQuad;
		gl_MeshPrimitivesEXT[quadIdx * 2 + 1].gl_CullPrimitiveEXT = cullQuad;
	}

	// Generate skirt primitives along outer boundary edges
	if (ly == 0 && lx < 10) { // Top edge
		uint v0 = lx;
		uint v1 = lx + 1;
		uint k0 = 121 + lx;
		uint k1 = 121 + lx + 1;
		uint primIdx = 200 + lx * 2;

		gl_PrimitiveTriangleIndicesEXT[primIdx + 0] = uvec3(v0, k0, v1);
		gl_PrimitiveTriangleIndicesEXT[primIdx + 1] = uvec3(v1, k0, k1);

		gl_MeshPrimitivesEXT[primIdx + 0].gl_PrimitiveShadingRateEXT = shadingRate;
		gl_MeshPrimitivesEXT[primIdx + 1].gl_PrimitiveShadingRateEXT = shadingRate;
		gl_MeshPrimitivesEXT[primIdx + 0].gl_CullPrimitiveEXT = false;
		gl_MeshPrimitivesEXT[primIdx + 1].gl_CullPrimitiveEXT = false;
	}

	if (ly == 10 && lx < 10) { // Bottom edge
		uint v0 = 110 + lx;
		uint v1 = 110 + lx + 1;
		uint k0 = 121 + 11 + lx;
		uint k1 = 121 + 11 + lx + 1;
		uint primIdx = 220 + lx * 2;

		gl_PrimitiveTriangleIndicesEXT[primIdx + 0] = uvec3(v1, k1, v0);
		gl_PrimitiveTriangleIndicesEXT[primIdx + 1] = uvec3(v0, k1, k0);

		gl_MeshPrimitivesEXT[primIdx + 0].gl_PrimitiveShadingRateEXT = shadingRate;
		gl_MeshPrimitivesEXT[primIdx + 1].gl_PrimitiveShadingRateEXT = shadingRate;
		gl_MeshPrimitivesEXT[primIdx + 0].gl_CullPrimitiveEXT = false;
		gl_MeshPrimitivesEXT[primIdx + 1].gl_CullPrimitiveEXT = false;
	}

	if (lx == 0 && ly < 10) { // Left edge
		uint v0 = ly * 11;
		uint v1 = (ly + 1) * 11;
		uint k0 = (ly == 0) ? 121 : (121 + 22 + (ly - 1));
		uint k1 = (ly + 1 == 10) ? 132 : (121 + 22 + ly);
		uint primIdx = 240 + ly * 2;

		gl_PrimitiveTriangleIndicesEXT[primIdx + 0] = uvec3(v1, k1, v0);
		gl_PrimitiveTriangleIndicesEXT[primIdx + 1] = uvec3(v0, k1, k0);

		gl_MeshPrimitivesEXT[primIdx + 0].gl_PrimitiveShadingRateEXT = shadingRate;
		gl_MeshPrimitivesEXT[primIdx + 1].gl_PrimitiveShadingRateEXT = shadingRate;
		gl_MeshPrimitivesEXT[primIdx + 0].gl_CullPrimitiveEXT = false;
		gl_MeshPrimitivesEXT[primIdx + 1].gl_CullPrimitiveEXT = false;
	}

	if (lx == 10 && ly < 10) { // Right edge
		uint v0 = ly * 11 + 10;
		uint v1 = (ly + 1) * 11 + 10;
		uint k0 = (ly == 0) ? 131 : (121 + 31 + (ly - 1));
		uint k1 = (ly + 1 == 10) ? 142 : (121 + 31 + ly);
		uint primIdx = 260 + ly * 2;

		gl_PrimitiveTriangleIndicesEXT[primIdx + 0] = uvec3(v0, k0, v1);
		gl_PrimitiveTriangleIndicesEXT[primIdx + 1] = uvec3(v1, k0, k1);

		gl_MeshPrimitivesEXT[primIdx + 0].gl_PrimitiveShadingRateEXT = shadingRate;
		gl_MeshPrimitivesEXT[primIdx + 1].gl_PrimitiveShadingRateEXT = shadingRate;
		gl_MeshPrimitivesEXT[primIdx + 0].gl_CullPrimitiveEXT = false;
		gl_MeshPrimitivesEXT[primIdx + 1].gl_CullPrimitiveEXT = false;
	}
}
