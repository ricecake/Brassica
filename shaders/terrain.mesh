#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_ARB_gpu_shader_int64 : require

#include "bindless.glsl"
#include "common.glsl"
#include "terrain.glsl"

layout(local_size_x = 11, local_size_y = 11, local_size_z = 1) in;
layout(triangles, max_vertices = 141, max_primitives = 240) out;

layout(push_constant) uniform TerrainPushConstants {
	uvec4 gridParams; // x = numLODs, y = meshletsPerRow, z = totalMeshlets, w = textureDim
	uvec4 lodOffsets0_3;
	uvec4 lodOffsets4_7;
	uvec4 lodOffsets8_11;
	uint  clipmapIndex;
	uint  minMaxIndex;
	uint  biomeIndex;
	uint  visibilityIndex;
	uint64_t pageTableAddr;
	uint64_t vertexPagePoolAddr;
} params;

struct TaskPayload {
	uint meshletIDs[32];
	uint lodLevels[32];
	uint pageIndices[32];
};

taskPayloadSharedEXT TaskPayload payload;

struct PageTableEntry {
	vec4 bounds;
	uint lod;
	uint pageIndex;
	uint isVisible;
	uint padding;
};

layout(buffer_reference, scalar) buffer PageTableBuffer {
	uint pageTableCount;
	uint padding[3];
	PageTableEntry entries[];
};

struct TerrainPageVertex {
	vec4 position; // xyz = worldPos, w = lod
	vec4 normal;   // xyz = normal, w = variance
	vec4 color;    // rgb = albedo, a = 1.0
};

layout(buffer_reference, scalar) buffer VertexPagePoolBuffer {
	TerrainPageVertex vertices[];
};

layout(location = 0) out vec3 outPosition[];
layout(location = 1) out vec3 outNormal[];
layout(location = 2) out vec4 outAlbedo[];

void main() {
	uint taskIndex = gl_WorkGroupID.x;
	uint meshletID = payload.meshletIDs[taskIndex];
	uint lodLevel = payload.lodLevels[taskIndex];
	uint pageIndex = payload.pageIndices[taskIndex];

	SetMeshOutputsEXT(141, 240);

	uint lx = gl_LocalInvocationID.x;
	uint ly = gl_LocalInvocationID.y;
	uint vertexIndex = ly * 11 + lx;

	vec3 worldPos = vec3(0.0);
	vec3 normal = vec3(0.0, 1.0, 0.0);
	vec3 lodColor = vec3(0.2, 0.6, 0.2);
	float height = 0.0;
	vec2 baseWorldXZ = vec2(0.0);
	vec3 meshletMin = vec3(0.0);

	float baseMeshletSize = 32.0;
	float meshletSize = baseMeshletSize * getLODScale(float(lodLevel));
	uint meshletsPerRow = params.gridParams.y;

	if (pageIndex != 0xFFFFFFFFu && params.vertexPagePoolAddr != 0UL) {
		VertexPagePoolBuffer uVertexPages = VertexPagePoolBuffer(params.vertexPagePoolAddr);
		uint pageVertIdx = pageIndex * 121u + vertexIndex;
		TerrainPageVertex pageVert = uVertexPages.vertices[pageVertIdx];
		worldPos = pageVert.position.xyz;
		height = worldPos.y;
		vec2 flatXZ = worldPos.xz - uCameraPosition.xz;
		float distSq = dot(flatXZ, flatXZ);
		float dropOff = distSq / (2.0 * FAKE_PLANET_RADIUS);
		worldPos.y = height - dropOff;
		normal = pageVert.normal.xyz;
		lodColor = pageVert.color.rgb;
		baseWorldXZ = worldPos.xz;
	} else if (params.pageTableAddr != 0UL && meshletID < PageTableBuffer(params.pageTableAddr).pageTableCount) {
		PageTableBuffer uPageTable = PageTableBuffer(params.pageTableAddr);
		PageTableEntry entry = uPageTable.entries[meshletID];

		vec2 localPos = vec2(float(lx) / 10.0, float(ly) / 10.0) * entry.bounds.zw;
		baseWorldXZ = entry.bounds.xy + localPos;

		TerrainConfig con = TerrainConfig(0.00001, -100.0, 1000.0, 0.14, 0.5);
		vec3 p = vec3(baseWorldXZ.x, 0.0, baseWorldXZ.y);
		vec3 grad = vec3(0.0);
		eval_terrain(p, con, height, normal, grad);

		vec2 flatXZ = baseWorldXZ - uCameraPosition.xz;
		float distSq = dot(flatXZ, flatXZ);
		float dropOff = distSq / (2.0 * FAKE_PLANET_RADIUS);
		worldPos = vec3(baseWorldXZ.x, height - dropOff, baseWorldXZ.y);

		vec3 sand = vec3(0.9, 0.8, 0.5);
		vec3 snow = vec3(0.9, 0.95, 1.0);
		vec3 rock = vec3(0.3, 0.22, 0.2);

		lodColor = mix(rock, lodColor, smoothstep(0.25, 1.0, normal.y));
		lodColor = mix(sand, lodColor, smoothstep(-2.0, 25.0, height));
		lodColor = mix(lodColor, snow, smoothstep(2500.0, 4000.0, height));
	} else {
		uint totalPerLOD = meshletsPerRow * meshletsPerRow;
		uint localID = meshletID % totalPerLOD;

		uint row = localID / meshletsPerRow;
		uint col = localID % meshletsPerRow;

		vec2 cameraSnap = floor(uCameraPosition.xz / meshletSize) * meshletSize;
		meshletMin = vec3(
			cameraSnap.x + (float(col) - float(meshletsPerRow) * 0.5) * meshletSize,
			0.0,
			cameraSnap.y + (float(row) - float(meshletsPerRow) * 0.5) * meshletSize
		);

		vec2 localPos = vec2(float(lx) / 10.0, float(ly) / 10.0) * meshletSize;
		baseWorldXZ = meshletMin.xz + localPos;

		vec2 offsetDist = abs(baseWorldXZ - cameraSnap);
		float distToCam = max(offsetDist.x, offsetDist.y);
		float outerDist = (float(meshletsPerRow) * 0.5) * meshletSize;

		float alpha = 0.0;
		vec2 morphedXZ = baseWorldXZ;

		if (lodLevel < params.gridParams.x - 1 && outerDist > 0.0) {
			float morphWidth = 2.5 * meshletSize;
			float morphStart = max(0.0, outerDist - morphWidth);

			if (distToCam > morphStart) {
				alpha = clamp((distToCam - morphStart) / max(outerDist - morphStart, 0.001), 0.0, 1.0);
				alpha = alpha * alpha * (3.0 - 2.0 * alpha);

				vec2 targetLocalPos = vec2(floor(float(lx) / 2.0) * 2.0, floor(float(ly) / 2.0) * 2.0) * (meshletSize / 10.0);
				vec2 targetXZ = meshletMin.xz + targetLocalPos;
				morphedXZ = mix(baseWorldXZ, targetXZ, alpha);
			}
		}

		vec4 texSample = sampleTerrainClipmap(
			params.clipmapIndex,
			morphedXZ,
			lodLevel,
			params.gridParams.w,
			params.lodOffsets0_3,
			params.lodOffsets4_7,
			params.lodOffsets8_11
		);
		height = texSample.r;
		normal = texSample.gba;

		if (alpha > 0.0) {
			vec4 texNext = sampleTerrainClipmap(
				params.clipmapIndex,
				morphedXZ,
				lodLevel + 1,
				params.gridParams.w,
				params.lodOffsets0_3,
				params.lodOffsets4_7,
				params.lodOffsets8_11
			);
			height = mix(height, texNext.r, alpha);
			if (length(texNext.gba) >= 0.1) {
				normal = normalize(mix(normal, texNext.gba, alpha));
			}
		}

		worldPos = vec3(morphedXZ.x, height, morphedXZ.y);

		vec2  flatXZ = worldPos.xz - uCameraPosition.xz;
		float distSq = dot(flatXZ, flatXZ);
		float dropOff = distSq / (2.0 * FAKE_PLANET_RADIUS);
		worldPos.y = height - dropOff;

		vec3 sand = vec3(0.9, 0.8, 0.5);
		vec3 snow = vec3(0.9, 0.95, 1.0);
		vec3 rock = vec3(0.3, 0.22, 0.2);

		lodColor = mix(rock, lodColor, smoothstep(0.25, 1.0, normal.y));
		lodColor = mix(sand, lodColor, smoothstep(-2.0, 25.0, height));
		lodColor = mix(lodColor, snow, smoothstep(2500.0, 4000.0, height));
	}

	vec4 clipPos = uViewProjMatrix * vec4(worldPos, 1.0);
	gl_MeshVerticesEXT[vertexIndex].gl_Position = clipPos;

	outPosition[vertexIndex] = worldPos - uCameraPosition.xyz;
	outNormal[vertexIndex] = normal;

	if (height < 0.0) {
		float depth = -height;
		vec3  wetSand = vec3(0.75, 0.70, 0.52);
		vec3  shallowReef = vec3(0.40, 0.9, 0.7);
		vec3  deepOceanBed = vec3(0.08, 0.16, 0.22);
		vec3  seafloorRock = vec3(0.18, 0.18, 0.20);

		vec3 seafloorColor = mix(wetSand, shallowReef, smoothstep(0.5, 5.0, depth));
		seafloorColor = mix(seafloorColor, deepOceanBed, smoothstep(12.0, 45.0, depth));
		seafloorColor = mix(seafloorRock, seafloorColor, smoothstep(0.3, 0.85, normal.y));

		lodColor = seafloorColor;
	}

	outAlbedo[vertexIndex] = vec4(lodColor, 1.0);

	bool isBoundarySample = (lx % 2 == 0) && (ly % 2 == 0) && (lx == 0 || lx == 10 || ly == 0 || ly == 10);
	if (isBoundarySample) {
		uint skirtID;
		if (ly == 0) {
			skirtID = lx / 2;
		} else if (ly == 10) {
			skirtID = 6 + lx / 2;
		} else if (lx == 0) {
			skirtID = 12 + (ly / 2 - 1);
		} else {
			skirtID = 16 + (ly / 2 - 1);
		}
		uint skirtIdx = 121 + skirtID;

		float skirtDepth = max(10.0, meshletSize * 0.1);
		vec3  skirtPos = worldPos - vec3(0.0, skirtDepth, 0.0);

		gl_MeshVerticesEXT[skirtIdx].gl_Position = uViewProjMatrix * vec4(skirtPos, 1.0);
		outPosition[skirtIdx] = skirtPos - uCameraPosition.xyz;
		outNormal[skirtIdx] = normal;
		outAlbedo[skirtIdx] = vec4(lodColor, 1.0);
	}

	if (lx < 10 && ly < 10) {
		uint quadIdx = ly * 10 + lx;
		uint v0 = ly * 11 + lx;
		uint v1 = ly * 11 + (lx + 1);
		uint v2 = (ly + 1) * 11 + lx;
		uint v3 = (ly + 1) * 11 + (lx + 1);

		gl_PrimitiveTriangleIndicesEXT[quadIdx * 2 + 0] = uvec3(v0, v2, v1);
		gl_PrimitiveTriangleIndicesEXT[quadIdx * 2 + 1] = uvec3(v1, v2, v3);

		bool cullQuad = false;
		if (pageIndex == 0xFFFFFFFFu && lodLevel > 0) {
			float prevMeshletSize = baseMeshletSize * getLODScale(float(lodLevel - 1));
			vec2  prevCameraSnap = floor(uCameraPosition.xz / prevMeshletSize) * prevMeshletSize;
			float prevExtent = float(meshletsPerRow) * 0.5 * prevMeshletSize;

			vec2 quadCenterLocal = vec2(float(lx) + 0.5, float(ly) + 0.5) / 10.0 * meshletSize;
			vec2 quadCenterWorld = meshletMin.xz + quadCenterLocal;

			vec2 dist = abs(quadCenterWorld - prevCameraSnap);

			if (max(dist.x, dist.y) < prevExtent - (meshletSize * 0.01)) {
				cullQuad = true;
			}
		}

		gl_MeshPrimitivesEXT[quadIdx * 2 + 0].gl_CullPrimitiveEXT = cullQuad;
		gl_MeshPrimitivesEXT[quadIdx * 2 + 1].gl_CullPrimitiveEXT = cullQuad;
	}

	if (ly == 0 && lx < 10 && lx % 2 == 0) {
		uint s = lx / 2;
		uint v0 = lx;
		uint v1 = lx + 2;
		uint k0 = 121 + s;
		uint k1 = 121 + s + 1;
		uint primIdx = 200 + s * 2;

		gl_PrimitiveTriangleIndicesEXT[primIdx + 0] = uvec3(v0, k0, v1);
		gl_PrimitiveTriangleIndicesEXT[primIdx + 1] = uvec3(v1, k0, k1);

		gl_MeshPrimitivesEXT[primIdx + 0].gl_CullPrimitiveEXT = false;
		gl_MeshPrimitivesEXT[primIdx + 1].gl_CullPrimitiveEXT = false;
	}

	if (ly == 10 && lx < 10 && lx % 2 == 0) {
		uint s = lx / 2;
		uint v0 = 110 + lx;
		uint v1 = 110 + lx + 2;
		uint k0 = 121 + 6 + s;
		uint k1 = 121 + 6 + s + 1;
		uint primIdx = 210 + s * 2;

		gl_PrimitiveTriangleIndicesEXT[primIdx + 0] = uvec3(v1, k1, v0);
		gl_PrimitiveTriangleIndicesEXT[primIdx + 1] = uvec3(v0, k1, k0);

		gl_MeshPrimitivesEXT[primIdx + 0].gl_CullPrimitiveEXT = false;
		gl_MeshPrimitivesEXT[primIdx + 1].gl_CullPrimitiveEXT = false;
	}

	if (lx == 0 && ly < 10 && ly % 2 == 0) {
		uint s = ly / 2;
		uint v0 = ly * 11;
		uint v1 = (ly + 2) * 11;
		uint k0 = (s == 0) ? 121 : (121 + 12 + (s - 1));
		uint k1 = (s + 1 == 5) ? 127 : (121 + 12 + s);
		uint primIdx = 220 + s * 2;

		gl_PrimitiveTriangleIndicesEXT[primIdx + 0] = uvec3(v1, k1, v0);
		gl_PrimitiveTriangleIndicesEXT[primIdx + 1] = uvec3(v0, k1, k0);

		gl_MeshPrimitivesEXT[primIdx + 0].gl_CullPrimitiveEXT = false;
		gl_MeshPrimitivesEXT[primIdx + 1].gl_CullPrimitiveEXT = false;
	}

	if (lx == 10 && ly < 10 && ly % 2 == 0) {
		uint s = ly / 2;
		uint v0 = ly * 11 + 10;
		uint v1 = (ly + 2) * 11 + 10;
		uint k0 = (s == 0) ? 126 : (121 + 16 + (s - 1));
		uint k1 = (s + 1 == 5) ? 132 : (121 + 16 + s);
		uint primIdx = 230 + s * 2;

		gl_PrimitiveTriangleIndicesEXT[primIdx + 0] = uvec3(v0, k0, v1);
		gl_PrimitiveTriangleIndicesEXT[primIdx + 1] = uvec3(v1, k0, k1);

		gl_MeshPrimitivesEXT[primIdx + 0].gl_CullPrimitiveEXT = false;
		gl_MeshPrimitivesEXT[primIdx + 1].gl_CullPrimitiveEXT = false;
	}
}
