#version 460
#extension GL_EXT_mesh_shader : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(triangles, max_vertices = 64, max_primitives = 98) out;

layout(set = 0, binding = 0) uniform FrameUBO {
	float time;
	uint  frameIndex;
	uint  globalSeed;
	uint  frameRandom;
} ubo;

layout(set = 1, binding = 0) uniform sampler2DArray terrainClipmap;

layout(push_constant) uniform TerrainPushConstants {
	mat4  viewProj;
	vec4  cameraPos;
	uvec4 gridParams; // x = numLODs, y = meshletsPerRow, z = totalMeshlets
} params;

struct TaskPayload {
	uint meshletIDs[32];
	uint lodLevels[32];
};

taskPayloadSharedEXT TaskPayload payload;

layout(location = 0) out vec3 outPosition[];
layout(location = 1) out vec3 outNormal[];
layout(location = 2) out vec4 outAlbedo[];

const vec3 LOD_COLORS[4] = vec3[](
	vec3(0.2, 0.8, 0.3), // LOD 0: Green
	vec3(0.2, 0.5, 0.9), // LOD 1: Blue
	vec3(0.9, 0.7, 0.2), // LOD 2: Yellow/Orange
	vec3(0.9, 0.2, 0.2)  // LOD 3: Red
);

void main() {
	uint taskIndex = gl_WorkGroupID.x;
	uint meshletID = payload.meshletIDs[taskIndex];
	uint lodLevel = payload.lodLevels[taskIndex];

	SetMeshOutputsEXT(64, 98);

	uint lx = gl_LocalInvocationID.x;
	uint ly = gl_LocalInvocationID.y;
	uint vertexIndex = ly * 8 + lx;

	uint meshletsPerRow = params.gridParams.y;
	uint row = meshletID / meshletsPerRow;
	uint col = meshletID % meshletsPerRow;

	float meshletSize = 32.0;
	vec3 meshletMin = vec3((float(col) - float(meshletsPerRow) * 0.5) * meshletSize, 0.0, (float(row) - float(meshletsPerRow) * 0.5) * meshletSize);

	vec2 localPos = vec2(float(lx) / 7.0, float(ly) / 7.0) * meshletSize;
	vec3 worldPos = meshletMin + vec3(localPos.x, 0.0, localPos.y);

	// Texel size doubles per LOD level
	float baseTexelSize = params.cameraPos.w;
	float texelSize = baseTexelSize * pow(2.0, float(lodLevel));
	float worldExtent = 1024.0 * texelSize;

	// Calculate UVs for texture array layer
	vec2 uv = (worldPos.xz + vec2(worldExtent * 0.5)) / worldExtent;
	uv = clamp(uv, vec2(0.0), vec2(1.0));

	vec4 texSample = texture(terrainClipmap, vec3(uv, float(lodLevel)));
	float height = texSample.r;
	vec3 normal = texSample.gba;
	if (length(normal) < 0.1) normal = vec3(0.0, 1.0, 0.0);

	worldPos.y = height;

	vec4 clipPos = params.viewProj * vec4(worldPos, 1.0);
	gl_MeshVerticesEXT[vertexIndex].gl_Position = clipPos;

	outPosition[vertexIndex] = worldPos;
	outNormal[vertexIndex] = normal;

	vec3 lodColor = LOD_COLORS[min(lodLevel, 3)];
	outAlbedo[vertexIndex] = vec4(lodColor, 1.0);

	// Generate 7x7 quad primitives (98 triangles)
	if (lx < 7 && ly < 7) {
		uint quadIdx = ly * 7 + lx;
		uint v0 = ly * 8 + lx;
		uint v1 = ly * 8 + (lx + 1);
		uint v2 = (ly + 1) * 8 + lx;
		uint v3 = (ly + 1) * 8 + (lx + 1);

		gl_PrimitiveTriangleIndicesEXT[quadIdx * 2 + 0] = uvec3(v0, v2, v1);
		gl_PrimitiveTriangleIndicesEXT[quadIdx * 2 + 1] = uvec3(v1, v2, v3);
	}
}
