#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "bindless.glsl"
#include "common.glsl"
#include "cbt.glsl"

layout(local_size_x = 11, local_size_y = 11, local_size_z = 1) in;
layout(triangles, max_vertices = 121, max_primitives = 100) out;

layout(push_constant) uniform TerrainPushConstants {
	uvec4 gridParams;
	uint  clipmapIndex;
	uint  minMaxIndex;
	uint  biomeIndex;
	float waterLevel;
	uint  weatherBiomeIndex;
	uint  cbtBitfieldIndex;
	uint  cbtPoolIndex;
	uint  cbtCommandsIndex;
	uint  cbtPageTableIndex;
	uint  cbtCacheIndex;
	uint  activeBisectorCount;
	uint  _pad0;
} params;

struct TaskPayload {
	uint64_t bisectorID[32];
	uint     cachePage[32];
	uint     depth[32];
	vec2     v0[32];
	vec2     v1[32];
	vec2     v2[32];
	uint     twinDepth[32];
	uint     nextDepth[32];
	uint     prevDepth[32];
};

taskPayloadSharedEXT TaskPayload payload;

layout(location = 0) out vec3 outPosition[];
layout(location = 1) out vec3 outNormal[];
layout(location = 2) out vec4 outAlbedo[];
layout(location = 3) out vec4 outMaterial[];
layout(location = 4) out vec4 outMaterialWeights[];

layout(std430, buffer_reference) buffer GeometryCacheBuffer {
	GeometryCacheHeader headers[];
};

float evaluate_mesh_height(vec2 pos2D) {
	vec2 p = pos2D * 0.0001;
	float h = sin(p.x * 3.0) * cos(p.y * 3.0) * 150.0;
	h += sin(p.x * 12.0 + 1.5) * cos(p.y * 12.0) * 45.0;
	return h;
}

void main() {
	SetMeshOutputsEXT(121, 100);

	uint taskIndex = gl_WorkGroupID.x;
	vec2 v0 = payload.v0[taskIndex];
	vec2 v1 = payload.v1[taskIndex];
	vec2 v2 = payload.v2[taskIndex];
	uint depth = payload.depth[taskIndex];
	uint twinDepth = payload.twinDepth[taskIndex];
	uint nextDepth = payload.nextDepth[taskIndex];
	uint prevDepth = payload.prevDepth[taskIndex];
	uint cachePage = payload.cachePage[taskIndex];

	uint lx = gl_LocalInvocationID.x;
	uint ly = gl_LocalInvocationID.y;
	uint vertexIndex = ly * 11u + lx;

	float fu = float(lx) / 10.0;
	float fv = float(ly) / 10.0;
	if (fu + fv > 1.0) {
		float sum = fu + fv;
		fu /= sum;
		fv /= sum;
	}

	// Barycentric interpolation over right triangle (v0, v1, v2)
	vec2 pos2D = v0 * (1.0 - fu - fv) + v1 * fu + v2 * fv;

	// Halfedge Edge Stitching along all three right triangle boundaries
	if (twinDepth < depth && (ly == 0u)) {
		float snappedU = floor(fu * 5.0 + 0.5) / 5.0;
		pos2D = mix(v0, v1, snappedU);
	}
	if (nextDepth < depth && (lx + ly == 10u)) {
		float snappedU = floor(fu * 5.0 + 0.5) / 5.0;
		pos2D = mix(v1, v2, snappedU);
	}
	if (prevDepth < depth && (lx == 0u)) {
		float snappedV = floor(fv * 5.0 + 0.5) / 5.0;
		pos2D = mix(v2, v0, snappedV);
	}

	float height = evaluate_mesh_height(pos2D);
	if (cachePage != CBT_INVALID_PAGE && params.cbtCacheIndex > 0u) {
		GeometryCacheBuffer cache = GeometryCacheBuffer(uSSBOBuffers[params.cbtCacheIndex]);
		height = cache.headers[cachePage].heights[vertexIndex];
	}

	float dropOff = cbt_apply_fake_curvature(pos2D);

	vec3 relWorldPos = vec3(pos2D.x - uCameraPosition.x, height + dropOff - uCameraPosition.y, pos2D.y - uCameraPosition.z);
	vec3 normal = vec3(0.0, 1.0, 0.0);

	vec3 viewPos = mat3(uViewMatrix) * relWorldPos;
	gl_MeshVerticesEXT[vertexIndex].gl_Position = uProjMatrix * vec4(viewPos, 1.0);

	outPosition[vertexIndex] = relWorldPos;
	outNormal[vertexIndex] = normal;

	vec3 baseColor = vec3(0.25, 0.55, 0.20);
	float roughness = 0.75;
	float metallic = 0.0;

	outAlbedo[vertexIndex] = vec4(baseColor, 1.0);
	outMaterial[vertexIndex] = vec4(metallic, roughness, 0.0, 0.0);
	outMaterialWeights[vertexIndex] = vec4(0.8, 0.2, 0.0, 0.0);

	if (lx < 10u && ly < 10u) {
		uint vA = ly * 11u + lx;
		uint vB = ly * 11u + (lx + 1u);
		uint vC = (ly + 1u) * 11u + lx;
		uint vD = (ly + 1u) * 11u + (lx + 1u);

		uint baseIdx = 0u;
		for (uint r = 0u; r < ly; ++r) {
			baseIdx += (10u - r) + (9u - r);
		}

		if (lx + ly < 10u) {
			uint lowerIdx = baseIdx + lx * 2u;
			gl_PrimitiveTriangleIndicesEXT[lowerIdx] = uvec3(vA, vB, vC);
			gl_MeshPrimitivesEXT[lowerIdx].gl_CullPrimitiveEXT = false;
		}

		if (lx + ly < 9u) {
			uint upperIdx = baseIdx + lx * 2u + 1u;
			gl_PrimitiveTriangleIndicesEXT[upperIdx] = uvec3(vB, vD, vC);
			gl_MeshPrimitivesEXT[upperIdx].gl_CullPrimitiveEXT = false;
		} else if (lx + ly == 9u) {
			uint upperIdx = baseIdx + lx * 2u + 1u;
			gl_PrimitiveTriangleIndicesEXT[upperIdx] = uvec3(vA, vA, vA);
			gl_MeshPrimitivesEXT[upperIdx].gl_CullPrimitiveEXT = true;
		}
	}
}
