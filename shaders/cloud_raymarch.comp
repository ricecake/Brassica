#version 450
#extension GL_EXT_nonuniform_qualifier : require

#include "bindless.glsl"
#include "lighting.glsl"
#include "atmosphere/common.glsl"
#include "helpers/octahedral.glsl"
#include "helpers/cloud_shadow.glsl"
#include "helpers/cloud_density.glsl"
#include "helpers/ambient.glsl"
#include "lygia/generative/psrdnoise.glsl"
#include "common.glsl"

// Stage A of the tile-based temporal pipeline (see the "Tile-based temporal accumulation for
// cloud raymarching" plan): converts the former cloud_render.frag fragment pass into a compute
// pass, so later stages can indirect-dispatch it per-tile (Stage D) and so it can produce the
// depth/velocity outputs temporal reprojection (Stage B) needs. Same marchClouds() math as
// before -- this stage changes where the raymarch runs and what it outputs, not the raymarch
// itself. Full-screen, every pixel, every frame -- no tile skipping yet (that's Stage D).
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform CloudRaymarchPushConstants {
	vec4  sunDir;
	vec4  sunRadianceAndSkyExp; // xyz = sunRadiance, w = skyExposure
	uint  gPositionIndex;
	uint  gAlbedoIndex;
	uint  transmittanceLUTIndex;
	uint  skyViewIndex;
	uint  weatherBiomeIndex;
	uint  cloudShadowIndex;
	uint  volumeIndex; // sampled bindless index for CloudDetailVolume
	uint  colorStorageIdx;
	uint  transmittanceStorageIdx;
	uint  depthStorageIdx;
	uint  velocityStorageIdx;
	uint  outputWidth;
	uint  outputHeight;
	float deltaTime;
	uint  gpuLightsIndex;
} push;

vec4 sampleCloudShadow(vec3 p) {
	return sampleCloudShadow(push.cloudShadowIndex, p, push.sunDir.xyz, uCameraPosition.xyz, 320000.0);
}

vec3 getTransmittance(float r, float mu) {
	vec2 uv = transmittanceToUV(r, mu);
	return SAMPLE_LINEAR(push.transmittanceLUTIndex, uv).rgb;
}

// Bifurcated step sizing, ported from boidish's atmosphere_lowres.comp
// (calculateBifurcatedStepSize): coarse strides through confirmed-empty space, a held-constant
// fine step while inside a cloud, and a step-back on entry so the boundary itself gets sampled
// at fine resolution instead of overshooting into the cloud on the first fine step.
float calculateBifurcatedStepSize(
	inout bool inCloud,
	inout int  zeroCount,
	float      macroDensity,
	float      fineStep,
	float      cheapMult,
	int        escapeThreshold
) {
	float cheapStep = fineStep * cheapMult;

	if (!inCloud) {
		if (macroDensity > 0.01) {
			inCloud = true;
			zeroCount = 0;
			return -cheapStep;
		}
		return cheapStep;
	} else {
		if (macroDensity <= 0.0) {
			zeroCount++;
			if (zeroCount >= escapeThreshold) {
				inCloud = false;
				return cheapStep;
			}
		} else {
			zeroCount = 0;
		}
		return fineStep;
	}
}

// weightedDistSum/totalWeight: weight = cloudTransmittance * (1 - stepTransmittance), biased by
// exp(-accumulatedOpticalDepth * 15.0) so heavily-occluded-by-closer-cloud steps contribute less
// to the "representative" hit distance -- boidish's atmosphere_lowres.comp's own formula,
// previously specified in a dead comment here with nothing consuming it; now feeds CloudDepth
// (Stage B's reprojection). lightEnergy/transmittance stay separate fields, not packed into a
// vec4's rgb/a, since transmittance is vec3 (per-channel extinction).
struct CloudMarchResult {
	vec3  lightEnergy;
	vec3  transmittance;
	float weightedDistSum;
	float totalWeight;
};

// lightningPulseColor: rgb = brightest active strike's color, w = its normalized flicker
// envelope -- computed once per pixel in main() (see there for why), not per raymarch step.
CloudMarchResult marchClouds(
	vec3 worldRay, float t_start, float t_end, vec3 sunDir, vec3 sunRadiance, vec4 lightningPulseColor, vec2 pixel
) {
	float baseStepSize = 50.0;
	float t = t_start;

	float jitter = InterleavedGradientNoise(pixel, int(uFrameIndex));
	t += baseStepSize * jitter;

	vec3  cloudTransmittance = vec3(1.0);
	vec3  lightEnergy = vec3(0.0);
	float prevDensity = 0.0;
	float weightedDistSum = 0.0;
	float totalWeight = 0.0;
	float accumulatedOpticalDepth = 0.0;

	bool inCloud = false;
	int zeroCount = 0;
	const float kCheapStepMult = 3.0; // boidish's own tuned value (atmosphere_lowres.comp:608)
	const int kEscapeThreshold = 3;

	// Safety cap against pathological cases (a near-horizon ray staying at the fine 50m step for
	// a very long segment) -- boidish's own atmosphere_lowres.comp uses the same 1000 as a
	// worst-case bound, not a typical step count; this loop normally exits via t < t_end long
	// before reaching it.
	const int kMaxIterations = 100000;

	// Weather texels are kilometres wide, so re-sampling the weather map every single ~50m step
	// is more precision than it has any use for -- cache it and only refresh every 48m along the
	// ray (boidish's weatherUpdateInterval, atmosphere_lowres.comp).
	float worldExtent = 2.0 * FAKE_PLANET_RADIUS * 3.14159265359;
	vec4  weatherSample = vec4(0.0);
	float weatherCoverage = 0.0;
	float weatherType = 0.0;
	float weatherMoisture = 0.0;
	float lastWeatherT = -1e9;
	const float kWeatherUpdateInterval = 48.0;

	// Step-invariant halves of the ambient terms (both only depend on sunDir/sunRadiance) --
	// horizonAmbient/ambientTop below still get recomputed every step since they fold in the
	// per-step groundUpwelling term.
	vec3 skyAmbient = getApproximateSkyAmbient(sunDir, sunRadiance);
	vec3 groundAmbientBase = getApproximateGroundAmbient(sunRadiance);

	for (int iter = 0; iter < kMaxIterations && t < t_end; iter++) {
		vec3 p_cloud = uCameraPosition.xyz + worldRay * t;
		float distFromCam = t;

		vec3 planetCenter = vec3(0.0, -FAKE_PLANET_RADIUS, 0.0);
		vec3 toPlanetCenter = p_cloud - planetCenter;
		float r_world = length(toPlanetCenter);
		vec3 surfaceDir = normalize(toPlanetCenter);

		if (abs(t - lastWeatherT) >= kWeatherUpdateInterval) {
			vec2 weatherUV = fract((p_cloud.xz / worldExtent) + 0.5);
			weatherSample = SAMPLE_LINEAR(push.weatherBiomeIndex, weatherUV);
			weatherCoverage = weatherSample.r;
			weatherType = weatherSample.g;
			weatherMoisture = weatherSample.b;
			lastWeatherT = t;
		}

		float density = 0.0;
		float cloudHeightFrac = 0.0;
		if (weatherCoverage > 0.01) {
			cloudHeightFrac = heightFraction(p_cloud, distFromCam);

			// Wind advection applies to the fine detail volume only, not the weather-coverage
			// lookup above: the weather map already has its own emergent motion (the CA sim's
			// upwind-cell advection, helpers/wind.glsl), and drifting it a second time with an
			// independent speed/direction would fight that rather than add to it. cloudFlowSpeed
			// is specifically the fine-texture-drift knob, matching boidish's own separation of
			// "weather" advection from "3D noise" advection (computeCloudWeather vs
			// calculateCloudDensity in atmosphere_lowres.comp's source).
			vec3 advection = getCloudAdvectionSpeed(clamp(cloudHeightFrac, 0.0, 1.0));
			vec3  advectedPos = p_cloud - advection * uTime;

			// Curl-noise detail warp -- skipped once this step's contribution to the final
			// pixel is already small, either because the ray is past the segment's midpoint or
			// because accumulated transmittance has already dropped: the fine turbulence it adds
			// isn't visible through that much attenuation anyway. Mirrors boidish's doCheap
			// convention (atmosphere_lowres.comp/helpers/clouds.glsl), applied to this specific
			// noise call rather than ported line-for-line -- boidish's own doCheap hooks around
			// this exact warp are dead/commented out in its current source.
			bool doCheap = (t >= mix(t_start, t_end, 0.5)) || all(lessThan(cloudTransmittance, vec3(0.705)));
			vec3 curlOffset = vec3(0.0);
			if (!doCheap) {
				mat3 grad;
				cross_noise_fbm(advectedPos/(prevDensity+5000), 4, uTime*0.05, grad);
				vec3 cross_curl = get_curl(grad);
				curlOffset = 200.0*grad*cross_curl * (smoothstep(0.0, 0.75, cloudHeightFrac));
			}

			float baseDensity = sampleCloudVolume(advectedPos+curlOffset, distFromCam, push.volumeIndex);

			// Shaping (height gradient, anvil spreading, coverage-threshold erosion) and the
			// moisture scale all live in helpers/cloud_density.glsl, shared with
			// cloud_shadow_gen.comp so shadows match what's actually rendered here.
			density = cloudShapeDensity(baseDensity, cloudHeightFrac, weatherCoverage, weatherType, weatherMoisture);
		}

		float nextStep =
			calculateBifurcatedStepSize(inCloud, zeroCount, density, baseStepSize, kCheapStepMult, kEscapeThreshold);

		if (nextStep < 0.0) {
			t += nextStep;
			continue;
		}

		if (!inCloud) {
			prevDensity = density;
			t += nextStep;
			continue;
		}

		{
			float stepSize = nextStep;
			if (density > 0.0) {
				vec3 rgbExtinction = cloudExtinctionCoefficient(cloudHeightFrac, weatherType, weatherMoisture);
				float averageDensity = (prevDensity + density) * 0.5;

				vec3  stepDensity = averageDensity * rgbExtinction;
				vec3  stepOpticalDepth = stepDensity * stepSize;

				// Artificially boost the optical depth to block the background rapidly,
				// without turning the internal multi-scattering lighting black.
				float opacityBoost = 1.0;
				vec3  stepTransmittance = exp(-stepOpticalDepth * opacityBoost);

				vec4 cloudShadowData = sampleCloudShadow(p_cloud);
				vec3 opticalDepthToLight = cloudShadowData.b * u_cloudShadowOpticalDepthMultiplier * rgbExtinction;

				float r_km = r_world / 1000.0;
                float mu = dot(surfaceDir, sunDir);
                vec3 atmosphereTransmittance = getTransmittance(r_km, mu);

				float cosTheta = dot(worldRay, sunDir);
				const int OCTAVES = 3;
				float currentExtinction = 1.0;
				float currentKfwd = u_cloudPhaseG1;
				float currentKbck = u_cloudPhaseG2;
				float currentEnergy = 1.0;
				float currentScatChaos = (1.0 - u_cloudPhaseIsotropic);

				vec3 msScattering = vec3(0.0);

				for(int oct = 0; oct < OCTAVES; oct++) {
					float phase = dualLobeSchlick(cosTheta, currentKfwd, currentKbck, u_cloudPhaseAlpha);
					phase = mix((1.0 / (4.0 * PI)), phase, currentScatChaos);

					vec3 octaveOpticalDepth = opticalDepthToLight * currentExtinction;
					vec3 octaveStepDensity = stepDensity * currentExtinction;

					vec3 shadowTerm = mix(
						beerPowder(
							octaveOpticalDepth, octaveStepDensity, u_directBeerPowderScale, u_cloudPowderMultiplier, u_cloudPowderLocalScale
						),
						exp(-octaveOpticalDepth),
						u_cloudBeerPowderMix
					);

					msScattering += shadowTerm * phase * currentEnergy;

					currentExtinction *= 0.5;
					currentKfwd *= 0.5;
					currentKbck *= 0.5;
					currentEnergy *= 0.5;
					currentScatChaos *= 0.5;
				}

				vec3 averageTerrainAlbedo = vec3(0.18, 0.16, 0.12);
				vec3 upwellingBase = sunRadiance * atmosphereTransmittance * max(0.0, sunDir.y) * averageTerrainAlbedo * (1.0 / 3.14159265);
				vec3 upwellingOpticalDepth = stepDensity * clamp(cloudHeightFrac, 0.0, 1.0) * 15000.0;
				vec3 groundUpwelling = upwellingBase * exp(-upwellingOpticalDepth * 0.1);

				float topLighting = smoothstep(0.1, 0.9, cloudHeightFrac);
				float backscatterWeight = max(0.0, -cosTheta) * topLighting;
				float isotropicPhase = 1.0 / (4.0 * 3.14159265);
				vec3 diffuseTopBackscatter = sunRadiance * atmosphereTransmittance * max(0.0, sunDir.y) * isotropicPhase * (0.8 + 1.2 * backscatterWeight) * exp(-opticalDepthToLight);

				vec3 powder = vec3(1.0) - vec3(1.0) / (vec3(1.0) + (25.0 * stepDensity * u_ambientBeerPowderScale));

				vec3 groundAmbient = groundAmbientBase + groundUpwelling;
				vec3 horizonAmbient = getApproximateHorizonAmbient(sunDir, sunRadiance, skyAmbient, groundAmbient);
				vec3 ambientTop = mix(skyAmbient, horizonAmbient, 0.4);

				vec3 upwardOD = stepDensity * clamp(cloudHeightFrac, 0.0, 1.0) * 15000.0;
				vec3 downwardOD = stepDensity * clamp(1.0 - cloudHeightFrac, 0.0, 1.0) * 15000.0;
				vec3 skyAttenuation = vec3(1.0) / (vec3(1.0) + downwardOD);
				vec3 groundAttenuation = vec3(1.0) / (vec3(1.0) + upwardOD);

				vec3 ambientGlow = ((ambientTop * skyAttenuation) + (groundAmbient * groundAttenuation)) * powder;

				vec3  emissiveGlow = vec3(0.0);
				float lightningPulse = lightningPulseColor.w;
				if (lightningPulse > 0.001) {
					float ridge = weatherSample.a;
					float wavePos = clamp(1.0 - lightningPulse, 0.0, 1.0);
					float midHeightEnvelope = exp(-pow((cloudHeightFrac - 0.5) * 4.0, 2.0));
					float temporalPhase = fract(uTime * 0.7 + ridge * 3.0);
					float stagger = sin(temporalPhase * 6.28318) * 0.5 + 0.5;
					float ridgeDist = abs(ridge - wavePos * 0.85);
					float waveFront = exp(-ridgeDist * ridgeDist * 16.0);
					float coreGlow = exp(-ridge * 4.0 / max(0.1, lightningPulse));
					float propagationGlow = (coreGlow * 0.7 + waveFront * 1.3) * lightningPulse * midHeightEnvelope * stagger;
					emissiveGlow = lightningPulseColor.rgb * propagationGlow;
				}

				vec3 directLight = sunRadiance * atmosphereTransmittance * msScattering * u_cloudSunLightScale;
				vec3 reflectedLight = (directLight + ambientGlow + diffuseTopBackscatter * powder) * u_cloudAlbedo;
				vec3 stepScattering = reflectedLight + emissiveGlow;

				vec3 inscatter = stepScattering * (1.0 - stepTransmittance);

				// Reprojection depth estimate (see the struct comment above) -- scalar-averaged
				// vec3 terms, since this is a heuristic weight, not a radiometric quantity.
				float stepOpticalDepthScalar = (stepOpticalDepth.r + stepOpticalDepth.g + stepOpticalDepth.b) / 3.0;
				float stepTransmittanceScalar = (stepTransmittance.r + stepTransmittance.g + stepTransmittance.b) / 3.0;
				float cloudTransmittanceScalar = (cloudTransmittance.r + cloudTransmittance.g + cloudTransmittance.b) / 3.0;
				float distWeight = cloudTransmittanceScalar * (1.0 - stepTransmittanceScalar) * exp(-accumulatedOpticalDepth * 15.0);
				weightedDistSum += distWeight * t;
				totalWeight += distWeight;
				accumulatedOpticalDepth += stepOpticalDepthScalar;

				lightEnergy += inscatter * cloudTransmittance;
				cloudTransmittance *= stepTransmittance;

				// if (all(lessThan(cloudTransmittance, vec3(0.05)))) {
				if (dot(cloudTransmittance, vec3(0.3333)) < 0.05) {
					cloudTransmittance = vec3(0.0);
					break;
				}
			}
			prevDensity = density;
		}

		t += nextStep;
	}

	return CloudMarchResult(lightEnergy * u_cloudColor, cloudTransmittance, weightedDistSum, totalWeight);
}

const ivec2 bayerOffsets[16] = ivec2[](
    ivec2(0,0), ivec2(2,0), ivec2(0,2), ivec2(2,2), // Indices 0-3
    ivec2(1,1), ivec2(3,1), ivec2(1,3), ivec2(3,3), // Indices 4-7
    ivec2(2,1), ivec2(0,1), ivec2(2,3), ivec2(0,3), // Indices 8-11
    ivec2(3,0), ivec2(1,0), ivec2(3,2), ivec2(1,2)  // Indices 12-15
);

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if (pixel.x >= int(push.outputWidth) || pixel.y >= int(push.outputHeight)) {
		return;
	}

const ivec2 bayer_offsets[16] = ivec2[](
    ivec2(0,0), ivec2(2,0), ivec2(0,2), ivec2(2,2), // Indices 0-3
    ivec2(1,1), ivec2(3,1), ivec2(1,3), ivec2(3,3), // Indices 4-7
    ivec2(2,1), ivec2(0,1), ivec2(2,3), ivec2(0,3), // Indices 8-11
    ivec2(3,0), ivec2(1,0), ivec2(3,2), ivec2(1,2)  // Indices 12-15
);
	ivec2 offset = bayer_offsets[uFrameIndex % 16];
	pixel = (pixel *4)+offset;
	// ivec2 fullResPixel = packedPixel * 2 + offset;
	// ivec2 fullResSize = packedSize * 2;

	// vec2 TexCoords = (vec2(fullResPixel) + 0.5) / vec2(fullResSize);

    // int sampleSequenceIndex = int(uFrameIndex) & 15;
	// ivec2 offset = bayerOffsets[sampleSequenceIndex];

    // ivec2 alignedBlockOrigin = pixel & ~3;
    // pixel = alignedBlockOrigin + offset;

	vec2 inUV = (vec2(pixel) + 0.5) / vec2(push.outputWidth, push.outputHeight);

	// float noise = InterleavedGradientNoise(inUV, int(uFrameIndex));
	// if (noise < 0.25) return;

	vec3  cloudRgb = vec3(0.0);
	vec3  cloudTransmittance = vec3(1.0);
	float cloudDepth = 1e9; // sentinel: no cloud hit
	vec2  cloudVelocity = vec2(0.0);

	vec4 albedo = SAMPLE_NEAREST(push.gAlbedoIndex, inUV);
	vec3 relPos = SAMPLE_NEAREST(push.gPositionIndex, inUV).rgb;

	float worldScale = 1.0;
	float waterLevelKM = u_waterLevel / 1000.0;
	float camAltKM = uCameraPosition.y / (1000.0 * worldScale);

	if (camAltKM >= waterLevelKM) {
		bool  hasSurface = albedo.a >= 0.01;
		float surfaceDistKM = hasSurface ? (length(relPos)) : 1e9;

		vec2 clipCoord = inUV * 2.0 - 1.0;
		vec4 viewRay4 = uInvProjMatrix * vec4(clipCoord, 1.0, 1.0);
		vec3 viewDir = viewRay4.xyz / viewRay4.w;
		vec3 worldRay = normalize((uInvViewMatrix * vec4(viewDir, 0.0)).xyz);

		float cloudAlt = 5000.0;
		float t_s1, t_e1, t_s2, t_e2;
		bool intersection = intersectCloudShell(uCameraPosition.xyz, worldRay, FAKE_PLANET_RADIUS, cloudAlt, 15000, t_s1, t_e1, t_s2, t_e2);
		if (intersection) {
			vec3 sunDir = normalize(push.sunDir.xyz);
			vec3 sunRadiance = push.sunRadianceAndSkyExp.xyz;

			// Brightest active GPU-driven strike (shaders/lighting.glsl's reserved uLights[]
			// range, written by lightning_age.comp) -- same per-pixel-once computation as the
			// former fragment shader's main().
			vec4  lightningPulseColor = vec4(0.0);
			float lightningScaleInv = 1.0 / max(0.0001, u_lightningFlashIntensity * 50.0);
			for (uint li = 0u; li < LIGHTNING_MAX_STRIKES; li++) {
				Light strikeLight = uGpuLightsBuffers[nonuniformEXT(push.gpuLightsIndex)].lights[LIGHTNING_LIGHT_SLOT_BASE + li];
				float strikePulse = strikeLight.intensity * lightningScaleInv;
				if (strikePulse > lightningPulseColor.w) {
					lightningPulseColor = vec4(strikeLight.color, strikePulse);
				}
			}

			vec3  resultRgb = vec3(0.0);
			vec3  resultTransmittance = vec3(1.0);
			float resultWeightedDistSum = 0.0;
			float resultTotalWeight = 0.0;

			bool nearVisible = t_s1 < t_e1 && t_s1 < surfaceDistKM;
			bool farVisible = t_s2 < t_e2 && t_s2 < surfaceDistKM;

			if (nearVisible) {
				CloudMarchResult near = marchClouds(
					worldRay, t_s1, min(t_e1, surfaceDistKM), sunDir, sunRadiance, lightningPulseColor, vec2(pixel)
				);
				resultRgb += near.lightEnergy;
				resultTransmittance *= near.transmittance;
				resultWeightedDistSum += near.weightedDistSum;
				resultTotalWeight += near.totalWeight;
			}

			if (farVisible) {
				CloudMarchResult far = marchClouds(
					worldRay, t_s2, min(t_e2, surfaceDistKM), sunDir, sunRadiance, lightningPulseColor, vec2(pixel)
				);
				float resultTransmittanceScalar =
					(resultTransmittance.r + resultTransmittance.g + resultTransmittance.b) / 3.0;
				resultRgb += far.lightEnergy * resultTransmittance;
				resultWeightedDistSum += far.weightedDistSum * resultTransmittanceScalar;
				resultTotalWeight += far.totalWeight * resultTransmittanceScalar;
				resultTransmittance *= far.transmittance;
			}

			cloudRgb = resultRgb;
			cloudTransmittance = resultTransmittance;

			// A real surface blocks every part of the cloud shell this ray could otherwise see --
			// e.g. foliage/decor/terrain below the cloud base. Mark it distinctly from "no cloud
			// shell intersection at all" (cloudDepth's 1e9 default) so CloudTemporalNode can tell
			// "confirmed no cloud here, ever, as long as this surface stays" apart from "open sky,
			// no cloud found this frame" -- conflating the two is what let a thin/dithered
			// foreground object's silhouette pixel inherit a neighboring sky sample's real cloud
			// result (jagged edges with no matching cloud, and spurious transmittance variation
			// feeding false god rays downstream in the froxel pass).
			if (hasSurface && !nearVisible && !farVisible) {
				cloudDepth = -1.0;
			}

			if (resultTotalWeight > 1e-5) {
				cloudDepth = resultWeightedDistSum / resultTotalWeight;

				// Non-camera (wind-only) screen-space velocity: project the representative hit
				// position and that same position minus one frame's wind drift through the SAME
				// (current) view-proj matrix, so only the wind-driven shift shows up here --
				// camera motion is reprojected separately in Stage B via uPreviousViewProjMatrix.
				vec3  worldPos = uCameraPosition.xyz + worldRay * cloudDepth;
				float hFrac = clamp(heightFraction(worldPos, cloudDepth), 0.0, 1.0);
				vec3  advectVel = getCloudAdvectionSpeed(hFrac) * push.deltaTime;
				vec3  prevWorldPos = worldPos - advectVel;

				vec4 curClip = uViewProjMatrix * vec4(worldPos, 1.0);
				vec4 prevClip = uViewProjMatrix * vec4(prevWorldPos, 1.0);
				vec2 curUV = (curClip.xy / curClip.w) * 0.5 + 0.5;
				vec2 prevUV = (prevClip.xy / prevClip.w) * 0.5 + 0.5;
				cloudVelocity = curUV - prevUV;
			}
		}
	}

	imageStore(uImagesGenericWrite[nonuniformEXT(push.colorStorageIdx)], pixel, vec4(cloudRgb, 0.0));
	imageStore(uImagesGenericWrite[nonuniformEXT(push.transmittanceStorageIdx)], pixel, vec4(cloudTransmittance, 0.0));
	imageStore(uImagesGenericWrite[nonuniformEXT(push.depthStorageIdx)], pixel, vec4(cloudDepth, 0.0, 0.0, 0.0));
	imageStore(uImagesGenericWrite[nonuniformEXT(push.velocityStorageIdx)], pixel, vec4(cloudVelocity, 0.0, 0.0));
}
