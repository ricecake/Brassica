#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_scalar_block_layout : require

// Half-chunk rendering: max 144 vertices (9x16), max 240 triangles (8x15 quads * 2)
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 144, max_primitives = 240) out;

#include "bindless.glsl"
#include "common.glsl"
#include "terrain.glsl"
#include "terrain_chunk_payload.glsl"

vec3 getTerrainMapColor(float h, vec3 normal) {
    vec3 lightDir = normalize(vec3(0.5, 0.8, 0.3));
    float hillshade = clamp(dot(normal, lightDir), 0.2, 1.0);

    vec3 col;
    if (h < 0.0) {
        float bathy = clamp(-h / 1000.0, 0.0, 1.0);
        col = mix(vec3(0.93, 0.85, 0.69), vec3(0.87, 0.72, 0.53), bathy);
    } else {
        float alt = h / 2500.0;
        if (alt < 0.1) {
            col = mix(vec3(0.18, 0.52, 0.22), vec3(0.35, 0.65, 0.25), alt / 0.1);
        } else if (alt < 0.4) {
            col = mix(vec3(0.35, 0.65, 0.25), vec3(0.75, 0.70, 0.40), (alt - 0.1) / 0.3);
        } else if (alt < 0.8) {
            col = mix(vec3(0.75, 0.70, 0.40), vec3(0.55, 0.45, 0.35), (alt - 0.4) / 0.4);
        } else {
            col = mix(vec3(0.55, 0.45, 0.35), vec3(0.95, 0.95, 0.98), clamp((alt - 0.8) / 0.4, 0.0, 1.0));
        }
        col *= hillshade;
    }
    return col;
}

struct TerrainChunkVertex {
	vec4 position; // xyz = position (planar), w = height
	vec4 normal;   // xyz = normal, w = biome
	vec4 material; // x = waterLevel, y = ridgeMap, z = substrate, w = unused
};

layout(scalar, buffer_reference) buffer VertexBufferRef {
	TerrainChunkVertex vertices[];
};

layout(push_constant) uniform TerrainChunkRenderPushConstants {
	uvec2 pageTableBufferAddr;
	uvec2 vertexBufferAddr;
	uvec4 gridParams; // x = numLODs, y = chunksPerRow, z = totalChunks, w = maxAllocatedChunks
	float baseChunkSize;
	float waterLevel;
	uint  minMaxIndex;
	uint  hizIndex;
} push;

layout(location = 0) out vec3 outPosition[];
layout(location = 1) out vec3 outNormal[];
layout(location = 2) out vec4 outAlbedo[];
layout(location = 3) out vec4 outMaterial[];
layout(location = 4) out vec4 outMaterialWeights[];

void processLocalVertex(uint localVIdx, uint globalVertIdx) {
	VertexBufferRef vertBuf = VertexBufferRef(push.vertexBufferAddr);
	TerrainChunkVertex v = vertBuf.vertices[globalVertIdx];

	vec3 worldPos = v.position.xyz;
	float height = v.position.w;
	vec3 normal = v.normal.xyz;
	float biome = v.normal.w;

	float localWaterLevel = v.material.x;
	float ridgeMap = v.material.y;
	float substrate = v.material.z;

	vec3 camSphereDir = worldXZToSphereDir(uCameraPosition.xz);
	uint camFace;
	vec2 camUV;
	sphereNormalToCubeFace(camSphereDir, camFace, camUV);
	vec3 camUp = cubeFaceToSphereNormal(camFace, camUV);
	vec3 camPos3D = camUp * (FAKE_PLANET_RADIUS + uCameraPosition.y);
	vec3 camEast, camNorth;
	getSphereTopocentricFrame(camUp, camUp, camEast, camNorth);

	vec3 relPos, relNorm;
	transformToCameraTopocentric(worldPos, normal, camPos3D, camUp, camEast, camNorth, relPos, relNorm);
	relNorm = normalize(relNorm);

	vec3 viewPos = mat3(uViewMatrix) * relPos;
	gl_MeshVerticesEXT[localVIdx].gl_Position = uProjMatrix * vec4(viewPos, 1.0);

	outPosition[localVIdx] = relPos;
	outNormal[localVIdx] = relNorm;

	vec3 baseColor = getTerrainMapColor(height, relNorm);
	float roughness = 0.75;
	float metallic = 0.0;
	float glint = 0.0;

	float slopeFactor = smoothstep(0.80, 0.30, relNorm.y);
	float rockWeight = max(slopeFactor * 0.85, smoothstep(0.2, 0.8, ridgeMap * 0.5));
	vec3 regionalRockColor = getGeologicalRockColor(biome);
	if (rockWeight > 0.0) {
		baseColor = mix(baseColor, regionalRockColor, rockWeight);
		roughness = mix(roughness, 0.85, rockWeight);
	}

	float sandWeight = 0.0;
	if (relNorm.y > 0.4) {
		float distToWater = abs(height - localWaterLevel);
		if (distToWater < 6.0) {
			float shoreFactor = (1.0 - smoothstep(0.0, 6.0, distToWater)) * smoothstep(0.4, 0.8, relNorm.y);
			sandWeight = shoreFactor * 0.85;
			baseColor = mix(baseColor, vec3(0.82, 0.75, 0.55), sandWeight);
		}
	}

	float grassWeight = clamp(1.0 - max(rockWeight, sandWeight), 0.0, 1.0);
	vec4 matWeights = vec4(grassWeight, rockWeight, sandWeight, 0.0);

	outAlbedo[localVIdx] = vec4(baseColor, 1.0);
	outMaterial[localVIdx] = vec4(metallic, roughness, glint, 0.0);
	outMaterialWeights[localVIdx] = matWeights;
}

void main() {
	uint taskIdx = gl_WorkGroupID.x;
	uint packedSlot = chunkPayload.physicalSlots[taskIdx];
	uint physicalSlot = packedSlot & 0x7FFFFFFFu;
	uint halfIdx = packedSlot >> 31u; // 0 = top half (rows 0..8, 8 quad rows), 1 = bottom half (rows 7..15, 8 quad rows)

	uint threadID = gl_LocalInvocationID.x;

	uint numVertRows = 9u; // 9 rows of 16 vertices = 144 vertices
	uint numQuadRows = 8u; // 8 rows of 15 quads = 120 quads = 240 triangles
	uint numVerts = numVertRows * 16u; // 144
	uint numTris = numQuadRows * 15u * 2u; // 240

	SetMeshOutputsEXT(numVerts, numTris);

	uint startRow = (halfIdx == 0u) ? 0u : 7u;

	// Output 144 vertices using 128 threads
	if (threadID < numVerts) {
		uint localRow = threadID / 16u;
		uint col = threadID % 16u;
		uint globalVertIdx = physicalSlot * 256u + (startRow + localRow) * 16u + col;
		processLocalVertex(threadID, globalVertIdx);
	}
	if (threadID + 128u < numVerts) {
		uint vIdx = threadID + 128u;
		uint localRow = vIdx / 16u;
		uint col = vIdx % 16u;
		uint globalVertIdx = physicalSlot * 256u + (startRow + localRow) * 16u + col;
		processLocalVertex(vIdx, globalVertIdx);
	}

	// Output 240 triangles (120 quads * 2) across 128 threads
	if (threadID < 120u) {
		uint localQuadRow = threadID / 15u;
		uint localQuadCol = threadID % 15u;

		uint v0 = localQuadRow * 16u + localQuadCol;
		uint v1 = localQuadRow * 16u + (localQuadCol + 1u);
		uint v2 = (localQuadRow + 1u) * 16u + localQuadCol;
		uint v3 = (localQuadRow + 1u) * 16u + (localQuadCol + 1u);

		uint prim0 = threadID * 2u;
		uint prim1 = threadID * 2u + 1u;

		gl_PrimitiveTriangleIndicesEXT[prim0] = uvec3(v0, v2, v1);
		gl_PrimitiveTriangleIndicesEXT[prim1] = uvec3(v1, v2, v3);

		gl_MeshPrimitivesEXT[prim0].gl_CullPrimitiveEXT = false;
		gl_MeshPrimitivesEXT[prim1].gl_CullPrimitiveEXT = false;
	}
}
