#version 460
#extension GL_EXT_ray_query : enable

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform FrameUBO {
	float time;
	uint  frameIndex;
	uint  globalSeed;
	uint  frameRandom;
} ubo;

layout(rgba16f, set = 1, binding = 0) writeonly uniform image3D injectionGrid;
layout(set = 1, binding = 1) uniform sampler2D transmittanceLUT;
layout(set = 1, binding = 2) uniform sampler2DArray terrainClipmap;
layout(set = 1, binding = 3) uniform accelerationStructureEXT topLevelAS;

struct TerrainAABB {
	float minX;
	float minY;
	float minZ;
	float maxX;
	float maxY;
	float maxZ;
};

layout(std430, set = 1, binding = 4) readonly buffer TerrainAABBs {
	TerrainAABB terrainAABBs[];
};

layout(push_constant) uniform VolumetricPushConstants {
	mat4  invViewProj;
	vec4  cameraPos;      // xyz = cam pos, w = baseTexelSize
	vec4  sunDir;         // xyz = sun direction, w = intensity
	vec4  sunColor;       // rgb = sun color
	vec4  gridDimensions; // x, y, z grid size (160, 90, 64)
	vec4  clipParams;     // x = near, y = far
	uvec4 gridParams;     // numLODs, meshletsPerRow, totalMeshlets, textureDim
	uvec4 lodOffsets0_3;
	uvec4 lodOffsets4_7;
} params;

// Mie Phase function
float miePhase(float cosTheta, float g) {
	float g2 = g * g;
	float num = 1.0 - g2;
	float denom = 4.0 * 3.14159265359 * pow(1.0 + g2 - 2.0 * g * cosTheta, 1.5);
	return num / max(denom, 0.0001);
}

void main() {
	uvec3 gridPos = gl_GlobalInvocationID;
	uvec3 dim = uvec3(params.gridDimensions.xyz);
	if (gridPos.x >= dim.x || gridPos.y >= dim.y || gridPos.z >= dim.z) {
		return;
	}

	vec3 uvw = (vec3(gridPos) + vec3(0.5)) / vec3(dim);

	float zNear = params.clipParams.x > 0.0 ? params.clipParams.x : 0.1;
	float zFar = params.clipParams.y > 0.0 ? params.clipParams.y : 32768.0;

	// Exponential depth distribution
	float viewDepth = zNear * pow(zFar / zNear, uvw.z);

	// Reconstruct world position from uvw and depth
	vec2 ndc = uvw.xy * 2.0 - 1.0;
	vec4 clipPos = vec4(ndc, 0.5, 1.0);
	vec4 worldRay = params.invViewProj * clipPos;
	vec3 rayDir = normalize(worldRay.xyz / worldRay.w - params.cameraPos.xyz);
	vec3 worldPos = params.cameraPos.xyz + rayDir * viewDepth;

	vec3 lightDir = normalize(params.sunDir.xyz);

	// Light transmittance and shadowing
	float shadow = 1.0;
	vec3 lightColor = params.sunColor.rgb * params.sunDir.w;

	// Ray Query shadow test
	rayQueryEXT rq;
	rayQueryInitializeEXT(
		rq,
		topLevelAS,
		gl_RayFlagsNoneEXT,
		0xFF,
		worldPos + lightDir * 0.1,
		0.1,
		lightDir,
		1000.0
	);

	while (rayQueryProceedEXT(rq)) {
		uint candidateType = rayQueryGetIntersectionTypeEXT(rq, false);
		if (candidateType == gl_RayQueryCandidateIntersectionAABBEXT) {
			rayQueryGenerateIntersectionEXT(rq, 0.5);
		}
	}

	if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
		shadow = 0.2;
	}

	float cosTheta = dot(rayDir, lightDir);
	float phase = miePhase(cosTheta, 0.8);

	// In-scattered light calculation
	vec3 inScattered = lightColor * phase * shadow + vec3(0.02, 0.04, 0.08); // Include sky ambient term
	float extinction = 0.0005; // Uniform atmospheric extinction coefficient

	imageStore(injectionGrid, ivec3(gridPos), vec4(inScattered, extinction));
}
