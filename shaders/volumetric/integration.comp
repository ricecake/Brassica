#version 460

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform FrameUBO {
	float time;
	uint  frameIndex;
	uint  globalSeed;
	uint  frameRandom;
} ubo;

layout(rgba16f, set = 1, binding = 0) readonly uniform image3D inInjection;
layout(rgba16f, set = 1, binding = 1) writeonly uniform image3D outScattering;
layout(rgba16f, set = 1, binding = 2) writeonly uniform image3D outHistory;

layout(push_constant) uniform VolumetricPushConstants {
	mat4  invViewProj;
	mat4  prevViewProj;
	vec4  cameraPos;         // xyz = cam pos, w = baseTexelSize
	vec4  sunDir;            // xyz = sun direction, w = intensity
	vec4  sunColor;          // rgb = sun color
	vec4  params0;           // x = anisotropy (g), y = intensity, z = ambientScale, w = shadowSensitivity
	vec4  params1;           // x = lightAccent, y = temporalAlpha, z = rayleighScale, w = mieScale
	vec4  cascadeDistances;  // 4 cascades: (20.0, 60.0, 200.0, 1000.0)
} params;

shared vec3  s_scat[256];
shared float s_trans[256];

void main() {
	uvec2 xy = gl_WorkGroupID.xy;
	if (xy.x >= 160u || xy.y >= 90u) {
		return;
	}

	int idx = int(gl_LocalInvocationID.x); // 0 .. 255
	ivec3 vox = ivec3(xy, idx);

	// Load injected scattering and extinction
	vec4 data = imageLoad(inInjection, vox);
	if (any(isnan(data))) {
		data = vec4(0.0);
	}

	// Store history for next frame
	imageStore(outHistory, vox, data);

	vec3 scattering = max(vec3(0.0), data.rgb);
	float extinction = max(0.0, data.a);

	int cascade = idx / 64;
	int z = idx % 64;

	float cascadeDists[4] = float[4](
		params.cascadeDistances.x,
		params.cascadeDistances.y,
		params.cascadeDistances.z,
		params.cascadeDistances.w
	);

	float z_near = (cascade == 0) ? 0.1 : cascadeDists[cascade - 1];
	float z_far = cascadeDists[cascade];

	float z0 = z_near * pow(z_far / z_near, float(z) / 64.0);
	float z1 = z_near * pow(z_far / z_near, float(z + 1) / 64.0);
	float stepSize = z1 - z0;

	float transmittance = exp(-extinction * stepSize);
	float factor = (extinction > 0.00001) ? (1.0 - transmittance) / extinction : stepSize;

	s_scat[idx] = scattering * factor;
	s_trans[idx] = transmittance;

	barrier();

	// Parallel Prefix Scan (Hillis-Steele Scan across 256 depth slices)
	// Associative operator: (S1, T1) op (S2, T2) = (S1 + T1 * S2, T1 * T2)
	for (int stride = 1; stride < 256; stride <<= 1) {
		vec3  otherScat = vec3(0.0);
		float otherTrans = 1.0;

		if (idx >= stride) {
			otherScat = s_scat[idx - stride];
			otherTrans = s_trans[idx - stride];
		}

		barrier();

		if (idx >= stride) {
			s_scat[idx] = otherScat + otherTrans * s_scat[idx];
			s_trans[idx] = otherTrans * s_trans[idx];
		}

		barrier();
	}

	// Store integrated scattering and transmittance
	vec3 finalScat = clamp(s_scat[idx], vec3(0.0), vec3(65504.0));
	float finalTrans = clamp(s_trans[idx], 0.0, 1.0);

	if (any(isnan(finalScat))) {
		finalScat = vec3(0.0);
	}

	imageStore(outScattering, vox, vec4(finalScat, finalTrans));
}
