#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform FrameUBO {
	float time;
	uint  frameIndex;
	uint  globalSeed;
	uint  frameRandom;
} ubo;

layout(rgba16f, set = 1, binding = 0) readonly uniform image3D injectionGrid;
layout(rgba16f, set = 1, binding = 1) writeonly uniform image3D integratedGrid;

layout(push_constant) uniform VolumetricPushConstants {
	mat4  invViewProj;
	vec4  cameraPos;      // xyz = cam pos, w = baseTexelSize
	vec4  sunDir;         // xyz = sun direction, w = intensity
	vec4  sunColor;       // rgb = sun color
	vec4  gridDimensions; // x, y, z grid size (160, 90, 64)
	vec4  clipParams;     // x = near, y = far
	uvec4 gridParams;     // numLODs, meshletsPerRow, totalMeshlets, textureDim
	uvec4 lodOffsets0_3;
	uvec4 lodOffsets4_7;
} params;

void main() {
	uvec2 cellXY = gl_GlobalInvocationID.xy;
	uvec3 dim = uvec3(params.gridDimensions.xyz);
	if (cellXY.x >= dim.x || cellXY.y >= dim.y) {
		return;
	}

	float zNear = params.clipParams.x > 0.0 ? params.clipParams.x : 0.1;
	float zFar = params.clipParams.y > 0.0 ? params.clipParams.y : 32768.0;

	vec3 accumScattering = vec3(0.0);
	float accumTransmittance = 1.0;

	float prevDepth = 0.0;

	for (uint z = 0u; z < dim.z; ++z) {
		float sliceFrac = (float(z) + 0.5) / float(dim.z);
		float currDepth = zNear * pow(zFar / zNear, sliceFrac);
		float stepLength = currDepth - prevDepth;
		prevDepth = currDepth;

		vec4 inj = imageLoad(injectionGrid, ivec3(cellXY, z));
		vec3 inScattering = inj.rgb;
		float extinction = max(inj.a, 0.00001);

		float stepTransmittance = exp(-extinction * stepLength);
		vec3 stepScattering = inScattering * (1.0 - stepTransmittance) / extinction;

		accumScattering += accumTransmittance * stepScattering;
		accumTransmittance *= stepTransmittance;

		// Accumulation clamping as specified for 3D pass
		accumScattering = clamp(accumScattering, vec3(0.0), vec3(65504.0));
		accumTransmittance = clamp(accumTransmittance, 0.0, 1.0);

		imageStore(integratedGrid, ivec3(cellXY, z), vec4(accumScattering, accumTransmittance));
	}
}
